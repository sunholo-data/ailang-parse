{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sunholo.com/docparse/officedocbench/adapter_output.schema.json",
  "title": "OfficeDocBench Adapter Output",
  "description": "Common output format that all OfficeDocBench adapters must produce",
  "type": "object",
  "required": [
    "text_elements"
  ],
  "properties": {
    "text_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "style": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "required": [
          "text",
          "level"
        ]
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array"
          },
          "row_count": {
            "type": "integer"
          },
          "has_merged_cells": {
            "type": "boolean"
          },
          "cell_text": {
            "type": "string"
          }
        }
      }
    },
    "track_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "headers_footers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "header",
              "footer"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      }
    },
    "footnotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "speaker_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "text_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "default": ""
          }
        }
      }
    },
    "lists": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ordered": {
            "type": "boolean"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        },
        "sheet_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "element_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "comment_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "list_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "hyperlinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "bookmarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "breaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRecord"
          }
        }
      }
    }
  },
  "$defs": {
    "structureRecord": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "fill": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "annotated_text": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "vertAlign": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "merged": {
          "type": "boolean"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "code": {
          "type": "boolean"
        },
        "anchored": {
          "type": "boolean"
        },
        "resolved": {
          "type": "boolean"
        },
        "table": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "col_span": {
          "type": "integer",
          "minimum": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "ordered": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
