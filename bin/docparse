#!/usr/bin/env bash
set -euo pipefail

# AILANG Parse CLI — Universal Document Parsing
# Wrapper around ailang that handles caps, AI model, and flags automatically.

# Disable auto-trace for production (2-5x speedup); set AILANG_NO_TRACE=0 to re-enable
export AILANG_NO_TRACE="${AILANG_NO_TRACE:-1}"

# Resolve symlinks to find the real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
MAIN_AIL="docparse/main.ail"
DEFAULT_AI_MODEL="gemini-2.5-flash"

# Module list for --check and --test (relative to PROJECT_DIR)
MODULES=(
  docparse/types/document.ail
  docparse/services/format_router.ail
  docparse/services/zip_extract.ail
  docparse/services/docx_parser.ail
  docparse/services/pptx_parser.ail
  docparse/services/xlsx_parser.ail
  docparse/services/direct_ai_parser.ail
  docparse/services/pdf_backend_external.ail
  docparse/services/layout_ai.ail
  docparse/services/output_formatter.ail
  docparse/services/csv_parser.ail
  docparse/services/markdown_parser.ail
  docparse/services/html_parser.ail
  docparse/services/epub_parser.ail
  docparse/services/odt_parser.ail
  docparse/services/odp_parser.ail
  docparse/services/ods_parser.ail
  docparse/services/eval.ail
  docparse/services/unstructured_compat.ail
  docparse/services/eml_parser.ail
  docparse/services/xml_helpers.ail
  docparse/services/a2ui_formatter.ail
  docparse/services/samples.ail
  docparse/services/tools.ail
  docparse/services/docparse_browser.ail
  docparse/services/html_generator.ail
  docparse/services/docx_generator.ail
  docparse/services/pptx_generator.ail
  docparse/services/xlsx_generator.ail
  docparse/services/odt_generator.ail
  docparse/services/odp_generator.ail
  docparse/services/ods_generator.ail
  docparse/services/qmd_generator.ail
  docparse/services/ai_generator.ail
  docparse/main.ail
)

TEST_MODULES=(
  docparse/services/format_router.ail
  docparse/services/zip_extract.ail
  docparse/services/docx_parser.ail
  docparse/services/odt_parser.ail
  docparse/services/odp_parser.ail
)

usage() {
  cat <<'EOF'
AILANG Parse — Universal Document Parsing

Usage: docparse <file|folder> [file2 ...] [options]
       docparse --check
       docparse --test

Examples:
  docparse report.docx                  Parse Office document
  docparse *.eml                        Batch parse (compile once)
  docparse ~/inbox/                     Parse all files in folder
  docparse slides.pptx --describe       With AI image descriptions
  docparse report.docx --summarize      With AI summary
  docparse contract.pdf                 PDF (deterministic pdftotext, no AI)
  docparse scan.pdf --pdf-backend ai    Scanned PDF (needs multimodal AI)
  docparse photo.png                    Image (auto-enables AI)

Performance:
  Pass multiple files or a folder for best throughput. Batch mode
  compiles once and parses all files — up to 10x faster per file
  than parsing one at a time.

    FAST:  docparse *.docx              (compile once, parse many)
    FAST:  docparse ~/Documents/        (same — folder expansion)
    SLOW:  for f in *.docx; do docparse "$f"; done  (recompiles each time)

Options:
  --describe        Enable AI image descriptions
  --summarize       Enable AI document summary
  --pdf-backend B   PDF backend: pdftotext (default, deterministic plain text),
                    docling (local ML layout), liteparse (font-size headings),
                    ai (multimodal AI — required for scanned/image-only PDFs)
  --ai MODEL        AI model (default: gemini-2.5-flash; gemini-3-flash-preview
                    is supported but ~5x slower for PDF parsing due to thinking
                    tokens — pass it explicitly only when reasoning helps)
  --verify          Enable runtime contract verification
  --budget-report   Show capability budget usage after run
  --output-dir DIR  Copy output files to DIR after parsing
  --check           Type-check all modules (no file needed)
  --test            Run all inline tests (no file needed)
  --prove           Static Z3 contract verification (no file needed, requires z3)
  --eval            Run AILANG eval on all golden files (no file needed)
  -h, --help        Show this help

Supported formats:
  Office:  .docx .pptx .xlsx                       (deterministic XML)
  ODF:     .odt .odp .ods                          (deterministic XML)
  Web:     .html .htm .xhtml                       (deterministic XML)
  Text:    .md .csv .txt .tex .tar.gz              (deterministic)
  Books:   .epub                                   (deterministic ZIP+XHTML)
  Email:   .eml .mbox                              (deterministic)
  AI:      .pdf .png .jpg .gif .bmp .webp .tiff
           .mp3 .wav .ogg .flac .mp4 .mov .avi .mkv  (multimodal AI)

Output:
  <out>/<filename>.json   Structured JSON with typed blocks
  <out>/<filename>.md     LLM-ready markdown
  Default <out> is docparse/data; --output-dir DIR overrides it. In batch
  mode each file's outputs are written as soon as that file finishes — you
  can inspect completed files mid-batch and nothing is lost on Ctrl+C.
EOF
}

# --- Dev commands ---

do_check() {
  echo "Type-checking all AILANG Parse modules..."
  local fail=0
  for mod in "${MODULES[@]}"; do
    local name
    name="$(basename "$mod")"
    if ailang check "$mod" 2>&1; then
      echo "  $name  OK"
    else
      echo "  $name  FAIL"
      fail=1
    fi
  done
  if [ "$fail" -eq 0 ]; then
    echo "All ${#MODULES[@]} modules type-check clean."
  else
    echo "Some modules failed type-checking."
    exit 1
  fi
}

do_test() {
  echo "Running inline tests..."
  for mod in "${TEST_MODULES[@]}"; do
    echo ""
    echo "--- $(basename "$mod") ---"
    ailang test "$mod"
  done
}

do_eval() {
  echo "Running AILANG eval on all golden files..."
  local golden_dir="benchmarks/office/golden"
  local test_dir="data/test_files"
  local pass=0
  local fail=0
  local total=0
  local eval_tmpdir
  eval_tmpdir="$(mktemp -d)"
  trap "rm -rf '$eval_tmpdir'" EXIT

  # Collect files to parse
  local batch_files=()
  local batch_names=()
  for golden in "$golden_dir"/*.json; do
    [ -f "$golden" ] || continue
    local fname
    fname="$(basename "$golden" .json)"
    [ -f "$test_dir/$fname" ] || continue
    total=$((total + 1))
    batch_files+=("$test_dir/$fname")
    batch_names+=("$fname")
  done

  # Phase 1: Parse all files in batch (compile once, run N times)
  echo "  Phase 1: Parsing $total files (batch mode)..."
  DOCPARSE_OUTPUT_DIR="$eval_tmpdir" ailang run --batch --entry main --caps IO,FS,Env --max-recursion-depth 50000 docparse/main.ail "${batch_files[@]}" > /dev/null 2>&1 || true
  local parsed=0
  for fname in "${batch_names[@]}"; do
    [ -f "$eval_tmpdir/${fname}.json" ] && parsed=$((parsed + 1))
  done
  echo "  Phase 1: $parsed/$total parsed"

  # Phase 2: Eval all files individually
  # (batch mode only supports 1 arg per invocation, eval needs 2: golden + actual)
  echo "  Phase 2: Evaluating..."
  for golden in "$golden_dir"/*.json; do
    [ -f "$golden" ] || continue
    local fname
    fname="$(basename "$golden" .json)"
    local output_json="$eval_tmpdir/${fname}.json"
    if [ ! -f "$output_json" ]; then
      fail=$((fail + 1))
      continue
    fi
    local eval_out
    eval_out=$(ailang run --entry evalMain --caps IO,FS,Env docparse/services/eval.ail "$golden" "$output_json" 2>&1)
    if echo "$eval_out" | grep -q "Score: 100"; then
      echo "    $fname: 100%"
      pass=$((pass + 1))
    else
      echo "    $fname: FAIL"
      echo "$eval_out" | head -5
      fail=$((fail + 1))
    fi
  done

  rm -rf "$eval_tmpdir"
  echo ""
  echo "AILANG eval: $pass/$total passed ($fail failures)"
}

do_prove() {
  echo "Static contract verification (Z3)..."
  echo ""
  local total_verified=0
  local total_skipped=0
  local total_violations=0
  local total_errors=0
  for mod in "${MODULES[@]}"; do
    local name
    name="$(basename "$mod")"
    local output
    if output=$(ailang verify "$mod" 2>&1); then
      echo "$output"
    else
      echo "$output"
    fi
    echo ""
  done
}

# --- Parse arguments ---

FILES=()
DESCRIBE=false
SUMMARIZE=false
AI_MODEL="$DEFAULT_AI_MODEL"
VERIFY=false
BUDGET=false
OUTPUT_DIR=""
PDF_BACKEND="${DOCPARSE_PDF_BACKEND:-pdftotext}"
EXTRA_FLAGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --check)
      cd "$PROJECT_DIR"
      do_check
      exit 0
      ;;
    --test)
      cd "$PROJECT_DIR"
      do_test
      exit 0
      ;;
    --prove)
      cd "$PROJECT_DIR"
      do_prove
      exit 0
      ;;
    --eval)
      cd "$PROJECT_DIR"
      do_eval
      exit 0
      ;;
    --describe)
      DESCRIBE=true
      shift
      ;;
    --summarize)
      SUMMARIZE=true
      shift
      ;;
    --ai)
      AI_MODEL="$2"
      shift 2
      ;;
    --verify)
      VERIFY=true
      shift
      ;;
    --budget-report)
      BUDGET=true
      shift
      ;;
    --output-dir)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    --pdf-backend)
      PDF_BACKEND="$2"
      case "$PDF_BACKEND" in
        pdftotext|ai|docling|liteparse) ;;
        *)
          echo "Error: --pdf-backend must be one of: pdftotext, ai, docling, liteparse (got: $PDF_BACKEND)" >&2
          exit 2
          ;;
      esac
      shift 2
      ;;
    -*)
      EXTRA_FLAGS+=("$1")
      shift
      ;;
    *)
      FILES+=("$1")
      shift
      ;;
  esac
done

if [ ${#FILES[@]} -eq 0 ]; then
  usage
  exit 1
fi

# Resolve file paths to absolute (files and directories)
RESOLVED_FILES=()
for f in "${FILES[@]}"; do
  if [[ ! "$f" = /* ]]; then
    f="$(pwd)/$f"
  fi
  if [ ! -f "$f" ] && [ ! -d "$f" ]; then
    echo "Error: File or folder not found: $f"
    exit 1
  fi
  RESOLVED_FILES+=("$f")
done

# --- Expand folders into file lists ---
# Supported extensions for folder scanning
SUPPORTED_EXTS_PATTERN='.*\.\(docx\|pptx\|xlsx\|odt\|odp\|ods\|html\|htm\|md\|csv\|epub\|eml\|mbox\|pdf\|png\|jpg\|jpeg\|gif\|bmp\|webp\|tiff\|tif\|mp3\|wav\|ogg\|flac\|mp4\|mov\|avi\|mkv\)$'

expand_folder() {
  local dir="$1"
  find "$dir" -maxdepth 1 -type f | grep -i "${SUPPORTED_EXTS_PATTERN}" | sort
}

# Expand any directories in RESOLVED_FILES
EXPANDED_FILES=()
for f in "${RESOLVED_FILES[@]}"; do
  if [ -d "$f" ]; then
    while IFS= read -r entry; do
      [ -n "$entry" ] && EXPANDED_FILES+=("$entry")
    done < <(expand_folder "$f")
  else
    EXPANDED_FILES+=("$f")
  fi
done

if [ ${#EXPANDED_FILES[@]} -eq 0 ]; then
  echo "Error: No supported files found."
  exit 1
fi

RESOLVED_FILES=("${EXPANDED_FILES[@]}")

# --- Detect if AI is needed (check all files) ---
# PDFs default to pdftotext (Process cap, no AI). Only --pdf-backend ai needs AI.

NEEDS_AI=false
NEEDS_PROCESS=false
for f in "${RESOLVED_FILES[@]}"; do
  EXT="${f##*.}"
  EXT_LOWER="$(echo "$EXT" | tr '[:upper:]' '[:lower:]')"
  case "$EXT_LOWER" in
    pdf)
      if [ "$PDF_BACKEND" = "ai" ]; then
        NEEDS_AI=true
      else
        NEEDS_PROCESS=true
      fi
      ;;
    png|jpg|jpeg|gif|bmp|webp|tiff|tif|mp3|wav|ogg|flac|mp4|mov|avi|mkv)
      NEEDS_AI=true
      ;;
  esac
done

USE_AI=false
if $NEEDS_AI || $DESCRIBE || $SUMMARIZE; then
  USE_AI=true
fi

# --- Build ailang command ---

CAPS="IO,FS,Env"
if $USE_AI; then
  CAPS="${CAPS},AI"
fi
if $NEEDS_PROCESS; then
  CAPS="${CAPS},Process"
fi

USE_BATCH=false
if [ ${#RESOLVED_FILES[@]} -gt 1 ]; then
  USE_BATCH=true
fi

CMD=(ailang run)
if $USE_BATCH; then
  CMD+=(--batch)
fi
CMD+=(--entry main --caps "$CAPS" --max-recursion-depth 50000)

if $USE_AI; then
  CMD+=(--ai "$AI_MODEL")
fi

if $VERIFY; then
  CMD+=(--verify-contracts)
fi

if $BUDGET; then
  CMD+=(--budget-report)
fi

CMD+=("${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}")
CMD+=("$MAIN_AIL")

# Pass flags to AILANG main
AILANG_ARGS=()
if $DESCRIBE; then
  AILANG_ARGS+=(describe)
fi
if $SUMMARIZE; then
  AILANG_ARGS+=(summarize)
fi

# --- Resolve output dir to absolute path before cd ---

if [ -n "$OUTPUT_DIR" ]; then
  if [[ ! "$OUTPUT_DIR" = /* ]]; then
    OUTPUT_DIR="$(pwd)/$OUTPUT_DIR"
  fi
fi

# --- Run ---

cd "$PROJECT_DIR"

# When --output-dir is set, AILANG writes outputs there directly (per file,
# eagerly as each file finishes) via the DOCPARSE_OUTPUT_DIR env var.
# This means: completed files are visible mid-batch, nothing is lost on
# Ctrl+C, and there's no bulk post-copy step.
ENV_PREFIX=()
if [ -n "$OUTPUT_DIR" ]; then
  mkdir -p "$OUTPUT_DIR"
  ENV_PREFIX+=(DOCPARSE_OUTPUT_DIR="$OUTPUT_DIR")
fi
if $USE_AI; then
  ENV_PREFIX+=(GOOGLE_API_KEY="")
fi
if [ "$PDF_BACKEND" != "ai" ]; then
  ENV_PREFIX+=(DOCPARSE_PDF_BACKEND="$PDF_BACKEND")
  ENV_PREFIX+=(DOCPARSE_PROJECT_ROOT="$PROJECT_DIR")
fi

run_cmd() {
  if [ ${#ENV_PREFIX[@]} -gt 0 ]; then
    env "${ENV_PREFIX[@]}" "$@"
  else
    "$@"
  fi
}

if $USE_BATCH; then
  TOTAL=${#RESOLVED_FILES[@]}
  echo "Batch mode: parsing ${TOTAL} files (compile once)..."
  if [ -n "$OUTPUT_DIR" ]; then
    echo "Outputs streaming to $OUTPUT_DIR/ as each file completes."
  fi
  echo ""
  START=$(date +%s)

  # Chunk large file lists to avoid OS ARG_MAX (~2MB on macOS).
  # 500 files per chunk keeps args well under the limit for any path length.
  BATCH_CHUNK_SIZE=500
  for (( i=0; i<TOTAL; i+=BATCH_CHUNK_SIZE )); do
    CHUNK=("${RESOLVED_FILES[@]:$i:$BATCH_CHUNK_SIZE}")
    FULL_CMD=("${CMD[@]}")
    for f in "${CHUNK[@]}"; do
      FULL_CMD+=("$f" "${AILANG_ARGS[@]+"${AILANG_ARGS[@]}"}")
    done
    run_cmd "${FULL_CMD[@]}"
  done

  END=$(date +%s)
  ELAPSED=$((END - START))
  echo ""
  echo "Batch complete: ${TOTAL} files in ${ELAPSED}s"
else
  # Single file
  FILE="${RESOLVED_FILES[0]}"
  CMD+=("$FILE" "${AILANG_ARGS[@]+"${AILANG_ARGS[@]}"}")
  run_cmd "${CMD[@]}"
fi
