#!/usr/bin/env bash
set -euo pipefail

# AILANG Parse CLI — Universal Document Parsing
# Wrapper around ailang that handles caps, AI model, and flags automatically.

# Disable auto-trace for production (2-5x speedup); set AILANG_NO_TRACE=0 to re-enable
export AILANG_NO_TRACE="${AILANG_NO_TRACE:-1}"

# Resolve symlinks to find the real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
MAIN_AIL="docparse/main.ail"
DEFAULT_AI_MODEL="gemini-2.5-flash"

# Module list for --check and --test (relative to PROJECT_DIR)
MODULES=(
  docparse/types/document.ail
  docparse/services/format_router.ail
  docparse/services/zip_extract.ail
  docparse/services/docx_parser.ail
  docparse/services/pptx_parser.ail
  docparse/services/xlsx_parser.ail
  docparse/services/direct_ai_parser.ail
  docparse/services/pdf_backend_external.ail
  docparse/services/layout_ai.ail
  docparse/services/markdown_writer.ail
  docparse/services/console_report.ail
  docparse/services/output_formatter.ail
  docparse/services/csv_parser.ail
  docparse/services/markdown_parser.ail
  docparse/services/html_parser.ail
  docparse/services/epub_parser.ail
  docparse/services/odf_text.ail
  docparse/services/odf_runs.ail
  docparse/services/docparse_generate.ail
  docparse/services/odt_parser.ail
  docparse/services/odp_parser.ail
  docparse/services/ods_parser.ail
  docparse/services/eval.ail
  docparse/services/unstructured_compat.ail
  docparse/services/eml_parser.ail
  docparse/services/xml_helpers.ail
  docparse/services/a2ui_formatter.ail
  docparse/services/samples.ail
  docparse/services/tools.ail
  docparse/services/docparse_browser.ail
  docparse/services/html_generator.ail
  docparse/services/docx_generator.ail
  docparse/services/pptx_generator.ail
  docparse/services/xlsx_generator.ail
  docparse/services/odt_generator.ail
  docparse/services/odp_generator.ail
  docparse/services/ods_generator.ail
  docparse/services/qmd_generator.ail
  docparse/services/ai_generator.ail
  # Added after an audit found these 12 were in neither --check nor --prove.
  # tex_parser alone carries 19 contracts — the most of any module in the repo —
  # so the module with the densest contract coverage was the one nothing scored.
  docparse/services/tex_parser.ail
  docparse/services/tex_input_resolver.ail
  docparse/services/tex_archive_extract.ail
  docparse/services/rtf_parser.ail
  docparse/services/orchestrator.ail
  docparse/services/chunker.ail
  docparse/services/omml.ail
  docparse/services/pdf_annotations.ail
  docparse/services/mcp/tools.ail
  docparse/services/mcp/auth.ail
  docparse/services/mcp/account.ail
  docparse/services/mcp/estimate.ail
  docparse/main.ail
)

TEST_MODULES=(
  docparse/services/format_router.ail
  docparse/services/zip_extract.ail
  docparse/services/docx_parser.ail
  docparse/services/odt_parser.ail
  docparse/services/odp_parser.ail
)

usage() {
  cat <<'EOF'
AILANG Parse — Universal Document Parsing

Usage: docparse <file|folder> [file2 ...] [options]
       docparse --check
       docparse --test

Examples:
  docparse report.docx                  Parse Office document
  docparse *.eml                        Batch parse (compile once)
  docparse ~/inbox/                     Parse all files in folder
  docparse slides.pptx --describe       With AI image descriptions
  docparse report.docx --summarize      With AI summary
  docparse contract.pdf                 PDF (deterministic pdftotext, no AI)
  docparse scan.pdf --pdf-backend ai    Scanned PDF (needs multimodal AI)
  docparse photo.png                    Image (auto-enables AI)

Performance:
  Pass multiple files or a folder for best throughput. Batch mode
  compiles once and parses all files — up to 10x faster per file
  than parsing one at a time.

    FAST:  docparse *.docx              (compile once, parse many)
    FAST:  docparse ~/Documents/        (same — folder expansion)
    SLOW:  for f in *.docx; do docparse "$f"; done  (recompiles each time)

Conversion & generation:
  docparse in.docx --convert out.html       Convert between formats
  docparse notes.md --convert slides.pptx   Markdown to slides
  docparse in.docx --convert out.qmd        To Quarto Markdown, then:
                                              quarto render out.qmd --to pdf
  docparse --generate report.docx --prompt "Q1 sales report with a revenue table"

  Convert targets: html docx pptx xlsx odt odp ods md qmd

Options:
  --convert PATH    Convert the input to PATH (format from its extension)
  --generate PATH   AI-generate a document at PATH (requires --prompt)
  --prompt TEXT     Prompt for --generate
  --describe        Enable AI image descriptions
  --summarize       Enable AI document summary
  --pdf-backend B   PDF backend: pdftotext (default, deterministic plain text),
                    docling (local ML layout), liteparse (font-size headings),
                    ai (multimodal AI — required for scanned/image-only PDFs)
  --ai MODEL        AI model (default: gemini-2.5-flash; gemini-3-flash-preview
                    is supported but ~5x slower for PDF parsing due to thinking
                    tokens — pass it explicitly only when reasoning helps)
  --verify          Enable runtime contract verification
  --budget-report   Show capability budget usage after run
  --output-dir DIR  Copy output files to DIR after parsing
  --no-attachment-data  EML/MBOX: omit attachment-data/attachment-ext base64
                    blocks from output (attachment-meta is kept)
  --check           Type-check all modules (no file needed)
  --test            Run all inline tests (no file needed)
  --prove           Static Z3 contract verification (no file needed, requires z3)
  --eval            Run AILANG eval on all golden files (no file needed)
  -h, --help        Show this help

Supported formats:
  Office:  .docx .pptx .xlsx                       (deterministic XML)
  ODF:     .odt .odp .ods                          (deterministic XML)
  Web:     .html .htm .xhtml                       (deterministic XML)
  Text:    .md .csv .txt .tex .tar.gz              (deterministic)
  Books:   .epub                                   (deterministic ZIP+XHTML)
  Email:   .eml .mbox                              (deterministic)
  AI:      .pdf .png .jpg .gif .bmp .webp .tiff
           .mp3 .wav .ogg .flac .mp4 .mov .avi .mkv  (multimodal AI)

Output:
  <out>/<filename>.json   Structured JSON with typed blocks
  <out>/<filename>.md     LLM-ready markdown
  Default <out> is docparse/data; --output-dir DIR overrides it. In batch
  mode each file's outputs are written as soon as that file finishes — you
  can inspect completed files mid-batch and nothing is lost on Ctrl+C.
EOF
}

# --- Dev commands ---

do_check() {
  echo "Type-checking all AILANG Parse modules..."
  local fail=0
  for mod in "${MODULES[@]}"; do
    local name
    name="$(basename "$mod")"
    if ailang check "$mod" 2>&1; then
      echo "  $name  OK"
    else
      echo "  $name  FAIL"
      fail=1
    fi
  done
  if [ "$fail" -eq 0 ]; then
    echo "All ${#MODULES[@]} modules type-check clean."
  else
    echo "Some modules failed type-checking."
    exit 1
  fi
}

do_test() {
  echo "Running inline tests..."
  for mod in "${TEST_MODULES[@]}"; do
    echo ""
    echo "--- $(basename "$mod") ---"
    ailang test "$mod"
  done
}

do_eval() {
  echo "Running AILANG eval on all golden files..."
  local golden_dir="benchmarks/office/golden"
  local test_dir="data/test_files"
  local pass=0
  local fail=0
  local total=0
  local skipped=0
  local eval_tmpdir
  eval_tmpdir="$(mktemp -d)"
  trap "rm -rf '$eval_tmpdir'" EXIT

  # Collect files to parse
  local batch_files=()
  local batch_names=()
  for golden in "$golden_dir"/*.json; do
    [ -f "$golden" ] || continue
    local fname
    fname="$(basename "$golden" .json)"
    [ -f "$test_dir/$fname" ] || continue
    total=$((total + 1))
    batch_files+=("$test_dir/$fname")
    batch_names+=("$fname")
  done

  # Phase 1: Parse all files in batch (compile once, run N times)
  echo "  Phase 1: Parsing $total files (batch mode)..."
  DOCPARSE_OUTPUT_DIR="$eval_tmpdir" ailang run --batch --entry main --caps IO,FS,Env --max-recursion-depth 50000 docparse/main.ail "${batch_files[@]}" > /dev/null 2>&1 || true
  local parsed=0
  for fname in "${batch_names[@]}"; do
    [ -f "$eval_tmpdir/${fname}.json" ] && parsed=$((parsed + 1))
  done
  echo "  Phase 1: $parsed/$total parsed"

  # Phase 2: Eval all files individually
  # (batch mode only supports 1 arg per invocation, eval needs 2: golden + actual)
  echo "  Phase 2: Evaluating..."
  for golden in "$golden_dir"/*.json; do
    [ -f "$golden" ] || continue
    local fname
    fname="$(basename "$golden" .json)"
    local output_json="$eval_tmpdir/${fname}.json"
    # Phase 1 only parses goldens whose source file exists locally. Apply the
    # SAME filter here — 93 goldens are committed but only ~58 sources are in
    # the tree (the rest come from benchmarks/download_test_files.sh). Counting
    # those as failures made the summary arithmetically impossible
    # ("56/58 passed (37 failures)") and buried the 2 real failures in 35 that
    # were never going to run.
    if [ ! -f "$test_dir/$fname" ]; then
      skipped=$((skipped + 1))
      continue
    fi
    if [ ! -f "$output_json" ]; then
      echo "    $fname: FAIL (source present but produced no output JSON)"
      fail=$((fail + 1))
      continue
    fi
    local eval_out
    local eval_rc
    # `|| true` is load-bearing. This script runs under `set -euo pipefail`, so
    # without it a non-zero `ailang run` makes the ASSIGNMENT non-zero, `set -e`
    # fires, and the whole script dies mid-loop — no summary, no FAIL line, and
    # an exit code that looks like an ordinary failure. The else-branch below
    # was written to report exactly this case and could never run.
    #
    # Observed: --eval reported 6 of 58 files and exited 1, which read as
    # "everything before this passed" rather than "the harness gave up".
    # Capture the status in the `if` condition rather than with `|| true` —
    # `|| true` would reset $? to 0 and the reported rc would always be a lie.
    #
    # NOTE: deliberately NOT raising --max-recursion-depth here. Phase 1 uses
    # 50000 for parsing, and mirroring that in the scoring loop was tried and
    # reverted: running 50k-frame interpreter stacks across every file is
    # memory-hungry enough to hurt the host. A recursion failure here is a
    # genuine result worth recording, not something to paper over with a
    # bigger stack.
    #
    # This note used to add that raising the depth "did not make the two
    # Gutenberg EPUBs pass". That framing was wrong: they were not failing on
    # recursion at all, they were being scored against goldens that predated
    # the v0.15.0 LinkBlock feature, so a block the parser now correctly types
    # as "link" was still "text" in the golden. Regenerating those two goldens
    # took --eval from 56/58 to 59/59. Recursion depth was never the cause.
    if eval_out=$(ailang run --entry evalMain --caps IO,FS,Env \
         docparse/services/eval.ail "$golden" "$output_json" 2>&1)
    then eval_rc=0
    else eval_rc=$?
    fi
    if echo "$eval_out" | grep -q "Score: 100"; then
      echo "    $fname: 100%"
      pass=$((pass + 1))
    else
      echo "    $fname: FAIL (rc=$eval_rc)"
      echo "$eval_out" | head -5 | sed 's/^/      /'
      fail=$((fail + 1))
    fi
  done

  rm -rf "$eval_tmpdir"
  echo ""
  echo "AILANG eval: $pass/$total passed ($fail failures)"
  if [ "$skipped" -gt 0 ]; then
    echo "  ($skipped golden files skipped — source not in data/test_files;"
    echo "   run benchmarks/download_test_files.sh to include them)"
  fi
  # Fail the command when any file fails, so CI and callers can gate on it.
  # Previously this always returned 0 (or died early), so a regression could
  # not be detected by exit status.
  [ "$fail" -eq 0 ]
}

do_prove() {
  echo "Static contract verification (Z3)..."
  echo ""
  local total_verified=0
  local total_skipped=0
  local total_violations=0
  local total_errors=0
  for mod in "${MODULES[@]}"; do
    local output
    output=$(ailang verify "$mod" 2>&1) || true
    # Only print modules that have contracts, so the summary is readable.
    if echo "$output" | grep -qE "VERIFIED|SKIPPED|VIOLATION|! ERROR"; then
      echo "$output"
      echo ""
    fi
    total_verified=$((total_verified + $(echo "$output" | grep -c "✓ VERIFIED" || true)))
    total_skipped=$((total_skipped + $(echo "$output" | grep -c "⚠ SKIPPED" || true)))
    total_violations=$((total_violations + $(echo "$output" | grep -c "✗ VIOLATION" || true)))
    total_errors=$((total_errors + $(echo "$output" | grep -c "! ERROR" || true)))
  done

  echo "─────────────────────────────────────────────"
  echo "verified:   $total_verified"
  echo "skipped:    $total_skipped   (outside Z3's decidable fragment)"
  echo "errors:     $total_errors   (encoder bugs upstream: sunholo-data/ailang#755-757)"
  echo "violations: $total_violations"

  # Gate on VIOLATIONs only. A violation means a contract we wrote is false —
  # a real regression. Skips are the decidable fragment being narrow, and the
  # errors are AILANG encoder bugs we have filed and cannot fix from here;
  # gating on either would make this permanently red and therefore ignored.
  #
  # This used to always return 0 — the counters above were declared, never
  # incremented and never checked — so --prove could not fail no matter what.
  if [ "$total_violations" -gt 0 ]; then
    echo ""
    echo "FAIL: $total_violations contract violation(s)."
    return 1
  fi
  return 0
}

# --- Parse arguments ---

FILES=()
DESCRIBE=false
SUMMARIZE=false
AI_MODEL="$DEFAULT_AI_MODEL"
VERIFY=false
BUDGET=false
OUTPUT_DIR=""
PDF_BACKEND="${DOCPARSE_PDF_BACKEND:-pdftotext}"
EXTRA_FLAGS=()
DEEP_REQUESTED=false
THREADED_REQUESTED=false
NO_ATTACHMENT_DATA_REQUESTED=false
CONVERT_TARGET=""
GENERATE_TARGET=""
PROMPT_TEXT=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --check)
      cd "$PROJECT_DIR"
      do_check
      exit 0
      ;;
    --test)
      cd "$PROJECT_DIR"
      do_test
      exit 0
      ;;
    --prove)
      cd "$PROJECT_DIR"
      do_prove
      exit 0
      ;;
    --eval)
      cd "$PROJECT_DIR"
      do_eval
      exit 0
      ;;
    --describe)
      DESCRIBE=true
      shift
      ;;
    --summarize)
      SUMMARIZE=true
      shift
      ;;
    --ai)
      AI_MODEL="$2"
      shift 2
      ;;
    --verify)
      VERIFY=true
      shift
      ;;
    --budget-report)
      BUDGET=true
      shift
      ;;
    --output-dir)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    # Module flags that take a value. Without explicit cases these hit the `-*`
    # catch-all below and go to EXTRA_FLAGS (passed to `ailang`, ahead of the
    # .ail file), while their VALUE falls to the `*)` case and is treated as an
    # input document — so `--convert out.html` died with "File or folder not
    # found: out.html" and still exited 0. Every example in
    # docs/examples/cli/convert.sh was broken this way.
    --convert)
      if [ $# -lt 2 ]; then
        echo "Error: --convert requires an output path (e.g. --convert out.docx)" >&2
        exit 2
      fi
      CONVERT_TARGET="$2"
      shift 2
      ;;
    --generate)
      if [ $# -lt 2 ]; then
        echo "Error: --generate requires an output path (e.g. --generate report.docx)" >&2
        exit 2
      fi
      GENERATE_TARGET="$2"
      shift 2
      ;;
    --prompt)
      if [ $# -lt 2 ]; then
        echo "Error: --prompt requires text (e.g. --prompt \"Q1 sales report\")" >&2
        exit 2
      fi
      PROMPT_TEXT="$2"
      shift 2
      ;;
    --pdf-backend)
      PDF_BACKEND="$2"
      case "$PDF_BACKEND" in
        pdftotext|ai|docling|liteparse) ;;
        *)
          echo "Error: --pdf-backend must be one of: pdftotext, ai, docling, liteparse (got: $PDF_BACKEND)" >&2
          exit 2
          ;;
      esac
      shift 2
      ;;
    # Module flags, not ailang flags. Without these cases they fall through to
    # EXTRA_FLAGS below, which is passed to `ailang` ahead of the .ail file —
    # so ailang rejects them and the program never sees them. --deep in
    # particular silently did nothing through this wrapper.
    --deep)
      DEEP_REQUESTED=true
      shift
      ;;
    --threaded)
      THREADED_REQUESTED=true
      shift
      ;;
    --no-attachment-data)
      NO_ATTACHMENT_DATA_REQUESTED=true
      shift
      ;;
    -*)
      EXTRA_FLAGS+=("$1")
      shift
      ;;
    *)
      FILES+=("$1")
      shift
      ;;
  esac
done

# --- AI generation mode: no input document, needs AI + a prompt ---
if [ -n "$GENERATE_TARGET" ]; then
  if [ -z "$PROMPT_TEXT" ]; then
    echo "Error: --generate requires --prompt (e.g. --generate report.docx --prompt \"Q1 sales report\")" >&2
    exit 2
  fi
  if [[ ! "$GENERATE_TARGET" = /* ]]; then
    GENERATE_TARGET="$(pwd)/$GENERATE_TARGET"
  fi
  cd "$PROJECT_DIR"
  exec env GOOGLE_API_KEY="${GOOGLE_API_KEY:-}" ailang run --entry main \
    --caps IO,FS,Env,AI --max-recursion-depth 50000 --ai "$AI_MODEL" \
    "$MAIN_AIL" --generate "$GENERATE_TARGET" --prompt "$PROMPT_TEXT"
fi

if [ -n "$PROMPT_TEXT" ]; then
  echo "Error: --prompt is only meaningful with --generate" >&2
  exit 2
fi

if [ ${#FILES[@]} -eq 0 ]; then
  usage
  exit 1
fi

# Resolve file paths to absolute (files and directories)
RESOLVED_FILES=()
for f in "${FILES[@]}"; do
  if [[ ! "$f" = /* ]]; then
    f="$(pwd)/$f"
  fi
  if [ ! -f "$f" ] && [ ! -d "$f" ]; then
    echo "Error: File or folder not found: $f"
    exit 1
  fi
  RESOLVED_FILES+=("$f")
done

# --- Expand folders into file lists ---
# Supported extensions for folder scanning
SUPPORTED_EXTS_PATTERN='.*\.\(docx\|pptx\|xlsx\|odt\|odp\|ods\|html\|htm\|md\|csv\|epub\|eml\|mbox\|pdf\|png\|jpg\|jpeg\|gif\|bmp\|webp\|tiff\|tif\|mp3\|wav\|ogg\|flac\|mp4\|mov\|avi\|mkv\)$'

expand_folder() {
  local dir="$1"
  find "$dir" -maxdepth 1 -type f | grep -i "${SUPPORTED_EXTS_PATTERN}" | sort
}

# Expand any directories in RESOLVED_FILES
EXPANDED_FILES=()
for f in "${RESOLVED_FILES[@]}"; do
  if [ -d "$f" ]; then
    while IFS= read -r entry; do
      [ -n "$entry" ] && EXPANDED_FILES+=("$entry")
    done < <(expand_folder "$f")
  else
    EXPANDED_FILES+=("$f")
  fi
done

if [ ${#EXPANDED_FILES[@]} -eq 0 ]; then
  echo "Error: No supported files found."
  exit 1
fi

RESOLVED_FILES=("${EXPANDED_FILES[@]}")

# --- Detect if AI is needed (check all files) ---
# PDFs default to pdftotext (Process cap, no AI). Only --pdf-backend ai needs AI.

NEEDS_AI=false
NEEDS_PROCESS=false
for f in "${RESOLVED_FILES[@]}"; do
  EXT="${f##*.}"
  EXT_LOWER="$(echo "$EXT" | tr '[:upper:]' '[:lower:]')"
  case "$EXT_LOWER" in
    pdf)
      if [ "$PDF_BACKEND" = "ai" ]; then
        NEEDS_AI=true
        NEEDS_PROCESS=true  # AI backend still calls pdftotext first; needs Process cap
      else
        NEEDS_PROCESS=true
      fi
      ;;
    eml|mbox)
      # --deep resolves PDF attachments, which shells out to the PDF backend.
      # Without Process the resolver dies mid-parse with "effect 'Process'
      # requires capability" after already reporting "Resolving attachments...".
      if [ "${DEEP_REQUESTED:-false}" = "true" ]; then
        NEEDS_PROCESS=true
      fi
      ;;
    png|jpg|jpeg|gif|bmp|webp|tiff|tif|mp3|wav|ogg|flac|mp4|mov|avi|mkv)
      NEEDS_AI=true
      ;;
  esac
done

USE_AI=false
if $NEEDS_AI || $DESCRIBE || $SUMMARIZE; then
  USE_AI=true
fi

# --- Build ailang command ---

CAPS="IO,FS,Env"
if $USE_AI; then
  CAPS="${CAPS},AI"
fi
if $NEEDS_PROCESS; then
  CAPS="${CAPS},Process"
fi

USE_BATCH=false
if [ ${#RESOLVED_FILES[@]} -gt 1 ]; then
  USE_BATCH=true
fi

CMD=(ailang run)
if $USE_BATCH; then
  CMD+=(--batch)
fi
CMD+=(--entry main --caps "$CAPS" --max-recursion-depth 50000)

if $USE_AI; then
  CMD+=(--ai "$AI_MODEL")
fi

if $VERIFY; then
  CMD+=(--verify-contracts)
fi

if $BUDGET; then
  CMD+=(--budget-report)
fi

CMD+=("${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}")
CMD+=("$MAIN_AIL")

# Pass flags to AILANG main
AILANG_ARGS=()
if $DESCRIBE; then
  AILANG_ARGS+=(describe)
fi
if $SUMMARIZE; then
  AILANG_ARGS+=(summarize)
fi
if [ -n "$CONVERT_TARGET" ]; then
  # One output path cannot receive N inputs — in batch mode AILANG_ARGS is
  # repeated per file, so every file would write over the same target and only
  # the last would survive.
  if $USE_BATCH; then
    echo "Error: --convert takes a single input file (got ${#RESOLVED_FILES[@]})." >&2
    echo "       Convert one at a time, or use --output-dir for batch parsing." >&2
    exit 2
  fi
  # Must be absolute: we cd to PROJECT_DIR before running, so a relative target
  # would land next to the sources instead of in the user's cwd.
  if [[ ! "$CONVERT_TARGET" = /* ]]; then
    CONVERT_TARGET="$(pwd)/$CONVERT_TARGET"
  fi
  mkdir -p "$(dirname "$CONVERT_TARGET")"
  AILANG_ARGS+=(--convert "$CONVERT_TARGET")
fi

# --- Resolve output dir to absolute path before cd ---

if [ -n "$OUTPUT_DIR" ]; then
  if [[ ! "$OUTPUT_DIR" = /* ]]; then
    OUTPUT_DIR="$(pwd)/$OUTPUT_DIR"
  fi
fi

# --- Run ---

cd "$PROJECT_DIR"

# When --output-dir is set, AILANG writes outputs there directly (per file,
# eagerly as each file finishes) via the DOCPARSE_OUTPUT_DIR env var.
# This means: completed files are visible mid-batch, nothing is lost on
# Ctrl+C, and there's no bulk post-copy step.
ENV_PREFIX=()
if [ -n "$OUTPUT_DIR" ]; then
  mkdir -p "$OUTPUT_DIR"
  ENV_PREFIX+=(DOCPARSE_OUTPUT_DIR="$OUTPUT_DIR")
fi
if $USE_AI; then
  ENV_PREFIX+=(GOOGLE_API_KEY="")
fi
ENV_PREFIX+=(DOCPARSE_PDF_BACKEND="$PDF_BACKEND")
if [ "$PDF_BACKEND" != "ai" ]; then
  ENV_PREFIX+=(DOCPARSE_PROJECT_ROOT="$PROJECT_DIR")
fi

# Batch mode consumes every trailing argv entry as an input path, so module
# flags must travel as environment — see docparse/main.ail's DOCPARSE_DEEP note.
if [ "$DEEP_REQUESTED" = "true" ]; then
  ENV_PREFIX+=(DOCPARSE_DEEP=1)
fi
if [ "$THREADED_REQUESTED" = "true" ]; then
  ENV_PREFIX+=(DOCPARSE_THREADED=1)
fi
if [ "$NO_ATTACHMENT_DATA_REQUESTED" = "true" ]; then
  ENV_PREFIX+=(DOCPARSE_NO_ATTACHMENT_DATA=1)
fi

run_cmd() {
  if [ ${#ENV_PREFIX[@]} -gt 0 ]; then
    env "${ENV_PREFIX[@]}" "$@"
  else
    "$@"
  fi
}

if $USE_BATCH; then
  TOTAL=${#RESOLVED_FILES[@]}
  echo "Batch mode: parsing ${TOTAL} files (compile once)..."
  if [ -n "$OUTPUT_DIR" ]; then
    echo "Outputs streaming to $OUTPUT_DIR/ as each file completes."
  fi
  echo ""
  START=$(date +%s)

  # Chunk large file lists to avoid OS ARG_MAX (~2MB on macOS).
  # 500 files per chunk keeps args well under the limit for any path length.
  BATCH_CHUNK_SIZE=500
  for (( i=0; i<TOTAL; i+=BATCH_CHUNK_SIZE )); do
    CHUNK=("${RESOLVED_FILES[@]:$i:$BATCH_CHUNK_SIZE}")
    FULL_CMD=("${CMD[@]}")
    for f in "${CHUNK[@]}"; do
      FULL_CMD+=("$f" "${AILANG_ARGS[@]+"${AILANG_ARGS[@]}"}")
    done
    run_cmd "${FULL_CMD[@]}"
  done

  END=$(date +%s)
  ELAPSED=$((END - START))
  echo ""
  echo "Batch complete: ${TOTAL} files in ${ELAPSED}s"
else
  # Single file
  FILE="${RESOLVED_FILES[0]}"
  CMD+=("$FILE" "${AILANG_ARGS[@]+"${AILANG_ARGS[@]}"}")
  run_cmd "${CMD[@]}"
fi
