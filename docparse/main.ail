-- AILANG Parse: Universal Document Parsing in AILANG
--
-- Demonstrates:
--   - ZIP + XML parsing for Office formats (std/zip, std/xml)
--   - AI-augmented layout understanding with bounded costs
--   - Contracts on output quality
--   - Pure/effectful function separation
--   - Pattern matching on XML trees
--
-- Run (without AI):
--   ailang run --entry main --caps IO,FS,Env docparse/main.ail myfile.docx
--
-- Run (with AI image descriptions):
--   GOOGLE_API_KEY="" ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail myfile.docx describe
--
-- Run (with contracts enforced):
--   ailang run --entry main --caps IO,FS,Env --verify-contracts docparse/main.ail myfile.docx
--
-- Test:
--   ailang test docparse/services/format_router.ail
--   ailang test docparse/services/docx_parser.ail
--
-- CAPABILITY BUDGETS:
--   IO @limit=1000  - Console output for results (increased for page-by-page PDF parsing)
--   FS @limit=100   - File reads (ZIP entries) + output write (increased from 20 for complex DOCX with headers/footers)
--   AI @limit=200  - PDF page-by-page parsing + image descriptions + layout inference (2 per page × up to ~100 pages)

export func main() -> () ! {IO @limit=50000, FS @limit=5000, AI @limit=200, Env, Clock, Net, Process} {
  println("=== AILANG Parse: Universal Document Parsing ===");
  println("");

  -- Get filepath and flags from CLI args
  let args = getArgs();
  let filepath = match args {
    [] => "docparse/data/sample.docx",
    f :: _ => f
  };
  let useAI = hasFlag(args, "describe");
  let doSummarize = hasFlag(args, "summarize");
  let convertTarget = getConvertTarget(args);
  let generateTarget = getGenerateTarget(args);
  let promptText = getPromptText(args);

  -- AI Document Generation mode: --generate output.docx --prompt "..."
  if length(generateTarget) > 0 && length(promptText) > 0 then {
    generateDocument(generateTarget, promptText)
  }
  else if length(generateTarget) > 0 then {
    println("Error: --generate requires --prompt \"description\"");
    println("");
    println("Usage: ./bin/docparse --generate report.docx --prompt \"Q1 sales report with tables\"");
    println("       ./bin/docparse --generate slides.pptx --prompt \"5-slide pitch deck\"")
  }
  -- Check file exists (normal parse mode)
  else if not fileExists(filepath) then {
    println("Error: File not found: ${filepath}");
    println("");
    println("Usage: ailang run --entry main --caps IO,FS,Env docparse/main.ail <file>");
    println("       ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail <file> describe");
    println("       ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail <file> summarize");
    println("       ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail --generate output.docx --prompt \"...\"")
  }
  else {
    -- Step 1: Detect format
    -- Special case: archive extensions (.tar.gz, .tgz, .tex.gz) route to
    -- the LaTeX pipeline — arXiv source bundles. getExtension only returns
    -- the last dotted suffix (".gz"), so we check the full filename first.
    let rawExt = getExtension(filepath);
    let ext = if isTarGz(filepath) then "tar.gz" else rawExt;
    let format = if isTarGz(filepath) then "latex" else detectFormat(rawExt);
    let strategy = strategyDescription(format);
    println("File:     ${filepath}");
    println("Format:   ${format} (${ext})");
    println("Strategy: ${strategy}");
    let aiRequired = needsAI(format);
    if aiRequired then println("AI:       required (format needs AI extraction)")
    else if doSummarize then println("AI:       enabled (summarize)")
    else if useAI then println("AI:       enabled (image descriptions)")
    else println("AI:       disabled (pass 'describe' or 'summarize' arg to enable)");
    println("");

    -- Step 2: Parse based on format
    match format {
      "zip-office" => parseOfficeDocument(filepath, ext, useAI || doSummarize, doSummarize, convertTarget),
      "pdf" => parsePdfDocument(filepath, doSummarize, convertTarget),
      "image" => parseImageDocument(filepath, ext, doSummarize, convertTarget),
      "audio" => parseAudioDocument(filepath, ext, doSummarize, convertTarget),
      "video" => parseVideoDocument(filepath, ext, doSummarize, convertTarget),
      "csv" => parseCsvDocument(filepath, ext, convertTarget),
      "markdown" => parseMarkdownDocument(filepath, convertTarget),
      "html" => parseHtmlDocument(filepath, useAI || doSummarize, doSummarize, convertTarget),
      "epub" => parseEpubDocument(filepath, useAI || doSummarize, doSummarize, convertTarget),
      "zip-odf" => parseOdfDocument(filepath, ext, useAI || doSummarize, doSummarize, convertTarget),
      -- --deep also reads from DOCPARSE_DEEP because AILANG batch mode treats
      -- every remaining argv entry as an input path: passing "file --deep"
      -- per file made --deep itself a (failing) input, which is why batch runs
      -- reported "4/4 succeeded" for 2 files. Env survives batch intact.
      "email" => parseEmailDocument(filepath, ext,
                   hasFlag(args, "--threaded") || getEnvOr("DOCPARSE_THREADED", "") == "1",
                   hasFlag(args, "--deep") || getEnvOr("DOCPARSE_DEEP", "") == "1"),
      "latex" => parseLatexDocument(filepath, useAI || doSummarize, convertTarget),
      "rtf" => parseRtfDocument(filepath, convertTarget),
      "text" => parseTextDocument(filepath),
      _ => println("Format '${format}' not yet supported in this demo.")
    }
  }
}

-- Check if a flag is present in args list
pure func hasFlag(args: [string], flag: string) -> bool =
  any(\a. a == flag, args)

-- Surface describe warnings to the terminal so an image that could not be
-- described reads as "skipped, here's why" rather than a silent empty.
func printWarnings(warnings: [string]) -> () ! {IO} =
  match warnings {
    [] => (),
    w :: rest => { println("⚠ ${w}"); printWarnings(rest) }
  }

-- Extract --convert target path from args: ["file.docx", "--convert", "out.html"] -> "out.html"
pure func getConvertTarget(args: [string]) -> string =
  match args {
    [] => "",
    "--convert" :: rest => match rest {
      [] => "",
      target :: _ => target
    },
    _ :: rest => getConvertTarget(rest)
  }

-- Extract --generate target path from args: ["--generate", "out.docx", "--prompt", "..."] -> "out.docx"
pure func getGenerateTarget(args: [string]) -> string =
  match args {
    [] => "",
    "--generate" :: rest => match rest {
      [] => "",
      target :: _ => target
    },
    _ :: rest => getGenerateTarget(rest)
  }

-- Extract --prompt text from args: ["--prompt", "Q1 report"] -> "Q1 report"
pure func getPromptText(args: [string]) -> string =
  match args {
    [] => "",
    "--prompt" :: rest => match rest {
      [] => "",
      text :: _ => text
    },
    _ :: rest => getPromptText(rest)
  }

-- AI Document Generation: prompt -> AI -> [Block] -> format generator -> file
func generateDocument(outputPath: string, prompt: string) -> () ! {IO, FS, AI, Env} {
  let ext = getExtension(outputPath);
  println("--- AI Document Generation ---");
  println("Output:   ${outputPath}");
  println("Format:   ${ext}");
  println("Prompt:   ${prompt}");
  println("");

  -- Step 1: Generate blocks from prompt via AI
  println("Generating content via AI...");
  let blocks = aiGenerateBlocks(prompt, ext);
  println("Generated ${show(countBlocks(blocks))} content blocks.");
  println("");

  -- Step 2: Build a ParsedDocument wrapper
  let doc = {
    format: ext,
    filename: outputPath,
    metadata: {title: prompt, author: "AILANG Parse AI", created: "", modified: "", pageCount: 0},
    blocks: blocks
  };

  -- Step 3: Show what was generated
  printSummary(doc);
  println("");
  println("--- Generated Content ---");
  printBlocks(blocks);
  println("");

  -- Step 4: Generate the output file
  if ext == "html" || ext == "htm" then {
    let html = generateHtml(doc);
    writeFile(outputPath, html);
    println("Generated HTML: ${outputPath}")
  }
  else if ext == "docx" then {
    let msg = generateDocx(doc, outputPath);
    println(msg)
  }
  else if ext == "pptx" then {
    let msg = generatePptx(doc, outputPath);
    println(msg)
  }
  else if ext == "xlsx" then {
    let msg = generateXlsx(doc, outputPath);
    println(msg)
  }
  else if ext == "odt" then {
    let msg = generateOdt(doc, outputPath);
    println(msg)
  }
  else if ext == "odp" then {
    let msg = generateOdp(doc, outputPath);
    println(msg)
  }
  else if ext == "ods" then {
    let msg = generateOds(doc, outputPath);
    println(msg)
  }
  else if ext == "md" then {
    let md = renderMarkdown(doc);
    writeFile(outputPath, md);
    println("Generated Markdown: ${outputPath}")
  }
  else if ext == "qmd" then {
    let qmd = generateQmd(doc);
    writeFile(outputPath, qmd);
    println("Generated Quarto Markdown: ${outputPath}")
  }
  else println("Unsupported format: ${ext} (supported: html, docx, pptx, xlsx, odt, odp, ods, md, qmd)");

  println("");
  println("=== AILANG Parse Generation Complete ===")
}

-- Parse an Office document (docx/pptx/xlsx)
func parseOfficeDocument(filepath: string, ext: string, useAI: bool, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  let office = officeType(ext);
  match office {
    "word" => parseWordDocument(filepath, useAI, doSummarize, convertTarget),
    "powerpoint" => parsePowerPointDocument(filepath, useAI, doSummarize, convertTarget),
    "excel" => parseExcelDocument(filepath, doSummarize, convertTarget),
    _ => println("Office type '${office}' not yet supported.")
  }
}

-- Parse a Word (DOCX) document
func parseWordDocument(filepath: string, useAI: bool, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing DOCX ---");
  println("");

  -- Step 2a: Extract metadata
  println("Extracting metadata...");
  let metadata = parseDocxMetadata(filepath);

  -- Step 2b: Parse document content, with comments anchored to the text they
  -- annotate and spliced in at their anchor point (one pass over document.xml).
  println("Parsing document XML...");
  let blocks = parseDocxWithComments(filepath);
  println("Extracted ${show(countBlocks(blocks))} content blocks.");
  println("");

  -- Step 2c: Extract headers and footers
  println("Extracting headers/footers...");
  let headerBlocks = parseDocxHeaders(filepath);
  let footerBlocks = parseDocxFooters(filepath);
  println("Found ${show(countBlocks(headerBlocks))} headers, ${show(countBlocks(footerBlocks))} footers.");

  -- Step 2d: Extract footnotes and endnotes
  println("Extracting footnotes/endnotes...");
  let footnoteBlocks = parseDocxFootnotes(filepath);
  let endnoteBlocks = parseDocxEndnotes(filepath);
  println("Found ${show(countBlocks(footnoteBlocks))} footnotes, ${show(countBlocks(endnoteBlocks))} endnotes.");

  -- Comments were anchored and spliced in step 2b, so there is no separate
  -- end-of-document comment list to append here.

  -- Step 2f: Extract embedded images
  println("Extracting images...");
  let imageBlocks = parseDocxImages(filepath);
  println("Found ${show(countBlocks(imageBlocks))} embedded images.");
  println("");

  -- Combine all blocks: headers + body (comments already spliced at their
  -- anchors) + footers + footnotes + endnotes + images
  let combinedBlocks = concat(headerBlocks,
    concat(blocks,
      concat(footerBlocks,
        concat(footnoteBlocks,
          concat(endnoteBlocks, imageBlocks)))));

  -- Step 2f: AI image descriptions (optional)
  let imageCount = countBlocks(filterImages(combinedBlocks));
  let describeRes = if useAI && imageCount > 0 then {
    println("Describing ${show(imageCount)} images with AI...");
    describeImages(dirOf(filepath), combinedBlocks)
  } else {
    if imageCount > 0
    then println("Images: ${show(imageCount)} (pass 'describe' arg for AI descriptions)")
    else println("No images found.");
    { blocks: combinedBlocks, warnings: [], aiCalls: 0 }
  };
  let describedBlocks = describeRes.blocks;
  printWarnings(describeRes.warnings);

  -- Step 2g: AI self-healing (fix tables with empty/ambiguous cells)
  let allBlocks = if useAI then {
    println("Enhancing blocks with AI (fixing tables, layout)...");
    enhanceBlocks(describedBlocks)
  } else describedBlocks;

  -- Step 3: Build result
  let doc = {
    format: "docx",
    filename: filepath,
    metadata: metadata,
    blocks: allBlocks
  };

  let result = {
    document: doc,
    warnings: describeRes.warnings,
    aiCallsUsed: describeRes.aiCalls
  };

  -- Step 4: Output
  println("");
  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(allBlocks);
  println("");

  -- Step 5: Write outputs
  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- Parse a PowerPoint (PPTX) document
func parsePowerPointDocument(filepath: string, useAI: bool, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing PPTX ---");
  println("");

  -- Step 2a: Extract metadata
  println("Extracting metadata...");
  let metadata = parsePptxMetadata(filepath);

  -- Step 2b: Parse all slides
  println("Parsing slides...");
  let blocks = parsePptx(filepath);
  println("Extracted ${show(countBlocks(blocks))} slide blocks.");
  println("");

  -- Step 2c: Extract embedded images (only when AI will describe them)
  let combinedBlocks = if useAI then {
    println("Extracting images for AI description...");
    let imageBlocks = parsePptxImages(filepath);
    println("Found ${show(countBlocks(imageBlocks))} embedded images.");
    println("");
    concat(blocks, imageBlocks)
  } else {
    let inlineImages = countBlocks(filterImages(blocks));
    println("Images: ${show(inlineImages)} (pass 'describe' arg to extract)");
    println("");
    blocks
  };

  -- Step 2d: AI image descriptions (optional)
  let imageCount = countBlocks(filterImages(combinedBlocks));
  let describeRes = if useAI && imageCount > 0 then {
    println("Describing ${show(imageCount)} images with AI...");
    describeImages(dirOf(filepath), combinedBlocks)
  } else {
    if imageCount > 0
    then println("Images: ${show(imageCount)} (pass 'describe' arg for AI descriptions)")
    else println("No images found.");
    { blocks: combinedBlocks, warnings: [], aiCalls: 0 }
  };
  let describedBlocks = describeRes.blocks;
  printWarnings(describeRes.warnings);

  -- Step 2e: AI self-healing (fix tables with empty/ambiguous cells)
  let allBlocks = if useAI then {
    println("Enhancing blocks with AI (fixing tables, layout)...");
    enhanceBlocks(describedBlocks)
  } else describedBlocks;

  -- Step 3: Build result
  let doc = {
    format: "pptx",
    filename: filepath,
    metadata: metadata,
    blocks: allBlocks
  };

  let result = {
    document: doc,
    warnings: describeRes.warnings,
    aiCallsUsed: describeRes.aiCalls
  };

  -- Step 4: Output
  println("");
  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(allBlocks);
  println("");

  -- Step 5: Write outputs
  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- Parse an Excel (XLSX) document
func parseExcelDocument(filepath: string, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing XLSX ---");
  println("");

  -- Step 2a: Extract metadata
  println("Extracting metadata...");
  let metadata = parseXlsxMetadata(filepath);

  -- Step 2b: Parse all worksheets
  println("Parsing worksheets...");
  let blocks = parseXlsx(filepath);
  println("Extracted ${show(countBlocks(blocks))} sheet blocks.");
  println("");

  -- Step 3: Build result
  let doc = {
    format: "xlsx",
    filename: filepath,
    metadata: metadata,
    blocks: blocks
  };

  let result = {
    document: doc,
    warnings: [],
    aiCallsUsed: 0
  };

  -- Step 4: Output
  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(blocks);
  println("");

  -- Step 5: Write outputs
  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- AI-backed PDF parse path (default).
func extractPdfAI(filepath: string) -> {metadata: DocMetadata, blocks: [Block], aiCalls: int} ! {IO, FS, AI, Net, Env, Clock} {
  println("--- Parsing PDF (AI) ---");
  println("");
  println("Extracting metadata via AI...");
  let metadata = parsePdfMetadata(filepath);
  println("Extracting content via AI...");
  let blocks = parsePdf(filepath);
  println("Extracted ${show(countBlocks(blocks))} content blocks.");
  println("");
  let aiCalls = 1 + (if countBlocks(blocks) > 0 then 1 else 0);
  {metadata: metadata, blocks: blocks, aiCalls: aiCalls}
}

-- External-backend PDF parse path (docling, liteparse, …).
func extractPdfExternal(backend: string, filepath: string, projectRoot: string) -> {metadata: DocMetadata, blocks: [Block], aiCalls: int} ! {IO, FS, Process} {
  println("--- Parsing PDF (${backend}) ---");
  println("");
  println("Invoking external backend '${backend}'...");
  -- Loud failure on any backend error or empty extraction: print a clear
  -- message and exit non-zero, never write a silent empty "success".
  match parsePdfViaBackend(backend, filepath, projectRoot) {
    Err(msg) => {
      println("Error: PDF backend '${backend}' failed: ${msg}");
      println("  Scanned/image-only PDFs have no text layer — retry with --pdf-backend ai.");
      let _ = exit(1);
      {metadata: emptyMetadata(), blocks: [], aiCalls: 0}
    },
    Ok(ext) => {
      println("Extracted ${show(countBlocks(ext.blocks))} content blocks.");
      -- Layer in PDF annotations (highlights, sticky notes, free text).
      -- These live in the /Annots object layer, which no text-extraction
      -- backend reports — without this the default backend silently drops
      -- every review comment in the document.
      let scan = scanAnnotations(filepath);
      let anns = scan.annotations;
      -- Object streams are readable by neither this scanner nor pdftotext's
      -- annotation view; say so rather than implying the list is complete.
      let _ = if scan.mayBeIncomplete
        then println("Note: PDF uses compressed object streams — annotations inside them are not visible.")
        else ();
      let annBlocks = if countAnns(anns) == 0 then [] else {
        -- Word positions let a highlight report the text it covers rather than
        -- just a page number. Unavailable positions degrade to unanchored.
        let words = fetchPdfWords(filepath, projectRoot);
        println("Found ${show(countAnns(anns))} annotations.");
        annotationsAsBlocksAnchored(anns, words)
      };
      println("");
      {metadata: ext.metadata, blocks: concat(ext.blocks, annBlocks), aiCalls: 0}
    }
  }
}

pure func countAnns(anns: [Annotation]) -> int = listLength(anns)

-- Parse a PDF document. Backend selected via DOCPARSE_PDF_BACKEND env var:
--   "pdftotext" (default) — poppler pdftotext -layout, deterministic plain text
--   "docling"   — IBM Docling, deterministic local layout analysis
--   "liteparse" — run-llama LiteParse, font-size heading inference
--   "ai"        — multimodal AI (Gemini/Claude/etc) via direct_ai_parser; the
--                 only backend that handles scanned/image-only PDFs
-- ("words" also exists in the adapter but is not a document backend: it returns
-- word positions used to resolve what a highlight annotation covers.)
func parsePdfDocument(filepath: string, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env, Net, Process, Clock} {
  let backend = getEnvOr("DOCPARSE_PDF_BACKEND", "pdftotext");
  let projectRoot = getEnvOr("DOCPARSE_PROJECT_ROOT", "");

  -- Any backend except "ai" runs through the external adapter bridge.
  let parsed = if backend == "ai"
    then extractPdfAI(filepath)
    else extractPdfExternal(backend, filepath, projectRoot);

  let metadata = parsed.metadata;
  let blocks = parsed.blocks;
  let aiCalls = parsed.aiCalls;

  -- Step 3: Build result
  let doc = {
    format: "pdf",
    filename: filepath,
    metadata: metadata,
    blocks: blocks
  };

  let result = {
    document: doc,
    warnings: [],
    aiCallsUsed: aiCalls
  };

  -- Step 4: Output
  println("");
  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(blocks);
  println("");

  -- Step 5: Write outputs
  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- Parse an image file (AI-powered document extraction)
-- Extracts structured content (headings, text, tables) from document page images.
-- Falls back to image description if no document content is found.
func parseImageDocument(filepath: string, ext: string, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing Image (AI Document Extraction) ---");
  println("");

  let mime = imageMimeType(ext);
  println("Extracting document content from image via AI...");
  let blocks = parseDocumentImage(filepath, mime);
  let finalBlocks = match blocks {
    [] => {
      println("No document content found, falling back to image description...");
      parseImage(filepath, mime)
    },
    _ => blocks
  };
  println("Generated ${show(countBlocks(finalBlocks))} content blocks.");
  println("");

  -- Build result
  let doc = {
    format: ext,
    filename: filepath,
    metadata: emptyMetadata(),
    blocks: finalBlocks
  };

  let result = {
    document: doc,
    warnings: [],
    aiCallsUsed: 1
  };

  -- Output
  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(finalBlocks);
  println("");

  -- Write outputs
  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

