-- Resolve the main .tex path. If the input is a .tar.gz / .tgz / .tex.gz
-- bundle (arXiv source), extract it and pick the file containing
-- \documentclass. Otherwise return the path unchanged.
func resolveLatexSource(filepath: string) -> string ! {IO, FS} {
  if isTarGz(filepath) then {
    let _ = println("Archive detected (${filepath}) — extracting...");
    match extractArxivBundle(filepath) {
      Ok(r) => {
        let _ = println("Extracted to ${r.dir}. Main .tex: ${r.main}");
        r.main
      },
      Err(msg) => {
        let _ = println("Extract failed: ${msg}");
        filepath
      }
    }
  } else filepath
}

-- Parse a LaTeX/TeX document (pure AILANG, no dependencies)
-- Effectful wrapper around the pure core parseLatex / parseLatexMetadata.
-- Scientific-paper wedge: deterministic parsing of .tex source (as found in
-- ~89% of arXiv papers) where competitors are OCR-bound on the rendered PDF.
-- Accepts raw .tex files or .tar.gz / .tgz arXiv source bundles.
func parseLatexDocument(filepath: string, useAI: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing LaTeX (pure AILANG, deterministic) ---");
  println("");

  -- Detect arXiv-style .tar.gz / .tgz bundles and extract before parsing.
  -- The main .tex file is auto-detected (one containing \documentclass).
  -- Requires std/tar + std/gzip (AILANG v0.12.0+).
  let mainTexPath = resolveLatexSource(filepath);

  let rawContent = readFile(mainTexPath);
  println("Parsing ${show(length(rawContent))} chars of LaTeX source...");

  -- Resolve \input{...} and \include{...} against the main file's
  -- directory before parsing. Single-file papers are unaffected; multi-file
  -- bundles (BERT, Vaswani, etc.) get their fragments spliced inline.
  let basedir = texDirname(mainTexPath);
  let content = expandInputs(basedir, rawContent);
  if length(content) != length(rawContent) then
    println("After \\input expansion: ${show(length(content))} chars.")
  else println("");

  let meta = parseLatexMetadata(content);
  let blocks = parseLatex(content);
  println("Extracted ${show(countBlocks(blocks))} blocks.");
  if length(meta.title) > 0 then println("Title:  ${meta.title}") else println("");
  if length(meta.author) > 0 then println("Author: ${meta.author}") else println("");
  println("");

  -- AI figure descriptions (optional). \includegraphics figures are external
  -- refs, so describeImages resolves each against basedir — the main .tex file's
  -- directory, which for arXiv tarballs is the extraction dir. Raster figures
  -- (PNG/JPG) are described; PDF/EPS figures the model can't read become warnings.
  let imageCount = countBlocks(filterImages(blocks));
  let describeRes = if useAI && imageCount > 0 then {
    println("Describing ${show(imageCount)} figures with AI...");
    describeImages(basedir, blocks)
  } else {
    if imageCount > 0
    then println("Figures: ${show(imageCount)} (pass 'describe' arg for AI descriptions)")
    else ();
    { blocks: blocks, warnings: [], aiCalls: 0 }
  };
  let describedBlocks = describeRes.blocks;
  printWarnings(describeRes.warnings);

  let docMeta = {
    title: meta.title,
    author: meta.author,
    created: "",
    modified: "",
    pageCount: 0
  };

  let doc = {
    format: "latex",
    filename: filepath,
    metadata: docMeta,
    blocks: describedBlocks
  };

  let result = {
    document: doc,
    warnings: describeRes.warnings,
    aiCallsUsed: describeRes.aiCalls
  };

  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(describedBlocks);
  println("");

  writeOutputs(doc, result, false, filepath, convertTarget)
}

-- Parse an EPUB document (ZIP of XHTML, pure AILANG)
func parseEpubDocument(filepath: string, useAI: bool, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing EPUB (pure AILANG, ZIP + XHTML) ---");
  println("");

  -- Extract metadata
  println("Extracting metadata...");
  let metadata = parseEpubMetadata(filepath);

  -- Parse content (image paths resolved to full ZIP paths in epub_parser)
  println("Parsing XHTML chapters...");
  let blocks = parseEpub(filepath);
  println("Extracted ${show(countBlocks(blocks))} blocks.");

  -- Resolve image references to binary data from EPUB ZIP
  println("Resolving embedded images...");
  let resolvedBlocks = resolveBlockImages(filepath, blocks);
  let imageCount = countBlocks(filterImages(resolvedBlocks));

  -- AI image descriptions (optional)
  let describeRes = if useAI && imageCount > 0 then {
    println("Describing ${show(imageCount)} images with AI...");
    describeImages(dirOf(filepath), resolvedBlocks)
  } else {
    if imageCount > 0
    then println("Images: ${show(imageCount)} (pass 'describe' arg for AI descriptions)")
    else println("No images found.");
    { blocks: resolvedBlocks, warnings: [], aiCalls: 0 }
  };
  let describedBlocks = describeRes.blocks;
  printWarnings(describeRes.warnings);

  -- AI self-healing (fix tables with empty/ambiguous cells)
  let allBlocks = if useAI then {
    println("Enhancing blocks with AI (fixing tables, layout)...");
    enhanceBlocks(describedBlocks)
  } else describedBlocks;
  println("");

  let doc = {
    format: "epub",
    filename: filepath,
    metadata: metadata,
    blocks: allBlocks
  };

  let result = {
    document: doc,
    warnings: describeRes.warnings,
    aiCallsUsed: describeRes.aiCalls
  };

  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(allBlocks);
  println("");

  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- Parse an ODF document (ODT/ODP/ODS — pure AILANG, ZIP + ODF XML)
func parseOdfDocument(filepath: string, ext: string, useAI: bool, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  let odfType = if ext == "odt" then "text"
    else if ext == "odp" then "presentation"
    else if ext == "ods" then "spreadsheet"
    else "unknown";
  println("--- Parsing ODF ${odfType} (pure AILANG, ZIP + XML) ---");
  println("");

  -- Extract metadata
  println("Extracting metadata...");
  let metadata = if ext == "odt" then parseOdtMetadata(filepath)
    else if ext == "odp" then parseOdpMetadata(filepath)
    else parseOdsMetadata(filepath);

  -- Extract headers/footers (ODT only, from styles.xml)
  let hdrFtrBlocks = if ext == "odt" then {
    println("Extracting headers/footers...");
    let hf = parseOdtHeadersFooters(filepath);
    println("Found ${show(countBlocks(hf))} header/footer blocks.");
    hf
  } else [];

  -- Parse content
  println("Parsing ODF XML...");
  let bodyBlocks = if ext == "odt" then parseOdt(filepath)
    else if ext == "odp" then parseOdp(filepath)
    else parseOds(filepath);
  let blocks = concat(bodyBlocks, hdrFtrBlocks);
  println("Extracted ${show(countBlocks(blocks))} blocks.");

  -- Resolve image references to binary data from ZIP
  println("Resolving embedded images...");
  let resolvedBlocks = resolveBlockImages(filepath, blocks);
  let imageCount = countBlocks(filterImages(resolvedBlocks));

  -- AI image descriptions (optional)
  let describeRes = if useAI && imageCount > 0 then {
    println("Describing ${show(imageCount)} images with AI...");
    describeImages(dirOf(filepath), resolvedBlocks)
  } else {
    if imageCount > 0
    then println("Images: ${show(imageCount)} (pass 'describe' arg for AI descriptions)")
    else println("No images found.");
    { blocks: resolvedBlocks, warnings: [], aiCalls: 0 }
  };
  let describedBlocks = describeRes.blocks;
  printWarnings(describeRes.warnings);

  -- AI self-healing (fix tables with empty/ambiguous cells)
  let allBlocks = if useAI then {
    println("Enhancing blocks with AI (fixing tables, layout)...");
    enhanceBlocks(describedBlocks)
  } else describedBlocks;
  println("");

  let doc = {
    format: ext,
    filename: filepath,
    metadata: metadata,
    blocks: allBlocks
  };

  let result = {
    document: doc,
    warnings: describeRes.warnings,
    aiCallsUsed: describeRes.aiCalls
  };

  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(allBlocks);
  println("");

  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- Parse an HTML/XHTML document (pure AILANG, XML-based)
-- Strategy: try deterministic XML parse first, AI fallback for dirty HTML
func parseHtmlDocument(filepath: string, useAI: bool, doSummarize: bool, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing HTML (pure AILANG, XML-based) ---");
  println("");

  let content = readFile(filepath);
  println("Parsing ${show(length(content))} chars of HTML...");

  -- Step 1: Try deterministic XML parsing. Use the combined entry
  -- point so the std/html parse runs once and both blocks + metadata
  -- come out of the same walk.
  let parsed = parseHtmlDoc(content);
  let blocks = parsed.blocks;
  let docMetadata = parsed.metadata;
  let hasError = htmlHasParseError(blocks);

  -- Step 2: If parse failed and AI is enabled, extract text via AI
  let resolvedBlocks = if hasError && useAI then {
    println("XML parse failed — extracting text content via AI...");
    let extracted = call(
      "Extract the text content from this HTML. Return the main text, preserving: paragraph breaks, headings, list items, and table data. Ignore HTML tags, scripts, and styles. Return clean readable text.\n\n${content}"
    );
    [TextBlock({text: extracted, style: "ai-extracted", level: 0})]
  } else blocks;

  println("Extracted ${show(countBlocks(resolvedBlocks))} blocks.");

  -- AI image descriptions (optional). Unlike the ZIP-based formats, HTML stores
  -- <img src> verbatim, so describeImages resolves each reference: local files are
  -- read from disk relative to the HTML file's directory, data: URIs are decoded,
  -- and remote URLs / missing files produce a warning instead of a silent no-op.
  let imageCount = countBlocks(filterImages(resolvedBlocks));
  let describeRes = if useAI && hasError == false && imageCount > 0 then {
    println("Describing ${show(imageCount)} images with AI...");
    describeImages(dirOf(filepath), resolvedBlocks)
  } else {
    if useAI == false && imageCount > 0
    then println("Images: ${show(imageCount)} (pass 'describe' arg for AI descriptions)")
    else ();
    { blocks: resolvedBlocks, warnings: [], aiCalls: 0 }
  };
  let describedBlocks = describeRes.blocks;
  printWarnings(describeRes.warnings);

  -- Apply AI table enhancement (only if parse succeeded deterministically)
  let allBlocks = if useAI && hasError == false then {
    println("Enhancing blocks with AI (fixing tables, layout)...");
    enhanceBlocks(describedBlocks)
  } else describedBlocks;
  println("");

  let doc = {
    format: "html",
    filename: filepath,
    metadata: docMetadata,
    blocks: allBlocks
  };

  -- Count the AI text-extraction fallback call too, when it ran.
  let extractCall = if hasError && useAI then 1 else 0;
  let result = {
    document: doc,
    warnings: describeRes.warnings,
    aiCallsUsed: describeRes.aiCalls + extractCall
  };

  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(allBlocks);
  println("");

  writeOutputs(doc, result, doSummarize, filepath, convertTarget)
}

-- Parse an email document (EML or MBOX)
func parseEmailDocument(filepath: string, ext: string, threaded: bool, deep: bool) -> () ! {IO, FS, AI, Env, Process} {
  println("--- Parsing Email (pure AILANG, RFC 5322) ---");
  if threaded then println("Mode: threaded (grouping by conversation)") else ();
  if deep then println("Mode: deep (resolving Office + PDF attachments)") else ();
  println("");

  let content = readFile(filepath);
  println("Parsing ${show(length(content))} chars of email...");

  let isMbox = ext == "mbox";
  let blocks = if isMbox && threaded then parseMboxThreaded(content)
               else if isMbox then parseMbox(content)
               else parseEml(content);
  let metadata = if isMbox then parseMboxMetadata(content) else parseEmlMetadata(content);
  println("Extracted ${show(countBlocks(blocks))} blocks.");

  -- Pass 2: Resolve attachments whose bytes pass 1 preserved (Office + PDF)
  let resolvedBlocks = if deep then {
    println("Resolving attachments...");
    let projectRoot = getEnvOr("DOCPARSE_PROJECT_ROOT", "");
    let resolved = emlResolveAttachments(blocks, 0, projectRoot);
    println("Resolved ${show(resolved.count)} attachment(s).");
    resolved.blocks
  } else blocks;
  println("");

  let doc = {
    format: ext,
    filename: filepath,
    metadata: metadata,
    blocks: resolvedBlocks
  };

  let result = {
    document: doc,
    warnings: [],
    aiCallsUsed: 0
  };

  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(resolvedBlocks);
  println("");

  writeOutputs(doc, result, false, filepath, "")
}

-- ============================================================
-- Pass 2: Office Attachment Resolution
-- ============================================================

-- Walk blocks, find attachment SectionBlocks with attachment-data, resolve them
func emlResolveAttachments(blocks: [Block], counter: int, projectRoot: string) -> { blocks: [Block], count: int } ! {IO, FS, Process} {
  match blocks {
    [] => { blocks: [], count: 0 },
    block :: rest => {
      let resolved = emlResolveOneBlock(block, counter, projectRoot);
      let restResolved = emlResolveAttachments(rest, counter + resolved.count, projectRoot);
      { blocks: resolved.block :: restResolved.blocks, count: resolved.count + restResolved.count }
    }
  }
}

-- Resolve a single block (recurse into SectionBlocks)
func emlResolveOneBlock(block: Block, counter: int, projectRoot: string) -> { block: Block, count: int } ! {IO, FS, Process} {
  match block {
    SectionBlock(s) => {
      if s.kind == "attachment" && emlHasAttachmentData(s.blocks) then {
        -- This attachment has base64 data to resolve
        let b64 = emlGetAttachmentData(s.blocks);
        let ext = emlGetAttachmentExt(s.blocks);
        let meta = emlGetAttachmentMeta(s.blocks);
        let tmpPath = "/tmp/ailang_email_attach_${show(counter)}.${ext}";
        match fromBase64(b64) {
          Some(bytes) => {
            writeFileBytes(tmpPath, bytes);
            let parsedBlocks = emlParseAttachmentFile(tmpPath, ext, projectRoot);
            removeFile(tmpPath);
            let metaBlock = TextBlock({text: meta, style: "attachment-meta", level: 0});
            { block: SectionBlock({kind: "attachment", blocks: metaBlock :: parsedBlocks}), count: 1 }
          },
          None => {
            println("  Warning: Failed to decode base64 for attachment");
            { block: block, count: 0 }
          }
        }
      }
      else {
        -- Recurse into nested sections (threads, mbox-messages, etc.)
        let inner = emlResolveAttachments(s.blocks, counter, projectRoot);
        { block: SectionBlock({kind: s.kind, blocks: inner.blocks}), count: inner.count }
      }
    },
    _ => { block: block, count: 0 }
  }
}

-- Parse a resolved attachment by extension.
--
-- PDFs go through the pdftotext -> docling ladder. Crucially this NEVER calls
-- exit(): an attachment that cannot be read is one bad file inside somebody's
-- mailbox, not a reason to abandon the message — let alone the rest of a batch
-- (see ailang#607, where exit() inside a batch item panics the whole run).
-- The failure becomes a visible block instead, so it can't pass for success.
func emlParseAttachmentFile(filepath: string, ext: string, projectRoot: string) -> [Block] ! {IO, FS, Process} {
  if ext == "docx" then parseDocx(filepath)
  else if ext == "xlsx" then parseXlsx(filepath)
  else if ext == "pptx" then parsePptx(filepath)
  else if ext == "pdf" then {
    match parsePdfWithFallback("pdftotext", filepath, projectRoot) {
      Ok(outcome) => {
        if outcome.backendUsed != "pdftotext"
        then println("    (no text layer — recovered via ${outcome.backendUsed} OCR)")
        else ();
        outcome.doc.blocks
      },
      Err(msg) => {
        println("    Warning: PDF attachment not readable: ${msg}");
        [TextBlock({text: "[unreadable PDF attachment: ${msg}]", style: "error", level: 0})]
      }
    }
  }
  else [TextBlock({text: "[unsupported attachment format: ${ext}]", style: "error", level: 0})]
}

-- Check if a block list contains an attachment-data TextBlock
pure func emlHasAttachmentData(blocks: [Block]) -> bool
  ensures { result == true || result == false }
=
  match blocks {
    [] => false,
    TextBlock(t) :: rest => if t.style == "attachment-data" then true else emlHasAttachmentData(rest),
    _ :: rest => emlHasAttachmentData(rest)
  }

-- Extract the base64 data from attachment blocks
pure func emlGetAttachmentData(blocks: [Block]) -> string
  ensures { length(result) >= 0 }
=
  match blocks {
    [] => "",
    TextBlock(t) :: rest => if t.style == "attachment-data" then t.text else emlGetAttachmentData(rest),
    _ :: rest => emlGetAttachmentData(rest)
  }

-- Extract the file extension from attachment blocks
pure func emlGetAttachmentExt(blocks: [Block]) -> string
  ensures { length(result) >= 0 }
=
  match blocks {
    [] => "bin",
    TextBlock(t) :: rest => if t.style == "attachment-ext" then t.text else emlGetAttachmentExt(rest),
    _ :: rest => emlGetAttachmentExt(rest)
  }

-- Extract the meta label from attachment blocks
pure func emlGetAttachmentMeta(blocks: [Block]) -> string
  ensures { length(result) >= 0 }
=
  match blocks {
    [] => "",
    TextBlock(t) :: rest => if t.style == "attachment-meta" then t.text else emlGetAttachmentMeta(rest),
    _ :: rest => emlGetAttachmentMeta(rest)
  }

-- Parse an RTF (Rich Text Format) document (pure AILANG, no dependencies)
func parseRtfDocument(filepath: string, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  println("--- Parsing RTF (pure AILANG, deterministic) ---");
  println("");

  let content = readFile(filepath);
  println("Parsing ${show(length(content))} chars of RTF source...");

  let blocks = parseRtf(content);
  println("Extracted ${show(countBlocks(blocks))} blocks.");
  println("");

  let doc = {
    format: "rtf",
    filename: filepath,
    metadata: emptyMetadata(),
    blocks: blocks
  };

  let result = {
    document: doc,
    warnings: [],
    aiCallsUsed: 0
  };

  printSummary(doc);
  println("");
  println("--- Content Blocks ---");
  printBlocks(blocks);
  println("");

  writeOutputs(doc, result, false, filepath, convertTarget)
}

-- Parse a plain text document
func parseTextDocument(filepath: string) -> () ! {IO, FS} {
  println("--- Parsing Text ---");
  let content = readFile(filepath);
  println("Content (${show(length(content))} chars):");
  println(content);
  println("=== AILANG Parse Complete ===")
}

-- Write all output files: JSON, markdown, optional conversion, and optional AI summary
-- Output filenames are derived from input: sample.docx -> sample.docx.json, sample.docx.md
-- Output dir: DOCPARSE_OUTPUT_DIR env var (default: docparse/data)
-- convertTarget: if non-empty, generate output in target format (e.g., "out.html", "out.docx")
func writeOutputs(doc: ParsedDocument, result: ExtractionResult, doSummarize: bool, filepath: string, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  let outDir = getEnvOr("DOCPARSE_OUTPUT_DIR", "docparse/data");
  let basename = mainBasename(filepath);

  -- Ensure the output directory exists (defensive — bin/docparse already
  -- mkdirs when --output-dir is used, but direct ailang invocations setting
  -- DOCPARSE_OUTPUT_DIR to a non-existent path need this).
  mkdirAll(outDir);

  -- Write JSON
  let jsonOutput = formatResult(result);
  let jsonPath = "${outDir}/${basename}.json";
  writeFile(jsonPath, jsonOutput);
  println("JSON output written to ${jsonPath}");

  -- Write markdown (LLM-ready text)
  let markdown = renderMarkdown(doc);
  let mdPath = "${outDir}/${basename}.md";
  writeFile(mdPath, markdown);
  println("Markdown output written to ${mdPath}");

  -- Optional: format conversion
  if length(convertTarget) > 0 then {
    println("");
    let convertExt = getExtension(convertTarget);
    if convertExt == "html" || convertExt == "htm" then {
      let html = generateHtml(doc);
      writeFile(convertTarget, html);
      println("Converted to HTML: ${convertTarget}")
    }
    else if convertExt == "docx" then {
      let msg = generateDocx(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "pptx" then {
      let msg = generatePptx(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "xlsx" then {
      let msg = generateXlsx(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "odt" then {
      let msg = generateOdt(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "odp" then {
      let msg = generateOdp(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "ods" then {
      let msg = generateOds(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "md" then {
      let md = renderMarkdown(doc);
      writeFile(convertTarget, md);
      println("Converted to Markdown: ${convertTarget}")
    }
    else if convertExt == "qmd" then {
      let qmd = generateQmd(doc);
      writeFile(convertTarget, qmd);
      println("Converted to Quarto Markdown: ${convertTarget}")
    }
    else println("Unsupported conversion format: ${convertExt} (supported: html, docx, pptx, xlsx, odt, odp, ods, md, qmd)")
  }
  else ();

  -- Optional: AI summary
  if doSummarize then {
    println("");
    println("--- AI Summary ---");
    let summary = call(
      "Summarize this document concisely. Include key points, data from any tables, and descriptions of any images. Output plain text, not markdown.\n\n${markdown}"
    );
    println(summary);
    println("");
    -- Write summary to file
    let summaryPath = "${outDir}/${basename}_summary.txt";
    writeFile(summaryPath, summary);
    println("Summary written to ${summaryPath}")
  }
  else ();

  println("");
  println("=== AILANG Parse Complete ===")
}

-- Extract basename from a filepath: "/path/to/sample.docx" -> "sample.docx"
pure func mainBasename(filepath: string) -> string {
  let parts = split(filepath, "/");
  match last(parts) {
    Some(name) => if length(name) > 0 then name else "output",
    None => "output"
  }
}

-- Check if parsed HTML blocks contain a parse error
-- The HTML parser returns TextBlock(style: "error") on parse failure
pure func htmlHasParseError(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    b :: rest => match b {
      TextBlock(t) => if t.style == "error" then true else htmlHasParseError(rest),
      _ => htmlHasParseError(rest)
    }
  }
