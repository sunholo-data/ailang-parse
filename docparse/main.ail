-- AILANG Parse: Universal Document Parsing in AILANG
--
-- Demonstrates:
--   - ZIP + XML parsing for Office formats (std/zip, std/xml)
--   - AI-augmented layout understanding with bounded costs
--   - Contracts on output quality
--   - Pure/effectful function separation
--   - Pattern matching on XML trees
--
-- Run (without AI):
--   ailang run --entry main --caps IO,FS,Env docparse/main.ail myfile.docx
--
-- Run (with AI image descriptions):
--   GOOGLE_API_KEY="" ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail myfile.docx describe
--
-- Run (with contracts enforced):
--   ailang run --entry main --caps IO,FS,Env --verify-contracts docparse/main.ail myfile.docx
--
-- Test:
--   ailang test docparse/services/format_router.ail
--   ailang test docparse/services/docx_parser.ail
--
-- CAPABILITY BUDGETS:
--   IO @limit=1000  - Console output for results (increased for page-by-page PDF parsing)
--   FS @limit=100   - File reads (ZIP entries) + output write (increased from 20 for complex DOCX with headers/footers)
--   AI @limit=200  - PDF page-by-page parsing + image descriptions + layout inference (2 per page × up to ~100 pages)

export func main() -> () ! {IO @limit=50000, FS @limit=5000, AI @limit=200, Env, Clock, Net, Process} {
  println("=== AILANG Parse: Universal Document Parsing ===");
  println("");

  -- Get filepath and flags from CLI args
  let args = getArgs();
  let filepath = match args {
    [] => "docparse/data/sample.docx",
    f :: _ => f
  };
  let useAI = hasFlag(args, "describe");
  let doSummarize = hasFlag(args, "summarize");
  let convertTarget = getConvertTarget(args);
  let generateTarget = getGenerateTarget(args);
  let promptText = getPromptText(args);

  -- AI Document Generation mode: --generate output.docx --prompt "..."
  if length(generateTarget) > 0 && length(promptText) > 0 then {
    generateDocument(generateTarget, promptText)
  }
  else if length(generateTarget) > 0 then {
    println("Error: --generate requires --prompt \"description\"");
    println("");
    println("Usage: ./bin/docparse --generate report.docx --prompt \"Q1 sales report with tables\"");
    println("       ./bin/docparse --generate slides.pptx --prompt \"5-slide pitch deck\"")
  }
  -- Check file exists (normal parse mode)
  else if not fileExists(filepath) then {
    println("Error: File not found: ${filepath}");
    println("");
    println("Usage: ailang run --entry main --caps IO,FS,Env docparse/main.ail <file>");
    println("       ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail <file> describe");
    println("       ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail <file> summarize");
    println("       ailang run --entry main --caps IO,FS,Env,AI --ai gemini-2.5-flash docparse/main.ail --generate output.docx --prompt \"...\"")
  }
  else {
    -- Step 1: Detect format
    -- Special case: archive extensions (.tar.gz, .tgz, .tex.gz) route to
    -- the LaTeX pipeline — arXiv source bundles. getExtension only returns
    -- the last dotted suffix (".gz"), so we check the full filename first.
    let rawExt = getExtension(filepath);
    let ext = if isTarGz(filepath) then "tar.gz" else rawExt;
    let format = if isTarGz(filepath) then "latex" else detectFormat(rawExt);
    let strategy = strategyDescription(format);
    println("File:     ${filepath}");
    println("Format:   ${format} (${ext})");
    println("Strategy: ${strategy}");
    let aiRequired = needsAI(format);
    if aiRequired then println("AI:       required (format needs AI extraction)")
    else if doSummarize then println("AI:       enabled (summarize)")
    else if useAI then println("AI:       enabled (image descriptions)")
    else println("AI:       disabled (pass 'describe' or 'summarize' arg to enable)");
    println("");

    -- Step 2: Parse. Every format recipe lives in the orchestrator, shared
    -- with the MCP server and the hosted API — see docparse/services/orchestrator.
    --
    -- --deep and --threaded also read from env because AILANG batch mode treats
    -- every remaining argv entry as an input path: passing "file --deep" per
    -- file made --deep itself a (failing) input, which is why batch runs
    -- reported "4/4 succeeded" for 2 files. Env survives batch intact.
    let opts = {
      useAI: useAI || doSummarize,
      pdfBackend: getEnvOr("DOCPARSE_PDF_BACKEND", ""),
      deep: hasFlag(args, "--deep") || getEnvOr("DOCPARSE_DEEP", "") == "1",
      extractImages: true,
      threaded: hasFlag(args, "--threaded") || getEnvOr("DOCPARSE_THREADED", "") == "1",
      projectRoot: getEnvOr("DOCPARSE_PROJECT_ROOT", "")
    };
    runParse(filepath, opts, doSummarize, convertTarget)
  }
}

-- Check if a flag is present in args list
pure func hasFlag(args: [string], flag: string) -> bool =
  any(\a. a == flag, args)

-- Surface describe warnings to the terminal so an image that could not be
-- described reads as "skipped, here's why" rather than a silent empty.
func printWarnings(warnings: [string]) -> () ! {IO} =
  match warnings {
    [] => (),
    w :: rest => { println("⚠ ${w}"); printWarnings(rest) }
  }

-- Progress notes accumulated by the orchestrator during the parse.
--
-- These print AFTER the parse rather than during it. The core returns data and
-- cannot stream, which is the deliberate trade for having ONE format recipe
-- shared by the CLI, the MCP server and the hosted API instead of three that
-- silently drift. On a large PDF this means a pause and then a block of output
-- where there used to be a trickle.
func printNotes(notes: [string]) -> () ! {IO} =
  match notes {
    [] => (),
    n :: rest => { println("  ${n}"); printNotes(rest) }
  }

-- Parse a document and report it. This is now pure presentation: the
-- orchestrator owns every format recipe, so all the CLI does is choose what to
-- show and where to write it.
--
-- Replaces ~14 parse*Document functions that each re-derived their own dispatch
-- and merge order — the divergence that let the hosted API drop PDF annotations
-- and silently truncate multi-file LaTeX.
func runParse(filepath: string, opts: ParseOptions, doSummarize: bool, convertTarget: string)
  -> () ! {IO, FS, AI, Env, Net, Process, Clock} {
  match parseDocument(filepath, opts) {
    Err(e) => {
      println("");
      println("Error: AI provider failure — ${show(e)}");
      exit(1)
    },
    Ok(outcome) => {
      printNotes(outcome.notes);
      printWarnings(outcome.warnings);
      let doc = outcome.document;
      let result = {
        document: doc,
        warnings: outcome.warnings,
        aiCallsUsed: outcome.aiCallsUsed
      };
      println("");
      printSummary(doc);
      println("");
      println("--- Content Blocks ---");
      printBlocks(doc.blocks);
      println("");
      -- Empty extraction is reported loudly but must NOT exit(): exit() inside
      -- a batch item panics the entire run (ailang#607), taking down every
      -- remaining file. Tried it — python_pptx_table.pptx yields 0 blocks and
      -- killed a 56-file batch at item 21, which is exactly the failure the
      -- eml attachment path documents avoiding.
      if countBlocks(doc.blocks) == 0
        then println("⚠ Warning: extraction produced no content blocks.")
        else ();
      writeOutputs(doc, result, doSummarize, filepath, convertTarget)
    }
  }
}

-- Extract --convert target path from args: ["file.docx", "--convert", "out.html"] -> "out.html"
pure func getConvertTarget(args: [string]) -> string =
  match args {
    [] => "",
    "--convert" :: rest => match rest {
      [] => "",
      target :: _ => target
    },
    _ :: rest => getConvertTarget(rest)
  }

-- Extract --generate target path from args: ["--generate", "out.docx", "--prompt", "..."] -> "out.docx"
pure func getGenerateTarget(args: [string]) -> string =
  match args {
    [] => "",
    "--generate" :: rest => match rest {
      [] => "",
      target :: _ => target
    },
    _ :: rest => getGenerateTarget(rest)
  }

-- Extract --prompt text from args: ["--prompt", "Q1 report"] -> "Q1 report"
pure func getPromptText(args: [string]) -> string =
  match args {
    [] => "",
    "--prompt" :: rest => match rest {
      [] => "",
      text :: _ => text
    },
    _ :: rest => getPromptText(rest)
  }

-- AI Document Generation: prompt -> AI -> [Block] -> format generator -> file
func generateDocument(outputPath: string, prompt: string) -> () ! {IO, FS, AI, Env} {
  let ext = getExtension(outputPath);
  println("--- AI Document Generation ---");
  println("Output:   ${outputPath}");
  println("Format:   ${ext}");
  println("Prompt:   ${prompt}");
  println("");

  -- Step 1: Generate blocks from prompt via AI
  println("Generating content via AI...");
  let blocks = aiGenerateBlocks(prompt, ext);
  println("Generated ${show(countBlocks(blocks))} content blocks.");
  println("");

  -- Step 2: Build a ParsedDocument wrapper
  let doc = {
    format: ext,
    filename: outputPath,
    metadata: {title: prompt, author: "AILANG Parse AI", created: "", modified: "", pageCount: 0},
    blocks: blocks
  };

  -- Step 3: Show what was generated
  printSummary(doc);
  println("");
  println("--- Generated Content ---");
  printBlocks(blocks);
  println("");

  -- Step 4: Generate the output file
  if ext == "html" || ext == "htm" then {
    let html = generateHtml(doc);
    writeFile(outputPath, html);
    println("Generated HTML: ${outputPath}")
  }
  else if ext == "docx" then {
    let msg = generateDocx(doc, outputPath);
    println(msg)
  }
  else if ext == "pptx" then {
    let msg = generatePptx(doc, outputPath);
    println(msg)
  }
  else if ext == "xlsx" then {
    let msg = generateXlsx(doc, outputPath);
    println(msg)
  }
  else if ext == "odt" then {
    let msg = generateOdt(doc, outputPath);
    println(msg)
  }
  else if ext == "odp" then {
    let msg = generateOdp(doc, outputPath);
    println(msg)
  }
  else if ext == "ods" then {
    let msg = generateOds(doc, outputPath);
    println(msg)
  }
  else if ext == "md" then {
    let md = renderMarkdown(doc);
    writeFile(outputPath, md);
    println("Generated Markdown: ${outputPath}")
  }
  else if ext == "qmd" then {
    let qmd = generateQmd(doc);
    writeFile(outputPath, qmd);
    println("Generated Quarto Markdown: ${outputPath}")
  }
  else println("Unsupported format: ${ext} (supported: html, docx, pptx, xlsx, odt, odp, ods, md, qmd)");

  println("");
  println("=== AILANG Parse Generation Complete ===")
}

-- Write all output files: JSON, markdown, optional conversion, and optional AI summary
-- Output filenames are derived from input: sample.docx -> sample.docx.json, sample.docx.md
-- Output dir: DOCPARSE_OUTPUT_DIR env var (default: docparse/data)
-- convertTarget: if non-empty, generate output in target format (e.g., "out.html", "out.docx")
func writeOutputs(doc: ParsedDocument, result: ExtractionResult, doSummarize: bool, filepath: string, convertTarget: string) -> () ! {IO, FS, AI, Env} {
  let outDir = getEnvOr("DOCPARSE_OUTPUT_DIR", "docparse/data");
  let basename = mainBasename(filepath);

  -- Ensure the output directory exists (defensive — bin/docparse already
  -- mkdirs when --output-dir is used, but direct ailang invocations setting
  -- DOCPARSE_OUTPUT_DIR to a non-existent path need this).
  mkdirAll(outDir);

  -- Write JSON
  let jsonOutput = formatResult(result);
  let jsonPath = "${outDir}/${basename}.json";
  writeFile(jsonPath, jsonOutput);
  println("JSON output written to ${jsonPath}");

  -- Write markdown (LLM-ready text)
  let markdown = renderMarkdown(doc);
  let mdPath = "${outDir}/${basename}.md";
  writeFile(mdPath, markdown);
  println("Markdown output written to ${mdPath}");

  -- Optional: format conversion
  if length(convertTarget) > 0 then {
    println("");
    let convertExt = getExtension(convertTarget);
    if convertExt == "html" || convertExt == "htm" then {
      let html = generateHtml(doc);
      writeFile(convertTarget, html);
      println("Converted to HTML: ${convertTarget}")
    }
    else if convertExt == "docx" then {
      let msg = generateDocx(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "pptx" then {
      let msg = generatePptx(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "xlsx" then {
      let msg = generateXlsx(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "odt" then {
      let msg = generateOdt(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "odp" then {
      let msg = generateOdp(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "ods" then {
      let msg = generateOds(doc, convertTarget);
      println(msg)
    }
    else if convertExt == "md" then {
      let md = renderMarkdown(doc);
      writeFile(convertTarget, md);
      println("Converted to Markdown: ${convertTarget}")
    }
    else if convertExt == "qmd" then {
      let qmd = generateQmd(doc);
      writeFile(convertTarget, qmd);
      println("Converted to Quarto Markdown: ${convertTarget}")
    }
    else println("Unsupported conversion format: ${convertExt} (supported: html, docx, pptx, xlsx, odt, odp, ods, md, qmd)")
  }
  else ();

  -- Optional: AI summary
  if doSummarize then {
    println("");
    println("--- AI Summary ---");
    let summary = call(
      "Summarize this document concisely. Include key points, data from any tables, and descriptions of any images. Output plain text, not markdown.\n\n${markdown}"
    );
    println(summary);
    println("");
    -- Write summary to file
    let summaryPath = "${outDir}/${basename}_summary.txt";
    writeFile(summaryPath, summary);
    println("Summary written to ${summaryPath}")
  }
  else ();

  println("");
  println("=== AILANG Parse Complete ===")
}

-- Extract basename from a filepath: "/path/to/sample.docx" -> "sample.docx"
pure func mainBasename(filepath: string) -> string {
  let parts = split(filepath, "/");
  match last(parts) {
    Some(name) => if length(name) > 0 then name else "output",
    None => "output"
  }
}

-- Check if parsed HTML blocks contain a parse error
-- The HTML parser returns TextBlock(style: "error") on parse failure
pure func htmlHasParseError(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    b :: rest => match b {
      TextBlock(t) => if t.style == "error" then true else htmlHasParseError(rest),
      _ => htmlHasParseError(rest)
    }
  }
