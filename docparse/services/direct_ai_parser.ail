module docparse/services/direct_ai_parser

import std/ai (call, callJson, callJsonSimple, callJsonSimpleResult, callResult, AIError)
import std/clock (sleep)
import std/fs (readFileBytes)
import std/string (length, substring, trim, find, startsWith, intToStr, stringToInt)
import std/json (decode, encode, jo, kv, js, jnum, ja, getString, getInt, getBool, getArray, asString, asArray)
import std/option (Some, None, getOrElse)
import std/list (map, flatMap, concat, any, length as listLength)
import std/result (Ok, Err)
import docparse/types/document (Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, TableCell, DocMetadata, emptyMetadata, simpleCell, mkImage, mkTable)
import docparse/services/pdf_annotations (extractAnnotations, annotationsAsBlocks)
import pkg/sunholo/gemini_files/upload (uploadFile, deleteFile, UploadedFile)

-- Direct AI Parser for PDF and Image files
--
-- Uses multimodal AI requests with two strategies:
--   Small files (< 500KB base64): inline base64 data in each request
--   Large files (>= 500KB): upload once to GCS/Files API, reference by URI
-- The AILANG runtime supports both inlineData and fileData parts.
--
-- This is the "AI-first" path - the file content IS the AI input.
-- Budget: AI @limit=N ensures bounded cost.

-- MIME type for PDF
pure func pdfMimeType() -> string = "application/pdf"

-- Parse a PDF file using AI multimodal extraction
-- Uses page-by-page parsing to avoid output token truncation on multi-page documents.
-- Each page is extracted separately, then results are concatenated.
-- For large files: uploads once to GCS/Files API, references by URI in all AI calls.
--
-- Also extracts /Annots metadata (highlights, comments, sticky notes) directly
-- from the PDF object structure — Gemini multimodal sees the rasterised page
-- and misses these entirely. Annotation extraction is fail-soft: if it errors
-- or hits a compressed-object PDF, the AI output still ships.
export func parsePdf(filepath: string) -> [Block] ! {Clock, FS, AI, Net, Env} {
  match readFileBytes(filepath) {
    Err(_) => [],
    Ok(base64Data) =>
      if length(base64Data) == 0 then []
      else {
        -- Upload large files for efficiency (avoids re-sending base64 per page)
        let uploaded = prepareUpload(base64Data, pdfMimeType(), filepath);
        let fileUri = uploadedUri(uploaded);
        let pageCount = aiGetPageCount(base64Data, fileUri, filepath);
        let aiBlocks = if pageCount <= 5
          then aiExtractWithRetry(base64Data, fileUri, filepath, true, 1)
          else parsePdfAllPages(base64Data, fileUri, filepath, 1, pageCount);
        -- Cleanup uploaded file (best-effort; GCS lifecycle policy as safety net)
        cleanupUpload(uploaded);
        -- Layer in PDF annotations (deterministic, no AI). Empty list on
        -- /ObjStm-compressed files; that's logged inside extractAnnotations.
        let annBlocks = annotationsAsBlocks(extractAnnotations(filepath));
        concat(aiBlocks, annBlocks)
      }
  }
}

-- Result-returning variant of parsePdf, used by the hosted API so it can
-- surface a typed AIError (→ HTTP 502/503) instead of a bare 500 when the AI
-- provider fails. Differs from parsePdf only in the page-count step: it retries
-- the (transient-prone) page-count call and returns Err on terminal failure.
--
-- Both the page-count probe AND the page-extraction calls are now hardened.
-- Extraction uses callJsonSimpleResult (AILANG v0.23.0) via the Result twins
-- below (aiExtractWithRetryResult / parsePdfAllPagesResult), so a terminal AI
-- failure anywhere in the pipeline returns Err(AIError) → HTTP 502/503 instead
-- of a bare 500. Kept parallel to parsePdf (which uses the non-Result twins),
-- not shared, so the CLI path (parsePdf) stays free of the Clock effect.
export func parsePdfResult(filepath: string) -> Result[[Block], AIError] ! {FS, AI, Net, Env, Clock} {
  match readFileBytes(filepath) {
    Err(_) => Ok([]),
    Ok(base64Data) =>
      if length(base64Data) == 0 then Ok([])
      else {
        let uploaded = prepareUpload(base64Data, pdfMimeType(), filepath);
        let fileUri = uploadedUri(uploaded);
        match aiGetPageCountResult(base64Data, fileUri, filepath) {
          Err(e) => { let _ = cleanupUpload(uploaded); Err(e) },
          Ok(pageCount) => {
            let extraction = if pageCount <= 5
              then aiExtractWithRetryResult(base64Data, fileUri, filepath, true, 1)
              else parsePdfAllPagesResult(base64Data, fileUri, filepath, 1, pageCount);
            let _ = cleanupUpload(uploaded);
            match extraction {
              Err(e) => Err(e),
              Ok(aiBlocks) => {
                let annBlocks = annotationsAsBlocks(extractAnnotations(filepath));
                Ok(concat(aiBlocks, annBlocks))
              }
            }
          }
        }
      }
  }
}

-- Transient-error retry wrapper around the Result-returning AI call.
-- Providers (Gemini included) occasionally return retryable 5xx ("Internal
-- error encountered"); a couple of backed-off retries absorb the blip rather
-- than failing the whole parse. Non-retryable errors (auth, schema, context
-- length) return immediately. Bounded retries keep the AI cost budget.
func aiCallWithRetry(request: string, retriesLeft: int, backoffMs: int) -> Result[string, AIError] ! {AI, Clock} =
  match callResult(request) {
    Ok(text) => Ok(text),
    Err(e) =>
      if e.retryable && retriesLeft > 0 then {
        let _ = sleep(backoffMs);
        aiCallWithRetry(request, retriesLeft - 1, backoffMs * 2)
      }
      else Err(e)
  }

-- Same transient-retry policy as aiCallWithRetry, but over the no-schema
-- callJsonSimpleResult (the call the page/image extraction path must use,
-- since callJson corrupts large multimodal responses). This is what lets the
-- extraction path surface a typed AIError instead of an uncaught effect error.
func aiCallJsonSimpleWithRetry(request: string, retriesLeft: int, backoffMs: int) -> Result[string, AIError] ! {AI, Clock} =
  match callJsonSimpleResult(request) {
    Ok(text) => Ok(text),
    Err(e) =>
      if e.retryable && retriesLeft > 0 then {
        let _ = sleep(backoffMs);
        aiCallJsonSimpleWithRetry(request, retriesLeft - 1, backoffMs * 2)
      }
      else Err(e)
  }

-- Result-returning page-count probe (retries transient failures).
-- Mirrors aiGetPageCount's parsing logic but surfaces a typed AIError.
func aiGetPageCountResult(base64Data: string, fileUri: string, filepath: string) -> Result[int, AIError] ! {AI, Clock} {
  let request = encode(jo([
    kv("mode", js("multimodal")),
    kv("mimeType", js(pdfMimeType())),
    sourceKv(base64Data, fileUri),
    kv("fileName", js(filepath)),
    kv("prompt", js("How many pages does this PDF have? Return ONLY the integer."))
  ]));
  match aiCallWithRetry(request, 2, 250) {
    Err(e) => Err(e),
    Ok(raw) => {
      let response = trim(raw);
      let pages = match decode(response) {
        Ok(json) => match getInt(json, "pageCount") {
          Some(n) => if n > 0 then n else 1,
          None => aiParsePageCountFromText(response)
        },
        Err(_) => aiParsePageCountFromText(response)
      };
      Ok(pages)
    }
  }
}

-- Upload file if large enough and a backend (GCS or AI Studio) is available.
-- Returns Ok(UploadedFile) if uploaded, Err if below threshold or unavailable.
-- Clock: uploadFile timestamps the temporary GCS object name (gemini_files 0.2.1).
func prepareUpload(base64Data: string, mimeType: string, filepath: string)
  -> Result[UploadedFile, string] ! {Clock, Net, FS, Env} {
  if length(base64Data) <= 500000 then Err("below threshold")
  else uploadFile(base64Data, mimeType, filepath)
}

-- Extract file URI from upload result ("" if not uploaded — use inline base64)
pure func uploadedUri(uploaded: Result[UploadedFile, string]) -> string =
  match uploaded {
    Ok(f) => f.uri,
    Err(_) => ""
  }

-- Delete uploaded file. Silent on failure (GCS 1-day lifecycle as safety net).
func cleanupUpload(uploaded: Result[UploadedFile, string]) -> () ! {Net, FS, Env} =
  match uploaded {
    Ok(f) => match deleteFile(f) {
      Ok(_) => (),
      Err(_) => ()
    },
    Err(_) => ()
  }

-- Build the source key-value for multimodal requests.
-- If fileUri is non-empty, use fileUri (file reference); otherwise use inline base64 data.
pure func sourceKv(base64Data: string, fileUri: string) -> {key: string, value: Json} =
  if length(fileUri) > 0
  then kv("fileUri", js(fileUri))
  else kv("data", js(base64Data))

-- Validate-and-retry: extract PDF content, retry once if output looks bad.
-- Checks: non-empty result, no ai-raw fallbacks, no empty list items.
-- At most 1 retry (2 total calls) to stay within AI budget.
func aiExtractWithRetry(base64Data: string, fileUri: string, filepath: string, singlePage: bool, retriesLeft: int) -> [Block] ! {AI} {
  let blocks = parsePdfOnePage(base64Data, fileUri, filepath, 1, singlePage);
  if aiIsValidExtraction(blocks) then blocks
  else if retriesLeft <= 0 then blocks
  else aiExtractWithRetry(base64Data, fileUri, filepath, singlePage, retriesLeft - 1)
}

-- Result twin of aiExtractWithRetry (used by parsePdfResult): same weak-output
-- validate-and-retry, but a typed AI failure short-circuits as Err rather than
-- raising. Transient 5xx are already absorbed inside parsePdfOnePageResult.
func aiExtractWithRetryResult(base64Data: string, fileUri: string, filepath: string, singlePage: bool, retriesLeft: int) -> Result[[Block], AIError] ! {AI, Clock} =
  match parsePdfOnePageResult(base64Data, fileUri, filepath, 1, singlePage) {
    Err(e) => Err(e),
    Ok(blocks) =>
      if aiIsValidExtraction(blocks) then Ok(blocks)
      else if retriesLeft <= 0 then Ok(blocks)
      else aiExtractWithRetryResult(base64Data, fileUri, filepath, singlePage, retriesLeft - 1)
  }

-- Validation: did the AI produce usable structured output?
pure func aiIsValidExtraction(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    _ => if any(aiIsRawBlock, blocks) then false
         else if any(aiIsEmptyList, blocks) then false
         else true
  }

-- Block fell through to raw text fallback (JSON parse failed or unrecognized type)
pure func aiIsRawBlock(b: Block) -> bool =
  match b {
    TextBlock(t) => t.style == "ai-raw",
    _ => false
  }

-- List block with zero items (AI returned structure but omitted content)
pure func aiIsEmptyList(b: Block) -> bool =
  match b {
    ListBlock(l) => match l.items { [] => true, _ => false },
    _ => false
  }

-- Get page count from PDF via lightweight AI call
func aiGetPageCount(base64Data: string, fileUri: string, filepath: string) -> int ! {AI} {
  let request = encode(jo([
    kv("mode", js("multimodal")),
    kv("mimeType", js(pdfMimeType())),
    sourceKv(base64Data, fileUri),
    kv("fileName", js(filepath)),
    kv("prompt", js("How many pages does this PDF have? Return ONLY the integer."))
  ]));
  let response = trim(call(request));
  match decode(response) {
    Ok(json) => match getInt(json, "pageCount") {
      Some(n) => if n > 0 then n else 1,
      None => aiParsePageCountFromText(response)
    },
    Err(_) => aiParsePageCountFromText(response)
  }
}

-- Parse page count from plain text AI response (e.g. "4" or "This PDF has 4 pages")
func aiParsePageCountFromText(response: string) -> int {
  match stringToInt(trim(response)) {
    Some(n) => if n > 0 then n else 1,
    None => 1
  }
}

-- Recursively parse all pages, concatenating blocks
func parsePdfAllPages(base64Data: string, fileUri: string, filepath: string, page: int, totalPages: int) -> [Block] ! {AI} {
  if page > totalPages then []
  else {
    let pageBlocks = parsePdfOnePage(base64Data, fileUri, filepath, page, false);
    let rest = parsePdfAllPages(base64Data, fileUri, filepath, page + 1, totalPages);
    concat(pageBlocks, rest)
  }
}

-- Result twin of parsePdfAllPages (used by parsePdfResult): returns Err on the
-- first page whose extraction terminally fails, otherwise concatenates pages.
func parsePdfAllPagesResult(base64Data: string, fileUri: string, filepath: string, page: int, totalPages: int) -> Result[[Block], AIError] ! {AI, Clock} =
  if page > totalPages then Ok([])
  else match parsePdfOnePageResult(base64Data, fileUri, filepath, page, false) {
    Err(e) => Err(e),
    Ok(pageBlocks) => match parsePdfAllPagesResult(base64Data, fileUri, filepath, page + 1, totalPages) {
      Err(e) => Err(e),
      Ok(rest) => Ok(concat(pageBlocks, rest))
    }
  }

-- Build the multimodal extraction request for one PDF page. Pure and shared by
-- both the raising (parsePdfOnePage) and Result (parsePdfOnePageResult) twins.
func pdfPageRequest(base64Data: string, fileUri: string, filepath: string, page: int, singlePage: bool) -> string {
  let pageInstruction = if singlePage
    then "Extract ALL content from this entire PDF"
    else "This is a multi-page PDF. Extract ALL content that appears on page ${intToStr(page)} only. You CAN see all pages — focus your extraction on page ${intToStr(page)} and skip content from other pages.";
  encode(jo([
    kv("mode", js("multimodal")),
    kv("mimeType", js(pdfMimeType())),
    sourceKv(base64Data, fileUri),
    kv("fileName", js(filepath)),
    kv("prompt", js(
      "${pageInstruction} Return a JSON array of blocks. Block types: {\"type\":\"heading\",\"text\":\"...\",\"level\":N}, {\"type\":\"text\",\"text\":\"...\"}, {\"type\":\"table\",\"headers\":[...],\"rows\":[[...]]}, {\"type\":\"list\",\"items\":[\"full item text here\",...],\"ordered\":bool}. CRITICAL RULES: 1. Create a SEPARATE text block for EACH paragraph or visual text section. Do NOT merge paragraphs. 2. Include the COMPLETE text of every list item and paragraph — do NOT omit or truncate. 3. Use heading blocks for titles, section headers, and any text that serves as a header (with appropriate level 1-6). 4. For tables, include ALL rows and ALL cell content. For tables with multi-row headers (e.g. 'Three Months Ended' spanning columns), use separate header rows: first row for group headers, second for sub-headers. 5. Preserve the document's reading order. Use compact JSON. Return ONLY the JSON array. If the page has no content, return []."
    ))
  ]))
}

-- Parse a single page of a PDF (CLI/browser path — raises on terminal failure)
func parsePdfOnePage(base64Data: string, fileUri: string, filepath: string, page: int, singlePage: bool) -> [Block] ! {AI} {
  let response = callJsonSimple(pdfPageRequest(base64Data, fileUri, filepath, page, singlePage));
  parseBlocksFromJson(response)
}

-- Result twin of parsePdfOnePage (hosted-API path): retries transient AI 5xx
-- and returns a typed AIError on terminal failure instead of raising → lets the
-- hosted /api/v1/parse map extraction failures to HTTP 502/503, not a bare 500.
func parsePdfOnePageResult(base64Data: string, fileUri: string, filepath: string, page: int, singlePage: bool) -> Result[[Block], AIError] ! {AI, Clock} =
  match aiCallJsonSimpleWithRetry(pdfPageRequest(base64Data, fileUri, filepath, page, singlePage), 2, 250) {
    Err(e) => Err(e),
    Ok(response) => Ok(parseBlocksFromJson(response))
  }

-- Parse an image of a document page using AI — extracts structured content (text, headings, tables)
-- Same extraction pipeline as PDF but for image inputs (JPG, PNG, etc.)
-- Use this for document page images (e.g., scanned pages, screenshots of documents)
export func parseDocumentImage(filepath: string, mime: string) -> [Block] ! {FS, AI} {
  match readFileBytes(filepath) {
    Err(_) => [],
    Ok(base64Data) =>
      if length(base64Data) == 0 then []
      else {
        let request = encode(jo([
          kv("mode", js("multimodal")),
          kv("mimeType", js(mime)),
          kv("data", js(base64Data)),
          kv("fileName", js(filepath)),
          kv("prompt", js(
            "This image may be a document page, OR a chart/graph/diagram/photo. Return a JSON array of blocks. Block types: {\"type\":\"heading\",\"text\":\"...\",\"level\":N}, {\"type\":\"text\",\"text\":\"...\"}, {\"type\":\"table\",\"headers\":[...],\"rows\":[[...]]}, {\"type\":\"list\",\"items\":[\"full item text here\",...],\"ordered\":bool}. FIRST, decide what the image is. If it is a chart, graph, plot, diagram, or photo (NOT a page of prose/table): emit ONE {\"type\":\"text\"} block FIRST that DESCRIBES WHAT THE VISUAL CONVEYS for a reader who cannot see it — for a chart/graph name the chart type, state each axis and its units, and describe the shape and trend of the plotted data (where it rises, falls, peaks, notable values/inflection points); for a diagram/photo say what it shows and how it is laid out. THEN extract any literal text (title, axis labels, legend entries, tick values, captions, body text) as further blocks in reading order. If it is an ordinary document page with no figure, skip the description block and just extract the text. RULES: 1. Separate text block per paragraph/visual section — do NOT merge. 2. Include COMPLETE text — do NOT truncate. 3. Use heading blocks for titles/section headers (level 1-6). 4. Tables: include ALL rows and cells; multi-row headers as separate header rows. 5. Preserve reading order. 6. Formulas in LaTeX where possible (e.g. $x^2$). Use compact JSON. Return ONLY the JSON array. If the image is truly empty, return []."
          ))
        ]));
        let response = callJsonSimple(request);
        parseBlocksFromJson(response)
      }
  }
}

-- Parse an image file using AI vision (describes the image, does NOT extract document content)
-- Use parseDocumentImage instead if the image is a document page
export func parseImage(filepath: string, mime: string) -> [Block] ! {FS, AI} {
  match readFileBytes(filepath) {
    Err(_) => [],
    Ok(base64Data) =>
      if length(base64Data) == 0 then []
      else {
        let request = encode(jo([
          kv("mode", js("multimodal")),
          kv("mimeType", js(mime)),
          kv("data", js(base64Data)),
          kv("fileName", js(filepath)),
          kv("prompt", js(
            "Describe this image in detail. Include what it shows, any visible text or labels, key data or information conveyed, and visual structure. Be concise but thorough."
          ))
        ]));
        let description = call(request);
        [mkImage(base64Data, description, mime)]
      }
  }
}

-- Parse an audio file using AI (transcription + understanding)
export func parseAudio(filepath: string, mime: string) -> [Block] ! {FS, AI} {
  match readFileBytes(filepath) {
    Err(_) => [],
    Ok(base64Data) =>
      if length(base64Data) == 0 then []
      else {
        let request = encode(jo([
          kv("mode", js("multimodal")),
          kv("mimeType", js(mime)),
          kv("data", js(base64Data)),
          kv("fileName", js(filepath)),
          kv("prompt", js(
            "Transcribe and analyze this audio file. Return a JSON object with:\n- \"transcription\": full text transcription of all speech\n- \"summary\": brief summary of the audio content\n- \"speakers\": number of distinct speakers detected\n- \"language\": detected language\nInclude ALL spoken content. Return ONLY the JSON."
          ))
        ]));
        let audioSchema = "{\"type\":\"object\",\"properties\":{\"transcription\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"},\"speakers\":{\"type\":\"integer\"},\"language\":{\"type\":\"string\"}}}";
        let response = callJson(request, audioSchema);
        parseAudioResponse(response, base64Data, mime)
      }
  }
}

-- Parse a video file using AI (visual + audio understanding)
export func parseVideo(filepath: string, mime: string) -> [Block] ! {FS, AI} {
  match readFileBytes(filepath) {
    Err(_) => [],
    Ok(base64Data) =>
      if length(base64Data) == 0 then []
      else {
        let request = encode(jo([
          kv("mode", js("multimodal")),
          kv("mimeType", js(mime)),
          kv("data", js(base64Data)),
          kv("fileName", js(filepath)),
          kv("prompt", js(
            "Analyze this video file. Extract ALL content from both visuals and audio. CRITICAL: Transcribe ALL spoken words completely — do not summarize or abbreviate speech. Every sentence spoken must appear as a transcription block.\n\nReturn a JSON array of blocks. Each block must be one of these types:\n- {\"type\":\"transcription\",\"text\":\"exact spoken words\"} — MUST include every sentence spoken in the video\n- {\"type\":\"heading\",\"text\":\"...\",\"level\":1} (level 1-6)\n- {\"type\":\"text\",\"text\":\"...\"} — for on-screen text or captions\n- {\"type\":\"table\",\"headers\":[\"col1\",\"col2\"],\"rows\":[[\"a\",\"b\"]]}\n- {\"type\":\"list\",\"items\":[\"item1\",\"item2\"],\"ordered\":false}\n- {\"type\":\"image\",\"description\":\"what is shown in this scene\"}\n\nInterleave transcription blocks with visual blocks in chronological order. Include scene descriptions, any on-screen text, tables or data shown. Return ONLY compact JSON (no whitespace)."
          ))
        ]));
        -- Use callJsonSimple for multimodal: callJson corrupts large responses (known bug)
        let response = callJsonSimple(request);
        parseVideoResponse(response, base64Data, mime)
      }
  }
}

-- Extract metadata from a PDF using AI
export func parsePdfMetadata(filepath: string) -> DocMetadata ! {FS, AI} {
  match readFileBytes(filepath) {
    Err(_) => emptyMetadata(),
    Ok(base64Data) =>
      if length(base64Data) == 0 then emptyMetadata()
      else {
        let request = encode(jo([
          kv("mode", js("multimodal")),
          kv("mimeType", js(pdfMimeType())),
          kv("data", js(base64Data)),
          kv("fileName", js(filepath)),
          kv("prompt", js(
            "Extract metadata from this PDF. Return JSON: {\"title\":\"...\",\"author\":\"...\",\"pageCount\":N}. Use empty string if unavailable. Return ONLY the JSON."
          ))
        ]));
        let metadataSchema = "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"},\"pageCount\":{\"type\":\"integer\"}}}";
        let response = callJson(request, metadataSchema);
        parseMetadataFromJson(response)
      }
  }
}

-- Parse AI response JSON into Block list
-- Handles truncated responses via JSON repair (AI may hit output token limits)
pure func parseBlocksFromJson(response: string) -> [Block] {
  let trimmed = trim(response);
  match decode(trimmed) {
    Ok(json) => match asArray(json) {
      Some(items) => parseBlockItems(items),
      None => [TextBlock({text: trimmed, style: "ai-raw", level: 0})]
    },
    Err(_) =>
      -- Try repairing truncated JSON array
      match repairJsonArray(trimmed) {
        Some(repaired) => match decode(repaired) {
          Ok(json2) => match asArray(json2) {
            Some(items) => parseBlockItems(items),
            None => [TextBlock({text: trimmed, style: "ai-raw", level: 0})]
          },
          Err(_) => [TextBlock({text: trimmed, style: "ai-raw", level: 0})]
        },
        None => [TextBlock({text: trimmed, style: "ai-raw", level: 0})]
      }
  }
}

-- Repair a truncated JSON array by finding the last complete object
-- If the response starts with [ but doesn't end with ], find the last }
-- and close the array. This recovers partial results from truncated AI output.
pure func repairJsonArray(s: string) -> Option[string] {
  if startsWith(s, "[") then {
    let lastBrace = findLastBrace(s, length(s) - 1);
    if lastBrace > 0
    then Some("${substring(s, 0, lastBrace + 1)}]")
    else None
  }
  else None
}

-- Find the last '}' character by scanning backwards
pure func findLastBrace(s: string, idx: int) -> int {
  if idx < 0 then -1
  else if substring(s, idx, idx + 1) == "}" then idx
  else findLastBrace(s, idx - 1)
}

-- Parse individual block items from JSON array
pure func parseBlockItems(items: [Json]) -> [Block] =
  flatMap(\item. match parseOneBlock(item) {
    Some(block) => [block],
    None => []
  }, items)

-- Parse a single JSON object into a Block
pure func parseOneBlock(json: Json) -> Option[Block] {
  match getString(json, "type") {
    Some("heading") => match getString(json, "text") {
      Some(text) =>
        Some(HeadingBlock({text: text, level: getOrElse(getInt(json, "level"), 1)})),
      None => None
    },
    Some("text") => match getString(json, "text") {
      Some(text) => Some(TextBlock({text: text, style: "Normal", level: 0})),
      None => None
    },
    Some("table") => {
      let headers = getOrElse(getArray(json, "headers"), []);
      let rows = getOrElse(getArray(json, "rows"), []);
      let flatHeaders = aiFlattenHeaders(headers);
      Some(mkTable(parseAiTableRows(rows), aiStringsToSimpleCells(flatHeaders)))
    },
    Some("list") => {
      let items = getOrElse(getArray(json, "items"), []);
      let ordered = getOrElse(getBool(json, "ordered"), false);
      Some(ListBlock({items: aiExtractStrings(items), ordered: ordered}))
    },
    Some("image") => match getString(json, "description") {
      Some(desc) => Some(mkImage("", desc, "image/unknown")),
      None => None
    },
    _ => None
  }
}

-- Parse metadata from AI JSON response
-- callJson guarantees valid JSON matching the metadata schema
pure func parseMetadataFromJson(response: string) -> DocMetadata {
  match decode(response) {
    Ok(json) => {
      title: getOrElse(getString(json, "title"), ""),
      author: getOrElse(getString(json, "author"), ""),
      created: "",
      modified: "",
      pageCount: getOrElse(getInt(json, "pageCount"), 0)
    },
    Err(_) => emptyMetadata()
  }
}

-- Parse table rows from JSON array of arrays
pure func parseAiTableRows(rowJsons: [Json]) -> [[TableCell]] =
  flatMap(\rj. match asArray(rj) {
    Some(cells) => [aiStringsToSimpleCells(aiExtractStrings(cells))],
    None => []
  }, rowJsons)

pure func aiStringsToSimpleCells(strs: [string]) -> [TableCell] =
  map(simpleCell, strs)

-- Flatten table headers: handles both ["h1","h2"] and [["row1h1","row1h2"],["row2h1","row2h2"]]
-- AI sometimes returns multi-row headers as nested arrays
pure func aiFlattenHeaders(jsons: [Json]) -> [string] =
  flatMap(\j. match asString(j) {
    Some(s) => [s],
    None => match asArray(j) {
      Some(inner) => aiExtractStrings(inner),
      None => match getString(j, "text") {
        Some(s) => [s],
        None => match getString(j, "header") {
          Some(s) => [s],
          None => []
        }
      }
    }
  }, jsons)

-- Extract strings from JSON array, handling both plain strings and objects with
-- text/header fields (AI sometimes returns {"header":"text","colspan":N} for table headers)
pure func aiExtractStrings(jsons: [Json]) -> [string] =
  flatMap(\j. match asString(j) {
    Some(s) => [s],
    None => match getString(j, "text") {
      Some(s) => [s],
      None => match getString(j, "header") {
        Some(s) => [s],
        None => []
      }
    }
  }, jsons)

-- Parse audio AI response into blocks
-- callJson guarantees valid JSON with transcription, summary, speakers, language fields
pure func parseAudioResponse(response: string, data: string, mime: string) -> [Block] {
  match decode(response) {
    Ok(json) => {
      let transcription = getOrElse(getString(json, "transcription"), response);
      let summary = getOrElse(getString(json, "summary"), "");
      let lang = getOrElse(getString(json, "language"), "");
      let blocks = [AudioBlock({data: data, transcription: transcription, mime: mime})];
      let withSummary = if length(summary) > 0
        then blocks ++ [TextBlock({text: "Summary: ${summary}", style: "ai-summary", level: 0})]
        else blocks;
      if length(lang) > 0
        then withSummary ++ [TextBlock({text: "Language: ${lang}", style: "ai-metadata", level: 0})]
        else withSummary
    },
    Err(_) => [AudioBlock({data: data, transcription: response, mime: mime})]
  }
}

-- Parse video AI response into blocks
-- callJsonSimple returns raw JSON string; we decode + validate here
pure func parseVideoResponse(response: string, data: string, mime: string) -> [Block] {
  match decode(response) {
    Ok(json) => match asArray(json) {
      Some(items) => {
        let contentBlocks = parseVideoBlockItems(items);
        let videoBlock = VideoBlock({data: data, description: videoSummaryFromBlocks(contentBlocks), mime: mime});
        videoBlock :: contentBlocks
      },
      None => [VideoBlock({data: data, description: response, mime: mime})]
    },
    Err(_) => [VideoBlock({data: data, description: response, mime: mime})]
  }
}

-- Parse video block items - extends standard blocks with transcription type
pure func parseVideoBlockItems(items: [Json]) -> [Block] =
  flatMap(\item. match parseVideoBlock(item) {
    Some(block) => [block],
    None => []
  }, items)

pure func parseVideoBlock(json: Json) -> Option[Block] {
  match getString(json, "type") {
    Some("transcription") => match getString(json, "text") {
      Some(text) => Some(TextBlock({text: text, style: "transcription", level: 0})),
      None => None
    },
    _ => parseOneBlock(json)
  }
}

-- Build a summary description from extracted video content blocks
pure func videoSummaryFromBlocks(blocks: [Block]) -> string =
  match blocks {
    [] => "video content",
    b :: _ => match b {
      TextBlock(t) => if length(t.text) > 100 then "${substring(t.text, 0, 100)}..."
                      else t.text,
      HeadingBlock(h) => h.text,
      _ => "video content"
    }
  }
