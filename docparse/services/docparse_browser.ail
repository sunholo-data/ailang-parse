module docparse/services/docparse_browser

-- Browser adapter for AILANG Parse: the bindings every page needs at boot.
--
-- JavaScript handles ZIP extraction (JSZip); AILANG handles XML -> Block ->
-- JSON. The per-format bindings live in docparse/services/browser_<format>
-- modules, which docs/js/wasm-demo.js loads (with their parsers) the first
-- time a file of that format is parsed: type-checking every parser at boot
-- was ~20s of a cold start on a CI runner, and most visitors drop one format.
-- This module keeps what is format-independent: format detection, the AI path
-- for PDFs, images and media, and the A2UI conversion of any block list.
--
-- It is NOT a standalone module — it requires its imports to be loaded in the
-- WASM REPL first (MODULES_TO_LOAD, in dependency order).

import std/json (encode, jo, kv, js, jb, ja)
import std/string (length)
import std/ai (callJsonSimple)
import docparse/services/format_router (detectFormat, getExtension, officeType,
    needsAI, strategyDescription)
import docparse/services/a2ui_formatter (convertBlocksJsonToA2UI as a2uiConvert)

-- Get format info as JSON for a filename
export pure func getFormatInfo(filename: string) -> string {
  let ext = getExtension(filename);
  let format = detectFormat(ext);
  encode(jo([
    kv("extension", js(ext)),
    kv("format", js(format)),
    kv("officeType", js(officeType(ext))),
    kv("needsAI", jb(needsAI(format))),
    kv("strategy", js(strategyDescription(format)))
  ]))
}

-- Parse a file from base64 data using AI multimodal extraction.
-- Browser-compatible: takes base64 directly (no FS), bridges to std/ai.
-- Accepts any MIME type (application/pdf, image/png, image/jpeg, etc.).
-- Returns JSON array of blocks (same format as browser_docx.parseDocxBody).
export func parseFileFromBase64(base64Data: string, mimeType: string, filename: string) -> string ! {AI} {
  if length(base64Data) == 0 then encode(ja([]))
  else {
    let request = encode(jo([
      kv("mode", js("multimodal")),
      kv("mimeType", js(mimeType)),
      kv("data", js(base64Data)),
      kv("fileName", js(filename)),
      kv("prompt", js(
        "Extract content from this file as a compact JSON array of blocks. For documents: use {\"type\":\"heading\",\"text\":\"...\",\"level\":N}, {\"type\":\"text\",\"text\":\"...\"}, {\"type\":\"table\",\"headers\":[...],\"rows\":[[...]]}, {\"type\":\"list\",\"items\":[...],\"ordered\":bool}. For images: describe what you see in detail using {\"type\":\"text\",\"text\":\"...\"} blocks. Include any visible text, objects, people, colors, layout, and context. Merge adjacent text into single blocks. Use compact JSON (no whitespace). Return ONLY the JSON array."
      ))
    ]));
    callJsonSimple(request)
  }
}

-- Backwards-compatible wrapper for PDF files.
export func parsePdfFromBase64(base64Data: string, filename: string) -> string ! {AI} =
  parseFileFromBase64(base64Data, "application/pdf", filename)

-- Describe a single embedded image using AI multimodal vision.
-- Browser equivalent of layout_ai.describeOneBlock — uses callJsonSimple
-- with multimodal JSON format so the AI handler sends inlineData (not raw base64 text).
-- Returns a one-sentence description string.
export func describeImageBase64(base64Data: string, mimeType: string) -> string ! {AI} {
  if length(base64Data) == 0 then ""
  else {
    let request = encode(jo([
      kv("mode", js("multimodal")),
      kv("mimeType", js(mimeType)),
      kv("data", js(base64Data)),
      kv("prompt", js(
        "Describe this image concisely in one or two sentences. Focus on the key content and any text visible. Return ONLY the description text, no JSON."
      ))
    ]));
    callJsonSimple(request)
  }
}

-- Convert block JSON (from any format binding) to A2UI component JSON.
-- Bridge: decodes JSON → Block ADT → A2UI nodes → JSON string.
-- Eliminates the duplicate JS blocksToA2UI() implementation.
export pure func convertBlocksToA2UI(blocksJson: string) -> string =
  a2uiConvert(blocksJson)
