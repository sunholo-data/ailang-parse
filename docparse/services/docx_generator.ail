module docparse/services/docx_generator

import std/string (length, intToStr, split, contains, startsWith)
import std/list (map, foldl, length as listLength)
import std/zip (createArchive, createArchiveWithBytes)
import std/bytes (fromString, toBase64)
import std/result (Ok, Err)
import docparse/types/document (mkList, InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, ParsedDocument, DocMetadata, countBlocks)
import docparse/services/xml_helpers (xmlEscape, xmlAttrEscape, xmlDecl, docxNs, docxRun, docxParagraph, docxStyledParagraph)

-- DOCX Generator — converts Block ADT to a valid .docx file.
--
-- Pattern: Build XML strings for each ZIP entry, then createArchive in one shot.
-- Uses createArchiveWithBytes when ImageBlocks have binary data to embed.
--
-- Generated DOCX structure:
--   [Content_Types].xml           - MIME registry
--   _rels/.rels                   - Root relationships
--   word/document.xml             - Main content (dynamic from blocks)
--   word/styles.xml               - Minimal style definitions
--   word/_rels/document.xml.rels  - Image relationships (when images present)
--   word/media/image1.ext ...     - Embedded images (binary, via createArchiveWithBytes)
--
-- Limitations:
--   - No headers/footers (could add as word/header1.xml if SectionBlocks present)
--   - Minimal styling (structural, not pixel-perfect)
--   - Image sizing is fixed (no aspect ratio detection from binary data)
--
-- Contract: non-empty blocks produce a valid DOCX

-- Which optional parts a given document needs. Threaded through the
-- [Content_Types].xml and document.xml.rels builders so every part that gets
-- written also gets declared and related — the P0 bug was styles.xml being
-- written and declared but never related, which makes it invisible to Word.
type DocxOptParts = {
  images: [DocxImage],
  links: [DocxLink],
  comments: [DocxComment],
  headers: [DocxHdrFtr],
  footers: [DocxHdrFtr],
  hasNumbering: bool
}

-- Generate a DOCX file from a ParsedDocument, writing to outputPath
-- Every OPC part of the document, as strings — the whole of DOCX generation
-- except the ZIP.
--
-- Exported because the packaging step is the ONLY part of this module that
-- needs a filesystem: std/zip.createArchive takes an output path and there is
-- no in-memory variant (ailang-core #644). A caller that can zip for itself —
-- the browser, via JS — needs the parts, not a file. generateDocx builds on
-- this rather than duplicating it, so the two can never drift.
--
-- Images are NOT included: they are binary and travel base64 through
-- createArchiveWithBytes. docxImageEntriesFor returns those separately.
export pure func docxPartsFor(doc: ParsedDocument) -> [{name: string, content: string}] {
  let plan = docxPlan(doc);
  docxTextParts(doc, plan.documentXml, plan.parts)
}

-- The binary half, base64-encoded, for callers assembling the archive
-- themselves. Empty when the document has no images.
export pure func docxImageEntriesFor(doc: ParsedDocument) -> [{name: string, data: string}] =
  docxImageEntries(docxPlan(doc).parts.images)

-- Shared setup for both the file and parts paths.
pure func docxPlan(doc: ParsedDocument) -> {documentXml: string, parts: DocxOptParts} {
  -- Headers and footers become real parts, so they leave the body block list.
  let sections = docxSplitSections(doc.blocks);
  let body = sections.body;

  let parts = {
    images: docxCollectImages(body, 1),
    links: docxCollectLinks(body, 1),
    comments: docxCollectComments(body, 1),
    headers: docxHdrFtrParts(sections.headers, "header", 1),
    footers: docxHdrFtrParts(sections.footers, "footer", 1),
    hasNumbering: docxHasList(body)
  };

  let bodyResult = docxBlocksToXml(body, {img: 1, link: 1, rev: 1, cmt: 1});
  let sectPr = docxSectPr(parts.headers, parts.footers);
  { documentXml: docxBuildDocument("${bodyResult.xml}${sectPr}"), parts: parts }
}

export func generateDocx(doc: ParsedDocument, outputPath: string) -> string ! {FS}
  ensures { length(result) > 0 }
{
  let plan = docxPlan(doc);
  let parts = plan.parts;
  let images = parts.images;

  let textParts = docxTextParts(doc, plan.documentXml, parts);
  let hasImages = listLength(images) > 0;

  if hasImages then {
    -- Mixed text+binary archive: everything goes through base64.
    let allEntries = docxAppendByteEntries(
      docxPartsToByteEntries(textParts),
      docxImageEntries(images)
    );
    match createArchiveWithBytes(outputPath, allEntries) {
      Ok(_) => "Generated DOCX: ${outputPath} (${intToStr(listLength(images))} images)",
      Err(e) => "Error generating DOCX: ${e}"
    }
  } else {
    -- No images: createArchive takes text directly, no base64 overhead.
    match createArchive(outputPath, textParts) {
      Ok(_) => "Generated DOCX: ${outputPath}",
      Err(e) => "Error generating DOCX: ${e}"
    }
  }
}

-- The full text-part list for a document. Single source of truth: both the
-- image and no-image archive paths derive their entries from this, so a part
-- can never be present on one path and missing on the other (which is how
-- document.xml.rels came to be image-path-only).
pure func docxTextParts(doc: ParsedDocument, documentXml: string, parts: DocxOptParts) -> [{name: string, content: string}] {
  let base = [
    {name: "[Content_Types].xml", content: docxContentTypes(parts)},
    {name: "_rels/.rels", content: docxRootRelsWithCore()},
    {name: "docProps/core.xml", content: docxCoreProps(doc.metadata)},
    {name: "word/document.xml", content: documentXml},
    {name: "word/styles.xml", content: docxMinimalStyles()},
    {name: "word/_rels/document.xml.rels", content: docxDocumentRels(parts)}
  ];
  let withNum = if parts.hasNumbering
    then docxAppendTextParts(base, [{name: "word/numbering.xml", content: docxNumbering()}])
    else base;
  let withComments = if listLength(parts.comments) > 0
    then docxAppendTextParts(withNum, [{name: "word/comments.xml", content: docxCommentsPart(parts.comments)}])
    else withNum;
  docxAppendTextParts(withComments,
    docxAppendTextParts(docxHdrFtrTextParts(parts.headers), docxHdrFtrTextParts(parts.footers)))
}

pure func docxAppendTextParts(a: [{name: string, content: string}], b: [{name: string, content: string}]) -> [{name: string, content: string}] =
  match a {
    [] => b,
    x :: rest => x :: docxAppendTextParts(rest, b)
  }

pure func docxPartsToByteEntries(parts: [{name: string, content: string}]) -> [{name: string, data: string}] =
  match parts {
    [] => [],
    p :: rest =>
      let entry = {name: p.name, data: docxTextToBase64(p.content)} in
      entry :: docxPartsToByteEntries(rest)
  }

-- Base64-encode a text string for createArchiveWithBytes
pure func docxTextToBase64(text: string) -> string =
  toBase64(fromString(text))

-- Build word/document.xml. The drawing namespaces are declared unconditionally:
-- unused namespace declarations are harmless, and making them conditional meant
-- the namespace set had to be kept in sync with a separate image check.
pure func docxBuildDocument(body: string) -> string
  ensures { length(result) > 0 }
{
  "${xmlDecl()}<w:document ${docxDocumentNsAttrs()}><w:body>${body}</w:body></w:document>"
}

pure func docxDocumentNsAttrs() -> string =
  "xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:wp=\"http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:pic=\"http://schemas.openxmlformats.org/drawingml/2006/picture\""

-- Section properties, last child of w:body. Carries the header/footer
-- references, so headers only take effect once this is emitted.
pure func docxSectPr(headers: [DocxHdrFtr], footers: [DocxHdrFtr]) -> string {
  let refs = "${docxHdrFtrRefs(headers, "header")}${docxHdrFtrRefs(footers, "footer")}";
  "<w:sectPr>${refs}<w:pgSz w:w=\"12240\" w:h=\"15840\"/><w:pgMar w:top=\"1440\" w:right=\"1440\" w:bottom=\"1440\" w:left=\"1440\" w:header=\"720\" w:footer=\"720\" w:gutter=\"0\"/></w:sectPr>"
}

pure func docxHdrFtrRefs(parts: [DocxHdrFtr], kind: string) -> string =
  match parts {
    [] => "",
    p :: rest =>
      "<w:${kind}Reference w:type=\"default\" r:id=\"${docxHdrFtrRelId(p)}\"/>${docxHdrFtrRefs(rest, kind)}"
  }

-- Simple, counter-free block rendering. Used for header/footer part bodies,
-- which are rendered standalone and so cannot own document-body rIds: an image
-- or link inside a header degrades to text rather than claiming an rId that the
-- body walk has already allocated.
pure func docxBlockToXml(block: Block) -> string =
  match block {
    HeadingBlock(h) =>
      if listLength(h.runs) > 0
      then docxParagraph("<w:pPr><w:pStyle w:val=\"Heading${intToStr(h.level)}\"/></w:pPr>${docxRunsToXml(h.runs)}")
      else docxStyledParagraph("Heading${intToStr(h.level)}", h.text),

    TextBlock(t) =>
      if t.style == "hr" then docxHorizontalRule()
      else if docxIsCodeStyle(t.style) then docxCodeBlock(t.text)
      else if listLength(t.runs) > 0
      then docxParagraph(docxRunsToXml(t.runs))
      else if length(t.text) > 0
      then docxParagraph(docxRun(t.text))
      else "",

    TableBlock(t) =>
      docxTableToXml(t.headers, t.rows),

    ListBlock(l) =>
      docxListToXml(l.items, l.ordered, l.itemRuns),

    ImageBlock(i) =>
      if length(i.description) > 0
      then docxParagraph(docxRun("[Image: ${i.description}]"))
      else docxParagraph(docxRun("[Image]")),

    AudioBlock(a) =>
      if length(a.transcription) > 0
      then docxParagraph(docxRun("[Audio: ${a.transcription}]"))
      else docxParagraph(docxRun("[Audio]")),

    VideoBlock(v) =>
      if length(v.description) > 0
      then docxParagraph(docxRun("[Video: ${v.description}]"))
      else docxParagraph(docxRun("[Video]")),

    SectionBlock(s) =>
      docxSectionToXml(s.kind, s.blocks),

    ChangeBlock(c) =>
      docxChangeToXml(c.changeType, c.author, c.date, c.text),

    LinkBlock(l) =>
      docxParagraph(docxRun("${l.text} (${l.href})")),

    CommentBlock(c) =>
      docxParagraph(docxRun(commentText(c.author, c.text, c.anchorText, c.anchored)))
  }

-- === Character formatting (P2 phase 4) ===================================

-- A fenced code block. Word has no code block, so each source line becomes its
-- own monospaced paragraph — which preserves the line structure that a single
-- paragraph with embedded newlines would lose.
pure func docxIsCodeStyle(style: string) -> bool =
  style == "code" || startsWith(style, "code:")

pure func docxCodeBlock(text: string) -> string =
  foldl(\acc line. "${acc}${docxParagraph(docxMonoRun(line))}", "", split(text, "\n"))

pure func docxMonoRun(text: string) -> string =
  "<w:r><w:rPr><w:rFonts w:ascii=\"Consolas\" w:hAnsi=\"Consolas\"/></w:rPr><w:t xml:space=\"preserve\">${xmlEscape(text)}</w:t></w:r>"

-- A thematic break. Word has no <hr> element — the idiom is an empty paragraph
-- carrying a bottom border, which is what Word itself writes for one.
pure func docxHorizontalRule() -> string =
  docxParagraph("<w:pPr><w:pBdr><w:bottom w:val=\"single\" w:sz=\"6\" w:space=\"1\" w:color=\"auto\"/></w:pBdr></w:pPr>")

pure func docxRunsToXml(runs: [InlineRun]) -> string =
  foldl(\acc r. "${acc}${docxRunMaybeLinked(r)}", "", runs)

-- A run carrying an href becomes a real clickable link.
--
-- Uses w:fldSimple with a HYPERLINK instruction rather than w:hyperlink + r:id:
-- the field form embeds the target inline, so it needs no relationship entry
-- and no id bookkeeping threaded through the block walk. Word, LibreOffice and
-- Pages all render it, and docx_parser reads w:fldSimple back, so it
-- round-trips.
--
-- Without this, HTML→DOCX put the literal Markdown "[text](url)" into Word:
-- the URL only ever lived in the marker text, and runs had nowhere to keep it.
pure func docxRunMaybeLinked(r: InlineRun) -> string =
  if length(r.href) > 0
  then "<w:fldSimple w:instr=\" HYPERLINK &quot;${xmlAttrEscape(r.href)}&quot; \">${docxLinkedRun(r)}</w:fldSimple>"
  else docxFormattedRun(r)

-- Same run, plus the Hyperlink character style so it looks like a link.
pure func docxLinkedRun(r: InlineRun) -> string =
  "<w:r><w:rPr><w:rStyle w:val=\"Hyperlink\"/>${docxRunPropsInner(r)}</w:rPr><w:t xml:space=\"preserve\">${xmlEscape(r.text)}</w:t></w:r>"

pure func docxFormattedRun(r: InlineRun) -> string =
  "<w:r>${docxRunProps(r)}<w:t xml:space=\"preserve\">${xmlEscape(r.text)}</w:t></w:r>"

-- Child order matters: CT_RPr is a sequence in the schema, not a choice, and
-- rFonts/b/i/strike/u/vertAlign must appear in that order. Emitting w:u before
-- w:strike produces a document Word may reject or silently repair.
pure func docxRunProps(r: InlineRun) -> string {
  -- DOCX has no "code" run property; a monospace font is its honest equivalent.
  let fonts = if r.code then "<w:rFonts w:ascii=\"Consolas\" w:hAnsi=\"Consolas\"/>" else "";
  let bold = if r.bold then "<w:b/>" else "";
  let italic = if r.italic then "<w:i/>" else "";
  let strike = if r.strike then "<w:strike/>" else "";
  let under = if r.underline then "<w:u w:val=\"single\"/>" else "";
  let vert = if length(r.vertAlign) > 0
    then "<w:vertAlign w:val=\"${xmlAttrEscape(r.vertAlign)}\"/>"
    else "";
  let inner = docxRunPropsInner(r);
  if length(inner) > 0 then "<w:rPr>${inner}</w:rPr>" else ""
}

-- The rPr children alone, so a linked run can prepend w:rStyle to them.
pure func docxRunPropsInner(r: InlineRun) -> string {
  let fonts = if r.code then "<w:rFonts w:ascii=\"Consolas\" w:hAnsi=\"Consolas\"/>" else "";
  let bold = if r.bold then "<w:b/>" else "";
  let italic = if r.italic then "<w:i/>" else "";
  let strike = if r.strike then "<w:strike/>" else "";
  let under = if r.underline then "<w:u w:val=\"single\"/>" else "";
  let vert = if length(r.vertAlign) > 0
    then "<w:vertAlign w:val=\"${xmlAttrEscape(r.vertAlign)}\"/>"
    else "";
  "${fonts}${bold}${italic}${strike}${under}${vert}"
}

-- Counters threaded through the body walk. Images and links each need a
-- relationship id, comments need an id shared with word/comments.xml, and
-- revisions need a document-unique w:id. Collect* functions below walk the same
-- blocks in the same order, so the ids they assign line up with these.
type DocxIdx = { img: int, link: int, rev: int, cmt: int }

type DocxBlockResult = { xml: string, idx: DocxIdx }

pure func docxBlocksToXml(blocks: [Block], idx: DocxIdx) -> DocxBlockResult =
  match blocks {
    [] => {xml: "", idx: idx},
    block :: rest =>
      let r = docxBlockToXmlIndexed(block, idx) in
      let restR = docxBlocksToXml(rest, r.idx) in
      {xml: "${r.xml}${restR.xml}", idx: restR.idx}
  }

pure func docxBlockToXmlIndexed(block: Block, idx: DocxIdx) -> DocxBlockResult =
  match block {
    -- Predicate MUST match docxCollectImages exactly: this walk assigns the
    -- rIds that the collector's relationship entries have to line up with, so
    -- any divergence points a <w:drawing> at the wrong image (or a missing one).
    ImageBlock(i) =>
      if docxIsBinaryPayload(i.data, i.mime)
      then {
        xml: docxInlineImage(idx.img, i.description),
        idx: {img: idx.img + 1, link: idx.link, rev: idx.rev, cmt: idx.cmt}
      }
      else {xml: docxBlockToXml(block), idx: idx},

    LinkBlock(l) =>
      if length(l.href) > 0
      then {
        xml: docxHyperlinkPara(idx.link, l.text, l.title),
        idx: {img: idx.img, link: idx.link + 1, rev: idx.rev, cmt: idx.cmt}
      }
      else {xml: docxBlockToXml(block), idx: idx},

    ChangeBlock(c) => {
      xml: docxRevisionPara(idx.rev, c.changeType, c.author, c.date, c.text),
      idx: {img: idx.img, link: idx.link, rev: idx.rev + 1, cmt: idx.cmt}
    },

    CommentBlock(c) => {
      xml: docxCommentAnchorPara(idx.cmt, c.anchorText, c.anchored),
      idx: {img: idx.img, link: idx.link, rev: idx.rev, cmt: idx.cmt + 1}
    },

    SectionBlock(s) =>
      let r = docxBlocksToXml(s.blocks, idx) in
      let label = docxSectionLabel(s.kind) in
      let labelXml = if length(label) > 0 then docxStyledParagraph("Heading3", label) else "" in
      {xml: "${labelXml}${r.xml}", idx: r.idx},

    _ => {xml: docxBlockToXml(block), idx: idx}
  }


-- Section label helper (extracted for reuse)
pure func docxSectionLabel(kind: string) -> string =
  if kind == "slide" then "--- Slide ---"
  else if kind == "sheet" then "--- Sheet ---"
  else if kind == "header" then "Header:"
  else if kind == "footer" then "Footer:"
  else if kind == "footnote" then "Footnote:"
  else if kind == "endnote" then "Endnote:"
  else if kind == "textbox" then "Text Box:"
  else ""

-- Build OOXML <w:drawing> for an inline image
-- rId references word/_rels/document.xml.rels entry
pure func docxInlineImage(imgIdx: int, description: string) -> string {
  let rId = "rId${intToStr(imgIdx)}";
  let idStr = intToStr(imgIdx);
  let desc = xmlEscape(description);
  -- Default size: 6 inches wide × 4 inches tall (in EMUs: 1 inch = 914400 EMU)
  let cx = "5486400";
  let cy = "3657600";
  docxParagraph(
    "<w:r><w:drawing><wp:inline distT=\"0\" distB=\"0\" distL=\"0\" distR=\"0\"><wp:extent cx=\"${cx}\" cy=\"${cy}\"/><wp:docPr id=\"${idStr}\" name=\"Image ${idStr}\" descr=\"${desc}\"/><a:graphic><a:graphicData uri=\"http://schemas.openxmlformats.org/drawingml/2006/picture\"><pic:pic><pic:nvPicPr><pic:cNvPr id=\"${idStr}\" name=\"Image ${idStr}\"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed=\"${rId}\"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x=\"0\" y=\"0\"/><a:ext cx=\"${cx}\" cy=\"${cy}\"/></a:xfrm><a:prstGeom prst=\"rect\"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r>"
  )
}

-- Build a DOCX table: <w:tbl> with <w:tr>/<w:tc>
-- Usable width of a US Letter page with 1" margins, in twips. Word auto-fits a
-- table with no explicit widths, but that is Word being forgiving: ECMA-376
-- §17.4.49 makes w:tblGrid part of the table's definition, and a reader that
-- follows the spec (Pages, for one) collapses every column to its minimum —
-- one character per line.
pure func docxContentWidthTwips() -> int = 9360

pure func docxTableToXml(headers: [TableCell], rows: [[TableCell]]) -> string {
  let cols = docxTableColCount(headers, rows);
  let colW = if cols > 0 then docxContentWidthTwips() / cols else docxContentWidthTwips();
  let tblPr = "<w:tblPr><w:tblBorders><w:top w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:left w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:bottom w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:right w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:insideH w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:insideV w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/></w:tblBorders><w:tblW w:w=\"${intToStr(docxContentWidthTwips())}\" w:type=\"dxa\"/><w:tblLayout w:type=\"fixed\"/></w:tblPr>";
  let grid = "<w:tblGrid>${docxGridCols(cols, colW)}</w:tblGrid>";
  let headerRow = if listLength(headers) > 0
    then "<w:tr>${docxHeaderCellsToXml(headers, colW)}</w:tr>"
    else "";
  let dataRows = foldl(\acc row. "${acc}<w:tr>${docxDataCellsToXml(row, colW)}</w:tr>", "", rows);
  "<w:tbl>${tblPr}${grid}${headerRow}${dataRows}</w:tbl>"
}

-- Widest row wins, counting a spanned cell as the columns it covers.
pure func docxTableColCount(headers: [TableCell], rows: [[TableCell]]) -> int =
  foldl(\acc row. { let n = docxRowSpanWidth(row) in if n > acc then n else acc },
        docxRowSpanWidth(headers), rows)

-- A row's true grid width. Cells that a preceding gridSpan already covers
-- occupy no grid position of their own — counting them made a 4-column table
-- declare a 7-column grid, because "Total {colspan=4}" plus its three merged
-- continuations was summed as 4+1+1+1.
pure func docxRowSpanWidth(cells: [TableCell]) -> int =
  docxRowWidthWalk(cells, 0, 0)

pure func docxRowWidthWalk(cells: [TableCell], cover: int, acc: int) -> int =
  match cells {
    [] => acc,
    c :: rest =>
      if c.merged && cover > 0
      then docxRowWidthWalk(rest, cover - 1, acc)
      else docxRowWidthWalk(rest, docxCoverAfter(c), acc + docxCellSpan(c))
  }

pure func docxCellSpan(c: TableCell) -> int = if c.colSpan > 1 then c.colSpan else 1

-- Grid positions a cell claims beyond the one it sits in.
pure func docxCoverAfter(c: TableCell) -> int = docxCellSpan(c) - 1

pure func docxGridCols(n: int, w: int) -> string =
  if n <= 0 then ""
  else "<w:gridCol w:w=\"${intToStr(w)}\"/>${docxGridCols(n - 1, w)}"

-- Header cells as bold <w:tc>
-- Emit cells left to right, skipping any merged cell that a preceding
-- gridSpan already covers.
--
-- `merged` means "this position is a continuation", and until now every one of
-- them became a <w:vMerge> tc — a VERTICAL merge. For the horizontal case that
-- is doubly wrong: the position is already occupied by the span, so the extra
-- tc pushes the row past the declared grid, and it claims continuation from a
-- row above that has no cell at that offset. python-docx refuses to read such
-- a row; Word offers to repair the file. vMerge is correct only when nothing
-- in this row covers the position.
pure func docxHeaderCellsToXml(cells: [TableCell], colW: int) -> string =
  docxHeaderCellsWalk(cells, colW, 0, "")

pure func docxHeaderCellsWalk(cells: [TableCell], colW: int, cover: int, acc: string) -> string =
  match cells {
    [] => acc,
    c :: rest =>
      if c.merged && cover > 0
      then docxHeaderCellsWalk(rest, colW, cover - 1, acc)
      else docxHeaderCellsWalk(rest, colW, docxCoverAfter(c),
                               "${acc}${docxHeaderCellToXml(c, colW)}")
  }

pure func docxHeaderCellToXml(cell: TableCell, colW: int) -> string {
  if cell.merged then "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW)}\" w:type=\"dxa\"/><w:vMerge/></w:tcPr><w:p/></w:tc>"
  else {
    let spanPr = if cell.colSpan > 1
      then "<w:gridSpan w:val=\"${intToStr(cell.colSpan)}\"/>"
      else "";
    "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW * (if cell.colSpan > 1 then cell.colSpan else 1))}\" w:type=\"dxa\"/>${spanPr}</w:tcPr><w:p><w:pPr><w:jc w:val=\"center\"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space=\"preserve\">${xmlEscape(cell.text)}</w:t></w:r></w:p></w:tc>"
  }
}

-- Data cells as normal <w:tc>, with the same horizontal-continuation skip.
pure func docxDataCellsToXml(cells: [TableCell], colW: int) -> string =
  docxDataCellsWalk(cells, colW, 0, "")

pure func docxDataCellsWalk(cells: [TableCell], colW: int, cover: int, acc: string) -> string =
  match cells {
    [] => acc,
    c :: rest =>
      if c.merged && cover > 0
      then docxDataCellsWalk(rest, colW, cover - 1, acc)
      else docxDataCellsWalk(rest, colW, docxCoverAfter(c),
                             "${acc}${docxDataCellToXml(c, colW)}")
  }

pure func docxDataCellToXml(cell: TableCell, colW: int) -> string {
  if cell.merged then "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW)}\" w:type=\"dxa\"/><w:vMerge/></w:tcPr><w:p/></w:tc>"
  else {
    let spanPr = if cell.colSpan > 1
      then "<w:gridSpan w:val=\"${intToStr(cell.colSpan)}\"/>"
      else "";
    "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW * (if cell.colSpan > 1 then cell.colSpan else 1))}\" w:type=\"dxa\"/>${spanPr}</w:tcPr>${docxParagraph(docxRun(cell.text))}</w:tc>"
  }
}

-- Lists as real Word list paragraphs referencing word/numbering.xml
-- (numId 1 = bullet, 2 = decimal).
pure func docxListToXml(items: [string], ordered: bool, itemRuns: [[InlineRun]]) -> string =
  docxListItemsToXml(items, itemRuns, if ordered then 2 else 1)

-- itemRuns is parallel to items but may be empty entirely (nothing formatted).
-- Both lists are walked together so a short or absent itemRuns simply falls
-- back to plain text per item rather than mis-pairing formatting with the
-- wrong item.
pure func docxListItemsToXml(items: [string], itemRuns: [[InlineRun]], numId: int) -> string =
  match items {
    [] => "",
    item :: rest =>
      let pPr = "<w:pPr><w:pStyle w:val=\"ListParagraph\"/><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"${intToStr(numId)}\"/></w:numPr></w:pPr>" in
      match itemRuns {
        [] =>
          "${docxParagraph("${pPr}${docxRun(item)}")}${docxListItemsToXml(rest, [], numId)}",
        r :: rrest =>
          let body = if listLength(r) > 0 then docxRunsToXml(r) else docxRun(item) in
          "${docxParagraph("${pPr}${body}")}${docxListItemsToXml(rest, rrest, numId)}"
      }
  }

-- Section blocks: render child blocks with a section label
pure func docxSectionToXml(kind: string, blocks: [Block]) -> string {
  let label = if kind == "slide" then "--- Slide ---"
    else if kind == "sheet" then "--- Sheet ---"
    else if kind == "header" then "Header:"
    else if kind == "footer" then "Footer:"
    else if kind == "footnote" then "Footnote:"
    else if kind == "endnote" then "Endnote:"
    else if kind == "textbox" then "Text Box:"
    else "";
  let labelXml = if length(label) > 0
    then docxStyledParagraph("Heading3", label)
    else "";
  "${labelXml}${foldl(\acc b. "${acc}${docxBlockToXml(b)}", "", blocks)}"
}

-- Track changes as styled paragraphs
-- Full revision markup (<w:ins>/<w:del>) would need revision IDs (deferred).
-- For now, render as styled text with attribution.
pure func docxChangeToXml(changeType: string, author: string, date: string, text: string) -> string {
  let attribution = " (${changeType} by ${author}, ${date})";
  if changeType == "delete" || changeType == "move-from"
  then docxParagraph(
    "<w:r><w:rPr><w:strike/></w:rPr><w:t xml:space=\"preserve\">${xmlEscape(text)}</w:t></w:r>${docxRun(attribution)}"
  )
  else docxParagraph(
    "<w:r><w:rPr><w:b/><w:u w:val=\"single\"/></w:rPr><w:t xml:space=\"preserve\">${xmlEscape(text)}</w:t></w:r>${docxRun(attribution)}"
  )
}

-- [Content_Types].xml with styles + image extensions
-- [Content_Types].xml. Every part written by docxTextParts must have an Override
-- here (or a Default for its extension) or Word rejects the package.
pure func docxContentTypes(parts: DocxOptParts) -> string {
  let wordNs = "application/vnd.openxmlformats-officedocument.wordprocessingml";
  let overrides = "${docxOverride("/word/document.xml", "${wordNs}.document.main+xml")}${docxOverride("/word/styles.xml", "${wordNs}.styles+xml")}${docxOverride("/docProps/core.xml", "application/vnd.openxmlformats-package.core-properties+xml")}";
  let numOverride = if parts.hasNumbering
    then docxOverride("/word/numbering.xml", "${wordNs}.numbering+xml")
    else "";
  let cmtOverride = if listLength(parts.comments) > 0
    then docxOverride("/word/comments.xml", "${wordNs}.comments+xml")
    else "";
  let hdrOverrides = docxHdrFtrOverrides(parts.headers, "${wordNs}.header+xml");
  let ftrOverrides = docxHdrFtrOverrides(parts.footers, "${wordNs}.footer+xml");
  "${xmlDecl()}<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/>${docxImageContentTypeDefaults(parts.images)}${overrides}${numOverride}${cmtOverride}${hdrOverrides}${ftrOverrides}</Types>"
}

pure func docxOverride(partName: string, contentType: string) -> string =
  "<Override PartName=\"${partName}\" ContentType=\"${contentType}\"/>"

pure func docxHdrFtrOverrides(parts: [DocxHdrFtr], contentType: string) -> string =
  match parts {
    [] => "",
    p :: rest =>
      "${docxOverride("/word/${docxHdrFtrPartName(p)}", contentType)}${docxHdrFtrOverrides(rest, contentType)}"
  }

-- Build <Default> entries for image MIME types found in the document
pure func docxImageContentTypeDefaults(images: [DocxImage]) -> string =
  docxUniqueExtDefaults(images, "")

pure func docxUniqueExtDefaults(images: [DocxImage], seen: string) -> string =
  match images {
    [] => "",
    img :: rest =>
      let ext = img.ext in
      -- Simple dedup: check if extension already in seen string
      if docxContainsExt(seen, ext)
      then docxUniqueExtDefaults(rest, seen)
      else "<Default Extension=\"${ext}\" ContentType=\"${img.mime}\"/>${docxUniqueExtDefaults(rest, "${seen},${ext}")}"
  }

pure func docxContainsExt(seen: string, ext: string) -> bool {
  let parts = split(seen, ",");
  docxExtInList(parts, ext)
}

pure func docxExtInList(parts: [string], ext: string) -> bool =
  match parts {
    [] => false,
    p :: rest => if p == ext then true else docxExtInList(rest, ext)
  }

-- Minimal styles.xml with heading styles.
-- Normal carries w:default="1": without it the part has no default paragraph
-- style, and consumers report no style at all for unstyled paragraphs
-- (python-docx returns None for paragraph.style).
pure func docxMinimalStyles() -> string {
  let normal = "<w:style w:type=\"paragraph\" w:default=\"1\" w:styleId=\"Normal\"><w:name w:val=\"Normal\"/></w:style>";
  -- ListParagraph is referenced by every w:numPr paragraph, Hyperlink by every
  -- w:hyperlink run. A missing style definition here is the same class of bug as
  -- the orphaned styles.xml: the reference resolves to nothing.
  let listPara = "<w:style w:type=\"paragraph\" w:styleId=\"ListParagraph\"><w:name w:val=\"List Paragraph\"/><w:pPr><w:ind w:left=\"720\"/><w:contextualSpacing/></w:pPr></w:style>";
  let hyperlink = "<w:style w:type=\"character\" w:styleId=\"Hyperlink\"><w:name w:val=\"Hyperlink\"/><w:rPr><w:color w:val=\"0563C1\"/><w:u w:val=\"single\"/></w:rPr></w:style>";
  "${xmlDecl()}<w:styles xmlns:w=\"${docxNs()}\">${normal}${listPara}${hyperlink}${docxHeadingStyle(1, "28")}${docxHeadingStyle(2, "24")}${docxHeadingStyle(3, "20")}${docxHeadingStyle(4, "18")}${docxHeadingStyle(5, "16")}${docxHeadingStyle(6, "14")}</w:styles>"
}

-- Build a heading style definition
pure func docxHeadingStyle(level: int, fontSize: string) -> string =
  "<w:style w:type=\"paragraph\" w:styleId=\"Heading${intToStr(level)}\"><w:name w:val=\"heading ${intToStr(level)}\"/><w:pPr><w:spacing w:before=\"240\" w:after=\"120\"/></w:pPr><w:rPr><w:b/><w:sz w:val=\"${fontSize}\"/></w:rPr></w:style>"

-- ============================================================
-- Image embedding support (M3: createArchiveWithBytes)
-- ============================================================

-- Collected image info
type DocxImage = { idx: int, data: string, mime: string, ext: string }

-- Collect all ImageBlocks with binary data from blocks
pure func docxCollectImages(blocks: [Block], startIdx: int) -> [DocxImage] =
  match blocks {
    [] => [],
    ImageBlock(i) :: rest =>
      if docxIsBinaryPayload(i.data, i.mime)
      then
        let img = {idx: startIdx, data: i.data, mime: i.mime, ext: docxMimeToExt(i.mime)} in
        img :: docxCollectImages(rest, startIdx + 1)
      else docxCollectImages(rest, startIdx),
    SectionBlock(s) :: rest =>
      let inner = docxCollectImages(s.blocks, startIdx) in
      let nextIdx = startIdx + listLength(inner) in
      docxAppendImageList(inner, docxCollectImages(rest, nextIdx)),
    _ :: rest => docxCollectImages(rest, startIdx)
  }

-- Whether an ImageBlock's payload can be embedded as a binary part.
--
-- ImageBlock.data is overloaded across parsers. DOCX/PPTX put base64 bytes in
-- it, but html_parser stores the <img src> URL (html_parser.ail:378) and
-- odt_parser stores the package href (odt_parser.ail:247). Embedding on
-- `length(data) > 0 && length(mime) > 0` therefore fed "hero-small.png" and
-- "Pictures/10000...svg" to the base64 decoder, and the archive writer failed
-- the ENTIRE document with "invalid base64: illegal base64 data at input byte
-- N" — every HTML file with an <img>, and two ODTs, could not be converted to
-- DOCX at all.
--
-- Mime alone cannot discriminate: odt_parser guesses a real mime
-- ("image/svg+xml") from the href's extension, so the reference looks
-- embeddable by every metadata check. The payload itself is the only reliable
-- signal, so require both a mime we can name an extension for and a payload
-- that is not obviously a path or URL.
--
-- References fall back to the "[Image: description]" text placeholder, which is
-- what external images already got.
pure func docxIsEmbeddableMime(mime: string) -> bool =
  mime == "image/png" || mime == "image/jpeg" || mime == "image/gif"
  || mime == "image/bmp" || mime == "image/tiff" || mime == "image/svg+xml"

-- "." " " and ":" are outside both the standard and URL-safe base64 alphabets,
-- and are near-universal in paths and URLs ("hero-small.png",
-- "Pictures/x.svg", "data:image/png;base64,..."). Checked with `contains`
-- builtins rather than a per-character scan, which would walk multi-megabyte
-- payloads in the interpreter.
pure func docxIsBinaryPayload(data: string, mime: string) -> bool {
  if length(data) == 0 then false
  else if docxIsEmbeddableMime(mime) == false then false
  else if contains(data, ".") then false
  else if contains(data, " ") then false
  else if contains(data, ":") then false
  else true
}

-- MIME type to file extension
pure func docxMimeToExt(mime: string) -> string =
  if mime == "image/png" then "png"
  else if mime == "image/jpeg" then "jpeg"
  else if mime == "image/gif" then "gif"
  else if mime == "image/bmp" then "bmp"
  else if mime == "image/tiff" then "tiff"
  else if mime == "image/svg+xml" then "svg"
  else "png"

-- Build word/_rels/document.xml.rels: the styles relationship, plus one per image.
--
-- The styles relationship is NOT optional and must be present even when the
-- document has no images. OPC resolves parts through the relationship graph, so
-- declaring word/styles.xml in [Content_Types].xml is not enough — without a
-- relationship pointing at it the part is unreachable, every
-- <w:pStyle w:val="HeadingN"/> resolves to nothing, and all headings silently
-- render as body text. LibreOffice and python-docx both drop them; pandoc only
-- appeared to work because it pattern-matches the styleId heuristically instead
-- of resolving the part, which is why this went unnoticed.
--
-- Image rIds are allocated from 1 (docxCollectImages(blocks, 1)), so the styles
-- relationship uses a non-numeric id to stay clear of them.
pure func docxDocumentRels(parts: DocxOptParts) -> string {
  let ofcNs = "http://schemas.openxmlformats.org/officeDocument/2006/relationships";
  let stylesRel = docxRel(docxStylesRelId(), "${ofcNs}/styles", "styles.xml");
  let numRel = if parts.hasNumbering
    then docxRel("rIdNumbering", "${ofcNs}/numbering", "numbering.xml")
    else "";
  let cmtRel = if listLength(parts.comments) > 0
    then docxRel("rIdComments", "${ofcNs}/comments", "comments.xml")
    else "";
  let hdrRels = docxHdrFtrRels(parts.headers, "${ofcNs}/header");
  let ftrRels = docxHdrFtrRels(parts.footers, "${ofcNs}/footer");
  let linkRels = docxLinkRels(parts.links, "${ofcNs}/hyperlink");
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">${stylesRel}${numRel}${cmtRel}${hdrRels}${ftrRels}${linkRels}${docxImageRelsEntries(parts.images)}</Relationships>"
}

pure func docxRel(id: string, relType: string, target: string) -> string =
  "<Relationship Id=\"${id}\" Type=\"${relType}\" Target=\"${target}\"/>"

pure func docxHdrFtrRels(parts: [DocxHdrFtr], relType: string) -> string =
  match parts {
    [] => "",
    p :: rest =>
      "${docxRel(docxHdrFtrRelId(p), relType, docxHdrFtrPartName(p))}${docxHdrFtrRels(rest, relType)}"
  }

-- Hyperlink targets are external URLs, so they need TargetMode="External".
-- Without it Word treats the href as a package-relative part path and the link
-- silently does nothing.
pure func docxLinkRels(links: [DocxLink], relType: string) -> string =
  match links {
    [] => "",
    l :: rest =>
      "<Relationship Id=\"${docxLinkRelId(l.idx)}\" Type=\"${relType}\" Target=\"${xmlAttrEscape(l.href)}\" TargetMode=\"External\"/>${docxLinkRels(rest, relType)}"
  }

pure func docxLinkRelId(idx: int) -> string = "rIdLink${intToStr(idx)}"

-- Relationship id for word/styles.xml. Non-numeric so it cannot collide with the
-- image rIds, which count up from rId1.
pure func docxStylesRelId() -> string = "rIdStyles"

pure func docxImageRelsEntries(images: [DocxImage]) -> string =
  match images {
    [] => "",
    img :: rest =>
      "<Relationship Id=\"rId${intToStr(img.idx)}\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/image\" Target=\"media/image${intToStr(img.idx)}.${img.ext}\"/>${docxImageRelsEntries(rest)}"
  }

-- Build binary archive entries for images
pure func docxImageEntries(images: [DocxImage]) -> [{name: string, data: string}] =
  match images {
    [] => [],
    img :: rest =>
      let entry = {name: "word/media/image${intToStr(img.idx)}.${img.ext}", data: img.data} in
      entry :: docxImageEntries(rest)
  }

-- List append helpers
pure func docxAppendByteEntries(a: [{name: string, data: string}], b: [{name: string, data: string}]) -> [{name: string, data: string}] =
  match a {
    [] => b,
    x :: rest => x :: docxAppendByteEntries(rest, b)
  }

pure func docxAppendImageList(a: [DocxImage], b: [DocxImage]) -> [DocxImage] =
  match a {
    [] => b,
    x :: rest => x :: docxAppendImageList(rest, b)
  }

-- ============================================================
-- docProps/core.xml — document metadata (P1 item 5)
-- ============================================================

-- The package-level rels must point at docProps/core.xml, otherwise the part is
-- orphaned exactly the way styles.xml was. Local to this module rather than a
-- change to xml_helpers.docxRootRels, which pptx/xlsx also use.
pure func docxRootRelsWithCore() -> string {
  let docRel = docxRel("rId1", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument", "word/document.xml");
  let coreRel = docxRel("rIdCore", "http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties", "docProps/core.xml");
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">${docRel}${coreRel}</Relationships>"
}

pure func docxCoreProps(meta: DocMetadata) -> string {
  let title = if length(meta.title) > 0 then "<dc:title>${xmlEscape(meta.title)}</dc:title>" else "";
  let creator = if length(meta.author) > 0 then "<dc:creator>${xmlEscape(meta.author)}</dc:creator>" else "";
  let modBy = if length(meta.author) > 0 then "<cp:lastModifiedBy>${xmlEscape(meta.author)}</cp:lastModifiedBy>" else "";
  let created = docxDctermsDate("created", meta.created);
  let modified = docxDctermsDate("modified", meta.modified);
  "${xmlDecl()}<cp:coreProperties xmlns:cp=\"http://schemas.openxmlformats.org/package/2006/metadata/core-properties\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\">${title}${creator}${modBy}${created}${modified}</cp:coreProperties>"
}

-- dcterms dates are xsi:type="dcterms:W3CDTF" and Word refuses to open a package
-- whose dates don't parse. Metadata reaching us from non-Office sources is
-- free-form, so emit the element only when the value already looks like W3CDTF
-- rather than risking an unopenable file for the sake of a date.
pure func docxDctermsDate(field: string, value: string) -> string =
  if docxIsW3CDTF(value)
  then "<dcterms:${field} xsi:type=\"dcterms:W3CDTF\">${xmlEscape(value)}</dcterms:${field}>"
  else ""

pure func docxIsW3CDTF(value: string) -> bool =
  length(value) >= 19 && contains(value, "-") && contains(value, "T") && contains(value, ":")

-- ============================================================
-- word/numbering.xml — real Word lists (P1 item 4)
-- ============================================================

-- Two abstract definitions, one instance each: numId 1 bullets, numId 2 decimal.
-- Single level only — mkList([string], bool) is flat, so
-- there is no nesting to represent. Nested lists need an ADT change.
pure func docxNumbering() -> string {
  let bulletLvl = "<w:lvl w:ilvl=\"0\"><w:start w:val=\"1\"/><w:numFmt w:val=\"bullet\"/><w:lvlText w:val=\"•\"/><w:lvlJc w:val=\"left\"/><w:pPr><w:ind w:left=\"720\" w:hanging=\"360\"/></w:pPr><w:rPr><w:rFonts w:ascii=\"Symbol\" w:hAnsi=\"Symbol\" w:hint=\"default\"/></w:rPr></w:lvl>";
  let decimalLvl = "<w:lvl w:ilvl=\"0\"><w:start w:val=\"1\"/><w:numFmt w:val=\"decimal\"/><w:lvlText w:val=\"%1.\"/><w:lvlJc w:val=\"left\"/><w:pPr><w:ind w:left=\"720\" w:hanging=\"360\"/></w:pPr></w:lvl>";
  "${xmlDecl()}<w:numbering xmlns:w=\"${docxNs()}\"><w:abstractNum w:abstractNumId=\"0\"><w:multiLevelType w:val=\"hybridMultilevel\"/>${bulletLvl}</w:abstractNum><w:abstractNum w:abstractNumId=\"1\"><w:multiLevelType w:val=\"hybridMultilevel\"/>${decimalLvl}</w:abstractNum><w:num w:numId=\"1\"><w:abstractNumId w:val=\"0\"/></w:num><w:num w:numId=\"2\"><w:abstractNumId w:val=\"1\"/></w:num></w:numbering>"
}

pure func docxHasList(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    ListBlock(_) :: _ => true,
    SectionBlock(s) :: rest => docxHasList(s.blocks) || docxHasList(rest),
    _ :: rest => docxHasList(rest)
  }

-- ============================================================
-- Hyperlinks (P1 item 6)
-- ============================================================

type DocxLink = { idx: int, href: string }

pure func docxCollectLinks(blocks: [Block], startIdx: int) -> [DocxLink] =
  match blocks {
    [] => [],
    LinkBlock(l) :: rest =>
      if length(l.href) > 0
      then
        let link = {idx: startIdx, href: l.href} in
        link :: docxCollectLinks(rest, startIdx + 1)
      else docxCollectLinks(rest, startIdx),
    SectionBlock(s) :: rest =>
      let inner = docxCollectLinks(s.blocks, startIdx) in
      docxAppendLinkList(inner, docxCollectLinks(rest, startIdx + listLength(inner))),
    _ :: rest => docxCollectLinks(rest, startIdx)
  }

pure func docxAppendLinkList(a: [DocxLink], b: [DocxLink]) -> [DocxLink] =
  match a {
    [] => b,
    x :: rest => x :: docxAppendLinkList(rest, b)
  }

pure func docxHyperlinkPara(idx: int, text: string, title: string) -> string {
  let tooltip = if length(title) > 0 then " w:tooltip=\"${xmlAttrEscape(title)}\"" else "";
  let run = "<w:r><w:rPr><w:rStyle w:val=\"Hyperlink\"/></w:rPr><w:t xml:space=\"preserve\">${xmlEscape(text)}</w:t></w:r>";
  docxParagraph("<w:hyperlink r:id=\"${docxLinkRelId(idx)}\"${tooltip}>${run}</w:hyperlink>")
}

-- ============================================================
-- Track changes and comments (P1 item 7)
-- ============================================================

type DocxComment = { id: int, author: string, date: string, text: string }

pure func docxCollectComments(blocks: [Block], startId: int) -> [DocxComment] =
  match blocks {
    [] => [],
    CommentBlock(c) :: rest =>
      let cmt = {id: startId, author: c.author, date: c.date, text: c.text} in
      cmt :: docxCollectComments(rest, startId + 1),
    SectionBlock(s) :: rest =>
      let inner = docxCollectComments(s.blocks, startId) in
      docxAppendCommentList(inner, docxCollectComments(rest, startId + listLength(inner))),
    _ :: rest => docxCollectComments(rest, startId)
  }

pure func docxAppendCommentList(a: [DocxComment], b: [DocxComment]) -> [DocxComment] =
  match a {
    [] => b,
    x :: rest => x :: docxAppendCommentList(rest, b)
  }

pure func docxCommentsPart(comments: [DocxComment]) -> string =
  "${xmlDecl()}<w:comments xmlns:w=\"${docxNs()}\">${docxCommentEntries(comments)}</w:comments>"

pure func docxCommentEntries(comments: [DocxComment]) -> string =
  match comments {
    [] => "",
    c :: rest =>
      "<w:comment w:id=\"${intToStr(c.id)}\" w:author=\"${xmlAttrEscape(c.author)}\"${docxDateAttr(c.date)}>${docxParagraph(docxRun(c.text))}</w:comment>${docxCommentEntries(rest)}"
  }

-- w:date must be W3CDTF when present, and it is optional in the schema — so an
-- unparseable date is dropped rather than written and risking the file.
pure func docxDateAttr(date: string) -> string =
  if docxIsW3CDTF(date) then " w:date=\"${xmlAttrEscape(date)}\"" else ""

-- CommentBlock is a standalone block carrying the text it annotates, so the
-- anchor paragraph is that text wrapped in the comment range. Unanchored
-- comments still get a reference so the comment is reachable in Word's pane.
pure func docxCommentAnchorPara(id: int, anchorText: string, anchored: bool) -> string {
  let idStr = intToStr(id);
  let ref = "<w:r><w:commentReference w:id=\"${idStr}\"/></w:r>";
  if anchored && length(anchorText) > 0
  then docxParagraph("<w:commentRangeStart w:id=\"${idStr}\"/>${docxRun(anchorText)}<w:commentRangeEnd w:id=\"${idStr}\"/>${ref}")
  else docxParagraph(ref)
}

-- Real revision marks. Deleted text uses <w:delText>, not <w:t> — Word ignores
-- a <w:t> inside <w:del>, which silently loses the deleted content.
pure func docxRevisionPara(id: int, changeType: string, author: string, date: string, text: string) -> string {
  let attrs = "w:id=\"${intToStr(id)}\" w:author=\"${xmlAttrEscape(author)}\"${docxDateAttr(date)}";
  if changeType == "delete" || changeType == "move-from"
  then docxParagraph("<w:del ${attrs}><w:r><w:delText xml:space=\"preserve\">${xmlEscape(text)}</w:delText></w:r></w:del>")
  else docxParagraph("<w:ins ${attrs}>${docxRun(text)}</w:ins>")
}

-- ============================================================
-- Headers and footers as real parts (P1 item 8)
-- ============================================================

type DocxHdrFtr = { idx: int, kind: string, xml: string }
type DocxSections = { body: [Block], headers: [Block], footers: [Block] }

-- Split top-level header/footer SectionBlocks out of the body. Only top-level:
-- nested ones keep the old inline-with-label rendering, since a header nested
-- inside another block has no meaningful sectPr to attach to.
pure func docxSplitSections(blocks: [Block]) -> DocxSections =
  match blocks {
    [] => {body: [], headers: [], footers: []},
    b :: rest =>
      let r = docxSplitSections(rest) in
      match b {
        SectionBlock(s) =>
          if s.kind == "header" then {body: r.body, headers: b :: r.headers, footers: r.footers}
          else if s.kind == "footer" then {body: r.body, headers: r.headers, footers: b :: r.footers}
          else {body: b :: r.body, headers: r.headers, footers: r.footers},
        _ => {body: b :: r.body, headers: r.headers, footers: r.footers}
      }
  }

pure func docxHdrFtrParts(blocks: [Block], kind: string, startIdx: int) -> [DocxHdrFtr] =
  match blocks {
    [] => [],
    b :: rest =>
      let inner = match b {
        SectionBlock(s) => docxBlocksSimple(s.blocks),
        _ => docxBlockToXml(b)
      } in
      let part = {idx: startIdx, kind: kind, xml: inner} in
      part :: docxHdrFtrParts(rest, kind, startIdx + 1)
  }

pure func docxBlocksSimple(blocks: [Block]) -> string =
  foldl(\acc b. "${acc}${docxBlockToXml(b)}", "", blocks)

pure func docxHdrFtrPartName(p: DocxHdrFtr) -> string =
  "${p.kind}${intToStr(p.idx)}.xml"

pure func docxHdrFtrRelId(p: DocxHdrFtr) -> string =
  "rId${docxCapKind(p.kind)}${intToStr(p.idx)}"

pure func docxCapKind(kind: string) -> string =
  if kind == "header" then "Header" else "Footer"

pure func docxHdrFtrTextParts(parts: [DocxHdrFtr]) -> [{name: string, content: string}] =
  match parts {
    [] => [],
    p :: rest =>
      let root = if p.kind == "header" then "w:hdr" else "w:ftr" in
      -- A header part must contain at least one block-level element; an empty
      -- one makes the package invalid.
      let body = if length(p.xml) > 0 then p.xml else docxParagraph("") in
      let entry = {
        name: "word/${docxHdrFtrPartName(p)}",
        content: "${xmlDecl()}<${root} ${docxDocumentNsAttrs()}>${body}</${root}>"
      } in
      entry :: docxHdrFtrTextParts(rest)
  }
