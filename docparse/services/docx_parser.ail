module docparse/services/docx_parser

import std/xml (parseLenient, findAll, findAllTexts, findFirst, getText, getAttr, getChildren, getTag)
import std/option (Some, None, flatMap as optFlatMap, map as optMap, getOrElse)
import std/result (Ok, Err)
import std/string (contains, length, trim, stringToInt, join, charCode, chars)
import std/list (map, flatMap, any, concat, length as listLength, filter, reverse, last)
import docparse/types/document (mkHeading, mkHeadingRuns, mkList, mkListRuns, mkText, mkTextRuns, plainRun, InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, ChangeBlock, CommentBlock, TableCell, DocMetadata, emptyMetadata, simpleCell, mergedCell, spanCell, mkImage, mkTable, mkAnchoredComment, mkUnanchoredComment)
import docparse/services/zip_extract (readDocxContent, readCoreProperties, readAppProperties, readDocxRelationships, findMediaEntries, readEmbeddedImage, mediaMimeType, findHeaderEntries, findFooterEntries, readZipEntry, findFootnoteEntries, findEndnoteEntries, readComments, readCommentsExtended)
import docparse/services/omml (renderOmml)

-- DOCX Parser
-- Parses Word document XML into a list of content Blocks.
--
-- DOCX XML structure (word/document.xml):
--   <w:document>
--     <w:body>
--       <w:p>            -- paragraph
--         <w:pPr>        -- paragraph properties
--           <w:pStyle w:val="Heading1"/>
--           <w:numPr/>   -- numbering (lists)
--         </w:pPr>
--         <w:r>          -- run (text with formatting)
--           <w:rPr/>     -- run properties (bold, italic, etc.)
--           <w:t>text</w:t>
--         </w:r>
--       </w:p>
--       <w:tbl>          -- table
--         <w:tr>         -- row
--           <w:tc>       -- cell
--             <w:p>...</w:p>
--           </w:tc>
--         </w:tr>
--       </w:tbl>
--     </w:body>
--   </w:document>
--
-- Run: ailang run --entry main --caps IO,FS docparse/main.ail

-- Parse a DOCX file into content blocks
export func parseDocx(filepath: string) -> [Block] ! {FS} {
  let xml = readDocxContent(filepath);
  match parseLenient(xml) {
    Ok(root) => extractBodyBlocks(root),
    Err(e) => [mkText("XML parse error: ${e}", "error", 0)]
  }
}

-- Extract metadata from a DOCX file
export func parseDocxMetadata(filepath: string) -> DocMetadata ! {FS} {
  let coreXml = readCoreProperties(filepath);
  match parseLenient(coreXml) {
    Ok(root) => extractMetadata(root),
    Err(_) => emptyMetadata()
  }
}

-- Extract images from a DOCX file
export func parseDocxImages(filepath: string) -> [Block] ! {FS} {
  let mediaEntries = findMediaEntries(filepath);
  extractImages(filepath, mediaEntries)
}

-- Extract headers from a DOCX file
export func parseDocxHeaders(filepath: string) -> [Block] ! {FS} {
  let entries = findHeaderEntries(filepath);
  parseSectionEntries(filepath, entries, "header")
}

-- Extract footers from a DOCX file
export func parseDocxFooters(filepath: string) -> [Block] ! {FS} {
  let entries = findFooterEntries(filepath);
  parseSectionEntries(filepath, entries, "footer")
}

-- Extract footnotes from a DOCX file
export func parseDocxFootnotes(filepath: string) -> [Block] ! {FS} {
  let entries = findFootnoteEntries(filepath);
  parseSectionEntries(filepath, entries, "footnote")
}

-- Extract endnotes from a DOCX file
export func parseDocxEndnotes(filepath: string) -> [Block] ! {FS} {
  let entries = findEndnoteEntries(filepath);
  parseSectionEntries(filepath, entries, "endnote")
}

-- Parse a list of ZIP entries as section blocks
func parseSectionEntries(filepath: string, entries: [string], kind: string) -> [Block] ! {FS} =
  match entries {
    [] => [],
    entry :: rest => {
      let xml = readZipEntry(filepath, entry);
      let blocks = parseSectionXml(xml);
      let moreBlocks = parseSectionEntries(filepath, rest, kind);
      if hasContent(blocks)
      then {
        let section = SectionBlock({kind: kind, blocks: blocks});
        section :: moreBlocks
      }
      else moreBlocks
    }
  }

-- Parse XML from a header/footer/footnote part into blocks
export pure func parseSectionXml(xml: string) -> [Block] {
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => {
      let children = getChildren(root);
      processBodyChildren(children)
    },
    Err(_) => []
  }
}

-- Check if a block list has any non-empty content
export pure func hasContent(blocks: [Block]) -> bool =
  any(blockHasContent, blocks)

-- Check if a single block has meaningful content
pure func blockHasContent(b: Block) -> bool =
  match b {
    TextBlock(t) => length(trim(t.text)) > 0,
    HeadingBlock(h) => length(trim(h.text)) > 0,
    TableBlock(_) => true,
    ListBlock(_) => true,
    ImageBlock(_) => true,
    SectionBlock(s) => hasContent(s.blocks),
    ChangeBlock(c) => length(trim(c.text)) > 0,
    _ => true
  }

-- Navigate to w:body and extract blocks from its children
export pure func extractBodyBlocks(root: XmlNode) -> [Block] {
  match findFirst(root, "w:body") {
    Some(body) => {
      let children = getChildren(body);
      processBodyChildren(children)
    },
    None => []
  }
}

-- Process children of w:body (paragraphs and tables)
pure func processBodyChildren(nodes: [XmlNode]) -> [Block] =
  flatMap(processBodyNode, nodes)

-- Process a single body-level node
pure func processBodyNode(node: XmlNode) -> [Block] {
  let tag = getTag(node);
  if tag == "w:p" then {
    let mainBlock = parseParagraph(node);
    let changeBlocks = extractParagraphChanges(node);
    let textBoxBlocks = extractTextBoxes(node);
    mainBlock :: concat(changeBlocks, textBoxBlocks)
  }
  else if tag == "w:tbl" then [parseTable(node)]
  else if tag == "w:sdt" then extractSdtBodyBlocks(node)
  else []
}

-- Extract blocks from a body-level structured document tag (w:sdt)
-- SDTs can wrap paragraphs, tables, and nested SDTs at the body level
pure func extractSdtBodyBlocks(sdt: XmlNode) -> [Block] =
  match findFirst(sdt, "w:sdtContent") {
    Some(content) => processBodyChildren(getChildren(content)),
    None => []
  }

-- Extract text from text boxes (wps:txbx / w:txbxContent) inside a node
-- Text boxes appear inside drawings within paragraphs
pure func extractTextBoxes(node: XmlNode) -> [Block] {
  let txbxContents = findAll(node, "w:txbxContent");
  extractTextBoxContent(txbxContents)
}

-- Parse text box content nodes into blocks wrapped in a SectionBlock
pure func extractTextBoxContent(nodes: [XmlNode]) -> [Block] =
  flatMap(\txbx.
    let blocks = processBodyChildren(getChildren(txbx)) in
    if hasContent(blocks) then [SectionBlock({kind: "textbox", blocks: blocks})]
    else [],
    nodes)

-- Parse a w:p (paragraph) element into a Block
pure func parseParagraph(p: XmlNode) -> Block {
  let text = extractParagraphText(p);
  let style = extractParagraphStyle(p);
  let headingLevel = headingLevelFromStyle(style);
  let runs = extractParagraphRuns(p);
  if headingLevel > 0
  then mkHeadingRuns(text, headingLevel, runs)
  else if isListParagraph(p)
  -- One DOCX list paragraph is one item, so itemRuns is parallel with a single
  -- entry. Kept empty when the item has no formatting, so the field only
  -- appears where it carries information.
  then mkListRuns([text], isOrderedList(p), if listLength(runs) > 0 then [runs] else [])
  else mkTextRuns(text, style, 0, runs)
}

-- Extract all text from a paragraph by concatenating runs
-- Handles track changes: includes w:ins and w:moveTo text,
-- skips w:del and w:moveFrom (deleted/moved-away text)
pure func extractParagraphText(p: XmlNode) -> string {
  let children = getChildren(p);
  extractTextFromChildren(children)
}

-- Walk paragraph children, skipping deleted/moved-away content
pure func extractTextFromChildren(nodes: [XmlNode]) -> string =
  join("", map(childNodeText, nodes))

-- === Character formatting (ECMA-376 §17.3.2) =============================
--
-- w:rPr has been sitting in every run this parser walks, read only for font
-- names, while bold/italic/underline were dropped on the floor. These build the
-- InlineRun list that carries it.
--
-- childNodeRuns MUST mirror childNodeText's tag handling exactly — same
-- inclusions, same skips — or `runs` and `text` describe different content for
-- the same paragraph. They are permitted to differ in general (see InlineRun in
-- types/document.ail), but for DOCX there are no Markdown markers involved, so
-- any divergence here would be a bug rather than the intended split.
pure func extractParagraphRuns(p: XmlNode) -> [InlineRun] {
  let runs = flatMap(childNodeRuns, getChildren(p));
  -- Emit nothing unless something is actually formatted. A plain paragraph
  -- gains no information from a single unstyled run, and suppressing it keeps
  -- the JSON for unformatted documents byte-identical to the pre-InlineRun
  -- shape — which is most documents, and all but a handful of the goldens.
  if any(docxRunIsFormatted, runs) then runs else []
}

pure func childNodeRuns(node: XmlNode) -> [InlineRun] {
  let tag = getTag(node);
  if tag == "w:r" then [extractRun(node)]
  else if tag == "w:del" then []
  else if tag == "w:moveFrom" then []
  else if tag == "w:ins" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:moveTo" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:smartTag" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:hyperlink" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:sdt" then childNodeSdtRuns(node)
  else if tag == "m:oMath" then [plainRun(renderOmml(node))]
  else if tag == "m:oMathPara" then [plainRun(renderOmml(node))]
  else []
}

pure func childNodeSdtRuns(sdt: XmlNode) -> [InlineRun] =
  match findFirst(sdt, "w:sdtContent") {
    Some(content) => map(extractRun, findAll(content, "w:r")),
    None => []
  }

pure func extractRun(run: XmlNode) -> InlineRun {
  let text = extractRunText(run);
  match findFirst(run, "w:rPr") {
    Some(rPr) => {
      text: text,
      bold: docxToggleProp(rPr, "w:b"),
      italic: docxToggleProp(rPr, "w:i"),
      underline: docxHasUnderline(rPr),
      strike: docxToggleProp(rPr, "w:strike"),
      -- DOCX has no "code" run property. Inferring one from a monospace font
      -- would be a guess, so it stays false rather than fabricated.
      code: false,
      vertAlign: docxVertAlign(rPr)
    },
    None => plainRun(text)
  }
}

pure func docxRunIsFormatted(r: InlineRun) -> bool =
  r.bold || r.italic || r.underline || r.strike || r.code || length(r.vertAlign) > 0

-- ECMA-376 toggle properties: a bare <w:b/> means ON, but <w:b w:val="0"/>
-- means OFF. Presence alone is not the signal — a paragraph that explicitly
-- turns bold off would otherwise come back bold.
pure func docxToggleProp(rPr: XmlNode, tag: string) -> bool =
  match findFirst(rPr, tag) {
    Some(el) => docxToggleOn(getOrElse(getAttr(el, "w:val"), "true")),
    None => false
  }

pure func docxToggleOn(val: string) -> bool =
  val != "0" && val != "false" && val != "off"

-- w:u is not a toggle: it names an underline style, and w:val="none" is the
-- off state.
pure func docxHasUnderline(rPr: XmlNode) -> bool =
  match findFirst(rPr, "w:u") {
    Some(el) => {
      let v = getOrElse(getAttr(el, "w:val"), "none");
      v != "none" && length(v) > 0
    },
    None => false
  }

pure func docxVertAlign(rPr: XmlNode) -> string =
  match findFirst(rPr, "w:vertAlign") {
    Some(el) => {
      let v = getOrElse(getAttr(el, "w:val"), "");
      if v == "superscript" || v == "subscript" then v else ""
    },
    None => ""
  }

-- Extract text contribution from a single child node
pure func childNodeText(node: XmlNode) -> string {
  let tag = getTag(node);
  if tag == "w:r" then extractRunText(node)
  else if tag == "w:del" then ""
  else if tag == "w:moveFrom" then ""
  else if tag == "w:ins" then extractNestedRunText(node)
  else if tag == "w:moveTo" then extractNestedRunText(node)
  else if tag == "w:smartTag" then extractNestedRunText(node)
  else if tag == "w:hyperlink" then extractNestedRunText(node)
  else if tag == "w:sdt" then extractSdtText(node)
  else if tag == "m:oMath" then renderOmml(node)
  else if tag == "m:oMathPara" then renderOmml(node)
  else ""
}

-- Extract text from runs nested inside ins/moveTo/smartTag/hyperlink elements
pure func extractNestedRunText(parent: XmlNode) -> string {
  let runs = findAll(parent, "w:r");
  joinRunTexts(runs)
}

-- Extract track change annotations from a paragraph
-- Finds w:ins, w:del, w:moveTo, w:moveFrom and creates ChangeBlocks
-- with author, date, change type, and affected text.
pure func extractParagraphChanges(p: XmlNode) -> [Block] {
  let children = getChildren(p);
  flatMap(extractChangeFromNode, children)
}

-- Extract a ChangeBlock from a node if it's a track change element
pure func extractChangeFromNode(node: XmlNode) -> [Block] {
  let tag = getTag(node);
  if tag == "w:ins" then [makeChangeBlock("insert", node)]
  else if tag == "w:del" then [makeChangeBlock("delete", node)]
  else if tag == "w:moveTo" then [makeChangeBlock("move-to", node)]
  else if tag == "w:moveFrom" then [makeChangeBlock("move-from", node)]
  else []
}

-- Create a ChangeBlock from a track change XML node
pure func makeChangeBlock(changeType: string, node: XmlNode) -> Block {
  let author = getOrElse(getAttr(node, "w:author"), "Unknown");
  let date = getOrElse(getAttr(node, "w:date"), "");
  let text = extractChangeText(node);
  ChangeBlock({changeType: changeType, author: author, date: date, text: text})
}

-- Extract text from a track change node (handles both w:t and w:delText)
pure func extractChangeText(node: XmlNode) -> string {
  let runs = findAll(node, "w:r");
  join("", map(extractRunChangeText, runs))
}

-- Extract text from a run in a track change
-- Checks w:delText first (used by w:del and w:moveFrom), then w:t
pure func extractRunChangeText(run: XmlNode) -> string {
  match findFirst(run, "w:delText") {
    Some(t) => getText(t),
    None => match findFirst(run, "w:t") {
      Some(t) => getText(t),
      None => ""
    }
  }
}

-- Extract text from structured document tags (w:sdt -> w:sdtContent)
pure func extractSdtText(sdt: XmlNode) -> string {
  match findFirst(sdt, "w:sdtContent") {
    Some(content) => {
      let runs = findAll(content, "w:r");
      joinRunTexts(runs)
    },
    None => ""
  }
}

-- Concatenate text from all runs
pure func joinRunTexts(runs: [XmlNode]) -> string =
  join("", map(extractRunText, runs))

-- Check if a font name is a symbol/dingbat font that uses PUA codepoints
pure func docxIsSymbolFont(fontName: string) -> bool =
  contains(fontName, "Wingdings") ||
  contains(fontName, "Webdings") ||
  fontName == "Symbol"

-- Strip Private Use Area characters (U+F000-U+F0FF) from text
-- These only render with the matching symbol font installed
pure func docxStripPuaChars(text: string) -> string {
  let charList = chars(text);
  let filtered = filter(\c. {
    let code = charCode(c);
    code < 61440 || code > 61695
  }, charList);
  join("", filtered)
}

-- Get the ASCII font name from a run's properties (w:rPr/w:rFonts[@w:ascii])
pure func docxGetRunFont(run: XmlNode) -> string =
  getOrElse(
    optFlatMap(\rpr.
      optFlatMap(\rfonts.
        getAttr(rfonts, "w:ascii"),
        findFirst(rpr, "w:rFonts")),
      findFirst(run, "w:rPr")),
    "")

-- Extract text from a single w:r (run)
-- Strips PUA characters from symbol font runs (Wingdings, Webdings, Symbol)
pure func extractRunText(run: XmlNode) -> string {
  match findFirst(run, "w:t") {
    Some(t) => {
      let text = getText(t);
      let font = docxGetRunFont(run);
      if docxIsSymbolFont(font) then docxStripPuaChars(text)
      else text
    },
    None => ""
  }
}

-- Extract the paragraph style name from w:pPr/w:pStyle
pure func extractParagraphStyle(p: XmlNode) -> string =
  getOrElse(
    optFlatMap(\ppr.
      optFlatMap(\pstyle.
        getAttr(pstyle, "w:val"),
        findFirst(ppr, "w:pStyle")),
      findFirst(p, "w:pPr")),
    "Normal")

-- Determine heading level from style name.
-- Recognizes the conformant ECMA-376 styleIds (Heading1..Heading6, Title,
-- Subtitle), the space-separated display names some non-conformant tools
-- emit ("Heading 1"..), and maps Word's Title/Subtitle to H1/H2.
-- Contract: result is in 0..6. Inline tests below enforce all real cases;
-- the `ensures` form is omitted because of ailang-core issue #236 (v0.19.2
-- property-test generator emits invalid _test.ail for several pure-func
-- shapes with ensures).
pure func headingLevelFromStyle(style: string) -> int
  tests [
    ("Heading1", 1),
    ("Heading2", 2),
    ("Heading3", 3),
    ("Heading 1", 1),
    ("Heading 4", 4),
    ("Title", 1),
    ("Subtitle", 2),
    ("Normal", 0),
    ("BodyText", 0)
  ]
{
  if style == "Heading1" || style == "Heading 1" then 1
  else if style == "Heading2" || style == "Heading 2" then 2
  else if style == "Heading3" || style == "Heading 3" then 3
  else if style == "Heading4" || style == "Heading 4" then 4
  else if style == "Heading5" || style == "Heading 5" then 5
  else if style == "Heading6" || style == "Heading 6" then 6
  else if style == "Title" then 1
  else if style == "Subtitle" then 2
  else 0
}

-- Check if paragraph is a list item (has w:numPr)
pure func isListParagraph(p: XmlNode) -> bool =
  getOrElse(
    optMap(\_.  true,
      optFlatMap(\ppr. findFirst(ppr, "w:numPr"), findFirst(p, "w:pPr"))),
    false)

-- Check if a list paragraph is ordered (numbered) vs unordered (bullet)
-- Convention: numId > 0 with ilvl suggests ordered; simplified heuristic
pure func isOrderedList(p: XmlNode) -> bool =
  getOrElse(
    optFlatMap(\ppr.
      optFlatMap(\numPr.
        optFlatMap(\numId.
          optMap(\val. val != "1", getAttr(numId, "w:val")),
          findFirst(numPr, "w:numId")),
        findFirst(ppr, "w:numPr")),
      findFirst(p, "w:pPr")),
    false)

-- Parse a w:tbl (table) element into a TableBlock
-- Handles merged cells via gridSpan (horizontal) and vMerge (vertical)
pure func parseTable(tbl: XmlNode) -> Block {
  let rows = findAll(tbl, "w:tr");
  let parsedRows = parseTableRows(rows);
  match parsedRows {
    [] => mkTable([], []),
    firstRow :: dataRows =>
      mkTable(dataRows, firstRow)
  }
}

-- Parse all table rows
-- Contract: result has the same row count as the input rows. The `ensures`
-- form is omitted because of ailang-core issue #236 (v0.19.2 property-test
-- generator emits invalid _test.ail for pure funcs with ensures).
pure func parseTableRows(rows: [XmlNode]) -> [[TableCell]]
{
  map(parseTableRow, rows)
}

-- Parse a single table row into TableCells with span info
pure func parseTableRow(tr: XmlNode) -> [TableCell] {
  let cells = findAll(tr, "w:tc");
  parseCells(cells)
}

-- Extract TableCells from all cells in a row
-- Contract: result has the same cell count as the input cells. The `ensures`
-- form is omitted because of ailang-core issue #236.
pure func parseCells(cells: [XmlNode]) -> [TableCell]
{
  map(parseCell, cells)
}

-- Parse a single w:tc into a TableCell with merge info
-- Reads w:tcPr for gridSpan and vMerge attributes
pure func parseCell(tc: XmlNode) -> TableCell {
  let text = getCellText(tc);
  let cs = getCellGridSpan(tc);
  let vm = getCellVMerge(tc);
  if vm == "continue"
  then { text: "", colSpan: cs, rowSpan: 1, merged: true, scope: "" }
  else { text: text, colSpan: cs, rowSpan: 1, merged: false, scope: "" }
}

-- Get gridSpan value from w:tcPr/w:gridSpan[@w:val]
-- Returns 1 if not present (normal single-column cell)
-- Contract: result is >= 1 (a cell always spans at least one column). The
-- `ensures` form is omitted because of ailang-core issue #236.
pure func getCellGridSpan(tc: XmlNode) -> int
{
  getOrElse(
    optFlatMap(\tcPr.
      optFlatMap(\gs.
        optMap(\val. parseIntOrDefault(val, 1), getAttr(gs, "w:val")),
        findFirst(tcPr, "w:gridSpan")),
      findFirst(tc, "w:tcPr")),
    1)
}

-- Get vMerge status from w:tcPr/w:vMerge
-- Returns "restart" for merge start, "continue" for continuation, "" for no merge
pure func getCellVMerge(tc: XmlNode) -> string {
  match optFlatMap(\tcPr. findFirst(tcPr, "w:vMerge"), findFirst(tc, "w:tcPr")) {
    Some(vm) => getOrElse(getAttr(vm, "w:val"), "continue"),
    None => ""
  }
}

-- Parse an integer string, returning default if not a valid number
pure func parseIntOrDefault(s: string, default: int) -> int =
  getOrElse(stringToInt(s), default)

-- Get text from a table cell (concatenate all paragraph text within)
pure func getCellText(tc: XmlNode) -> string {
  let paragraphs = findAll(tc, "w:p");
  joinParagraphTexts(paragraphs)
}

-- Concatenate text from multiple paragraphs
pure func joinParagraphTexts(ps: [XmlNode]) -> string =
  join("\n", map(extractParagraphText, ps))

-- Extract metadata from core.xml
export pure func extractMetadata(root: XmlNode) -> DocMetadata {
  let title = getMetaField(root, "dc:title");
  let author = getMetaField(root, "dc:creator");
  let created = getMetaField(root, "dcterms:created");
  let modified = getMetaField(root, "dcterms:modified");
  { title: title, author: author, created: created, modified: modified, pageCount: 0 }
}

-- Get a text field from metadata XML
export pure func getMetaField(root: XmlNode, tagName: string) -> string =
  getOrElse(optMap(getText, findFirst(root, tagName)), "")

-- Extract images from media entries
func extractImages(filepath: string, entries: [string]) -> [Block] ! {FS} =
  match entries {
    [] => [],
    entry :: rest => {
      let imageData = readEmbeddedImage(filepath, entry);
      let mime = mediaMimeType(entry);
      let block = mkImage(imageData, "", mime);
      let moreBlocks = extractImages(filepath, rest);
      block :: moreBlocks
    }
  }

-- === Comment anchoring (ECMA-376 §17.13.1) ================================
--
-- A comment's body lives in word/comments.xml keyed by w:id; the span it
-- annotates lives in word/document.xml as w:commentRangeStart /
-- w:commentRangeEnd markers carrying the same w:id. Correlating the two is
-- what makes a comment usable — "this is nonsense" is noise without the text
-- it points at, and an agent handed a detached comment will guess a target.
--
-- Ranges are stateful: they open at one node and close at a later one, which
-- may be a different paragraph or a different table cell. So the anchor walk
-- is a fold threading the set of currently-open ranges, not a stateless map
-- like processBodyChildren.
--
-- Note: w:bookmarkStart also carries a w:id, in a SEPARATE numbering space.
-- Ids are therefore only ever read off comment-specific tags.

-- A range opened but not yet closed. `parts` holds run text in REVERSE order
-- (prepend during the walk, reverse at close — never concat onto the tail
-- inside a fold).
type DocxOpenRange = {
  id: string,
  parts: [string],
  startIndex: int
}

-- A resolved anchor: the exact text a comment points at.
-- kind is "range" (w:commentRangeStart/End pair) or "point" (a bare
-- w:commentReference, which anchors to its containing paragraph).
-- startIndex/endIndex are body block indices, so a consumer can render the
-- comment in place.
type DocxAnchor = {
  id: string,
  text: string,
  kind: string,
  startIndex: int,
  endIndex: int
}

-- Body walk state. blocks and anchors accumulate REVERSED.
type DocxWalk = {
  blocks: [Block],
  anchors: [DocxAnchor],
  open: [DocxOpenRange],
  count: int
}

-- Walk the body once, producing content blocks and comment anchors together.
-- Doing both in one pass keeps the block indices honest (an anchor's index is
-- the position of its paragraph in the emitted block list, which only this
-- walk knows) and avoids parsing document.xml twice.
export pure func docxWalkBodyRoot(root: XmlNode) -> DocxWalk =
  match findFirst(root, "w:body") {
    Some(body) => {
      let st = docxWalkNodes(getChildren(body), docxEmptyWalk());
      { blocks: reverse(st.blocks), anchors: reverse(st.anchors),
        open: st.open, count: st.count }
    },
    None => docxEmptyWalk()
  }

pure func docxEmptyWalk() -> DocxWalk =
  { blocks: [], anchors: [], open: [], count: 0 }

pure func docxWalkNodes(nodes: [XmlNode], st: DocxWalk) -> DocxWalk =
  match nodes {
    [] => st,
    node :: rest => docxWalkNodes(rest, docxWalkNode(node, st))
  }

-- Process one body-level node: emit its blocks (reusing processBodyNode so
-- block extraction stays in one place) and scan it for comment markers.
pure func docxWalkNode(node: XmlNode, st: DocxWalk) -> DocxWalk {
  let tag = getTag(node);
  if tag == "w:sdt" then
    -- SDTs emit their content's blocks, so recurse rather than counting them
    -- as one node; the recursion keeps the index accounting correct.
    match findFirst(node, "w:sdtContent") {
      Some(content) => docxWalkNodes(getChildren(content), st),
      None => st
    }
  else {
    let emitted = processBodyNode(node);
    let scanned =
      if tag == "w:p" then docxScanParagraph(node, st)
      else if tag == "w:tbl" then docxScanParagraphs(findAll(node, "w:p"), st)
      else st;
    { blocks: docxPrependAll(emitted, scanned.blocks),
      anchors: scanned.anchors,
      open: scanned.open,
      count: scanned.count + listLength(emitted) }
  }
}

-- Prepend a list onto a reversed accumulator
pure func docxPrependAll(xs: [Block], acc: [Block]) -> [Block] =
  match xs {
    [] => acc,
    x :: rest => docxPrependAll(rest, x :: acc)
  }

-- Scan several paragraphs in document order (table cells, nested tables)
pure func docxScanParagraphs(ps: [XmlNode], st: DocxWalk) -> DocxWalk =
  match ps {
    [] => st,
    p :: rest => docxScanParagraphs(rest, docxScanParagraph(p, st))
  }

-- Scan one paragraph's children in document order, then close the paragraph
pure func docxScanParagraph(p: XmlNode, st: DocxWalk) -> DocxWalk {
  let paraText = extractParagraphText(p);
  let scanned = docxScanChildren(getChildren(p), paraText, st);
  docxEndParagraph(scanned)
}

pure func docxScanChildren(nodes: [XmlNode], paraText: string, st: DocxWalk) -> DocxWalk =
  match nodes {
    [] => st,
    n :: rest => docxScanChildren(rest, paraText, docxScanChild(n, paraText, st))
  }

-- One paragraph child. Text is appended to EVERY currently-open range, which
-- is what makes nested and overlapping ranges fall out for free.
pure func docxScanChild(node: XmlNode, paraText: string, st: DocxWalk) -> DocxWalk {
  let tag = getTag(node);
  if tag == "w:commentRangeStart" then
    match getAttr(node, "w:id") {
      Some(id) => docxOpenRange(id, st),
      None => st
    }
  else if tag == "w:commentRangeEnd" then
    match getAttr(node, "w:id") {
      Some(id) => docxCloseRange(id, st),
      None => st
    }
  else {
    let withRefs = docxScanRefs(findAll(node, "w:commentReference"), paraText, st);
    let text = childNodeText(node);
    if length(text) == 0 then withRefs
    else docxAppendOpen(text, withRefs)
  }
}

-- A w:commentReference whose id never had a range is a point anchor, not an
-- error: attach the containing paragraph and mark it as such.
pure func docxScanRefs(refs: [XmlNode], paraText: string, st: DocxWalk) -> DocxWalk =
  match refs {
    [] => st,
    r :: rest => {
      let next = match getAttr(r, "w:id") {
        Some(id) =>
          if docxKnowsId(id, st) then st
          else {
            let anchor = { id: id, text: trim(paraText), kind: "point",
                           startIndex: st.count, endIndex: st.count };
            { blocks: st.blocks, anchors: anchor :: st.anchors,
              open: st.open, count: st.count }
          },
        None => st
      };
      docxScanRefs(rest, paraText, next)
    }
  }

-- Is this id already open, or already resolved?
pure func docxKnowsId(id: string, st: DocxWalk) -> bool =
  any(\r. r.id == id, st.open) || any(\a. a.id == id, st.anchors)

pure func docxOpenRange(id: string, st: DocxWalk) -> DocxWalk =
  { blocks: st.blocks, anchors: st.anchors, count: st.count,
    open: { id: id, parts: [], startIndex: st.count } :: st.open }

-- Close a range: reverse its collected fragments into the anchor text.
-- A close with no matching open is ignored — it degrades to unanchored
-- rather than anchoring to whatever text happens to be nearby.
pure func docxCloseRange(id: string, st: DocxWalk) -> DocxWalk =
  match filter(\r. r.id == id, st.open) {
    [] => st,
    r :: _ => {
      let anchor = { id: id, text: trim(join("", reverse(r.parts))),
                     kind: "range", startIndex: r.startIndex, endIndex: st.count };
      { blocks: st.blocks,
        anchors: anchor :: st.anchors,
        open: filter(\o. o.id != id, st.open),
        count: st.count }
    }
  }

pure func docxAppendOpen(text: string, st: DocxWalk) -> DocxWalk =
  { blocks: st.blocks, anchors: st.anchors, count: st.count,
    open: map(\r. { id: r.id, parts: text :: r.parts, startIndex: r.startIndex }, st.open) }

-- A range still open at a paragraph break keeps collecting across it, so
-- record the boundary rather than running the two paragraphs together.
pure func docxEndParagraph(st: DocxWalk) -> DocxWalk =
  match st.open {
    [] => st,
    _ => docxAppendOpen("\n", st)
  }

-- A comment body read from comments.xml, before the anchor join.
-- lastParaId is the w14:paraId of its final paragraph — the key
-- commentsExtended.xml uses to express threading.
type DocxCommentBody = {
  id: string,
  author: string,
  date: string,
  text: string,
  lastParaId: string
}

-- A comment together with the body block index it should follow.
-- index < 0 means unanchored: the comment goes in the trailing group.
type DocxPlacedComment = {
  index: int,
  block: Block
}

-- Parse a DOCX body with its comments spliced in at their anchors.
--
-- Comments appear exactly once, immediately after the block holding the end
-- of the span they annotate, so a linear reader (or an agent walking blocks in
-- order) meets each comment beside its target. Comments whose anchor could not
-- be resolved go in a trailing group, explicitly labelled unanchored.
export func parseDocxWithComments(filepath: string) -> [Block] ! {FS} =
  parseDocxWithCommentsXml(readDocxContent(filepath),
                           readComments(filepath),
                           readCommentsExtended(filepath))

-- Pure core of the anchored parse, over raw XML strings.
--
-- The browser (WASM) build has no filesystem — JavaScript unzips and hands the
-- parts over as strings — so both the CLI and the browser go through this one
-- function. Anchoring that worked on the CLI but silently degraded in the
-- browser demo would be worse than either being consistently unanchored.
export pure func parseDocxWithCommentsXml(documentXml: string, commentsXml: string,
                                           extXml: string) -> [Block] =
  match parseLenient(documentXml) {
    Ok(root) => {
      let walk = docxWalkBodyRoot(root);
      let placed = docxCommentsFromXml(commentsXml, extXml, walk.anchors);
      docxSpliceComments(walk.blocks, placed)
    },
    Err(e) => [mkText("XML parse error: ${e}", "error", 0)]
  }

-- Extract comments from a DOCX file (word/comments.xml), each anchored to the
-- span of document.xml text it annotates. Returned as a flat list for callers
-- that want comments alone; parseDocxWithComments splices them into the body.
export func parseDocxComments(filepath: string) -> [Block] ! {FS} {
  let anchors = match parseLenient(readDocxContent(filepath)) {
    Ok(root) => docxWalkBodyRoot(root).anchors,
    Err(_) => []
  };
  let placed = docxCommentsFromXml(readComments(filepath), readCommentsExtended(filepath), anchors);
  map(\p. docxWrapComment(p.block), placed)
}

-- Anchored comments alone, over raw XML strings (browser/WASM entry point).
export pure func docxCommentsOnlyXml(commentsXml: string, documentXml: string,
                                      extXml: string) -> [Block] {
  let anchors = match parseLenient(documentXml) {
    Ok(root) => docxWalkBodyRoot(root).anchors,
    Err(_) => []
  };
  map(\p. docxWrapComment(p.block), docxCommentsFromXml(commentsXml, extXml, anchors))
}

-- Join comments.xml + commentsExtended.xml to the anchors collected from
-- document.xml.
pure func docxCommentsFromXml(commentsXml: string, extXml: string,
                               anchors: [DocxAnchor]) -> [DocxPlacedComment] =
  if length(commentsXml) == 0 then []
  else match parseLenient(commentsXml) {
    Ok(root) => {
      let bodies = map(docxCommentBody, findAll(root, "w:comment"));
      let exNodes = docxReadCommentExNodes(extXml);
      let placed = map(\b. docxPlaceComment(b, anchors, bodies, exNodes), bodies);
      docxInheritReplyAnchors(placed, bodies, anchors, exNodes)
    },
    Err(_) => []
  }

-- Read one w:comment element into a body record
pure func docxCommentBody(node: XmlNode) -> DocxCommentBody {
  let paragraphs = findAll(node, "w:p");
  {
    id: getOrElse(getAttr(node, "w:id"), ""),
    author: getOrElse(getAttr(node, "w:author"), "Unknown"),
    date: getOrElse(getAttr(node, "w:date"), ""),
    text: join(" ", docxExtractCommentTexts(paragraphs)),
    lastParaId: docxLastParaId(paragraphs)
  }
}

-- commentsExtended.xml keys threading on the LAST paragraph of a comment body
pure func docxLastParaId(ps: [XmlNode]) -> string =
  match last(ps) {
    Some(p) => getOrElse(getAttr(p, "w14:paraId"), ""),
    None => ""
  }

pure func docxReadCommentExNodes(xml: string) -> [XmlNode] =
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => findAll(root, "w15:commentEx"),
    Err(_) => []
  }

-- Join one comment body to its anchor.
--
-- Every path that cannot resolve an anchor with certainty produces an
-- unanchored comment: no matching range, an empty range, a missing w:id. The
-- one thing this must never do is fall back to nearby text — a comment
-- confidently pinned to the wrong clause is worse than one with no target,
-- because nothing signals that it was a guess.
pure func docxPlaceComment(body: DocxCommentBody, anchors: [DocxAnchor],
                            bodies: [DocxCommentBody], exNodes: [XmlNode]) -> DocxPlacedComment {
  let parentId = docxParentIdOf(body, bodies, exNodes);
  let resolved = docxIsResolved(body, exNodes);
  match filter(\a. a.id == body.id, anchors) {
    [] => docxUnplaced(body, parentId, resolved),
    a :: _ =>
      if length(trim(a.text)) == 0 then docxUnplaced(body, parentId, resolved)
      else {
        index: a.endIndex,
        block: mkAnchoredComment(body.id, body.author, body.date, body.text,
                                 a.text, a.kind, a.startIndex, parentId, resolved)
      }
  }
}

pure func docxUnplaced(body: DocxCommentBody, parentId: string, resolved: bool) -> DocxPlacedComment =
  { index: 0 - 1,
    block: mkUnanchoredComment(body.id, body.author, body.date, body.text, parentId, resolved) }

-- Which comment does this one reply to?
-- commentsExtended maps a comment's last paraId to its parent's last paraId;
-- we resolve that back to the parent's w:id.
pure func docxParentIdOf(body: DocxCommentBody, bodies: [DocxCommentBody], exNodes: [XmlNode]) -> string {
  if length(body.lastParaId) == 0 then ""
  else match filter(\n. getOrElse(getAttr(n, "w15:paraId"), "") == body.lastParaId, exNodes) {
    [] => "",
    ex :: _ => {
      let parentPara = getOrElse(getAttr(ex, "w15:paraIdParent"), "");
      if length(parentPara) == 0 then ""
      else match filter(\b. b.lastParaId == parentPara, bodies) {
        [] => "",
        parent :: _ => parent.id
      }
    }
  }
}

pure func docxIsResolved(body: DocxCommentBody, exNodes: [XmlNode]) -> bool =
  match filter(\n. getOrElse(getAttr(n, "w15:paraId"), "") == body.lastParaId, exNodes) {
    [] => false,
    ex :: _ => getOrElse(getAttr(ex, "w15:done"), "0") == "1"
  }

-- A reply annotates the same span as the comment it replies to. Word does not
-- always write a separate range for replies, so an unanchored reply inherits
-- its parent's anchor. This is the OOXML thread model, not a proximity guess:
-- the parent link is explicit in commentsExtended.xml.
pure func docxInheritReplyAnchors(placed: [DocxPlacedComment], bodies: [DocxCommentBody],
                                   anchors: [DocxAnchor], exNodes: [XmlNode]) -> [DocxPlacedComment] =
  map(\p. docxInheritOne(p, bodies, anchors, exNodes), placed)

pure func docxInheritOne(p: DocxPlacedComment, bodies: [DocxCommentBody],
                          anchors: [DocxAnchor], exNodes: [XmlNode]) -> DocxPlacedComment =
  match p.block {
    CommentBlock(c) =>
      if c.anchored || length(c.parentId) == 0 then p
      else match filter(\a. a.id == c.parentId, anchors) {
        [] => p,
        a :: _ =>
          if length(trim(a.text)) == 0 then p
          else {
            index: a.endIndex,
            block: mkAnchoredComment(c.id, c.author, c.date, c.text,
                                     a.text, a.kind, a.startIndex, c.parentId, c.resolved)
          }
      },
    _ => p
  }

-- Keep the SectionBlock(kind: "comment") wrapper so consumers written against
-- the pre-anchoring shape still find comments where they expect them.
pure func docxWrapComment(b: Block) -> Block =
  SectionBlock({kind: "comment", blocks: [b]})

-- Place each comment directly after the block its span ends in; anything
-- unanchored (or pointing past the end of the body) trails the document.
pure func docxSpliceComments(blocks: [Block], placed: [DocxPlacedComment]) -> [Block] {
  let n = listLength(blocks);
  let inline = filter(\p. p.index >= 0 && p.index < n, placed);
  let trailing = filter(\p. p.index < 0 || p.index >= n, placed);
  concat(docxSpliceAt(blocks, 0, inline),
         map(\p. docxWrapComment(p.block), trailing))
}

pure func docxSpliceAt(blocks: [Block], idx: int, placed: [DocxPlacedComment]) -> [Block] =
  match blocks {
    [] => [],
    b :: rest => {
      let here = map(\p. docxWrapComment(p.block), filter(\p. p.index == idx, placed));
      b :: concat(here, docxSpliceAt(rest, idx + 1, placed))
    }
  }

-- Extract text from comment paragraphs
pure func docxExtractCommentTexts(paragraphs: [XmlNode]) -> [string] =
  match paragraphs {
    [] => [],
    p :: rest => {
      let pText = join("", findAllTexts(p, "w:t"));
      if length(pText) > 0
      then pText :: docxExtractCommentTexts(rest)
      else docxExtractCommentTexts(rest)
    }
  }

