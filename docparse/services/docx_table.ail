module docparse/services/docx_table

import std/string (length, intToStr)
import std/list (map, foldl, length as listLength)
import docparse/types/document (InlineRun, TableCell)
import docparse/services/xml_helpers (xmlEscape, docxRun, docxParagraph)
import docparse/services/docx_layout (docxColumnWidths, docxSpanWidth)
import docparse/services/docx_runs (docxHeaderAlignPr, docxAlignPr, docxRunsToXml)

-- DOCX tables (<w:tbl> with an explicit grid) and list paragraphs. Split out
-- of docx_generator (see its header) to keep each module inside the browser
-- type-checker's step ceiling.

-- Build a DOCX table: <w:tbl> with <w:tr>/<w:tc>
-- Use the selected section width in twips. Word auto-fits a
-- table with no explicit widths, but that is Word being forgiving: ECMA-376
-- §17.4.49 makes w:tblGrid part of the table's definition, and a reader that
-- follows the spec (Pages, for one) collapses every column to its minimum —
-- one character per line.
export pure func docxTableToXml(headers: [TableCell], rows: [[TableCell]], tblStyle: string, totalWidth: int) -> string {
  let cols = docxTableColCount(headers, rows);
  let widths = docxColumnWidths(headers, rows, cols, totalWidth);
  let tableWidth = foldl(\acc w. acc + w, 0, widths);
  -- Under a template table style the style carries the borders — hardcoded
  -- direct formatting would override it and defeat the binding — so only the
  -- styleless path emits them. Geometry follows the selected page/column
  -- width, with bounded content weights rather than a fixed Letter grid.
  let tblPr = if length(tblStyle) > 0
    then "<w:tblPr><w:tblStyle w:val=\"${tblStyle}\"/><w:tblW w:w=\"${intToStr(tableWidth)}\" w:type=\"dxa\"/><w:tblLayout w:type=\"fixed\"/></w:tblPr>"
    else "<w:tblPr><w:tblBorders><w:top w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:left w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:bottom w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:right w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:insideH w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/><w:insideV w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/></w:tblBorders><w:tblW w:w=\"${intToStr(tableWidth)}\" w:type=\"dxa\"/><w:tblLayout w:type=\"fixed\"/></w:tblPr>";
  let grid = "<w:tblGrid>${docxGridCols(widths)}</w:tblGrid>";
  let headerRow = if listLength(headers) > 0
    then "<w:tr><w:trPr><w:tblHeader/></w:trPr>${docxHeaderCellsToXml(headers, widths)}</w:tr>"
    else "";
  let dataRows = foldl(\acc row. "${acc}<w:tr>${docxDataCellsToXml(row, widths)}</w:tr>", "", rows);
  "<w:tbl>${tblPr}${grid}${headerRow}${dataRows}</w:tbl>"
}

-- Widest row wins, counting a spanned cell as the columns it covers.
pure func docxTableColCount(headers: [TableCell], rows: [[TableCell]]) -> int =
  foldl(\acc row. { let n = docxRowSpanWidth(row) in if n > acc then n else acc },
        docxRowSpanWidth(headers), rows)

-- A row's true grid width. Cells that a preceding gridSpan already covers
-- occupy no grid position of their own — counting them made a 4-column table
-- declare a 7-column grid, because "Total {colspan=4}" plus its three merged
-- continuations was summed as 4+1+1+1.
pure func docxRowSpanWidth(cells: [TableCell]) -> int =
  docxRowWidthWalk(cells, 0, 0)

pure func docxRowWidthWalk(cells: [TableCell], cover: int, acc: int) -> int =
  match cells {
    [] => acc,
    c :: rest =>
      if c.merged && cover > 0
      then docxRowWidthWalk(rest, cover - 1, acc)
      else docxRowWidthWalk(rest, docxCoverAfter(c), acc + docxCellSpan(c))
  }

pure func docxCellSpan(c: TableCell) -> int = if c.colSpan > 1 then c.colSpan else 1

-- Grid positions a cell claims beyond the one it sits in.
pure func docxCoverAfter(c: TableCell) -> int = docxCellSpan(c) - 1

pure func docxGridCols(widths: [int]) -> string =
  foldl(\acc w. "${acc}<w:gridCol w:w=\"${intToStr(w)}\"/>", "", widths)

-- Header cells as bold <w:tc>
-- Emit cells left to right, skipping any merged cell that a preceding
-- gridSpan already covers.
--
-- `merged` means "this position is a continuation", and until now every one of
-- them became a <w:vMerge> tc — a VERTICAL merge. For the horizontal case that
-- is doubly wrong: the position is already occupied by the span, so the extra
-- tc pushes the row past the declared grid, and it claims continuation from a
-- row above that has no cell at that offset. python-docx refuses to read such
-- a row; Word offers to repair the file. vMerge is correct only when nothing
-- in this row covers the position.
pure func docxHeaderCellsToXml(cells: [TableCell], widths: [int]) -> string =
  docxHeaderCellsWalk(cells, widths, 0, 0, "")

pure func docxHeaderCellsWalk(cells: [TableCell], widths: [int], pos: int, cover: int, acc: string) -> string =
  match cells {
    [] => acc,
    c :: rest =>
      if c.merged && cover > 0
      then docxHeaderCellsWalk(rest, widths, pos, cover - 1, acc)
      else docxHeaderCellsWalk(rest, widths, pos + docxCellSpan(c), docxCoverAfter(c),
                               "${acc}${docxHeaderCellToXml(c, docxSpanWidth(widths, pos, docxCellSpan(c)))}")
  }

pure func docxHeaderCellToXml(cell: TableCell, colW: int) -> string {
  if cell.merged then "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW)}\" w:type=\"dxa\"/><w:vMerge/></w:tcPr><w:p/></w:tc>"
  else {
    let spanPr = if cell.colSpan > 1
      then "<w:gridSpan w:val=\"${intToStr(cell.colSpan)}\"/>"
      else "";
    -- Runs carry their own formatting (e.g. code:true from a `backtick` span);
    -- bold is forced on top of that rather than replacing it, so a header cell
    -- stays bold the way a plain-text header cell always has.
    let body = if listLength(cell.runs) > 0
      then docxRunsToXml(map(\r. {r | bold: true}, cell.runs))
      else "<w:r><w:rPr><w:b/></w:rPr><w:t xml:space=\"preserve\">${xmlEscape(cell.text)}</w:t></w:r>";
    "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW)}\" w:type=\"dxa\"/>${spanPr}</w:tcPr><w:p>${docxHeaderAlignPr(cell.align)}${body}</w:p></w:tc>"
  }
}

-- Data cells as normal <w:tc>, with the same horizontal-continuation skip.
pure func docxDataCellsToXml(cells: [TableCell], widths: [int]) -> string =
  docxDataCellsWalk(cells, widths, 0, 0, "")

pure func docxDataCellsWalk(cells: [TableCell], widths: [int], pos: int, cover: int, acc: string) -> string =
  match cells {
    [] => acc,
    c :: rest =>
      if c.merged && cover > 0
      then docxDataCellsWalk(rest, widths, pos, cover - 1, acc)
      else docxDataCellsWalk(rest, widths, pos + docxCellSpan(c), docxCoverAfter(c),
                             "${acc}${docxDataCellToXml(c, docxSpanWidth(widths, pos, docxCellSpan(c)))}")
  }

pure func docxDataCellToXml(cell: TableCell, colW: int) -> string {
  if cell.merged then "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW)}\" w:type=\"dxa\"/><w:vMerge/></w:tcPr><w:p/></w:tc>"
  else {
    let spanPr = if cell.colSpan > 1
      then "<w:gridSpan w:val=\"${intToStr(cell.colSpan)}\"/>"
      else "";
    -- cell.runs is the tokenized decomposition of cell.text (markdown_parser
    -- populates it; every other parser leaves it empty), so a `code` span or
    -- **bold** term inside a cell renders as a real Word run instead of
    -- reaching the page as literal backtick/asterisk characters.
    let body = if listLength(cell.runs) > 0 then docxRunsToXml(cell.runs) else docxRun(cell.text);
    "<w:tc><w:tcPr><w:tcW w:w=\"${intToStr(colW)}\" w:type=\"dxa\"/>${spanPr}</w:tcPr>${docxParagraph("${docxAlignPr(cell.align)}${body}")}</w:tc>"
  }
}

-- Lists as real Word list paragraphs referencing word/numbering.xml
-- (numBase = bullet, numBase + 1 = decimal, matching docxNumberingDefs).
-- itemOrdered (parallel, usually empty) picks the numbering per item, so a
-- numbered outline with bulleted sub-points keeps both; Word continues each
-- numId's counter independently, so the top-level numbering is not reset by
-- the bulleted items between.
export pure func docxListToXml(items: [string], ordered: bool, itemRuns: [[InlineRun]],
                        itemLevels: [int], itemOrdered: [bool], numBase: int) -> string =
  match itemOrdered {
    [] => docxListItemsToXml(items, itemRuns, itemLevels, if ordered then numBase + 1 else numBase),
    _ => docxListMixedToXml(items, itemRuns, itemLevels, itemOrdered, numBase)
  }

pure func docxListMixedToXml(items: [string], itemRuns: [[InlineRun]], itemLevels: [int],
                             itemOrdered: [bool], numBase: int) -> string =
  match items {
    [] => "",
    item :: rest => {
      let o = match itemOrdered { [] => false, x :: _ => x };
      let runs = match itemRuns { [] => [], r :: _ => [r] };
      let one = docxListItemsToXml([item], runs, [docxHeadLevel(itemLevels)],
                                   if o then numBase + 1 else numBase);
      let restRuns = match itemRuns { [] => [], _ :: t => t };
      let restOrd = match itemOrdered { [] => [], _ :: t => t };
      "${one}${docxListMixedToXml(rest, restRuns, docxTailLevels(itemLevels), restOrd, numBase)}"
    }
  }

-- itemRuns is parallel to items but may be empty entirely (nothing formatted).
-- Both lists are walked together so a short or absent itemRuns simply falls
-- back to plain text per item rather than mis-pairing formatting with the
-- wrong item.
pure func docxListItemsToXml(items: [string], itemRuns: [[InlineRun]], itemLevels: [int], numId: int) -> string =
  match items {
    [] => "",
    item :: rest =>
      -- w:ilvl is the nesting depth Word indents by; it was hardcoded to 0, so
      -- every sub-item rendered flush with its parent.
      let lvl = docxHeadLevel(itemLevels) in
      let pPr = "<w:pPr><w:pStyle w:val=\"ListParagraph\"/><w:numPr><w:ilvl w:val=\"${intToStr(lvl)}\"/><w:numId w:val=\"${intToStr(numId)}\"/></w:numPr></w:pPr>" in
      match itemRuns {
        [] =>
          "${docxParagraph("${pPr}${docxRun(item)}")}${docxListItemsToXml(rest, [], docxTailLevels(itemLevels), numId)}",
        r :: rrest =>
          let body = if listLength(r) > 0 then docxRunsToXml(r) else docxRun(item) in
          "${docxParagraph("${pPr}${body}")}${docxListItemsToXml(rest, rrest, docxTailLevels(itemLevels), numId)}"
      }
  }

-- itemLevels is parallel to items but may be absent entirely (a flat list), so
-- both are walked together and a missing level simply means top level.
pure func docxHeadLevel(levels: [int]) -> int =
  match levels { [] => 0, n :: _ => n }

pure func docxTailLevels(levels: [int]) -> [int] =
  match levels { [] => [], _ :: t => t }
