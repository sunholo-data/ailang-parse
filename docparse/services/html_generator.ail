module docparse/services/html_generator

import std/string (length, join, intToStr, startsWith, contains, find, substring)
import std/fs (readFile)
import std/result (Result, Ok, Err)
import std/list (map, foldl, length as listLength)
import docparse/types/document (InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, ParsedDocument, countBlocks, imageSrcRef)
import docparse/services/xml_helpers (xmlEscape, xmlAttrEscape)

-- HTML Generator — converts Block ADT to standalone HTML document.
-- Pure string concatenation, no XML tree building needed.
--
-- Supports all 9 Block variants:
--   HeadingBlock  -> <h1>...<h6>
--   TextBlock     -> <p> with optional style class
--   TableBlock    -> <table> with colspan/rowspan for merged cells
--   ListBlock     -> <ol>/<ul> with <li> items
--   ImageBlock    -> <img> with base64 data URI or description placeholder
--   AudioBlock    -> <audio> or transcription text
--   VideoBlock    -> <video> or description text
--   SectionBlock  -> <section> with class for kind
--   ChangeBlock   -> <ins>/<del> with attribution

-- Generate a complete HTML document from a ParsedDocument
export pure func generateHtml(doc: ParsedDocument) -> string
  ensures { length(result) > 0 }
{
  generateHtmlStyled(doc, htmlStyle())
}

-- The marker an .html reference must contain to say where generated content
-- goes. A comment, so the template stays a valid, viewable page on its own.
export pure func htmlContentMarker() -> string = "<!-- docparse:content -->"

-- The class names generated markup uses. A house stylesheet is written against
-- these, so they are a contract: renaming one silently breaks every stylesheet
-- in the wild. Exported so a doc test can assert the documented list matches.
export pure func htmlClassContract() -> [string] = [
  "section-header", "section-footer", "section-slide", "section-textbox",
  "merged", "level-1", "level-2", "level-3"
]

-- styleBlock is dropped in verbatim between </title> and </head>, so a caller
-- can pass our built-in <style> or a template's.
export pure func generateHtmlStyled(doc: ParsedDocument, styleBlock: string) -> string
  ensures { length(result) > 0 }
{
  let title = if length(doc.metadata.title) > 0
    then xmlEscape(doc.metadata.title)
    else xmlEscape(doc.filename);
  "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<title>${title}</title>\n${styleBlock}</head>\n<body>\n${htmlBlocksToStr(doc.blocks)}</body>\n</html>\n"
}

-- Generate against a reference: a .css whose rules replace the built-in
-- stylesheet, or an .html shell our body is spliced into at htmlContentMarker().
--
-- A shell without the marker is an ERROR naming it, never an append. Appending
-- would produce a page that opens, looks like the template, and silently omits
-- or misplaces the content — and the caller cannot tell from the exit code.
export func generateHtmlWithReference(doc: ParsedDocument, referencePath: string)
  -> Result[string, string] ! {FS} =
  if length(referencePath) == 0
  then Ok(generateHtml(doc))
  else {
    -- readFile returns the contents directly; the caller checks existence
    -- before we get here, so an empty result means an empty or unreadable
    -- file, and either way there is no style to apply.
    let text = readFile(referencePath);
    if length(text) == 0
    then Err("reference ${referencePath} is empty — no styles to apply")
    else if htmlRefIsCss(referencePath)
    then Ok(generateHtmlStyled(doc, "<style>\n${text}\n</style>\n"))
    else if not contains(text, htmlContentMarker())
    then Err("reference ${referencePath} contains no ${htmlContentMarker()} marker — nothing says where the generated content goes")
    else Ok(htmlSpliceInto(text, htmlBlocksToStr(doc.blocks)))
  }

pure func htmlRefIsCss(path: string) -> bool =
  if length(path) < 4 then false
  else substring(path, length(path) - 4, length(path)) == ".css"

-- Replace every marker occurrence with the body. Every, not the first: a
-- two-column shell may legitimately want the content twice, and silently
-- filling only one would be the same partial-success failure as appending.
export pure func htmlSpliceInto(shell: string, body: string) -> string {
  let m = htmlContentMarker();
  let i = find(shell, m);
  if i < 0 then shell
  else htmlSpliceInto("${substring(shell, 0, i)}${body}${substring(shell, i + length(m), length(shell))}", body)
}

-- Generate just the body HTML from blocks (no wrapper)
export pure func generateHtmlBody(blocks: [Block]) -> string =
  htmlBlocksToStr(blocks)

-- Minimal CSS for readable output
pure func htmlStyle() -> string =
  "<style>\nbody { font-family: sans-serif; max-width: 800px; margin: 2em auto; line-height: 1.6; }\ntable { border-collapse: collapse; margin: 1em 0; }\nth, td { border: 1px solid #ccc; padding: 0.5em; text-align: left; }\nth { background: #f5f5f5; }\n.merged { background: #f0f0f0; }\nins { background: #d4edda; text-decoration: none; }\ndel { background: #f8d7da; }\n.section-header, .section-footer { color: #666; font-style: italic; border-top: 1px solid #eee; padding-top: 0.5em; }\n.section-slide { border-top: 2px solid #333; padding-top: 1em; margin-top: 2em; }\n.section-textbox { border-left: 3px solid #ccc; padding-left: 1em; margin: 1em 0; }\nli.level-1 { margin-left: 1.5em; }\nli.level-2 { margin-left: 3em; }\nli.level-3 { margin-left: 4.5em; }\n</style>\n"

-- Convert a list of blocks to HTML
pure func htmlBlocksToStr(blocks: [Block]) -> string =
  foldl(\acc b. "${acc}${htmlBlockToStr(b)}", "", blocks)

-- Convert a single Block to HTML
pure func htmlBlockToStr(block: Block) -> string =
  match block {
    HeadingBlock(h) =>
      let tag = htmlHeadingTag(h.level) in
      let body = if listLength(h.runs) > 0 then htmlRunsToStr(h.runs) else xmlEscape(h.text) in
      "<${tag}>${body}</${tag}>\n",

    TextBlock(t) =>
      if t.style == "hr" then "<hr>\n"
      else if t.style == "quote" then "<blockquote><p>${if listLength(t.runs) > 0 then htmlRunsToStr(t.runs) else xmlEscape(t.text)}</p></blockquote>\n"
      else if t.style == "code" || startsWith(t.style, "code:")
      then "<pre><code>${xmlEscape(t.text)}</code></pre>\n"
      else if listLength(t.runs) > 0 || length(t.text) > 0
      then {
        -- Prefer runs: they carry clean text plus structure, where `text` for
        -- HTML-sourced blocks holds Markdown markers that would otherwise be
        -- escaped and rendered as literal "**bold**".
        let body = if listLength(t.runs) > 0
          then htmlRunsToStr(t.runs)
          else xmlEscape(t.text);
        if length(t.style) > 0 && t.style != "normal" && t.style != "Normal"
        then "<p class=\"${xmlEscape(t.style)}\">${body}</p>\n"
        else "<p>${body}</p>\n"
      }
      else "",

    TableBlock(t) =>
      htmlTableToStr(t.headers, t.rows),


    ListBlock(l) =>
      let body = htmlListItemsLevels(l.items, l.itemRuns, l.itemLevels) in
      if l.ordered
      then "<ol>\n${body}</ol>\n"
      else "<ul>\n${body}</ul>\n",

    -- src is built by imageSrcRef, which knows the difference between embedded
    -- base64 and a path/URL reference, and is escaped like every other attribute
    -- here. Both mattered: this branch used to interpolate i.mime and i.data raw
    -- while every sibling escaped, so an <img src='x" onerror="…'> in an input
    -- HTML document broke out of the attribute in the generated one.
    ImageBlock(i) =>
      let src = imageSrcRef(i.data, i.mime) in
      if length(src) > 0
      then "<figure><img src=\"${xmlAttrEscape(src)}\" alt=\"${xmlEscape(i.description)}\"/></figure>\n"
      else if length(i.description) > 0
        then "<p><em>[Image: ${xmlEscape(i.description)}]</em></p>\n"
        else "<p><em>[Image]</em></p>\n",

    AudioBlock(a) =>
      if length(a.transcription) > 0
      then "<blockquote><p><strong>Audio transcription:</strong> ${xmlEscape(a.transcription)}</p></blockquote>\n"
      else "<p><em>[Audio]</em></p>\n",

    VideoBlock(v) =>
      if length(v.description) > 0
      then "<p><em>[Video: ${xmlEscape(v.description)}]</em></p>\n"
      else "<p><em>[Video]</em></p>\n",

    SectionBlock(s) =>
      htmlSectionToStr(s.kind, s.name, s.blocks),

    ChangeBlock(c) =>
      htmlChangeToStr(c.changeType, c.author, c.date, c.text),

    LinkBlock(l) =>
      if length(l.title) > 0
      then "<p><a href=\"${xmlEscape(l.href)}\" title=\"${xmlEscape(l.title)}\">${xmlEscape(l.text)}</a></p>\n"
      else "<p><a href=\"${xmlEscape(l.href)}\">${xmlEscape(l.text)}</a></p>\n",

    -- Anchored comments render as a blockquote quoting the annotated span, so
    -- a reader sees comment and target together rather than having to guess.
    CommentBlock(c) =>
      if c.anchored && length(c.anchorText) > 0
      then "<aside class=\"comment\"><blockquote>${xmlEscape(c.anchorText)}</blockquote><p><strong>${xmlEscape(c.author)}</strong>: ${xmlEscape(c.text)}</p></aside>\n"
      else "<aside class=\"comment comment-unanchored\"><p><strong>${xmlEscape(c.author)}</strong> (unanchored): ${xmlEscape(c.text)}</p></aside>\n"
  }

-- Heading tag from level
pure func htmlHeadingTag(level: int) -> string =
  if level == 1 then "h1"
  else if level == 2 then "h2"
  else if level == 3 then "h3"
  else if level == 4 then "h4"
  else if level == 5 then "h5"
  else if level == 6 then "h6"
  else "h2"

-- Render inline runs as nested HTML inline elements.
--
-- Tags are emitted outermost-first in a fixed order so nesting is deterministic
-- and the output round-trips back through html_parser to the same flags.
-- <sup>/<sub> are innermost because they wrap the smallest span.
pure func htmlRunsToStr(runs: [InlineRun]) -> string =
  foldl(\acc r. "${acc}${htmlRunToStr(r)}", "", runs)

pure func htmlRunToStr(r: InlineRun) -> string {
  let inner = xmlEscape(r.text);
  let withVert = if r.vertAlign == "superscript" then "<sup>${inner}</sup>"
    else if r.vertAlign == "subscript" then "<sub>${inner}</sub>"
    else inner;
  let withCode = if r.code then "<code>${withVert}</code>" else withVert;
  let withStrike = if r.strike then "<del>${withCode}</del>" else withCode;
  let withUnder = if r.underline then "<u>${withStrike}</u>" else withStrike;
  let withItalic = if r.italic then "<em>${withUnder}</em>" else withUnder;
  if r.bold then "<strong>${withItalic}</strong>" else withItalic
}

-- List items, preferring per-item runs when present. itemRuns is parallel to
-- items but may be empty; both are walked together so a short or absent
-- itemRuns degrades to plain text rather than mis-pairing.
-- Nested items carry their depth as a class rather than reopening <ul>, which
-- would need lookahead to close correctly. The CSS indents on it.
pure func htmlListItemsLevels(items: [string], itemRuns: [[InlineRun]], levels: [int]) -> string =
  match items {
    [] => "",
    item :: rest => {
      let lvl = match levels { [] => 0, n :: _ => n };
      let restLevels = match levels { [] => [], _ :: t => t };
      let body = match itemRuns {
        [] => xmlEscape(item),
        r :: _ => if listLength(r) > 0 then htmlRunsToStr(r) else xmlEscape(item)
      };
      let restRuns = match itemRuns { [] => [], _ :: t => t };
      let cls = if lvl > 0 then " class=\"level-${intToStr(lvl)}\"" else "";
      "<li${cls}>${body}</li>\n${htmlListItemsLevels(rest, restRuns, restLevels)}"
    }
  }

pure func htmlListItemsRuns(items: [string], itemRuns: [[InlineRun]]) -> string =
  match items {
    [] => "",
    item :: rest =>
      match itemRuns {
        [] => "<li>${xmlEscape(item)}</li>\n${htmlListItemsRuns(rest, [])}",
        r :: rrest =>
          let body = if listLength(r) > 0 then htmlRunsToStr(r) else xmlEscape(item) in
          "<li>${body}</li>\n${htmlListItemsRuns(rest, rrest)}"
      }
  }

-- Render table with headers and rows
pure func htmlTableToStr(headers: [TableCell], rows: [[TableCell]]) -> string {
  let headerRow = if listLength(headers) > 0
    then "<thead><tr>${htmlHeaderCells(headers)}</tr></thead>\n"
    else "";
  let bodyRows = foldl(\acc row. "${acc}<tr>${htmlDataCells(row)}</tr>\n", "", rows);
  let body = if length(bodyRows) > 0
    then "<tbody>\n${bodyRows}</tbody>\n"
    else "";
  "<table>\n${headerRow}${body}</table>\n"
}

-- Render header cells as <th> with colspan support
pure func htmlHeaderCells(cells: [TableCell]) -> string =
  foldl(\acc c. "${acc}${htmlHeaderCell(c)}", "", cells)

pure func htmlHeaderCell(cell: TableCell) -> string {
  if cell.merged then ""
  else {
    let span = if cell.colSpan > 1 then " colspan=\"${intToStr(cell.colSpan)}\"" else "";
    "<th${span}${htmlAlignAttr(cell.align)}>${xmlEscape(cell.text)}</th>"
  }
}

-- Declared alignment, which the Markdown separator row carries and every
-- previous version discarded.
pure func htmlAlignAttr(align: string) -> string =
  if length(align) > 0 then " style=\"text-align:${align}\"" else ""

-- Render data cells as <td> with colspan support
pure func htmlDataCells(cells: [TableCell]) -> string =
  foldl(\acc c. "${acc}${htmlDataCell(c)}", "", cells)

pure func htmlDataCell(cell: TableCell) -> string {
  if cell.merged then ""
  else {
    let span = if cell.colSpan > 1 then " colspan=\"${intToStr(cell.colSpan)}\"" else "";
    "<td${span}${htmlAlignAttr(cell.align)}>${xmlEscape(cell.text)}</td>"
  }
}

-- Render list items
pure func htmlListItems(items: [string]) -> string =
  foldl(\acc item. "${acc}<li>${xmlEscape(item)}</li>\n", "", items)

-- Render section block with appropriate CSS class
pure func htmlSectionToStr(kind: string, name: string, blocks: [Block]) -> string {
  let cssClass = if kind == "slide" then "section-slide"
    else if kind == "sheet" then "section-sheet"
    else if kind == "header" then "section-header"
    else if kind == "footer" then "section-footer"
    else if kind == "footnote" then "section-footnote"
    else if kind == "endnote" then "section-endnote"
    else if kind == "textbox" then "section-textbox"
    else "section-other";
  -- The container's own name (sheet, slide, chapter) belongs in the markup, not
  -- only in the JSON — without it every sheet of a workbook renders as an
  -- anonymous <section>.
  let titleAttr = if length(name) > 0 then " title=\"${xmlEscape(name)}\"" else "";
  "<section class=\"${cssClass}\"${titleAttr}>\n${htmlBlocksToStr(blocks)}</section>\n"
}

-- Render track change as <ins> or <del> with attribution
pure func htmlChangeToStr(changeType: string, author: string, date: string, text: string) -> string {
  let attribution = " <small>(${xmlEscape(changeType)} by ${xmlEscape(author)}, ${xmlEscape(date)})</small>";
  if changeType == "delete" || changeType == "move-from"
  then "<del>${xmlEscape(text)}</del>${attribution}\n"
  else "<ins>${xmlEscape(text)}</ins>${attribution}\n"
}
