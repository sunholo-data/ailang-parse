module docparse/services/html_parser

import std/html (parse)
import std/xml (findAll, findFirst, getText, getAttr, getChildren, getTag, getAttrMap, nodeKind, NodeKind, KindElement, KindText, KindComment, flatMapChildren)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/string (length, trim, find, replace, join, stringToInt, substring, charAt)
import std/list (map, flatMap, filter, concat, length as listLength)
import std/map (lookup)
import docparse/types/document (mkText, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, LinkBlock, TableCell, DocMetadata, emptyMetadata, simpleCell, scopedCell, mkImageFull, mkTable, mkTableFull)

-- HTML Parser — converts HTML5 to Block ADT.
-- Pure AILANG implementation using std/html (WHATWG HTML5 spec via
-- golang.org/x/net/html), which returns the same XmlNode ADT as std/xml.
--
-- Reuses the same tree-walking pattern as DOCX/PPTX parsers but with
-- HTML tag names instead of Office XML namespaces.
--
-- Supports:
--   - Headings (h1 through h6)
--   - Paragraphs (p, div with text)
--   - Tables (table/thead/tbody/tr/th/td)
--   - Ordered and unordered lists (ol, ul, li)
--   - Images (img src + alt)
--   - Sections (article, section, main, aside, nav, header, footer)
--   - Inline text extraction (span, a, em, strong, b, i, code, etc.)
--
-- Lenient: handles real-world HTML5 (unclosed tags, boolean attributes,
-- overlapping nesting, mixed case, Word/Office namespaces, raw `<` in
-- text content, etc.) — std/html is a spec-compliant parser, not a
-- strict XML parser with a sanitizer pipeline in front.
--
-- Usage:
--   let blocks = parseHtml(content)

-- Parse HTML content string into Block ADT
-- Contract: returns error block on malformed input, never crashes
export pure func parseHtml(content: string) -> [Block]
  ensures { listLength(result) >= 0 }
{
  match parse(content) {
    Ok(root) => htmlExtractBlocks(root),
    Err(e) => [mkText("HTML parse error: ${e}", "error", 0)]
  }
}

-- Combined parse: extract both blocks and metadata in a SINGLE parse
-- pass. Used by main.ail to avoid running the std/html parser twice
-- on the same input (one for blocks, one for metadata). For an 80 KB
-- page like sunholo.com this halves the parse cost.
export pure func parseHtmlDoc(content: string) -> {blocks: [Block], metadata: DocMetadata} {
  match parse(content) {
    Ok(root) => {blocks: htmlExtractBlocks(root), metadata: htmlExtractMetadata(root)},
    Err(e) => {
      blocks: [mkText("HTML parse error: ${e}", "error", 0)],
      metadata: emptyMetadata()
    }
  }
}

-- Parse HTML document metadata from <head> children.
-- Extracts:
--   <title>             → DocMetadata.title
--   <meta name="author">                → DocMetadata.author
--   <meta name="description">           → DocMetadata.author fallback for description-as-byline
--   <meta property="og:title">          → DocMetadata.title fallback if <title> empty
--   <meta name="date">                  → DocMetadata.created
--   <meta property="article:published_time"> → DocMetadata.created fallback
--
-- Returns emptyMetadata() if no <head> or no <title> and no <meta> tags
-- are present. Pure: requires no FS / IO effects.
export pure func parseHtmlMetadata(content: string) -> DocMetadata {
  match parse(content) {
    Ok(root) => htmlExtractMetadata(root),
    Err(_) => emptyMetadata()
  }
}

-- Walk the parsed HTML tree to find <head> and extract title + metas.
pure func htmlExtractMetadata(root: XmlNode) -> DocMetadata {
  let title = htmlExtractTitle(root);
  let author = htmlExtractMeta(root, "author");
  let created = htmlExtractCreatedDate(root);
  {title: title, author: author, created: created, modified: "", pageCount: 0}
}

-- Find the <title> element anywhere in the tree (typically inside <head>).
-- Falls back to og:title if <title> is missing or empty.
pure func htmlExtractTitle(root: XmlNode) -> string {
  let direct = match findFirst(root, "title") {
    Some(t) => trim(getText(t)),
    None => ""
  };
  if length(direct) > 0 then direct
  else htmlExtractProperty(root, "og:title")
}

-- Look up <meta name="X" content="Y"> and return Y.
pure func htmlExtractMeta(root: XmlNode, name: string) -> string {
  htmlFindMetaContent(findAll(root, "meta"), "name", name)
}

-- Look up <meta property="X" content="Y"> and return Y (for OG tags).
pure func htmlExtractProperty(root: XmlNode, property: string) -> string {
  htmlFindMetaContent(findAll(root, "meta"), "property", property)
}

-- Walk a list of <meta> nodes, return the `content` attribute of the
-- first one whose attribute `attrName` equals `attrValue`.
pure func htmlFindMetaContent(metas: [XmlNode], attrName: string, attrValue: string) -> string {
  match metas {
    [] => "",
    m :: rest => {
      let actual = getOrElse(getAttr(m, attrName), "");
      if actual == attrValue
      then getOrElse(getAttr(m, "content"), "")
      else htmlFindMetaContent(rest, attrName, attrValue)
    }
  }
}

-- Prefer <meta name="date"> ISO date, fall back to article:published_time.
pure func htmlExtractCreatedDate(root: XmlNode) -> string {
  let direct = htmlExtractMeta(root, "date");
  if length(direct) > 0 then direct
  else htmlExtractProperty(root, "article:published_time")
}


-- Extract blocks from an HTML root element
-- Looks for <body> first; falls back to processing root children directly
pure func htmlExtractBlocks(root: XmlNode) -> [Block] {
  match findFirst(root, "body") {
    Some(body) => htmlProcessChildrenOf(body),
    None => {
      -- No <body> — might be a fragment or the root IS the content
      let tag = getTag(root);
      if tag == "html" then {
        -- Try to find body inside html
        let children = getChildren(root);
        let bodyChildren = flatMap(htmlFindBody, children);
        if listLength(bodyChildren) > 0 then bodyChildren
        else htmlProcessChildren(children)
      }
      else htmlProcessNode(root)
    }
  }
}

-- Helper to find body inside html children
pure func htmlFindBody(node: XmlNode) -> [Block] {
  let tag = getTag(node);
  if tag == "body" then htmlProcessChildrenOf(node)
  else []
}

-- Process a list of child nodes into blocks. Uses flatMap which is
-- backed by an iterative Go-native builtin (M-ITERATIVE-LIST).
-- Kept for the few callsites that already have a [XmlNode] (e.g. the
-- <picture> <source> filter). Most callsites use htmlProcessChildrenOf
-- instead, which avoids materialising the [XmlNode] list at all.
pure func htmlProcessChildren(nodes: [XmlNode]) -> [Block] =
  flatMap(htmlProcessNode, nodes)

-- Process a node's direct children into blocks via std/xml.flatMapChildren.
-- This is the v0.18.3 / M-STDLIB-XML-WALK-PERF M4 path: a Go-iterative
-- builtin reads children directly from the node and appends per-child
-- block lists into a single native slice. No [XmlNode] materialisation
-- (vs the old `flatMap(htmlProcessNode, getChildren(node))`), and no
-- AILANG-level accumulator cons + final reverse (which is what made
-- the earlier foldChildren attempt regress 229 MB → 395 MB on Mollie).
pure func htmlProcessChildrenOf(node: XmlNode) -> [Block] =
  flatMapChildren(node, htmlProcessNode)

-- Process a single HTML node into zero or more blocks
pure func htmlProcessNode(node: XmlNode) -> [Block] {
  -- Fast path: text nodes account for ~half of all flatMap invocations
  -- during a parse and have no tag-specific handling — they just need
  -- their text content extracted. Without this fast path each text
  -- node walks the full 30+ branch dispatch below before falling
  -- through to the default text handler. Measured on www.sunholo.com:
  -- ~500 text nodes × 30 string compares = 15,000 wasted comparisons.
  match nodeKind(node) {
    KindText =>
      let text = trim(getText(node)) in
      if length(text) > 0 then [mkText(text, "normal", 0)]
      else [],
    KindComment => [],
    KindElement => htmlProcessElement(node)
  }
}

-- Element-only dispatch (text + comment cases handled by the caller).
pure func htmlProcessElement(node: XmlNode) -> [Block] {
  let tag = getTag(node);

  -- Headings (rare per node but block-level elements).
  if tag == "h1" then [HeadingBlock({text: htmlDeepText(node), level: 1})]
  else if tag == "h2" then [HeadingBlock({text: htmlDeepText(node), level: 2})]
  else if tag == "h3" then [HeadingBlock({text: htmlDeepText(node), level: 3})]
  else if tag == "h4" then [HeadingBlock({text: htmlDeepText(node), level: 4})]
  else if tag == "h5" then [HeadingBlock({text: htmlDeepText(node), level: 5})]
  else if tag == "h6" then [HeadingBlock({text: htmlDeepText(node), level: 6})]

  -- Paragraphs
  else if tag == "p" then
    let text = trim(htmlDeepText(node)) in
    if length(text) > 0 then [mkText(text, "normal", 0)]
    else []

  -- Tables
  else if tag == "table" then [htmlParseTable(node)]

  -- Lists
  else if tag == "ul" then htmlParseList(node, false)
  else if tag == "ol" then htmlParseList(node, true)

  -- Images. Captures the full HTML5 attribute set: src, alt, width,
  -- height, srcset (responsive candidates), title (tooltip/caption),
  -- and loading (lazy/eager). Missing attributes default to 0 / empty
  -- string. Width and height parse the raw attribute value as an
  -- integer; non-numeric values (e.g. "100%") fall back to 0 because
  -- we don't model fractional/percentage sizes.
  else if tag == "img" then
    [htmlParseImg(node, "")]

  -- Anchors (<a href>) — HTML5 treats <a> as a "transparent" element
  -- that may wrap block-level content (e.g. `<a class="card"><img><h3>title</h3></a>`).
  -- Strategy: recurse into children to surface any block content (images,
  -- headings, nested structure), and ALSO emit a LinkBlock if href is
  -- present so the URL is captured. Anchors without href (named anchors,
  -- placeholders) collapse to text/blocks via children-recursion alone.
  else if tag == "a" then
    let href = getOrElse(getAttr(node, "href"), "") in
    let title = getOrElse(getAttr(node, "title"), "") in
    let inner = htmlProcessChildrenOf(node) in
    let linkText = trim(htmlDeepText(node)) in
    let textOnly = htmlBlocksAreTextOnly(inner) in
    if length(href) > 0 then
      -- Has href: anchor is a real link.
      -- If the inner content is just text, emit a single LinkBlock
      -- carrying both the visible text and the URL.
      -- If the inner content has structure (img, heading, nested blocks),
      -- emit the structured blocks first, then a LinkBlock describing
      -- the link itself (with the visible text or a "(link)" placeholder
      -- if the text is empty).
      if textOnly then
        if length(linkText) > 0
        then [LinkBlock({text: linkText, href: href, title: title})]
        else []
      else
        concat(inner, [LinkBlock({text: if length(linkText) > 0 then linkText else "(link)", href: href, title: title})])
    else
      -- No href: not really a link. Just produce inner content or text.
      if listLength(inner) > 0 then inner
      else if length(linkText) > 0 then [mkText(linkText, "normal", 0)]
      else []

  -- Semantic sections — recurse into children wrapped in SectionBlock
  else if tag == "article" || tag == "section" || tag == "main" ||
          tag == "aside" || tag == "nav" then
    let blocks = htmlProcessChildrenOf(node) in
    if listLength(blocks) > 0 then [SectionBlock({kind: tag, blocks: blocks})]
    else []

  -- Header/footer sections
  else if tag == "header" || tag == "footer" then
    let blocks = htmlProcessChildrenOf(node) in
    if listLength(blocks) > 0 then [SectionBlock({kind: tag, blocks: blocks})]
    else []

  -- Block-level containers that flatten into the parent stream.
  else if tag == "div" || tag == "blockquote" ||
          tag == "fieldset" || tag == "form" then
    htmlProcessChildrenOf(node)

  -- <figure>/<figcaption>: a figure is an image (or other media) with
  -- an attached caption. Emit a SectionBlock(kind: "figure") so the
  -- caption stays paired with the image instead of floating away.
  else if tag == "figure" then
    let blocks = htmlProcessChildrenOf(node) in
    if listLength(blocks) > 0 then [SectionBlock({kind: "figure", blocks: blocks})]
    else []

  -- <figcaption>: the caption inside a <figure>. Promoted to a small
  -- TextBlock with the "caption" style so consumers can recognise it.
  else if tag == "figcaption" then
    let text = trim(htmlDeepText(node)) in
    if length(text) > 0 then [mkText(text, "caption", 0)]
    else []

  -- <address>: contact info / authorship block. Treated as its own
  -- semantic section so it can be surfaced separately from body text.
  else if tag == "address" then
    let blocks = htmlProcessChildrenOf(node) in
    if listLength(blocks) > 0 then [SectionBlock({kind: "address", blocks: blocks})]
    else {
      let text = trim(htmlDeepText(node)) in
      if length(text) > 0 then [mkText(text, "address", 0)]
      else []
    }

  -- <details>/<summary>: collapsible disclosure widget. Treat as a
  -- SectionBlock(kind: "details") so the structure is preserved; the
  -- <summary> child (if present) renders as a level-3 heading inside.
  else if tag == "details" then
    let blocks = htmlProcessChildrenOf(node) in
    if listLength(blocks) > 0 then [SectionBlock({kind: "details", blocks: blocks})]
    else []

  -- <summary>: the disclosure caption inside a <details>. Promote to a
  -- heading so it stands out from the details body.
  else if tag == "summary" then
    let text = trim(htmlDeepText(node)) in
    if length(text) > 0 then [HeadingBlock({text: text, level: 3})]
    else []

  -- <picture> for responsive images: HTML5 picks one <source srcset>
  -- candidate at runtime and falls back to the <img> child. We collect
  -- all <source srcset> values (comma-joined) and attach them to the
  -- fallback <img>'s srcset attribute, then emit the <img> as a single
  -- ImageBlock. Any <img>'s own srcset takes priority and is preserved.
  else if tag == "picture" then
    htmlParsePicture(node)

  -- Pre/code blocks → TextBlock with code style. If the <pre> wraps a
  -- single <code class="language-X"> child, the language tag is
  -- captured as `code-X` in the style field; otherwise the style is
  -- just `code`.
  else if tag == "pre" then
    let text = htmlDeepText(node) in
    if length(text) > 0
    then [mkText(text, htmlPreCodeStyle(node), 0)]
    else []

  -- Definition lists
  else if tag == "dl" then htmlParseDl(node)

  -- Skip script, style, head, meta, link, noscript
  else if tag == "script" || tag == "style" || tag == "head" ||
          tag == "meta" || tag == "link" || tag == "noscript" ||
          tag == "template" then []

  -- Horizontal rule → section break marker
  else if tag == "hr" then [mkText("---", "separator", 0)]

  -- Line break — skip (inline element)
  else if tag == "br" then []

  -- Fallback: try to extract text from inline elements
  else
    let text = trim(htmlDeepText(node)) in
    if length(text) > 0 then [mkText(text, "normal", 0)]
    else []
}

-- Parse an <img> node into a Block. `inheritedSrcset` is non-empty
-- only when the <img> is the fallback inside a <picture> element —
-- in that case sibling <source> srcsets are concatenated and passed
-- in here so the resulting ImageBlock carries all candidates. If the
-- <img> itself has a srcset attribute, it takes priority (preserves
-- author intent).
pure func htmlParseImg(node: XmlNode, inheritedSrcset: string) -> Block {
  -- Pull the full attribute map in ONE FFI call rather than 7 separate
  -- getAttr calls. For an image-heavy page (100+ <img>) this trades 700
  -- FFI crossings for 100 + 100×7 hash lookups (which stay Go-side).
  let attrs = getAttrMap(node);
  let src = getOrElse(lookup(attrs, "src"), "");
  let alt = getOrElse(lookup(attrs, "alt"), "");
  let title = getOrElse(lookup(attrs, "title"), "");
  let loading = getOrElse(lookup(attrs, "loading"), "");
  let widthStr = getOrElse(lookup(attrs, "width"), "");
  let heightStr = getOrElse(lookup(attrs, "height"), "");
  let ownSrcset = getOrElse(lookup(attrs, "srcset"), "");
  let width = htmlParseDimension(widthStr);
  let height = htmlParseDimension(heightStr);
  let srcset = if length(ownSrcset) > 0 then ownSrcset else inheritedSrcset;
  mkImageFull(src, alt, "image/unknown", width, height, srcset, title, loading)
}

-- Parse an HTML width/height attribute as a non-negative pixel int.
-- HTML allows "100", "100px", "100%", or absent; we model only integer
-- pixel values, returning 0 for anything else (including percentages
-- and unitless floats).
pure func htmlParseDimension(s: string) -> int {
  if length(s) == 0 then 0
  else match stringToInt(s) {
    Some(n) => if n >= 0 then n else 0,
    None => 0
  }
}

-- Parse a <picture> element. Collect all <source srcset> values
-- (joined with ", ") and pass them as the inherited srcset for the
-- inner <img> fallback. <source> elements without srcset, and
-- non-<source>/<img> children, are ignored.
pure func htmlParsePicture(node: XmlNode) -> [Block] {
  let children = getChildren(node);
  let sourceSrcsets = filter(\s. length(s) > 0,
                             map(\c. if getTag(c) == "source"
                                     then getOrElse(getAttr(c, "srcset"), "")
                                     else "",
                                 children));
  let inheritedSrcset = join(", ", sourceSrcsets);
  flatMap(\c. if getTag(c) == "img"
              then [htmlParseImg(c, inheritedSrcset)]
              else [],
          children)
}

-- True if every block in the list is a plain text block (no images,
-- headings, tables, sections, etc.). Used by anchor handling to decide
-- whether to flatten an <a> to a single LinkBlock or to emit the inner
-- structured blocks alongside a LinkBlock.
pure func htmlBlocksAreTextOnly(blocks: [Block]) -> bool =
  match blocks {
    [] => true,
    block :: rest =>
      match block {
        TextBlock(_) => htmlBlocksAreTextOnly(rest),
        _ => false
      }
  }

-- Extract all text from a node and its children (deep text).
-- Inserts newlines around block-level child elements so that
-- "SummaryMaria reported..." becomes "Summary\nMaria reported...".
-- For leaf nodes (no children), falls back to getText().
pure func htmlDeepText(node: XmlNode) -> string {
  let children = getChildren(node);
  if listLength(children) == 0 then getText(node)
  else {
    let texts = map(htmlChildTextWithSpacing, children);
    let joined = join("", texts);
    htmlCollapseNewlines(joined)
  }
}

-- Render a child node's text, adding a newline before block-level tags
-- and wrapping inline elements with markdown-style markers so semantic
-- emphasis survives the parse → text → JSON → consumer pipeline.
-- Text nodes (tag == "") pass through as-is to preserve inline spacing.
pure func htmlChildTextWithSpacing(node: XmlNode) -> string {
  let tag = getTag(node);
  let text = htmlDeepText(node);
  if length(trim(text)) == 0 then
    -- Empty inline content. Even so, <br>/<wbr> produce structural
    -- whitespace; everything else collapses to nothing.
    if tag == "br" then "\n"
    else ""
  else if tag == "br" then "\n"
  else if htmlIsBlockTag(tag) then "\n${text}"
  else htmlInlineWrap(node, tag, text)
}

-- Wrap a non-empty inline child with the appropriate markdown marker.
-- Falls through to the plain text when the tag has no special inline
-- semantics. Markers chosen for compatibility with CommonMark / Pandoc /
-- typical LLM consumption.
pure func htmlInlineWrap(node: XmlNode, tag: string, text: string) -> string {
  if tag == "strong" || tag == "b" then "**${text}**"
  else if tag == "em" || tag == "i" then "*${text}*"
  else if tag == "code" || tag == "kbd" || tag == "samp" then "`${text}`"
  else if tag == "del" || tag == "s" then "~~${text}~~"
  else if tag == "mark" then "==${text}=="
  else if tag == "a" then htmlInlineAnchor(node, text)
  else if tag == "time" then htmlInlineTime(node, text)
  else if tag == "abbr" then htmlInlineAbbr(node, text)
  else if tag == "cite" || tag == "q" then "\"${text}\""
  else text
}

-- Inline anchor: emit `[text](href)` markdown link. If href is missing
-- or starts with "#" (anchor-only), drop the href and return text alone
-- so we don't pollute output with `[text](#)` for placeholder anchors.
pure func htmlInlineAnchor(node: XmlNode, text: string) -> string {
  let href = getOrElse(getAttr(node, "href"), "");
  if length(href) == 0 then text
  else if length(href) > 0 && htmlIsAnchorOnly(href) then text
  else "[${text}](${href})"
}

pure func htmlIsAnchorOnly(href: string) -> bool {
  length(href) > 0 && (find(href, "#") == 0)
}

-- Inline <time datetime="...">label</time>: include the datetime in
-- parens after the human label so the machine-readable timestamp
-- survives. If datetime is missing, just emit the label.
pure func htmlInlineTime(node: XmlNode, text: string) -> string {
  let dt = getOrElse(getAttr(node, "datetime"), "");
  if length(dt) > 0 && dt != text then "${text} (${dt})"
  else text
}

-- Inline <abbr title="...">label</abbr>: append the expansion in parens.
pure func htmlInlineAbbr(node: XmlNode, text: string) -> string {
  let title = getOrElse(getAttr(node, "title"), "");
  if length(title) > 0 then "${text} (${title})"
  else text
}

-- Style string for a <pre> block. If the <pre> wraps exactly one
-- <code class="language-X"> child, capture the language as `code-X`;
-- otherwise return `code`.
pure func htmlPreCodeStyle(pre: XmlNode) -> string {
  let children = getChildren(pre);
  match children {
    [singleChild] =>
      if getTag(singleChild) == "code" then htmlCodeLanguageStyle(singleChild)
      else "code",
    _ => "code"
  }
}

-- Pull `language-X` from a <code class="..."> attribute.
pure func htmlCodeLanguageStyle(code: XmlNode) -> string {
  let cls = getOrElse(getAttr(code, "class"), "");
  let prefix = "language-";
  let idx = find(cls, prefix);
  if idx < 0 then "code"
  else {
    -- Extract substring from end-of-prefix up to next space or end.
    let prefixLen = length(prefix);
    let start = idx + prefixLen;
    htmlCodeLangAt(cls, start, start)
  }
}

-- Scan from `start` forward, returning "code-<lang>" once we hit a
-- space, end of string, or non-language character. Lang chars are
-- alphanumeric and `-` (e.g. "objective-c", "csharp", "html5").
pure func htmlCodeLangAt(cls: string, start: int, i: int) -> string {
  if i >= length(cls) then "code-${trim(htmlCodeLangSubstring(cls, start, i))}"
  else {
    let c = charAt(cls, i);
    if c == " " || c == "\t" || c == "\n"
    then "code-${trim(htmlCodeLangSubstring(cls, start, i))}"
    else htmlCodeLangAt(cls, start, i + 1)
  }
}

pure func htmlCodeLangSubstring(s: string, start: int, end: int) -> string {
  if start >= end then ""
  else substring(s, start, end)
}

-- Collapse runs of 3+ newlines down to 2 (one blank line max).
-- Hot path: called by every htmlDeepText invocation, including on
-- short fragments that contain no triple-newline. The find() guard
-- short-circuits 95%+ of calls without any string allocation, and
-- avoids the O(n) substring comparison at the bottom of the recursion.
pure func htmlCollapseNewlines(s: string) -> string {
  if find(s, "\n\n\n") < 0 then s
  else {
    let collapsed = replace(s, "\n\n\n", "\n\n");
    if collapsed == s then s
    else htmlCollapseNewlines(collapsed)
  }
}

-- Is a tag a block-level HTML element that should have whitespace around it?
-- Ordered by observed frequency on real web pages (sunholo.com sample:
-- 132 <div>, 40 <p>, 37 <li>, 24 <h3>, ...). The chained || short-circuits
-- on the first match, so the most common tags should appear first.
pure func htmlIsBlockTag(tag: string) -> bool =
  tag == "div" || tag == "p" || tag == "li" || tag == "h3" ||
  tag == "section" || tag == "h2" || tag == "ul" || tag == "h1" ||
  tag == "table" || tag == "tr" || tag == "td" || tag == "th" ||
  tag == "ol" || tag == "blockquote" || tag == "pre" ||
  tag == "article" || tag == "header" || tag == "footer" ||
  tag == "nav" || tag == "aside" || tag == "figure" || tag == "figcaption" ||
  tag == "h4" || tag == "h5" || tag == "h6" ||
  tag == "dl" || tag == "dt" || tag == "dd" || tag == "hr"

-- Parse an HTML <table> into a TableBlock
-- Handles <thead>/<tbody> structure or flat <tr> rows
pure func htmlParseTable(table: XmlNode) -> Block
  ensures { isTable(result) }
{
  -- Try thead/tbody structure first
  let theadRows = htmlFindTheadRows(table);
  let tbodyRows = htmlFindTbodyRows(table);

  -- Fall back to direct <tr> children if no thead/tbody
  let directRows = findAll(table, "tr");

  let allRows = if listLength(theadRows) > 0 || listLength(tbodyRows) > 0
    then concat(theadRows, tbodyRows)
    else directRows;

  let parsedRows = map(htmlParseTableRow, allRows);

  -- Extract the optional <caption> (any depth under <table>).
  let caption = match findFirst(table, "caption") {
    Some(c) => trim(htmlDeepText(c)),
    None => ""
  };

  match parsedRows {
    [] => mkTableFull([], [], caption),
    firstRow :: dataRows =>
      mkTableFull(dataRows, firstRow, caption)
  }
}

-- Check if a block is a table (for contract)
pure func isTable(block: Block) -> bool =
  match block {
    TableBlock(_) => true,
    _ => false
  }

-- Find <tr> rows inside <thead>
pure func htmlFindTheadRows(table: XmlNode) -> [XmlNode] {
  match findFirst(table, "thead") {
    Some(thead) => findAll(thead, "tr"),
    None => []
  }
}

-- Find <tr> rows inside <tbody>
pure func htmlFindTbodyRows(table: XmlNode) -> [XmlNode] {
  match findFirst(table, "tbody") {
    Some(tbody) => findAll(tbody, "tr"),
    None => []
  }
}

-- Parse a single <tr> into TableCells
-- Contract: row-level cell count is preserved
pure func htmlParseTableRow(tr: XmlNode) -> [TableCell] {
  let thCells = findAll(tr, "th");
  let tdCells = findAll(tr, "td");
  let allCells = concat(thCells, tdCells);
  map(htmlParseTableCell, allCells)
}

-- Parse a <td> or <th> into a TableCell. Reads:
--   colspan / rowspan → cell merge dimensions
--   scope (on <th>)   → accessibility-style scope hint ("row" | "col" |
--                       "rowgroup" | "colgroup"); empty for <td>.
pure func htmlParseTableCell(cell: XmlNode) -> TableCell {
  let text = trim(htmlDeepText(cell));
  let colSpanStr = getOrElse(getAttr(cell, "colspan"), "1");
  let colSpan = htmlParseIntDefault(colSpanStr);
  let rowSpanStr = getOrElse(getAttr(cell, "rowspan"), "1");
  let rowSpan = htmlParseIntDefault(rowSpanStr);
  let scope = if getTag(cell) == "th"
              then getOrElse(getAttr(cell, "scope"), "")
              else "";
  {text: text, colSpan: colSpan, rowSpan: rowSpan, merged: false, scope: scope}
}

-- Parse an integer string for colspan/rowspan values
-- Contract: always returns at least 1 (spans cannot be zero or negative)
pure func htmlParseIntDefault(s: string) -> int
  ensures { result >= 1 }
{
  if s == "1" then 1
  else if s == "2" then 2
  else if s == "3" then 3
  else if s == "4" then 4
  else if s == "5" then 5
  else if s == "6" then 6
  else if s == "7" then 7
  else if s == "8" then 8
  else if s == "9" then 9
  else if s == "10" then 10
  else 1
}

-- Parse a <ul> or <ol> into a ListBlock
-- Contract: produces exactly one ListBlock if items exist
pure func htmlParseList(list: XmlNode, ordered: bool) -> [Block] {
  let items = findAll(list, "li");
  let texts = map(htmlDeepText, items);
  let nonEmpty = filter(\t. length(trim(t)) > 0, texts);
  if listLength(nonEmpty) > 0
  then [ListBlock({items: map(trim, nonEmpty), ordered: ordered})]
  else []
}

-- Parse a <dl> (definition list) into blocks
-- Each <dt>/<dd> pair becomes a text block
pure func htmlParseDl(dl: XmlNode) -> [Block] {
  let children = getChildren(dl);
  flatMap(htmlParseDlChild, children)
}

-- Process a single <dt> or <dd> node
pure func htmlParseDlChild(node: XmlNode) -> [Block] {
  let tag = getTag(node);
  let text = trim(htmlDeepText(node));
  if tag == "dt" && length(text) > 0
    then [mkText(text, "dt", 0)]
  else if tag == "dd" && length(text) > 0
    then [mkText(text, "dd", 0)]
  else []
}
