module docparse/services/layout_ai

import std/ai (call, callJson, callJsonSimple, callResult, AIError)
import std/string (length, join, substring, startsWith, find, contains, split, toLower)
import std/json (decode, encode, jo, kv, js, getString, getArray, getInt, asString, asArray, asNumber)
import std/math (floatToInt)
import std/option (Some, None, flatMap as optFlatMap, getOrElse)
import std/result (Ok, Err)
import std/list (map, foldl, length as listLength, flatMap, mapE, nth, concat, take, last_or)
import std/fs (readFileBytes)
import docparse/types/document (Block, TextBlock, TableBlock, ImageBlock, AudioBlock, VideoBlock, HeadingBlock, ListBlock, SectionBlock, ChangeBlock, LinkBlock, TableCell, blockText, isImage, isTable, cellText, simpleCell, mkImage, mkTable)

-- AI-powered layout understanding
-- Uses LLM to handle complex document structure that pure XML parsing misses:
--   - Table structure inference (merged cells, nested tables)
--   - Reading order for multi-column layouts
--   - Image content description
--   - Complex list nesting
--
-- Budget: AI @limit=N ensures bounded cost per document.
-- Pure parsing handles the deterministic parts; AI handles ambiguity.

-- What an ImageBlock.data string actually refers to. Office/EPUB/ODF parsers
-- embed raw base64; the HTML parser stores the <img src> verbatim, which may be
-- a data: URI, a local file path, or a remote URL.
type ImageSource
  = InlineBase64(string)   -- bytes in hand (embedded base64 or decoded data: URI)
  | LocalFile(string)      -- path to read from disk, relative to the doc's dir
  | RemoteUrl(string)      -- http(s) — not fetched by the CLI (warned)
  | NotAnImage             -- empty / unusable reference

-- Describe every image in a document using AI vision.
--
-- Resolves each image's source rather than assuming embedded base64:
--   * embedded base64 and data: URIs      -> described directly
--   * local file refs (<img src="a/x.png">) -> read from disk relative to baseDir
--   * remote URLs / unreadable files       -> a WARNING, never a silent no-op
--
-- Returns the described blocks alongside the warnings raised and the real number
-- of AI calls made, so callers can surface both instead of guessing.
export func describeImages(baseDir: string, blocks: [Block]) -> {blocks: [Block], warnings: [string], aiCalls: int} ! {AI, FS}
  ensures { listLength(result.blocks) == listLength(blocks) }
{
  layoutDescribeList(baseDir, blocks)
}

func layoutDescribeList(baseDir: string, blocks: [Block]) -> {blocks: [Block], warnings: [string], aiCalls: int} ! {AI, FS} =
  match blocks {
    [] => { blocks: [], warnings: [], aiCalls: 0 },
    b :: rest => {
      let h = layoutDescribeOne(baseDir, b);
      let t = layoutDescribeList(baseDir, rest);
      { blocks: h.block :: t.blocks,
        warnings: concat(h.warnings, t.warnings),
        aiCalls: h.aiCalls + t.aiCalls }
    }
  }

func layoutDescribeOne(baseDir: string, b: Block) -> {block: Block, warnings: [string], aiCalls: int} ! {AI, FS} =
  match b {
    ImageBlock(img) =>
      match layoutClassifySource(img.data) {
        InlineBase64(b64) => {
          let mime = layoutEffectiveMime(img.mime, img.data);
          let r = layoutDescribeBytes(b64, mime, "embedded image");
          { block: ImageBlock({img | description: layoutPickDesc(r.desc, img.description)}), warnings: r.warnings, aiCalls: r.calls }
        },
        LocalFile(path) => {
          let full = layoutJoinPath(baseDir, path);
          match readFileBytes(full) {
            Ok(b64) => {
              let r = layoutDescribeBytes(b64, layoutMimeFromPath(path), "'${path}'");
              { block: ImageBlock({img | description: layoutPickDesc(r.desc, img.description)}), warnings: r.warnings, aiCalls: r.calls }
            },
            Err(_) => { block: b, warnings: ["describe: could not read linked image '${path}' (looked in '${baseDir}') — left undescribed"], aiCalls: 0 }
          }
        },
        RemoteUrl(url) => { block: b, warnings: ["describe: remote image '${url}' not fetched — the CLI does not download remote images"], aiCalls: 0 },
        NotAnImage => { block: b, warnings: [], aiCalls: 0 }
      },
    SectionBlock(s) => {
      let inner = layoutDescribeList(baseDir, s.blocks);
      { block: SectionBlock({kind: s.kind, blocks: inner.blocks}), warnings: inner.warnings, aiCalls: inner.aiCalls }
    },
    _ => { block: b, warnings: [], aiCalls: 0 }
  }

-- Classify what an ImageBlock.data string refers to. Base64 uses the alphabet
-- A-Za-z0-9+/= and so never contains "."; a real file reference carries an
-- extension dot. That "." is the discriminator between a long embedded blob and
-- a path.
pure func layoutClassifySource(data: string) -> ImageSource {
  if length(data) == 0 then NotAnImage
  else if startsWith(data, "data:") then {
    let idx = find(data, ",");
    if idx >= 0 then InlineBase64(substring(data, idx + 1, length(data)))
    else NotAnImage
  }
  else if startsWith(data, "http://") || startsWith(data, "https://") then RemoteUrl(data)
  else if length(data) > 100 && contains(data, ".") == false then InlineBase64(data)
  else LocalFile(data)
}

-- Send image bytes to the AI as a real multimodal request (mode=multimodal),
-- NOT base64 interpolated into a text prompt — the old path did the latter,
-- which risks the documented call() truncation and is not seen as an image.
-- Fail-soft: an AI error on one image (e.g. a corrupt/rejected file) becomes a
-- warning and an empty description, rather than aborting the whole parse.
func layoutDescribeBytes(base64: string, mime: string, label: string) -> {desc: string, warnings: [string], calls: int} ! {AI} {
  let request = encode(jo([
    kv("mode", js("multimodal")),
    kv("mimeType", js(mime)),
    kv("data", js(base64)),
    kv("prompt", js(layoutDescribePrompt()))
  ]));
  match callResult(request) {
    Ok(text) => { desc: text, warnings: [], calls: 1 },
    Err(e) => { desc: "", warnings: ["describe: AI could not describe ${label} — ${e.message}"], calls: 0 }
  }
}

-- Keep an existing description (e.g. HTML alt text) if the AI returned nothing.
pure func layoutPickDesc(aiDesc: string, existing: string) -> string =
  if length(aiDesc) > 0 then aiDesc else existing

-- Reading-first, not OCR-first: describe what a chart CONVEYS (trend/shape),
-- then note the labels — the reverse of the old "one sentence, any text visible".
pure func layoutDescribePrompt() -> string =
  "Describe this image for a reader who cannot see it. If it is a chart, graph, or plot: name the chart type, state each axis and its units, and describe the shape and trend of the plotted data — where it rises, falls, peaks, and any notable values or inflection points. If it is a diagram, screenshot, or photo: say what it shows and how it is laid out. Then note any visible text or labels. Be concise but complete (2-4 sentences)."

pure func layoutEffectiveMime(imgMime: string, data: string) -> string {
  if imgMime != "image/unknown" && imgMime != "" then imgMime
  else if startsWith(data, "data:") then layoutDataUriMime(data)
  else "image/unknown"
}

-- Extract the MIME from a data: URI header, e.g. "data:image/png;base64,..." -> "image/png".
pure func layoutDataUriMime(data: string) -> string {
  let afterPrefix = substring(data, 5, length(data));
  let semi = find(afterPrefix, ";");
  let comma = find(afterPrefix, ",");
  let end = if semi >= 0 then semi else (if comma >= 0 then comma else length(afterPrefix));
  substring(afterPrefix, 0, end)
}

pure func layoutMimeFromPath(path: string) -> string {
  let parts = split(path, ".");
  let ext = toLower(last_or(parts, ""));
  if ext == "png" then "image/png"
  else if ext == "jpg" || ext == "jpeg" then "image/jpeg"
  else if ext == "gif" then "image/gif"
  else if ext == "webp" then "image/webp"
  else if ext == "bmp" then "image/bmp"
  else if ext == "svg" then "image/svg+xml"
  else if ext == "tif" || ext == "tiff" then "image/tiff"
  else "image/unknown"
}

pure func layoutJoinPath(base: string, rel: string) -> string {
  if startsWith(rel, "/") then rel
  else if base == "" || base == "." then rel
  else "${base}/${rel}"
}

-- Directory portion of a file path (everything before the last "/").
-- Used to resolve <img src> relative to the document, not the process CWD.
export pure func dirOf(path: string) -> string {
  let parts = split(path, "/");
  let n = listLength(parts);
  if n <= 1 then "."
  else join("/", take(n - 1, parts))
}

-- Use AI to infer table structure from raw cell data
-- Handles: merged cells, header detection, nested tables
export func inferTableStructure(block: Block) -> Block ! {AI}
  ensures { isTable(block) || isTable(result) == false }
{
  match block {
    TableBlock(tbl) => {
      let tableDesc = formatTableForAI(tbl.headers, tbl.rows);
      let tableSchema = "{\"type\":\"object\",\"properties\":{\"headers\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"rows\":{\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}}}";
      let response = callJson(
        "Analyze this table and return a JSON object with: \"headers\": [list of header strings], \"rows\": [[row1 cells], [row2 cells], ...]. Fix any merged cell issues, align columns, and clean up whitespace. Table data:\n${tableDesc}",
        tableSchema
      );
      match parseTableResponse(response) {
        Some(fixed) => fixed,
        None => block
      }
    },
    _ => block
  }
}

-- Use AI to determine reading order for complex layouts
-- Multi-column documents, text boxes, floating elements
export func inferReadingOrder(blocks: [Block]) -> [Block] ! {AI}
  ensures { listLength(blocks) == 0 || listLength(result) > 0 }
{
  let blockSummary = summarizeBlocks(blocks, 0);
  let response = callJsonSimple(
    "Given these document blocks in their original order, return the correct reading order as a JSON array of block indices (0-based). Consider: multi-column layouts should be read column by column, headers before their content, captions near their images.\nBlocks:\n${blockSummary}"
  );
  match parseOrderResponse(response, blocks) {
    Some(reordered) => reordered,
    None => blocks
  }
}

-- Use AI to clean up and structure extracted text
-- Fixes: broken paragraphs, OCR artifacts, encoding issues
export func cleanExtractedText(blocks: [Block]) -> [Block] ! {AI}
  ensures { listLength(result) == 1 }
{
  let rawText = collectBlockTexts(blocks);
  let response = call(
    "Clean up this extracted document text. Fix: broken paragraphs (merge lines that were split mid-sentence), remove OCR artifacts, fix obvious encoding issues. Return the cleaned text with paragraph breaks as \\n\\n.\n\n${rawText}"
  );
  [TextBlock({text: response, style: "cleaned", level: 0})]
}

-- Enhance blocks using AI when quality issues are detected
-- This is the "self-healing" step: after deterministic parsing,
-- AI fixes tables with empty/ambiguous cells, and reorders blocks if needed.
-- Only calls AI when heuristics detect a problem - doesn't waste budget on good blocks.
export func enhanceBlocks(blocks: [Block]) -> [Block] ! {AI}
  ensures { listLength(result) == listLength(blocks) }
{
  mapE(enhanceOneBlock, blocks)
}

func enhanceOneBlock(b: Block) -> Block ! {AI} =
  match b {
    TableBlock(tbl) =>
      if tableNeedsAI(tbl.headers, tbl.rows)
      then inferTableStructure(b)
      else b,
    SectionBlock(s) => {
      let innerEnhanced = mapE(enhanceOneBlock, s.blocks);
      SectionBlock({kind: s.kind, blocks: innerEnhanced})
    },
    _ => b
  }

-- Heuristic: does this table have quality issues that AI could fix?
-- Triggers on: all-empty cells, many merged cells, misaligned columns
pure func tableNeedsAI(headers: [TableCell], rows: [[TableCell]]) -> bool {
  let emptyHeaders = countEmptyCells(headers);
  let totalHeaders = countCellsLen(headers);
  let emptyRows = countEmptyRows(rows);
  let totalRows = countRows(rows);
  let mergedCount = aiCountMergedCells(headers) + aiCountMergedInRows(rows);
  -- Trigger AI if: all headers empty, or >50% rows empty, or many merged cells
  (totalHeaders > 0 && emptyHeaders == totalHeaders) ||
  (totalRows > 0 && emptyRows * 2 > totalRows) ||
  mergedCount > 3
}

pure func countEmptyCells(cells: [TableCell]) -> int =
  foldl(\acc c. if length(cellText(c)) == 0 then acc + 1 else acc, 0, cells)

pure func countCellsLen(cells: [TableCell]) -> int = listLength(cells)

pure func countEmptyRows(rows: [[TableCell]]) -> int =
  foldl(\acc row. if isRowEmpty(row) then acc + 1 else acc, 0, rows)

pure func isRowEmpty(cells: [TableCell]) -> bool =
  foldl(\acc c. acc && length(cellText(c)) == 0, true, cells)

pure func aiCountMergedCells(cells: [TableCell]) -> int =
  foldl(\acc c. if c.merged then acc + 1 else acc, 0, cells)

pure func aiCountMergedInRows(rows: [[TableCell]]) -> int =
  foldl(\acc row. acc + aiCountMergedCells(row), 0, rows)

-- Format a table for AI analysis
pure func formatTableForAI(headers: [TableCell], rows: [[TableCell]]) -> string {
  let headerLine = "Headers: ${joinTableCells(headers)}";
  let rowLines = formatRows(rows, 1);
  "${headerLine}\n${rowLines}"
}

pure func formatRows(rows: [[TableCell]], idx: int) -> string =
  match rows {
    [] => "",
    row :: rest =>
      "Row ${show(idx)}: ${joinTableCells(row)}\n${formatRows(rest, idx + 1)}"
  }

pure func joinTableCells(cells: [TableCell]) -> string =
  join(" | ", map(cellText, cells))

-- Summarize blocks for AI ordering
pure func summarizeBlocks(blocks: [Block], idx: int) -> string =
  match blocks {
    [] => "",
    b :: rest =>
      "${show(idx)}: ${blockSummary(b)}\n${summarizeBlocks(rest, idx + 1)}"
  }

pure func blockSummary(b: Block) -> string =
  match b {
    TextBlock(t) => "[text] ${truncateStr(t.text, 60)}",
    HeadingBlock(h) => "[h${show(h.level)}] ${h.text}",
    TableBlock(t) => "[table] ${show(countRows(t.rows))} rows",
    ListBlock(l) => "[list] ${show(aiCountItems(l.items))} items",
    ImageBlock(i) => "[image] ${i.mime}",
    AudioBlock(a) => "[audio] ${a.mime}",
    VideoBlock(v) => "[video] ${v.mime}",
    SectionBlock(s) => "[${s.kind}] ${show(aiCountItems2(s.blocks))} blocks",
    ChangeBlock(c) => "[${c.changeType}] ${truncateStr(c.text, 60)}",
    LinkBlock(l) => "[link] ${truncateStr(l.text, 40)} → ${truncateStr(l.href, 60)}"
  }

pure func aiCountItems2(blocks: [Block]) -> int = listLength(blocks)

pure func truncateStr(s: string, maxLen: int) -> string {
  if length(s) <= maxLen then s
  else "${substring(s, 0, maxLen)}..."
}

pure func countRows(rows: [[TableCell]]) -> int = listLength(rows)

pure func aiCountItems(items: [string]) -> int = listLength(items)

-- Collect all text from blocks
pure func collectBlockTexts(blocks: [Block]) -> string =
  join("\n", map(blockText, blocks))

-- Parse AI response for table structure
pure func parseTableResponse(response: string) -> Option[Block] {
  match decode(response) {
    Ok(json) =>
      optFlatMap(\headerJsons.
        let headers = aiStringsToSimpleCells2(aiExtractStrings2(headerJsons)) in
        optFlatMap(\rowJsons.
          let rows = stringRowsToSimpleCells(extractStringArrays(rowJsons)) in
          Some(mkTable(rows, headers)),
          getArray(json, "rows")),
        getArray(json, "headers")),
    Err(_) => None
  }
}

-- Convert string lists to simple TableCell lists (for AI-reconstructed tables)
pure func aiStringsToSimpleCells2(strs: [string]) -> [TableCell] =
  map(simpleCell, strs)

pure func stringRowsToSimpleCells(rows: [[string]]) -> [[TableCell]] =
  map(aiStringsToSimpleCells2, rows)

-- Parse AI response for reading order
-- Expects a JSON array of integers (block indices)
pure func parseOrderResponse(response: string, blocks: [Block]) -> Option[[Block]] {
  match decode(response) {
    Ok(json) => match asArray(json) {
      Some(indices) => {
        let reordered = reorderByIndices(extractInts(indices), blocks);
        if aiCountItems2(reordered) > 0 then Some(reordered)
        else None
      },
      None => None
    },
    Err(_) => None
  }
}

-- Extract integers from a JSON array of numbers
pure func extractInts(jsons: [Json]) -> [int] =
  flatMap(\j. match asNumber(j) {
    Some(n) => [floatToInt(n)],
    None => []
  }, jsons)

-- Reorder blocks by index list
pure func reorderByIndices(indices: [int], blocks: [Block]) -> [Block] =
  flatMap(\idx. match nth(blocks, idx) {
    Some(b) => [b],
    None => []
  }, indices)

-- Extract strings from JSON array
pure func aiExtractStrings2(jsons: [Json]) -> [string] =
  flatMap(\j. match asString(j) {
    Some(s) => [s],
    None => []
  }, jsons)

-- Extract arrays of strings from JSON array of arrays
pure func extractStringArrays(jsons: [Json]) -> [[string]] =
  map(\j. match getArray(j, "") {
    Some(arr) => aiExtractStrings2(arr),
    None => []
  }, jsons)
