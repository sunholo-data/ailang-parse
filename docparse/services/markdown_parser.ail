module docparse/services/markdown_parser

import std/string (split, trim, length, startsWith, endsWith, substring, find, contains, charAt, join)
import std/list (map, foldl, reverse, length as listLength)
import docparse/types/document (DocMetadata, emptyMetadata, mkHeading, mkHeadingRuns, mkList, mkListNested, mkText, mkTextRuns, mkImage, mkTable, InlineRun, Block)
import docparse/services/markdown_inline (mdInlineRuns as mdScanInline, mdRunsText, mdRunsFormatted, mdAnyFormatted)
import docparse/services/markdown_table (mdSplitCells, mdCellAlign, mdCellFromText, mdCellsWidth, mdFitCells, mdApplyAligns, mdParseTableRow, mdIsTableSeparator)
import docparse/services/markdown_roundtrip (mdQuoteBlocks)

-- Markdown Parser — converts Markdown text to Block ADT.
-- Pure AILANG implementation, no external dependencies.
--
-- Supports:
--   - Headings (# through ######)
--   - Paragraphs (text blocks separated by blank lines)
--   - Unordered lists (- or * prefix)
--   - Ordered lists (1. 2. etc prefix)
--   - Simple tables (| col | col | format)
--   - Blockquotes (>)
--   - Code blocks (``` fenced, and 4-space / tab indented)
--   - Comments and track changes, in the exact blockquote syntax
--     markdown_writer.renderCommentMd / renderChangeMd emit, so the
--     docx -> md -> docx waypoint is lossless instead of silently demoting
--     both to inert quote text.
--
-- Does NOT handle (yet):
--   - Inline formatting (bold, italic, links)
--   - Images (![alt](url))
--
-- Usage:
--   let blocks = parseMarkdown(content)
--
-- Split for the per-module WASM type-check budget, the same remedy the
-- output_formatter split used (see markdown_writer's header): the browser
-- workbench type-checks each loaded module against a wall-clock budget —
-- 8s on the current embedder config — and the combined module exceeded it on
-- ordinary visitor hardware (68608 type-checker steps at mdProcessLine), so
-- DOCX files exercising tracked changes and comments came back "Parse
-- failed." No single function dominates; the cost is the accumulation of the
-- whole module. Three halves moved out, each importing only what it needs:
--
--   markdown_inline    the inline scanner (mdInlineRuns) + runs helpers
--   markdown_table     table rows, cells, colSpan/merged topology, widths
--   markdown_roundtrip comment + track-change blockquote readers
--
-- The public API is unchanged: parseMarkdown, parseMarkdownMeta and
-- mdInlineRuns are still exported from HERE, so every importer (orchestrator,
-- docparse_browser, the SDKs' module lists) is unaffected.

-- Parse markdown content into Block ADT
-- Contract: empty content produces no blocks
export pure func parseMarkdown(content: string) -> [Block]
  ensures { length(content) > 0 || listLength(result) == 0 }
{
  let split0 = mdSplitFrontMatter(content);
  let lines = split(split0.body, "\n");
  let result = foldl(mdProcessLine, emptyParseState(), lines);
  -- Flush any remaining accumulated state
  reverse(flushState(result))
}

-- YAML front matter is how a Markdown author states a document's title and
-- author, and it is the only way an AI writing Markdown can set them: without
-- it every generated DOCX carries empty core properties. Recognised only as
-- the very first line, so a thematic break further down keeps its meaning.
export pure func parseMarkdownMeta(content: string) -> DocMetadata {
  let fm = mdSplitFrontMatter(content);
  if length(fm.front) == 0 then emptyMetadata()
  else {
    let fields = split(fm.front, "\n");
    { title: mdFrontField(fields, "title"),
      author: mdFrontField(fields, "author"),
      created: mdFrontField(fields, "date"),
      modified: "",
      pageCount: 0 }
  }
}

type MdFront = { front: string, body: string }

pure func mdSplitFrontMatter(content: string) -> MdFront =
  if not startsWith(content, "---\n") then { front: "", body: content }
  else {
    let rest = substring(content, 4, length(content));
    let close = find(rest, "\n---");
    if close < 0 then { front: "", body: content }
    else {
      let after = substring(rest, close + 4, length(rest));
      -- Tolerate "---", "---\n" and "--- \n" as the closing fence.
      let body = if startsWith(after, "\n") then substring(after, 1, length(after))
                 else if startsWith(after, "-") then after
                 else after;
      { front: substring(rest, 0, close), body: body }
    }
  }

-- One "key: value" line. Quotes around the value are stripped, since YAML
-- writers add them whenever the value contains a colon.
pure func mdFrontField(fields: [string], key: string) -> string =
  match fields {
    [] => "",
    line :: rest =>
      if startsWith(trim(line), "${key}:")
      then mdStripQuotes(trim(substring(trim(line), length(key) + 1, length(trim(line)))))
      else mdFrontField(rest, key)
  }

pure func mdStripQuotes(v: string) -> string {
  let n = length(v);
  if n >= 2 && ((startsWith(v, "\"") && endsWith(v, "\"")) ||
                (startsWith(v, "'") && endsWith(v, "'")))
  then substring(v, 1, n - 1)
  else v
}

-- Internal parse state tracks accumulated lines for multi-line blocks.
-- Every accumulator is held in reverse and reversed once at flush: appending
-- with concat(xs, [x]) inside a fold over lines is quadratic.
type MdParseState = {
  blocks: [Block],       -- accumulated blocks (in reverse order)
  listItems: [string],   -- accumulated list items (reversed)
  listOrdered: bool,     -- is current list ordered?
  tableRows: [[string]], -- accumulated table rows (reversed)
  textLines: [string],   -- accumulated paragraph lines (reversed)
  codeLines: [string],   -- accumulated fenced-code lines (reversed)
  indentCode: [string],  -- accumulated indented-code-block lines (reversed)
  quoteLines: [string],  -- accumulated blockquote lines (reversed)
  tableAligns: [string], -- per-column alignment from the separator row
  itemLevels: [int],     -- nesting depth per list item (reversed)
  inCode: bool,          -- inside a ``` fence
  codeLang: string       -- info string of the open fence, "" when absent
}

-- Contract: empty state has no accumulated content
pure func emptyParseState() -> MdParseState
  ensures {
    listLength(result.blocks) == 0 &&
    listLength(result.listItems) == 0 &&
    listLength(result.tableRows) == 0 &&
    listLength(result.textLines) == 0
  }
= {
  blocks: [],
  listItems: [],
  listOrdered: false,
  tableRows: [],
  textLines: [],
  codeLines: [],
  indentCode: [],
  quoteLines: [],
  tableAligns: [],
  itemLevels: [],
  inCode: false,
  codeLang: ""
}

-- Process a single line, updating parse state
pure func mdProcessLine(state: MdParseState, line: string) -> MdParseState {
  let trimmedLine = trim(line);

  -- Inside a fence, nothing is markup: the line is code, verbatim and
  -- untrimmed. Running the inline scanner over it would eat the backticks out
  -- of a shell command and the asterisks out of a C pointer.
  if state.inCode then
    if startsWith(trimmedLine, "```") then mdFlushCode(state)
    else { state | codeLines: line :: state.codeLines }

  -- Opening fence
  else if startsWith(trimmedLine, "```") then
    let s = flushToState(state) in
    { s | inCode: true, codeLang: trim(substring(trimmedLine, 3, length(trimmedLine))), codeLines: [] }

  -- Blank line: flush current paragraph/list. Inside an indented code block a
  -- blank line is content (CommonMark keeps interior blanks), not a terminator
  -- — the block ends only on a dedented non-blank line.
  else if length(trimmedLine) == 0 then
    if not mdIsEmptyList(state.indentCode)
    then { state | indentCode: "" :: state.indentCode }
    else flushToState(state)

  -- Heading: # through ######
  else if startsWith(trimmedLine, "######") then mdHeadingState(state, trimmedLine, 6)
  else if startsWith(trimmedLine, "#####") then mdHeadingState(state, trimmedLine, 5)
  else if startsWith(trimmedLine, "####") then mdHeadingState(state, trimmedLine, 4)
  else if startsWith(trimmedLine, "###") then mdHeadingState(state, trimmedLine, 3)
  else if startsWith(trimmedLine, "##") then mdHeadingState(state, trimmedLine, 2)
  else if startsWith(trimmedLine, "#") then mdHeadingState(state, trimmedLine, 1)

  -- Thematic break: --- / *** / ___ on a line of its own. Only when no
  -- paragraph is open, so a setext underline keeps its current reading rather
  -- than silently changing meaning.
  else if mdIsEmptyList(state.textLines) && mdIsThematicBreak(trimmedLine) then
    let s = flushToState(state) in
    { s | blocks: mkText("", "hr", 0) :: s.blocks }

  -- Unordered list item: - or *. Depth comes from the RAW line's indentation,
  -- which is why it is measured before trimming.
  else if startsWith(trimmedLine, "- ") || startsWith(trimmedLine, "* ") then
    let s = flushText(flushTable(flushIndentCode(state))) in
    let item = trim(substring(trimmedLine, 2, length(trimmedLine))) in
    { s | listItems: item :: s.listItems, listOrdered: false,
          itemLevels: mdIndentLevel(line) :: s.itemLevels }

  -- Unicode bullet glyphs as unordered list markers. GFM only knows - * +,
  -- but content that CAME from Word carries literal bullet characters — a
  -- copied-out list is exactly "• item" lines — and hand-written documents
  -- use them too. Without this those lines parse as one plain paragraph and
  -- the generated DOCX shows literal • runs that do not behave as a list: no
  -- renumbering, no demote/promote, indent lost on paste. The marker set is
  -- the unambiguous bullet glyphs (Word's paste set plus common round/hyphen
  -- variants); en dash and middle dot are deliberately excluded because they
  -- are live punctuation in prose (ranges, ellipses) and would false-fire.

  else if mdIsUnicodeBullet(trimmedLine) then
    let s = flushText(flushTable(flushIndentCode(state))) in
    let item = trim(substring(trimmedLine, 1, length(trimmedLine))) in
    { s | listItems: item :: s.listItems, listOrdered: false,
          itemLevels: mdIndentLevel(line) :: s.itemLevels }

  -- Ordered list item: starts with digit followed by ". "
  else if mdIsOrderedListItem(trimmedLine) then
    let s = flushText(flushTable(flushIndentCode(state))) in
    let item = mdExtractOrderedItem(trimmedLine) in
    { s | listItems: item :: s.listItems, listOrdered: true,
          itemLevels: mdIndentLevel(line) :: s.itemLevels }

  -- Table row: starts and ends with |
  else if startsWith(trimmedLine, "|") then
    -- Skip separator rows (| --- | --- |)
    -- The separator row is where alignment is declared. It used to be skipped
    -- outright, so ":---:" was read and then thrown away.
    if mdIsTableSeparator(trimmedLine)
    then { state | tableAligns: map(mdCellAlign, mdSplitCells(trimmedLine)) }
    else
      let s = flushText(flushList(flushIndentCode(state))) in
      let cells = mdParseTableRow(trimmedLine) in
      { s | tableRows: cells :: s.tableRows }

  -- Blockquote: "> quoted". Consecutive lines join into one quoted
  -- paragraph. Without this the ">" survived as a literal character in the
  -- text and every generator rendered it as punctuation.
  else if startsWith(trimmedLine, ">") then {
    let s = flushList(flushTable(flushText(flushIndentCode(state))));
    let body = trim(substring(trimmedLine, 1, length(trimmedLine)));
    { s | quoteLines: body :: s.quoteLines }
  }

  -- Indented code block: four or more columns of indentation with nothing
  -- else open. CommonMark treats it exactly like a fenced block, and every
  -- consumer of this parser does too (an aligned ASCII address table must
  -- keep its column spacing, not collapse into one run-on paragraph).
  -- The check sits here, AFTER the marker branches, deliberately: indented
  -- "- item" / "* item" / "1. item" lines are nested list items (the list
  -- branches read nesting depth off the raw line), and demoting them to code
  -- would destroy every nested list this parser accepts. Strict CommonMark
  -- precedence for indented headings/tables/thematic breaks is likewise left
  -- to the existing branches; the indented-code branch claims only what
  -- everything above lets fall through, and only with no paragraph or list
  -- open (an indented line inside either is a lazy continuation). An open
  -- blockquote is treated the same way; an open table is flushed first so the
  -- table block is emitted BEFORE the code block, not after it.
  else if mdIsEmptyList(state.listItems) && mdIsEmptyList(state.textLines) &&
          mdIsEmptyList(state.quoteLines) &&
          mdCodeIndentCount(line, 0, 0) >= 4 then
    let s = flushTable(state) in
    { s | indentCode: mdStripCodeIndent(line) :: s.indentCode }

  -- Regular text line: a wrapped continuation of the open list item's
  -- paragraph (CommonMark lazy continuation) joins onto that item, so a
  -- hard-wrapped source line doesn't split one item into a list block plus an
  -- orphaned sibling text block. Otherwise accumulate for a plain paragraph.
  else if not mdIsEmptyList(state.listItems) then
    match state.listItems {
      item :: rest => { state | listItems: "${item} ${trimmedLine}" :: rest },
      [] => state
    }
  else
    let s = flushList(flushTable(flushQuote(flushIndentCode(state)))) in
    { s | textLines: trimmedLine :: s.textLines }
}

-- Flush accumulated blockquote lines into blocks.
--
-- A blockquote that came from markdown_writer (renderCommentMd /
-- renderChangeMd) is read back into the CommentBlock / ChangeBlock it came
-- from, so the markdown waypoint is lossless instead of silently demoting
-- comments and track changes to inert quote text. Anything else keeps the
-- plain quoted-paragraph reading.
pure func flushQuote(state: MdParseState) -> MdParseState =
  if mdIsEmptyList(state.quoteLines) then state
  else match mdQuoteBlocks(reverse(state.quoteLines)) {
    Some(bs) => { state | blocks: mdPrependBlocks(bs, state.blocks), quoteLines: [] },
    None => {
      let text = mdJoinLines(reverse(state.quoteLines));
      { state | blocks: mdTextBlock(text, "quote", 0) :: state.blocks, quoteLines: [] }
    }
  }

-- Prepend blocks (in document order) onto the reversed accumulated list.
pure func mdPrependBlocks(bs: [Block], acc: [Block]) -> [Block] =
  match bs {
    [] => acc,
    b :: rest => b :: mdPrependBlocks(rest, acc)
  }

pure func mdHeadingState(state: MdParseState, trimmedLine: string, level: int) -> MdParseState {
  let s = flushToState(state);
  let text = trim(substring(trimmedLine, level, length(trimmedLine)));
  { s | blocks: mdHeadingBlock(text, level) :: s.blocks }
}

-- A fenced code block becomes one TextBlock with style "code" (or the fence's
-- info string, e.g. "code:python"), carrying the lines verbatim. Generators
-- render it monospaced; the markdown writer fences it again.
pure func mdFlushCode(state: MdParseState) -> MdParseState {
  let body = join("\n", reverse(state.codeLines));
  let style = if length(state.codeLang) > 0 then "code:${state.codeLang}" else "code";
  { state | blocks: mkText(body, style, 0) :: state.blocks,
            codeLines: [], inCode: false, codeLang: "" }
}

-- Flush accumulated indented-code lines into a TextBlock with style "code",
-- exactly the shape mdFlushCode emits for a fence, so every generator renders
-- both forms identically. Lines are verbatim (no inline scan, no trimming);
-- trailing blank lines are dropped, interior ones kept.
pure func flushIndentCode(state: MdParseState) -> MdParseState =
  if mdIsEmptyList(state.indentCode) then state
  else {
    let lines = mdDropTrailingBlanks(reverse(state.indentCode));
    let body = join("\n", lines);
    { state | blocks: mkText(body, "code", 0) :: state.blocks, indentCode: [] }
  }

pure func mdDropTrailingBlanks(xs: [string]) -> [string] =
  reverse(mdDropLeadingBlanks(reverse(xs)))

pure func mdDropLeadingBlanks(xs: [string]) -> [string] =
  match xs {
    [] => [],
    x :: rest => if length(x) == 0 then mdDropLeadingBlanks(rest) else xs
  }

-- Columns of indentation: a space is 1, a tab is 4 (CommonMark's tab stop for
-- the code-block indent). Distinct from mdCountIndent, whose tab=2 is the
-- LIST nesting rule — one tab must still qualify as an indented code line.
pure func mdCodeIndentCount(line: string, i: int, acc: int) -> int =
  if i >= length(line) then acc
  else {
    let c = charAt(line, i);
    if c == " " then mdCodeIndentCount(line, i + 1, acc + 1)
    else if c == "\t" then mdCodeIndentCount(line, i + 1, acc + 4)
    else acc
  }

-- The line minus up to 4 columns of leading indent (tab = 4 columns),
-- CommonMark's "strip one indent unit". Whatever is left is the code line.
pure func mdStripCodeIndent(line: string) -> string
  tests [
    ("    a    b", "a    b"),
    ("      deeper", "  deeper"),
    ("\tcode line", "code line"),
    ("  \tcode line", "code line"),
    ("  only two", "  only two"),
    ("", "")
  ]
{ mdStripIndent(line, 0, 0) }

pure func mdStripIndent(line: string, i: int, acc: int) -> string =
  if i >= length(line) then ""
  else if acc >= 4 then substring(line, i, length(line))
  else {
    let c = charAt(line, i);
    if c == " " then mdStripIndent(line, i + 1, acc + 1)
    else if c == "\t" then mdStripIndent(line, i + 1, acc + 4)
    else line   -- under 4 columns before content: not an indented line, keep it
  }

-- Flush all accumulated state into blocks
pure func flushState(state: MdParseState) -> [Block] {
  let s = flushToState(state);
  s.blocks
}

-- Flush accumulated text, list, and table into state
pure func flushToState(state: MdParseState) -> MdParseState {
  let s = if state.inCode && not mdIsEmptyList(state.codeLines)
    then mdFlushCode(state)   -- unterminated fence: keep the code, don't drop it
    else state;
  flushQuote(flushText(flushList(flushTable(flushIndentCode(s)))))
}

-- Flush accumulated text lines into a TextBlock
-- Contract: text lines are always cleared after flush
pure func flushText(state: MdParseState) -> MdParseState
  ensures { listLength(result.textLines) == 0 }
{
  if mdIsEmptyList(state.textLines) then state
  else {
    let text = mdJoinLines(reverse(state.textLines));
    let block = if mdIsImageOnly(text) then mdImageBlock(text) else mdTextBlock(text, "normal", 0);
    { state | blocks: block :: state.blocks, textLines: [] }
  }
}

-- Flush accumulated list items into a ListBlock
-- Contract: list items are always cleared after flush
pure func flushList(state: MdParseState) -> MdParseState
  ensures { listLength(result.listItems) == 0 }
{
  if mdIsEmptyList(state.listItems) then state
  else {
    let items = reverse(state.listItems);
    let levels = reverse(state.itemLevels);
    { state | blocks: mdListBlock(items, state.listOrdered, levels) :: state.blocks,
              listItems: [], listOrdered: false, itemLevels: [] }
  }
}

-- Flush accumulated table rows into a TableBlock
-- Contract: table rows are always cleared after flush
pure func flushTable(state: MdParseState) -> MdParseState
  ensures { listLength(result.tableRows) == 0 }
{
  if mdIsEmptyRowList(state.tableRows) then state
  else {
    match reverse(state.tableRows) {
      [] => state,
      headerCells :: dataRows => {
        let aligns = state.tableAligns;
        let headerRow = mdApplyAligns(map(mdCellFromText, headerCells), aligns);
        -- Rows are fitted to the header width (GFM): short rows gain empty
        -- cells, long rows lose the excess. A ragged table is not renderable
        -- and every consumer downstream assumes rectangularity.
        --
        -- Width is the sum of the colSpans, not the number of cells: in a table
        -- with merged cells a row of 2 cells can be exactly as wide as a header
        -- of 3, and padding it to 3 would invent a column.
        let width = mdCellsWidth(headerRow);
        let bodyRows = map(\row. mdApplyAligns(mdFitCells(map(mdCellFromText, row), width), aligns), dataRows);
        { state | blocks: mkTable(bodyRows, headerRow) :: state.blocks,
                  tableRows: [], tableAligns: [] }
      }
    }
  }
}

-- Re-exported from markdown_inline under its original name so every existing
-- importer of markdown_parser.mdInlineRuns keeps working after the split.
export pure func mdInlineRuns(s: string) -> [InlineRun] = mdScanInline(s)

-- === Block constructors ==================================================
--
-- Unformatted text keeps `runs` empty and its original string, so ordinary
-- prose serialises byte-identically to the pre-inline shape. Only text that
-- actually carries formatting gains runs, and there `text` becomes the
-- marker-free reading — the same contract the DOCX and HTML parsers follow.

-- `text` is always the run concatenation, never the raw source. For prose with
-- no markers the two are identical (the scanner short-circuits to a single
-- plain run), so unformatted output stays byte-for-byte what it was. Where
-- they differ is a backslash escape: "\\*literal\\*" reads as "*literal*",
-- and taking the raw string in the unformatted branch left the backslashes in
-- while the formatted branch stripped them — the same document punctuated two
-- different ways depending on whether it happened to contain bold elsewhere.
pure func mdTextBlock(raw: string, style: string, level: int) -> Block {
  let runs = mdScanInline(raw);
  if mdRunsFormatted(runs)
  then mkTextRuns(mdRunsText(runs), style, level, runs)
  else mkText(mdRunsText(runs), style, level)
}

pure func mdHeadingBlock(raw: string, level: int) -> Block {
  let runs = mdScanInline(raw);
  if mdRunsFormatted(runs)
  then mkHeadingRuns(mdRunsText(runs), level, runs)
  else mkHeading(mdRunsText(runs), level)
}

pure func mdListBlock(items: [string], ordered: bool, levels: [int]) -> Block {
  let itemRuns = map(mdScanInline, items);
  let texts = map(mdRunsText, itemRuns);
  -- Levels are dropped when every item is top-level, so a flat list keeps the
  -- shape it has always had.
  let nested = mdAnyNested(levels);
  if mdAnyFormatted(itemRuns) || nested
  then mkListNested(texts, ordered, (if mdAnyFormatted(itemRuns) then itemRuns else []),
                    (if nested then levels else []))
  else mkList(texts, ordered)
}

pure func mdAnyNested(levels: [int]) -> bool =
  match levels {
    [] => false,
    n :: rest => n > 0 || mdAnyNested(rest)
  }

-- Two spaces (or one tab) per level, which is what every Markdown writer emits
-- and what CommonMark's "indented enough to be inside the parent item" reduces
-- to for ordinary lists. Capped so a runaway indent cannot invent depth.
pure func mdIndentLevel(line: string) -> int {
  let n = mdCountIndent(line, 0, 0);
  let lvl = n / 2;
  if lvl > 8 then 8 else lvl
}

pure func mdCountIndent(line: string, i: int, acc: int) -> int =
  if i >= length(line) then acc
  else {
    let c = charAt(line, i);
    if c == " " then mdCountIndent(line, i + 1, acc + 1)
    else if c == "\t" then mdCountIndent(line, i + 1, acc + 2)
    else acc
  }

-- A paragraph that is nothing but an image is an image, not a sentence about
-- one. Inline images inside prose are left as text rather than silently
-- dropped, since a run cannot carry image data.
pure func mdIsImageOnly(raw: string) -> bool =
  startsWith(raw, "![") && endsWith(raw, ")") && contains(raw, "](")

pure func mdImageBlock(raw: string) -> Block {
  let close = find(raw, "](");
  let alt = substring(raw, 2, close);
  let src = substring(raw, close + 2, length(raw) - 1);
  mkImage(src, alt, "image/unknown")
}

-- A run of three or more of the same -, * or _ is a thematic break. It used to
-- become a paragraph reading literally "---", which then travelled into every
-- generated DOCX and PPTX as those three characters.
-- Does the line start with one of the Unicode bullet glyphs treated as an
-- unordered list marker? These are the characters a list becomes when copied
-- out of Word (or written by hand) as plain text: • (U+2022), ‣, ⁃, ◦, ▪.
-- En dash and middle dot are deliberately NOT markers — they are live
-- punctuation in prose (ranges, ellipses) and would convert ordinary lines.
-- The glyph must be followed by something, so a bare glyph line stays text.
-- Requires a space after the marker: "•text" without one is far more likely
-- decoration than a list item, and the space is what Word's paste format has.
pure func mdIsUnicodeBullet(line: string) -> bool
  tests [
    ("• First literal bullet", true),
    ("•Second no space", false),
    ("  • indented bullet", true),
    ("– en dash is not a marker", false),
    ("· middle dot is not a marker", false),
    ("•", false),
    ("- ascii dash stays gfm", false),
    ("◦ round bullet", true)
  ]
{ let t = trim(line) in length(t) > 2 &&
  (startsWith(t, "• ") || startsWith(t, "‣ ") || startsWith(t, "⁃ ") ||
   startsWith(t, "◦ ") || startsWith(t, "▪ ")) }

pure func mdIsThematicBreak(line: string) -> bool {
  let t = trim(line);
  if length(t) < 3 then false
  else {
    let c = charAt(t, 0);
    if c == "-" || c == "*" || c == "_" then mdAllChar(t, c, 0) else false
  }
}

pure func mdAllChar(s: string, c: string, i: int) -> bool =
  if i >= length(s) then true
  else charAt(s, i) == c && mdAllChar(s, c, i + 1)

-- Join text lines with spaces (paragraph reconstruction)
-- Contract: non-empty input produces non-empty output
pure func mdJoinLines(lines: [string]) -> string
  ensures { listLength(lines) == 0 || length(result) > 0 }
{
  -- join is a single allocation; folding with "${acc} ${line}" rebuilt the
  -- whole paragraph once per line, which is quadratic in its length.
  join(" ", lines)
}

-- listLength is O(n) and these are asked once per input line; a match is O(1).
pure func mdIsEmptyList(xs: [string]) -> bool = match xs { [] => true, _ => false }

pure func mdIsEmptyRowList(xs: [[string]]) -> bool = match xs { [] => true, _ => false }

-- Check if a line is an ordered list item (starts with "N. ")
pure func mdIsOrderedListItem(line: string) -> bool {
  let dotPos = find(line, ". ");
  if dotPos > 0 then
    let prefix = substring(line, 0, dotPos) in
    mdAllDigits(trim(prefix))
  else false
}

-- Check if all characters in a string are digits
-- Contract: empty string is never all digits
pure func mdAllDigits(s: string) -> bool
  ensures { length(s) > 0 || result == false }
{
  if length(s) == 0 then false
  else mdAllDigitsFrom(s, 0)
}

-- Check digits from index i using charAt (avoids substring allocation)
pure func mdAllDigitsFrom(s: string, i: int) -> bool =
  if i >= length(s) then true
  else mdIsDigit(charAt(s, i)) && mdAllDigitsFrom(s, i + 1)

-- Check if a single character is a digit
-- Contract: only returns true for single-char strings
pure func mdIsDigit(c: string) -> bool
  ensures { result == false || length(c) == 1 }
=
  c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
  c == "5" || c == "6" || c == "7" || c == "8" || c == "9"

-- Extract the text after "N. " from an ordered list item
-- Contract: result is never longer than input (we're extracting a suffix)
pure func mdExtractOrderedItem(line: string) -> string
  ensures { length(result) <= length(line) }
{
  let dotPos = find(line, ". ");
  if dotPos >= 0 then trim(substring(line, dotPos + 2, length(line)))
  else line
}