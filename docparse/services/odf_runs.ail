module docparse/services/odf_runs

import std/string (length, concat as strConcat)
import std/list (foldl, map, filter, flatMap)
import std/map (fromList as mapFromList, values as mapValues)
import docparse/types/document (InlineRun, Block, TextBlock, HeadingBlock, ListBlock, SectionBlock)
import docparse/services/odf_text (odfEncodeText)

-- Inline run styling for ODF, shared by the ODT and ODP generators.
--
-- Both dialects express character formatting the same way — a <text:span>
-- naming a <style:style style:family="text"> — so the machinery does not
-- belong to either generator. Companion to odf_text, which owns the
-- whitespace rules.

-- === Character formatting (ODF §16.27) ===================================
--
-- The inverse of the parser's problem. ODF cannot put formatting on the run:
-- each distinct combination needs its own <style:style> in
-- office:automatic-styles, and the run references it by name.
--
-- Style names are derived from the formatting itself, so the same combination
-- always produces the same name. That means the set can be deduped with a map
-- at the end instead of threading a counter through the whole block walk, and
-- the generated XML is deterministic for a given document.

pure func odfRunStyleName(r: InlineRun) -> string {
  let b = if r.bold then "b" else "";
  let i = if r.italic then "i" else "";
  let u = if r.underline then "u" else "";
  let s = if r.strike then "s" else "";
  let c = if r.code then "c" else "";
  let v = if r.vertAlign == "superscript" then "p"
    else if r.vertAlign == "subscript" then "q"
    else "";
  "AR${b}${i}${u}${s}${c}${v}"
}

-- A run with no formatting needs no span at all, so it also needs no style.
export pure func odfRunIsPlain(r: InlineRun) -> bool =
  r.bold == false && r.italic == false && r.underline == false &&
  r.strike == false && r.code == false && length(r.vertAlign) == 0

pure func odfRunStyleDef(r: InlineRun) -> string {
  let bold = if r.bold then " fo:font-weight=\"bold\"" else "";
  let italic = if r.italic then " fo:font-style=\"italic\"" else "";
  -- Underline and strike name a line style, mirroring what the parser reads.
  let under = if r.underline
    then " style:text-underline-style=\"solid\" style:text-underline-width=\"auto\" style:text-underline-color=\"font-color\""
    else "";
  let strike = if r.strike then " style:text-line-through-style=\"solid\"" else "";
  -- ODF has no "code" property either; a monospace family is its honest
  -- equivalent, as Consolas is on the DOCX side.
  let code = if r.code then " fo:font-family=\"Consolas, monospace\"" else "";
  -- style:text-position is "super|sub <percent>"; 58% is the ODF default rise.
  let vert = if r.vertAlign == "superscript" then " style:text-position=\"super 58%\""
    else if r.vertAlign == "subscript" then " style:text-position=\"sub 58%\""
    else "";
  "<style:style style:name=\"${odfRunStyleName(r)}\" style:family=\"text\"><style:text-properties${bold}${italic}${under}${strike}${code}${vert}/></style:style>"
}

-- One <style:style> per distinct formatting combination used anywhere in the
-- document. mapValues is sorted by key, so the output order is stable.
export pure func odfCollectRunStyles(blocks: [Block]) -> string {
  let formatted = filter(\r. odfRunIsPlain(r) == false, flatMap(odfBlockRuns, blocks));
  strConcat(mapValues(mapFromList(map(\r. (odfRunStyleName(r), odfRunStyleDef(r)), formatted))))
}

pure func odfBlockRuns(b: Block) -> [InlineRun] =
  match b {
    TextBlock(t) => t.runs,
    HeadingBlock(h) => h.runs,
    ListBlock(l) => flatMap(\rs. rs, l.itemRuns),
    SectionBlock(s) => flatMap(odfBlockRuns, s.blocks),
    _ => []
  }

export pure func odfRunsToXml(runs: [InlineRun]) -> string =
  foldl(\acc r. "${acc}${odfRunToXml(r)}", "", runs)

pure func odfRunToXml(r: InlineRun) -> string =
  if odfRunIsPlain(r)
  then odfEncodeText(r.text)
  else "<text:span text:style-name=\"${odfRunStyleName(r)}\">${odfEncodeText(r.text)}</text:span>"
