module docparse/services/odp_parser

import std/xml (parseLenient, findAll, findFirst, getText, getAttr, getChildren, getTag)
import std/zip (readEntry)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/string (length, trim, endsWith, stringToInt)
import std/list (map, flatMap, filter, concat, length as listLength)
import docparse/services/odf_text (odfText)
import docparse/types/document (mkHeading, mkList, mkText, Block, TextBlock, HeadingBlock, TableBlock, ImageBlock, ListBlock, SectionBlock, TableCell, DocMetadata, simpleCell, emptyMetadata, mkImage, mkTable, mkNamedSection)

-- ODP Parser — converts OpenDocument Presentation to Block ADT.
-- Pure AILANG implementation using std/zip + std/xml.
--
-- ODP structure (ZIP archive):
--   content.xml    — slides (draw:page elements)
--   meta.xml       — metadata
--
-- ODF Presentation XML structure:
--   office:body > office:presentation > draw:page (slides)
--   Each draw:page contains draw:frame > draw:text-box > text:p
--
-- Analogous to PPTX parser but with ODF namespaces.

-- Parse an ODP file into content blocks.
-- Contract: result is a possibly-empty list. `ensures` omitted —
-- see ailang-core issue #236.
export func parseOdp(filepath: string) -> [Block] ! {FS}
{
  let xml = match readEntry(filepath, "content.xml") {
    Ok(c) => c,
    Err(_) => ""
  };

  if length(xml) == 0
  then [mkText("ODP error: could not read content.xml", "error", 0)]
  else match parseLenient(xml) {
    Ok(root) => odpExtractSlides(root),
    Err(e) => [mkText("ODP XML parse error: ${e}", "error", 0)]
  }
}

-- Extract metadata from an ODP file
export func parseOdpMetadata(filepath: string) -> DocMetadata ! {FS} {
  let xml = match readEntry(filepath, "meta.xml") {
    Ok(c) => c,
    Err(_) => ""
  };

  if length(xml) == 0 then emptyMetadata()
  else match parseLenient(xml) {
    Ok(root) => odpParseMetadata(root),
    Err(_) => emptyMetadata()
  }
}

-- Navigate to office:body/office:presentation and extract slides
export pure func odpExtractSlides(root: XmlNode) -> [Block] {
  match findFirst(root, "office:body") {
    Some(body) =>
      match findFirst(body, "office:presentation") {
        Some(pres) => {
          let pages = findAll(pres, "draw:page");
          flatMap(odpParseSlide, pages)
        },
        None => []
      },
    None => []
  }
}

-- Parse a single draw:page (slide) into blocks.
-- Wraps slide content in SectionBlock(kind="slide") and any speaker notes
-- from <presentation:notes> in a following SectionBlock(kind="notes").
pure func odpParseSlide(page: XmlNode) -> [Block] {
  let slideName = getOrElse(getAttr(page, "draw:name"), "slide");
  let children = getChildren(page);
  let blocks = flatMap(odpProcessFrame, children);
  let noteBlocks = flatMap(odpProcessNotes, children);
  let slideSection =
    if listLength(blocks) > 0
    then [mkNamedSection("slide", slideName, blocks)]
    else [];
  let notesSection =
    if listLength(noteBlocks) > 0
    then [mkNamedSection("notes", slideName, noteBlocks)]
    else [];
  concat(slideSection, notesSection)
}

-- Process a draw:frame or other slide child element
pure func odpProcessFrame(node: XmlNode) -> [Block] {
  let tag = getTag(node);

  if tag == "draw:frame" then {
    let presClass = getOrElse(getAttr(node, "presentation:class"), "");
    let children = getChildren(node);
    if presClass == "title" then flatMap(\c. odpProcessTitleFrameChild(c, 1), children)
    else if presClass == "subtitle" then flatMap(\c. odpProcessTitleFrameChild(c, 2), children)
    else flatMap(odpProcessFrameChild, children)
  }
  -- Tables can appear directly in slides
  else if tag == "table:table" then [odpParseTable(node)]
  else []
}

-- Extract speaker notes from <presentation:notes>, skipping master placeholders
-- like page-number, header, footer, and date-time.
pure func odpProcessNotes(node: XmlNode) -> [Block] {
  if getTag(node) == "presentation:notes" then
    flatMap(odpProcessNoteFrame, getChildren(node))
  else []
}

pure func odpProcessNoteFrame(node: XmlNode) -> [Block] {
  if getTag(node) == "draw:frame" then {
    let presClass = getOrElse(getAttr(node, "presentation:class"), "");
    if presClass == "page-number" || presClass == "header" || presClass == "footer" || presClass == "date-time"
    then []
    else flatMap(odpProcessFrameChild, getChildren(node))
  }
  else []
}

-- Process children of a title/subtitle draw:frame so paragraphs become headings
pure func odpProcessTitleFrameChild(node: XmlNode, level: int) -> [Block] {
  let tag = getTag(node);
  if tag == "draw:text-box" then
    flatMap(\c. odpProcessTitleTextElement(c, level), getChildren(node))
  else odpProcessFrameChild(node)
}

pure func odpProcessTitleTextElement(node: XmlNode, level: int) -> [Block] {
  let tag = getTag(node);
  if tag == "text:p" then
    let text = trim(odfText(node)) in
    if length(text) > 0 then [mkHeading(text, level)]
    else []
  else odpProcessTextElement(node)
}

-- Process children of a draw:frame (text boxes, tables, images)
pure func odpProcessFrameChild(node: XmlNode) -> [Block] {
  let tag = getTag(node);

  if tag == "draw:text-box" then {
    let children = getChildren(node);
    flatMap(odpProcessTextElement, children)
  }
  else if tag == "table:table" then [odpParseTable(node)]
  else if tag == "draw:image" then {
    let href = getOrElse(getAttr(node, "xlink:href"), "");
    if length(href) > 0
    then [mkImage(href, "", odpGuessMime(href))]
    else []
  }
  else []
}

-- Guess MIME type from image path
pure func odpGuessMime(href: string) -> string
  tests [
    ("media/image.png", "image/png"),
    ("slide.jpg", "image/jpeg"),
    ("slide.jpeg", "image/jpeg"),
    ("icon.gif", "image/gif"),
    ("diagram.svg", "image/svg+xml"),
    ("scan.bmp", "image/bmp"),
    ("photo.webp", "image/webp"),
    ("unknown.xyz", "image/unknown")
  ]
{
  if endsWith(href, ".png") then "image/png"
  else if endsWith(href, ".jpg") || endsWith(href, ".jpeg") then "image/jpeg"
  else if endsWith(href, ".gif") then "image/gif"
  else if endsWith(href, ".svg") then "image/svg+xml"
  else if endsWith(href, ".bmp") then "image/bmp"
  else if endsWith(href, ".webp") then "image/webp"
  else "image/unknown"
}

-- Process text elements inside a text box
pure func odpProcessTextElement(node: XmlNode) -> [Block] {
  let tag = getTag(node);

  -- Headings
  if tag == "text:h" then
    let text = trim(odfText(node)) in
    let levelStr = getOrElse(getAttr(node, "text:outline-level"), "1") in
    let level = odpParseLevel(levelStr) in
    if length(text) > 0 then [mkHeading(text, level)]
    else []

  -- Paragraphs
  else if tag == "text:p" then
    let text = trim(odfText(node)) in
    if length(text) > 0 then [mkText(text, "normal", 0)]
    else []

  -- Lists
  else if tag == "text:list" then odpParseList(node)

  else []
}

-- Parse heading level.
-- Contract: result is in 1..6. `ensures` omitted — see ailang-core issue #236.
pure func odpParseLevel(s: string) -> int
{
  if s == "1" then 1
  else if s == "2" then 2
  else if s == "3" then 3
  else if s == "4" then 4
  else if s == "5" then 5
  else if s == "6" then 6
  else 1
}

-- Parse an ODF table
pure func odpParseTable(table: XmlNode) -> Block {
  let rows = findAll(table, "table:table-row");
  let parsedRows = map(odpParseTableRow, rows);
  match parsedRows {
    [] => mkTable([], []),
    firstRow :: dataRows =>
      mkTable(dataRows, firstRow)
  }
}

-- Parse a table row
pure func odpParseTableRow(tr: XmlNode) -> [TableCell] {
  let cells = findAll(tr, "table:table-cell");
  map(odpParseTableCell, cells)
}

-- Parse a table cell, preserving column/row span attributes
pure func odpParseTableCell(cell: XmlNode) -> TableCell {
  let text = trim(odfText(cell));
  let colSpan = odpParseSpan(getOrElse(getAttr(cell, "table:number-columns-spanned"), "1"));
  let rowSpan = odpParseSpan(getOrElse(getAttr(cell, "table:number-rows-spanned"), "1"));
  {text: text, colSpan: colSpan, rowSpan: rowSpan, merged: false, scope: "", align: "", runs: [], fill: "", color: "", formula: ""}
}

pure func odpParseSpan(s: string) -> int
  tests [
    ("1", 1),
    ("2", 2),
    ("13", 13),
    ("0", 1),
    ("", 1),
    ("abc", 1)
  ]
{
  match stringToInt(s) {
    Some(n) => if n > 1 then n else 1,
    None => 1
  }
}

-- Parse a text:list
pure func odpParseList(list: XmlNode) -> [Block] {
  let items = findAll(list, "text:list-item");
  let texts = map(\item. trim(odfText(item)), items);
  let nonEmpty = filter(\t. length(t) > 0, texts);
  if listLength(nonEmpty) > 0
  then [mkList(nonEmpty, false)]
  else []
}

-- Parse metadata from meta.xml
export pure func odpParseMetadata(root: XmlNode) -> DocMetadata {
  let title = odpFindMeta(root, "dc:title");
  let author = odpFindMeta(root, "dc:creator");
  let created = odpFindMeta(root, "meta:creation-date");
  let modified = odpFindMeta(root, "dc:date");
  {title: title, author: author, created: created, modified: modified, pageCount: 0}
}

-- Find a metadata element's text
pure func odpFindMeta(root: XmlNode, tagName: string) -> string {
  let elements = findAll(root, tagName);
  match elements {
    [] => "",
    el :: _ => trim(getText(el))
  }
}
