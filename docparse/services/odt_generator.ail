module docparse/services/odt_generator

import std/string (length, intToStr)
import std/list (foldl, length as listLength)
import std/zip (createArchive)
import std/result (Ok, Err)
import docparse/types/document (InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, ParsedDocument, countBlocks)
import docparse/services/xml_helpers (xmlEscape, xmlDecl)
import docparse/services/odf_text (odfEncodeText)
import docparse/services/odf_runs (odfCollectRunStyles, odfRunsToXml)

-- ODT Generator — converts Block ADT to a valid .odt file.
--
-- ODF is simpler than OOXML: single content.xml for all content.
-- Nobody does native ODT generation without LibreOffice — this is first-of-kind.
--
-- ODT structure (ZIP):
--   mimetype               - "application/vnd.oasis.opendocument.text" (uncompressed, first entry)
--   META-INF/manifest.xml  - file registry
--   content.xml            - all content
--   styles.xml             - style definitions
--   meta.xml               - metadata
--
-- ODF namespace prefixes:
--   text:   — headings, paragraphs, lists
--   table:  — tables
--   office: — document structure
--   style:  — style definitions

-- Generate an ODT file from ParsedDocument
export func generateOdt(doc: ParsedDocument, outputPath: string) -> string ! {FS}
  ensures { length(result) > 0 }
{
  let contentXml = odtBuildContent(doc.blocks);
  let stylesXml = odtMinimalStyles();
  let metaXml = odtBuildMeta(doc.metadata.title, doc.metadata.author);
  let manifest = odtManifest();
  let mimetype = "application/vnd.oasis.opendocument.text";

  let entries = [
    {name: "mimetype", content: mimetype},
    {name: "META-INF/manifest.xml", content: manifest},
    {name: "content.xml", content: contentXml},
    {name: "styles.xml", content: stylesXml},
    {name: "meta.xml", content: metaXml}
  ];

  let result = createArchive(outputPath, entries);
  match result {
    Ok(_) => "Generated ODT: ${outputPath}",
    Err(e) => "Error generating ODT: ${e}"
  }
}

-- ODF namespace declaration string
pure func odfNs() -> string =
  "xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:draw=\"urn:oasis:names:tc:opendocument:xmlns:drawing:1.0\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:meta=\"urn:oasis:names:tc:opendocument:xmlns:meta:1.0\""

-- Build content.xml
pure func odtBuildContent(blocks: [Block]) -> string {
  let body = foldl(\acc b. "${acc}${odtBlockToXml(b)}", "", blocks);
  let styles = odfCollectRunStyles(blocks);
  "${xmlDecl()}<office:document-content ${odfNs()} office:version=\"1.2\"><office:automatic-styles>${styles}</office:automatic-styles><office:body><office:text>${body}</office:text></office:body></office:document-content>"
}

-- Convert a Block to ODF XML
pure func odtBlockToXml(block: Block) -> string =
  match block {
    HeadingBlock(h) =>
      let inner = if listLength(h.runs) > 0 then odfRunsToXml(h.runs) else odfEncodeText(h.text) in
      "<text:h text:style-name=\"${odtHeadingStyleName(h.level)}\" text:outline-level=\"${intToStr(h.level)}\">${inner}</text:h>",

    TextBlock(t) =>
      if length(t.text) > 0
      then
        let inner = if listLength(t.runs) > 0 then odfRunsToXml(t.runs) else odfEncodeText(t.text) in
        "<text:p text:style-name=\"Standard\">${inner}</text:p>"
      else "",

    TableBlock(t) =>
      odtTableToXml(t.headers, t.rows),

    ListBlock(l) =>
      odtListToXml(l.items, l.ordered, l.itemRuns),

    ImageBlock(i) =>
      "<text:p text:style-name=\"Standard\">[Image: ${odfEncodeText(i.description)}]</text:p>",

    AudioBlock(a) =>
      "<text:p text:style-name=\"Standard\">[Audio: ${odfEncodeText(a.transcription)}]</text:p>",

    VideoBlock(v) =>
      "<text:p text:style-name=\"Standard\">[Video: ${odfEncodeText(v.description)}]</text:p>",

    SectionBlock(s) =>
      "<text:section text:name=\"${xmlEscape(s.kind)}\">${foldl(\acc b. "${acc}${odtBlockToXml(b)}", "", s.blocks)}</text:section>",

    ChangeBlock(c) =>
      "<text:p text:style-name=\"Standard\">${odfEncodeText(c.text)} (${odfEncodeText(c.changeType)} by ${odfEncodeText(c.author)}, ${odfEncodeText(c.date)})</text:p>",

    LinkBlock(l) =>
      "<text:p text:style-name=\"Standard\"><text:a xlink:type=\"simple\" xlink:href=\"${xmlEscape(l.href)}\">${odfEncodeText(l.text)}</text:a></text:p>",

    -- Write-back of real ODF annotations (office:annotation) is out of scope
    -- for this read-only release; the pairing is preserved as text.
    CommentBlock(c) =>
      "<text:p text:style-name=\"Standard\">${odfEncodeText(commentText(c.author, c.text, c.anchorText, c.anchored))}</text:p>"
  }

-- Build an ODF table
pure func odtTableToXml(headers: [TableCell], rows: [[TableCell]]) -> string {
  let colCount = if listLength(headers) > 0 then listLength(headers)
    else match rows {
      r :: _ => listLength(r),
      [] => 1
    };
  let columns = odtTableColumns(colCount);
  let headerRow = if listLength(headers) > 0
    then "<table:table-header-rows><table:table-row>${odtTableCells(headers)}</table:table-row></table:table-header-rows>"
    else "";
  let dataRows = foldl(\acc row. "${acc}<table:table-row>${odtTableCells(row)}</table:table-row>", "", rows);
  "<table:table table:name=\"Table\">${columns}${headerRow}${dataRows}</table:table>"
}

pure func odtTableColumns(count: int) -> string =
  if count <= 0 then ""
  else "<table:table-column/>${odtTableColumns(count - 1)}"

pure func odtTableCells(cells: [TableCell]) -> string =
  foldl(\acc c. "${acc}${odtTableCell(c)}", "", cells)

pure func odtTableCell(cell: TableCell) -> string {
  let spanAttr = if cell.colSpan > 1
    then " table:number-columns-spanned=\"${intToStr(cell.colSpan)}\""
    else "";
  if cell.merged then "<table:covered-table-cell/>"
  else "<table:table-cell${spanAttr}><text:p>${odfEncodeText(cell.text)}</text:p></table:table-cell>"
}

-- Build an ODF list.
-- itemRuns is parallel to items but may be absent entirely. Both lists are
-- walked together so a short or missing itemRuns falls back to plain text per
-- item rather than pairing formatting with the wrong item.
-- List items name List_20_Bullet / List_20_Number for the same reason headings
-- name Heading_20_N: an unnamed text:p inherits the default paragraph style, so
-- a template's list styling would have nothing to attach to.
pure func odtListToXml(items: [string], ordered: bool, itemRuns: [[InlineRun]]) -> string =
  let styleName = if ordered then "List_20_Number" else "List_20_Bullet" in
  "<text:list>${odtListItemsToXml(items, itemRuns, styleName)}</text:list>"

pure func odtListItemsToXml(items: [string], itemRuns: [[InlineRun]], styleName: string) -> string =
  match items {
    [] => "",
    item :: rest =>
      match itemRuns {
        [] => "${odtListItem(odfEncodeText(item), styleName)}${odtListItemsToXml(rest, [], styleName)}",
        r :: rrest =>
          let body = if listLength(r) > 0 then odfRunsToXml(r) else odfEncodeText(item) in
          "${odtListItem(body, styleName)}${odtListItemsToXml(rest, rrest, styleName)}"
      }
  }

pure func odtListItem(body: string, styleName: string) -> string =
  "<text:list-item><text:p text:style-name=\"${styleName}\">${body}</text:p></text:list-item>"

-- Every style this generator's body XML can reference, as (name, xml) pairs
-- rather than one blob.
--
-- Two things depend on the pair shape. First, a reference doc can then inject
-- only the names the template does NOT define, so the template's Heading_20_1
-- wins while a missing List_20_Bullet is still filled in. Second, the set the
-- body references and the set styles.xml defines are derived from ONE list, so
-- they cannot disagree — a body naming a style nothing defines is the same
-- class of bug as an orphaned styles.xml part, and it renders as plain body
-- text with no indication why. (Measured: a template's Heading_20_1 at 55pt red
-- had NO effect until the heading named it — see the design doc's E1a/E1b.)
--
-- ODF encodes a space in a style name as "_20_", so "Heading 1" is the display
-- name and Heading_20_1 is the identifier. Both are emitted: consumers match on
-- style:name, but style:display-name is what a user sees in LibreOffice's style
-- list, and a template author needs to recognise them.
export pure func odfStyleDefs() -> [{name: string, xml: string}] = [
  {name: "Standard", xml: "<style:style style:name=\"Standard\" style:family=\"paragraph\"/>"},
  {name: "Heading_20_1", xml: odtHeadingStyle(1, "130%")},
  {name: "Heading_20_2", xml: odtHeadingStyle(2, "115%")},
  {name: "Heading_20_3", xml: odtHeadingStyle(3, "101%")},
  {name: "Heading_20_4", xml: odtHeadingStyle(4, "95%")},
  {name: "Heading_20_5", xml: odtHeadingStyle(5, "85%")},
  {name: "Heading_20_6", xml: odtHeadingStyle(6, "75%")},
  {name: "List_20_Bullet", xml: "<style:style style:name=\"List_20_Bullet\" style:display-name=\"List Bullet\" style:family=\"paragraph\" style:parent-style-name=\"Standard\"/>"},
  {name: "List_20_Number", xml: "<style:style style:name=\"List_20_Number\" style:display-name=\"List Number\" style:family=\"paragraph\" style:parent-style-name=\"Standard\"/>"}
]

-- Sizes are PERCENTAGES of the document default, not absolute points. A
-- template that sets a 9pt body should get proportionate headings, and a
-- hardcoded 28pt would fight it.
pure func odtHeadingStyle(level: int, size: string) -> string =
  "<style:style style:name=\"Heading_20_${intToStr(level)}\" style:display-name=\"Heading ${intToStr(level)}\" style:family=\"paragraph\" style:parent-style-name=\"Standard\" style:default-outline-level=\"${intToStr(level)}\"><style:text-properties fo:font-size=\"${size}\" fo:font-weight=\"bold\"/></style:style>"

-- ODF outline levels run 1..6; a deeper heading names the deepest style that
-- exists rather than a Heading_20_9 nothing defines.
export pure func odtHeadingStyleName(level: int) -> string =
  if level < 1 then "Heading_20_1"
  else if level > 6 then "Heading_20_6"
  else "Heading_20_${intToStr(level)}"

pure func odtJoinStyleXml(defs: [{name: string, xml: string}]) -> string =
  foldl(\acc d. "${acc}${d.xml}", "", defs)

-- styles.xml, built from the one list above.
pure func odtMinimalStyles() -> string =
  "${xmlDecl()}<office:document-styles ${odfNs()} office:version=\"1.2\"><office:styles>${odtJoinStyleXml(odfStyleDefs())}</office:styles></office:document-styles>"

-- Build meta.xml
pure func odtBuildMeta(title: string, author: string) -> string {
  let titleTag = if length(title) > 0 then "<dc:title>${xmlEscape(title)}</dc:title>" else "";
  let authorTag = if length(author) > 0 then "<dc:creator>${xmlEscape(author)}</dc:creator>" else "";
  "${xmlDecl()}<office:document-meta ${odfNs()} office:version=\"1.2\"><office:meta>${titleTag}${authorTag}<meta:generator>AILANG Parse</meta:generator></office:meta></office:document-meta>"
}

-- manifest.xml
pure func odtManifest() -> string =
  "${xmlDecl()}<manifest:manifest xmlns:manifest=\"urn:oasis:names:tc:opendocument:xmlns:manifest:1.0\" manifest:version=\"1.2\"><manifest:file-entry manifest:media-type=\"application/vnd.oasis.opendocument.text\" manifest:full-path=\"/\"/><manifest:file-entry manifest:media-type=\"text/xml\" manifest:full-path=\"content.xml\"/><manifest:file-entry manifest:media-type=\"text/xml\" manifest:full-path=\"styles.xml\"/><manifest:file-entry manifest:media-type=\"text/xml\" manifest:full-path=\"meta.xml\"/></manifest:manifest>"
