module docparse/services/odt_generator

import std/string (length, intToStr, contains, startsWith)
import std/list (foldl, length as listLength)
import std/zip (createArchive, createArchiveWithBytes)
import std/bytes (fromString, toBase64, fromBase64, toString)
import std/option (Some, None)
import std/result (Ok, Err)
import docparse/types/document (InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, ParsedDocument, countBlocks)
import docparse/services/xml_helpers (xmlEscape, xmlDecl)
import docparse/services/odf_text (odfEncodeText)
import docparse/services/odf_runs (odfCollectRunStyles, odfRunsToXml)
import docparse/services/odf_template (OdfRefDoc, odfTplNone, odfTplLoad, odfTplHeadingName, odfTplHasStyleNamed, odfTplInsertBeforeLast)
import docparse/services/image_size (imageExtentEmu)
import docparse/services/image_embed (embedIsBinaryPayload)
import docparse/services/odf_image (OdfImgPart, odfImgPart, odfImgCm, odfImgFrame, odfImgFrameStyle, odfImgNsMissing, odfImgManifest, odfImgByteEntries)

-- ODT Generator — converts Block ADT to a valid .odt file.
--
-- ODF is simpler than OOXML: single content.xml for all content.
-- Nobody does native ODT generation without LibreOffice — this is first-of-kind.
--
-- ODT structure (ZIP):
--   mimetype               - "application/vnd.oasis.opendocument.text" (uncompressed, first entry)
--   META-INF/manifest.xml  - file registry
--   content.xml            - all content
--   styles.xml             - style definitions
--   meta.xml               - metadata
--
-- ODF namespace prefixes:
--   text:   — headings, paragraphs, lists
--   table:  — tables
--   office: — document structure
--   style:  — style definitions

-- Generate against a reference document: an existing .odt whose styles, fonts,
-- page geometry, headers and footers are applied to this document's content.
--
-- An unreadable or non-ODF reference is an error and writes NOTHING. Falling
-- back to the built-in styling would produce a plausible file missing exactly
-- the house style it was asked for.
export func generateOdtWithReference(doc: ParsedDocument, outputPath: string,
                                     referencePath: string) -> string ! {FS} =
  if length(referencePath) == 0
  then odtWriteArchive(doc, outputPath, odfTplNone())
  else match odfTplLoad(referencePath) {
    Err(e) => "Error generating ODT: ${e}",
    Ok(ref) => odtWriteArchive(doc, outputPath, ref)
  }

-- Generate an ODT file from ParsedDocument
export func generateOdt(doc: ParsedDocument, outputPath: string) -> string ! {FS}
  ensures { length(result) > 0 }
{
  odtWriteArchive(doc, outputPath, odfTplNone())
}

func odtWriteArchive(doc: ParsedDocument, outputPath: string, ref: OdfRefDoc) -> string ! {FS} {
  let body = odtBodyAcc(doc.blocks, ref, {xml: "", pics: [], next: 1, taken: odtRefNames(ref.entries)});
  let pics = body.pics;
  let contentXml = odtBuildContent(doc.blocks, body);
  let stylesXml = odtStylesFor(ref);
  let metaXml = odtBuildMeta(doc.metadata.title, doc.metadata.author);
  let manifest = odfImgManifest(odtManifest(), pics);
  let mimetype = "application/vnd.oasis.opendocument.text";

  if ref.active then {
    -- mimetype must be the FIRST entry in an ODF package, so it leads the list
    -- and the carried parts follow ours. META-INF/manifest.xml comes from the
    -- template, which already lists the parts being carried; the pictures we
    -- add are listed in it by odtRefEntries.
    let ourParts = [
      {name: "mimetype", content: mimetype},
      {name: "content.xml", content: contentXml},
      {name: "styles.xml", content: stylesXml},
      {name: "meta.xml", content: metaXml}
    ];
    let allBytes = odtAppendByteEntries(
      odtAppendByteEntries(odtPartsToByteEntries(ourParts), odtRefEntries(ref.entries, pics)),
      odfImgByteEntries(pics));
    match createArchiveWithBytes(outputPath, allBytes) {
      Ok(_) =>
        if ref.resolvedCount == 0
        then "Generated ODT: ${outputPath} (reference applied: ${intToStr(listLength(ref.entries))} parts carried; the template defines no heading styles, so headings use the built-in ones)"
        else "Generated ODT: ${outputPath} (reference applied: ${intToStr(listLength(ref.entries))} parts carried, ${intToStr(ref.resolvedCount)} of 6 heading levels from the template)",
      Err(e) => "Error generating ODT: ${e}"
    }
  } else {
    let entries = [
      {name: "mimetype", content: mimetype},
      {name: "META-INF/manifest.xml", content: manifest},
      {name: "content.xml", content: contentXml},
      {name: "styles.xml", content: stylesXml},
      {name: "meta.xml", content: metaXml}
    ];
    if listLength(pics) == 0 then {
      match createArchive(outputPath, entries) {
        Ok(_) => "Generated ODT: ${outputPath}",
        Err(e) => "Error generating ODT: ${e}"
      }
    } else {
      match createArchiveWithBytes(outputPath,
          odtAppendByteEntries(odtPartsToByteEntries(entries), odfImgByteEntries(pics))) {
        Ok(_) => "Generated ODT: ${outputPath}",
        Err(e) => "Error generating ODT: ${e}"
      }
    }
  }
}

-- The body XML and the picture parts it places, threaded through the walk. A
-- picture's part name and its frame are both derived from the key chosen at the
-- point it is placed, so they cannot disagree. next is the key to try next, and
-- taken lists the part names a reference document already carries.
type OdtBody = {xml: string, pics: [OdfImgPart], next: int, taken: [string]}

pure func odtRefNames(entries: [{name: string, data: string}]) -> [string] =
  match entries {
    [] => [],
    e :: rest => e.name :: odtRefNames(rest)
  }

-- The first key at or after n whose picture part name no carried part uses. A
-- template's own dpimage parts (from an earlier run of this generator) are
-- skipped rather than duplicated.
pure func odtImgFreeKey(taken: [string], n: int) -> int =
  if odtImgKeyTaken(taken, "Pictures/dpimage${intToStr(n)}.") then odtImgFreeKey(taken, n + 1)
  else n

pure func odtImgKeyTaken(taken: [string], prefix: string) -> bool =
  match taken {
    [] => false,
    t :: rest => if startsWith(t, prefix) then true else odtImgKeyTaken(rest, prefix)
  }

-- Widest picture: the 6.5in text width of a Letter page with 1in margins.
pure func odtImgMaxCx() -> int = 5943600

pure func odtBodyAcc(blocks: [Block], ref: OdfRefDoc, acc: OdtBody) -> OdtBody =
  match blocks {
    [] => acc,
    b :: rest => odtBodyAcc(rest, ref, odtBlockAcc(b, ref, acc))
  }

-- Sections and embeddable pictures are walked here because they carry state
-- (nested blocks, the picture list); everything else is plain XML.
pure func odtBlockAcc(block: Block, ref: OdfRefDoc, acc: OdtBody) -> OdtBody =
  match block {
    ImageBlock(i) =>
      if embedIsBinaryPayload(i.data, i.mime) then odtImageAcc(i.data, i.mime, i.description, i.width, i.height, acc)
      else {xml: "${acc.xml}${odtBlockToXml(block, ref)}", pics: acc.pics, next: acc.next, taken: acc.taken},
    SectionBlock(s) => {
      let inner = odtBodyAcc(s.blocks, ref, {xml: "", pics: acc.pics, next: acc.next, taken: acc.taken});
      {xml: "${acc.xml}<text:section text:name=\"${xmlEscape(s.kind)}\">${inner.xml}</text:section>", pics: inner.pics, next: inner.next, taken: acc.taken}
    },
    _ => {xml: "${acc.xml}${odtBlockToXml(block, ref)}", pics: acc.pics, next: acc.next, taken: acc.taken}
  }

-- A picture in its own paragraph, anchored as a character so it stays inline,
-- sized to the author's width/height when given, else its natural size, and
-- scaled down to the text width.
pure func odtImageAcc(data: string, mime: string, description: string, wantW: int, wantH: int, acc: OdtBody) -> OdtBody {
  let n = odtImgFreeKey(acc.taken, acc.next);
  let key = intToStr(n);
  let part = odfImgPart(key, data, mime);
  let ext = imageExtentEmu(data, mime, odtImgMaxCx(), wantW, wantH);
  let attrs = "draw:style-name=\"dpImgFrame\" draw:name=\"Image${key}\" text:anchor-type=\"as-char\" svg:width=\"${odfImgCm(ext.cx)}\" svg:height=\"${odfImgCm(ext.cy)}\"";
  let para = "<text:p text:style-name=\"Standard\">${odfImgFrame(attrs, part.name, description)}</text:p>";
  {xml: "${acc.xml}${para}", pics: part :: acc.pics, next: n + 1, taken: acc.taken}
}

-- The template's carried parts, with the pictures added to its manifest. The
-- manifest arrives base64 in the carried list, so it is decoded, extended and
-- re-encoded; without pictures every entry passes through untouched.
pure func odtRefEntries(entries: [{name: string, data: string}], pics: [OdfImgPart]) -> [{name: string, data: string}] =
  match entries {
    [] => [],
    e :: rest =>
      let here = if e.name == "META-INF/manifest.xml" && listLength(pics) > 0
        then odtRefManifestEntry(e, pics)
        else e in
      here :: odtRefEntries(rest, pics)
  }

pure func odtRefManifestEntry(e: {name: string, data: string}, pics: [OdfImgPart]) -> {name: string, data: string} =
  match fromBase64(e.data) {
    Some(b) => {name: e.name, data: toBase64(fromString(odfImgManifest(toString(b), pics)))},
    None => e
  }

-- styles.xml: ours outright, or the template's plus ONLY the definitions it
-- lacks. Injecting only the missing ones is what lets the template's Heading 1
-- win while a style it never defined is still resolvable — the same merge
-- docx_generator does with docxStyleDefs.
pure func odtStylesFor(ref: OdfRefDoc) -> string =
  if not ref.active then odtMinimalStyles()
  else odfTplInsertBeforeLast(ref.stylesXml, "</office:styles>",
                              odtMissingStyleXml(odfStyleDefs(), ref.stylesXml))

pure func odtMissingStyleXml(defs: [{name: string, xml: string}], stylesXml: string) -> string =
  match defs {
    [] => "",
    d :: rest =>
      let here = if odfTplHasStyleNamed(stylesXml, d.name) then "" else d.xml in
      "${here}${odtMissingStyleXml(rest, stylesXml)}"
  }

pure func odtPartsToByteEntries(parts: [{name: string, content: string}]) -> [{name: string, data: string}] =
  match parts {
    [] => [],
    p :: rest =>
      let entry = {name: p.name, data: toBase64(fromString(p.content))} in
      entry :: odtPartsToByteEntries(rest)
  }

pure func odtAppendByteEntries(a: [{name: string, data: string}], b: [{name: string, data: string}]) -> [{name: string, data: string}] =
  match a {
    [] => b,
    x :: rest => x :: odtAppendByteEntries(rest, b)
  }

-- ODF namespace declaration string
pure func odfNs() -> string =
  "xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:draw=\"urn:oasis:names:tc:opendocument:xmlns:drawing:1.0\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:meta=\"urn:oasis:names:tc:opendocument:xmlns:meta:1.0\""

-- Build content.xml
pure func odtBuildContent(blocks: [Block], body: OdtBody) -> string {
  let styles = odfCollectRunStyles(blocks);
  let hasPics = listLength(body.pics) > 0;
  let ns = if hasPics then odfImgNsMissing(odfNs()) else odfNs();
  let frameStyle = if hasPics then odfImgFrameStyle() else "";
  "${xmlDecl()}<office:document-content ${ns} office:version=\"1.2\"><office:automatic-styles>${styles}${frameStyle}</office:automatic-styles><office:body><office:text>${body.xml}</office:text></office:body></office:document-content>"
}

-- Convert a Block to ODF XML
pure func odtBlockToXml(block: Block, ref: OdfRefDoc) -> string =
  match block {
    HeadingBlock(h) =>
      let inner = if listLength(h.runs) > 0 then odfRunsToXml(h.runs) else odfEncodeText(h.text) in
      "<text:h text:style-name=\"${odfTplHeadingName(ref, h.level, odtHeadingStyleName(h.level))}\" text:outline-level=\"${intToStr(h.level)}\">${inner}</text:h>",

    TextBlock(t) =>
      if length(t.text) > 0
      then
        let inner = if listLength(t.runs) > 0 then odfRunsToXml(t.runs) else odfEncodeText(t.text) in
        "<text:p text:style-name=\"Standard\">${inner}</text:p>"
      else "",

    TableBlock(t) =>
      odtTableToXml(t.headers, t.rows),

    ListBlock(l) =>
      odtListToXml(l.items, l.ordered, l.itemRuns, ref),

    -- Reached only for a picture with no embeddable payload: odtBlockAcc
    -- places the embeddable ones (and walks sections) itself.
    ImageBlock(i) =>
      "<text:p text:style-name=\"Standard\">[Image: ${odfEncodeText(i.description)}]</text:p>",

    AudioBlock(a) =>
      "<text:p text:style-name=\"Standard\">[Audio: ${odfEncodeText(a.transcription)}]</text:p>",

    VideoBlock(v) =>
      "<text:p text:style-name=\"Standard\">[Video: ${odfEncodeText(v.description)}]</text:p>",

    -- Not reached from odtBlockAcc, which walks sections itself so nested
    -- pictures are placed; kept so the match stays total.
    SectionBlock(s) =>
      "<text:section text:name=\"${xmlEscape(s.kind)}\">${foldl(\acc b. "${acc}${odtBlockToXml(b, ref)}", "", s.blocks)}</text:section>",

    ChangeBlock(c) =>
      "<text:p text:style-name=\"Standard\">${odfEncodeText(c.text)} (${odfEncodeText(c.changeType)} by ${odfEncodeText(c.author)}, ${odfEncodeText(c.date)})</text:p>",

    LinkBlock(l) =>
      "<text:p text:style-name=\"Standard\"><text:a xlink:type=\"simple\" xlink:href=\"${xmlEscape(l.href)}\">${odfEncodeText(l.text)}</text:a></text:p>",

    -- Write-back of real ODF annotations (office:annotation) is out of scope
    -- for this read-only release; the pairing is preserved as text.
    CommentBlock(c) =>
      "<text:p text:style-name=\"Standard\">${odfEncodeText(commentText(c.author, c.text, c.anchorText, c.anchored))}</text:p>"
  }

-- Build an ODF table
pure func odtTableToXml(headers: [TableCell], rows: [[TableCell]]) -> string {
  let colCount = if listLength(headers) > 0 then listLength(headers)
    else match rows {
      r :: _ => listLength(r),
      [] => 1
    };
  let columns = odtTableColumns(colCount);
  let headerRow = if listLength(headers) > 0
    then "<table:table-header-rows><table:table-row>${odtTableCells(headers)}</table:table-row></table:table-header-rows>"
    else "";
  let dataRows = foldl(\acc row. "${acc}<table:table-row>${odtTableCells(row)}</table:table-row>", "", rows);
  "<table:table table:name=\"Table\">${columns}${headerRow}${dataRows}</table:table>"
}

pure func odtTableColumns(count: int) -> string =
  if count <= 0 then ""
  else "<table:table-column/>${odtTableColumns(count - 1)}"

pure func odtTableCells(cells: [TableCell]) -> string =
  foldl(\acc c. "${acc}${odtTableCell(c)}", "", cells)

pure func odtTableCell(cell: TableCell) -> string {
  let spanAttr = if cell.colSpan > 1
    then " table:number-columns-spanned=\"${intToStr(cell.colSpan)}\""
    else "";
  if cell.merged then "<table:covered-table-cell/>"
  else "<table:table-cell${spanAttr}><text:p>${odfEncodeText(cell.text)}</text:p></table:table-cell>"
}

-- Build an ODF list.
-- itemRuns is parallel to items but may be absent entirely. Both lists are
-- walked together so a short or missing itemRuns falls back to plain text per
-- item rather than pairing formatting with the wrong item.
-- List items name List_20_Bullet / List_20_Number for the same reason headings
-- name Heading_20_N: an unnamed text:p inherits the default paragraph style, so
-- a template's list styling would have nothing to attach to.
pure func odtListToXml(items: [string], ordered: bool, itemRuns: [[InlineRun]], ref: OdfRefDoc) -> string =
  let ours = if ordered then "List_20_Number" else "List_20_Bullet" in
  let fromTpl = if ordered then ref.numberId else ref.bulletId in
  let styleName = if ref.active && length(fromTpl) > 0 then fromTpl else ours in
  "<text:list>${odtListItemsToXml(items, itemRuns, styleName)}</text:list>"

pure func odtListItemsToXml(items: [string], itemRuns: [[InlineRun]], styleName: string) -> string =
  match items {
    [] => "",
    item :: rest =>
      match itemRuns {
        [] => "${odtListItem(odfEncodeText(item), styleName)}${odtListItemsToXml(rest, [], styleName)}",
        r :: rrest =>
          let body = if listLength(r) > 0 then odfRunsToXml(r) else odfEncodeText(item) in
          "${odtListItem(body, styleName)}${odtListItemsToXml(rest, rrest, styleName)}"
      }
  }

pure func odtListItem(body: string, styleName: string) -> string =
  "<text:list-item><text:p text:style-name=\"${styleName}\">${body}</text:p></text:list-item>"

-- Every style this generator's body XML can reference, as (name, xml) pairs
-- rather than one blob.
--
-- Two things depend on the pair shape. First, a reference doc can then inject
-- only the names the template does NOT define, so the template's Heading_20_1
-- wins while a missing List_20_Bullet is still filled in. Second, the set the
-- body references and the set styles.xml defines are derived from ONE list, so
-- they cannot disagree — a body naming a style nothing defines is the same
-- class of bug as an orphaned styles.xml part, and it renders as plain body
-- text with no indication why. (Measured: a template's Heading_20_1 at 55pt red
-- had NO effect until the heading named it — see the design doc's E1a/E1b.)
--
-- ODF encodes a space in a style name as "_20_", so "Heading 1" is the display
-- name and Heading_20_1 is the identifier. Both are emitted: consumers match on
-- style:name, but style:display-name is what a user sees in LibreOffice's style
-- list, and a template author needs to recognise them.
export pure func odfStyleDefs() -> [{name: string, xml: string}] = [
  {name: "Standard", xml: "<style:style style:name=\"Standard\" style:family=\"paragraph\"/>"},
  {name: "Heading_20_1", xml: odtHeadingStyle(1, "130%")},
  {name: "Heading_20_2", xml: odtHeadingStyle(2, "115%")},
  {name: "Heading_20_3", xml: odtHeadingStyle(3, "101%")},
  {name: "Heading_20_4", xml: odtHeadingStyle(4, "95%")},
  {name: "Heading_20_5", xml: odtHeadingStyle(5, "85%")},
  {name: "Heading_20_6", xml: odtHeadingStyle(6, "75%")},
  {name: "List_20_Bullet", xml: "<style:style style:name=\"List_20_Bullet\" style:display-name=\"List Bullet\" style:family=\"paragraph\" style:parent-style-name=\"Standard\"/>"},
  {name: "List_20_Number", xml: "<style:style style:name=\"List_20_Number\" style:display-name=\"List Number\" style:family=\"paragraph\" style:parent-style-name=\"Standard\"/>"}
]

-- Sizes are PERCENTAGES of the document default, not absolute points. A
-- template that sets a 9pt body should get proportionate headings, and a
-- hardcoded 28pt would fight it.
pure func odtHeadingStyle(level: int, size: string) -> string =
  "<style:style style:name=\"Heading_20_${intToStr(level)}\" style:display-name=\"Heading ${intToStr(level)}\" style:family=\"paragraph\" style:parent-style-name=\"Standard\" style:default-outline-level=\"${intToStr(level)}\"><style:text-properties fo:font-size=\"${size}\" fo:font-weight=\"bold\"/></style:style>"

-- ODF outline levels run 1..6; a deeper heading names the deepest style that
-- exists rather than a Heading_20_9 nothing defines.
export pure func odtHeadingStyleName(level: int) -> string =
  if level < 1 then "Heading_20_1"
  else if level > 6 then "Heading_20_6"
  else "Heading_20_${intToStr(level)}"

pure func odtJoinStyleXml(defs: [{name: string, xml: string}]) -> string =
  foldl(\acc d. "${acc}${d.xml}", "", defs)

-- styles.xml, built from the one list above.
pure func odtMinimalStyles() -> string =
  "${xmlDecl()}<office:document-styles ${odfNs()} office:version=\"1.2\"><office:styles>${odtJoinStyleXml(odfStyleDefs())}</office:styles></office:document-styles>"

-- Build meta.xml
pure func odtBuildMeta(title: string, author: string) -> string {
  let titleTag = if length(title) > 0 then "<dc:title>${xmlEscape(title)}</dc:title>" else "";
  let authorTag = if length(author) > 0 then "<dc:creator>${xmlEscape(author)}</dc:creator>" else "";
  "${xmlDecl()}<office:document-meta ${odfNs()} office:version=\"1.2\"><office:meta>${titleTag}${authorTag}<meta:generator>AILANG Parse</meta:generator></office:meta></office:document-meta>"
}

-- manifest.xml
pure func odtManifest() -> string =
  "${xmlDecl()}<manifest:manifest xmlns:manifest=\"urn:oasis:names:tc:opendocument:xmlns:manifest:1.0\" manifest:version=\"1.2\"><manifest:file-entry manifest:media-type=\"application/vnd.oasis.opendocument.text\" manifest:full-path=\"/\"/><manifest:file-entry manifest:media-type=\"text/xml\" manifest:full-path=\"content.xml\"/><manifest:file-entry manifest:media-type=\"text/xml\" manifest:full-path=\"styles.xml\"/><manifest:file-entry manifest:media-type=\"text/xml\" manifest:full-path=\"meta.xml\"/></manifest:manifest>"

export pure func testOdtImgFreeKey() -> bool
  tests [((), true)]
{
  odtImgFreeKey([], 3) == 3 &&
  odtImgFreeKey(["Pictures/dpimage1.png"], 1) == 2 &&
  odtImgFreeKey(["Pictures/dpimage10.png"], 1) == 1 &&
  odtImgFreeKey(["Pictures/dpimage1.png", "Pictures/dpimage2.jpeg"], 1) == 3
}
