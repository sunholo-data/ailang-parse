module docparse/services/odt_parser

import std/xml (parseLenient, findAll, findFirst, getText, getAttr, getChildren, getTag, nodeKind, NodeKind, KindElement, KindText, KindComment)
import std/zip (readEntry)
import std/option (Some, None, getOrElse)
import std/map (fromList as mapFromList, lookup as mapLookup)
import std/result (Ok, Err)
import std/string (length, trim, contains, startsWith, substring, endsWith)
import std/list (map, flatMap, filter, concat, any, length as listLength)
import docparse/services/odf_text (odfText, odfWhitespace)
import docparse/types/document (mkHeadingRuns, mkTextRuns, mkListRuns, InlineRun, mkHeading, mkList, mkText, Block, TextBlock, HeadingBlock, TableBlock, ImageBlock, ListBlock, SectionBlock, TableCell, DocMetadata, simpleCell, emptyMetadata, mkImage, mkTable, mkSection)

-- ODT Parser — converts OpenDocument Text to Block ADT.
-- Pure AILANG implementation using std/zip + std/xml.
--
-- ODT structure (ZIP archive):
--   content.xml    — main content (text:h, text:p, table:table, text:list)
--   meta.xml       — metadata (dc:title, dc:creator, dc:date)
--   styles.xml     — style definitions
--   META-INF/manifest.xml — media types
--
-- ODF XML namespace prefixes:
--   text:   — text elements (text:h, text:p, text:span, text:list)
--   table:  — table elements (table:table, table:table-row, table:table-cell)
--   office: — document structure (office:body, office:text)
--   draw:   — drawing elements (draw:frame, draw:image)
--   dc:     — Dublin Core metadata
--
-- This is the strategic gap: nobody does native ODT parsing.

-- Parse an ODT file into content blocks.
-- Contract: result is a possibly-empty list. `ensures` form is omitted —
-- see ailang-core issue #236 (v0.19.2 property-test generator bug).
export func parseOdt(filepath: string) -> [Block] ! {FS}
{
  let xml = match readEntry(filepath, "content.xml") {
    Ok(c) => c,
    Err(_) => ""
  };

  if length(xml) == 0
  then [mkText("ODT error: could not read content.xml", "error", 0)]
  else match parseLenient(xml) {
    Ok(root) => odtExtractBody(root),
    Err(e) => [mkText("ODT XML parse error: ${e}", "error", 0)]
  }
}

-- Extract headers and footers from styles.xml
-- ODF stores headers/footers in style:master-page elements
export func parseOdtHeadersFooters(filepath: string) -> [Block] ! {FS} {
  let xml = match readEntry(filepath, "styles.xml") {
    Ok(c) => c,
    Err(_) => ""
  };

  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => odtExtractHeadersFooters(root),
    Err(_) => []
  }
}

-- Extract header/footer blocks from styles.xml
export pure func odtExtractHeadersFooters(root: XmlNode) -> [Block] {
  let styles = odtBuildStyles(root);
  let masterPages = findAll(root, "style:master-page");
  flatMap(\mp. odtExtractMasterPage(mp, styles), masterPages)
}

-- Extract headers/footers from a single master-page
pure func odtExtractMasterPage(mp: XmlNode, styles: Map[string, OdtFmt]) -> [Block] {
  let headers = match findFirst(mp, "style:header") {
    Some(h) =>
      let blocks = odtProcessChildren(getChildren(h), styles) in
      if listLength(blocks) > 0 then [mkSection("header", blocks)]
      else [],
    None => []
  };
  let footers = match findFirst(mp, "style:footer") {
    Some(f) =>
      let blocks = odtProcessChildren(getChildren(f), styles) in
      if listLength(blocks) > 0 then [mkSection("footer", blocks)]
      else [],
    None => []
  };
  concat(headers, footers)
}

-- Extract metadata from an ODT file
export func parseOdtMetadata(filepath: string) -> DocMetadata ! {FS} {
  let xml = match readEntry(filepath, "meta.xml") {
    Ok(c) => c,
    Err(_) => ""
  };

  if length(xml) == 0 then emptyMetadata()
  else match parseLenient(xml) {
    Ok(root) => odtParseMetadata(root),
    Err(_) => emptyMetadata()
  }
}

-- Navigate to office:body/office:text and extract blocks
export pure func odtExtractBody(root: XmlNode) -> [Block] {
  -- Index automatic styles once, then thread them through the walk: a
  -- <text:span> names its style but does not carry the properties.
  let styles = odtBuildStyles(root);
  -- ODF: root > office:body > office:text
  match findFirst(root, "office:body") {
    Some(body) =>
      match findFirst(body, "office:text") {
        Some(text) => odtProcessChildren(getChildren(text), styles),
        None => []
      },
    None => {
      -- Try direct children (some ODT files have flat structure)
      let textNodes = findAll(root, "office:text");
      flatMap(\t. odtProcessChildren(getChildren(t), styles), textNodes)
    }
  }
}

-- Process a list of ODF child nodes into blocks
pure func odtProcessChildren(nodes: [XmlNode], styles: Map[string, OdtFmt]) -> [Block] =
  flatMap(\n. odtProcessNode(n, styles), nodes)

-- === Character formatting (ODF §16.27) ===================================
--
-- ODF differs from both OOXML dialects again: formatting is not on the run at
-- all. A <text:span> carries only text:style-name="T2", and the properties live
-- in a <style:style style:name="T2"> elsewhere in the document, so the span
-- cannot be interpreted without first indexing the styles. That is why the
-- style map is built once at the top and threaded through the walk.
--
-- Limitation: style:parent-style-name chains are NOT resolved. Automatic styles
-- (T1, T2, …), which is what LibreOffice and Word emit for direct formatting,
-- carry their properties inline, so the common case is covered; formatting
-- inherited purely from a named parent style is not.
type OdtFmt = {bold: bool, italic: bool, underline: bool, strike: bool, vertAlign: string}

pure func odtNoFmt() -> OdtFmt =
  {bold: false, italic: false, underline: false, strike: false, vertAlign: ""}

-- Index every style:style by name. Built once per document — a linear scan per
-- span would be O(spans x styles) on documents that have plenty of both.
pure func odtBuildStyles(root: XmlNode) -> Map[string, OdtFmt] =
  mapFromList(map(odtStyleEntry, findAll(root, "style:style")))

pure func odtStyleEntry(s: XmlNode) -> (string, OdtFmt) {
  let name = getOrElse(getAttr(s, "style:name"), "");
  match findFirst(s, "style:text-properties") {
    Some(tp) => (name, odtFmtFromProps(tp)),
    None => (name, odtNoFmt())
  }
}

pure func odtFmtFromProps(tp: XmlNode) -> OdtFmt = {
  bold: getOrElse(getAttr(tp, "fo:font-weight"), "") == "bold",
  italic: getOrElse(getAttr(tp, "fo:font-style"), "") == "italic",
  underline: odtLineOn(getOrElse(getAttr(tp, "style:text-underline-style"), "none")),
  strike: odtLineOn(getOrElse(getAttr(tp, "style:text-line-through-style"), "none")),
  vertAlign: odtVertAlign(getOrElse(getAttr(tp, "style:text-position"), ""))
}

-- These name a line style; "none" is the off state, as in DrawingML.
pure func odtLineOn(v: string) -> bool = length(v) > 0 && v != "none"

-- style:text-position is "super 58%" / "sub 58%" / a raw percentage.
pure func odtVertAlign(v: string) -> string =
  if startsWith(v, "super") then "superscript"
  else if startsWith(v, "sub") then "subscript"
  else ""

pure func odtLookupFmt(styles: Map[string, OdtFmt], name: string) -> OdtFmt =
  getOrElse(mapLookup(styles, name), odtNoFmt())

pure func odtRunsFor(node: XmlNode, styles: Map[string, OdtFmt]) -> [InlineRun] {
  let runs = odtCollectRuns(node, styles, odtNoFmt());
  if any(odtRunIsFormatted, runs) then runs else []
}

pure func odtRunIsFormatted(r: InlineRun) -> bool =
  r.bold || r.italic || r.underline || r.strike || length(r.vertAlign) > 0

pure func odtCollectRuns(node: XmlNode, styles: Map[string, OdtFmt], fmt: OdtFmt) -> [InlineRun] {
  let children = getChildren(node);
  if listLength(children) == 0
  then odtLeafRun(odfText(node), fmt)
  else flatMap(\c. odtChildRuns(c, styles, fmt), children)
}

pure func odtChildRuns(child: XmlNode, styles: Map[string, OdtFmt], fmt: OdtFmt) -> [InlineRun] =
  match nodeKind(child) {
    KindText => odtLeafRun(getText(child), fmt),
    KindComment => [],
    KindElement => {
      let tag = getTag(child);
      -- text:s / text:tab / text:line-break carry whitespace as elements, so
      -- they must be turned back into characters here or the runs jam together
      -- exactly as the plain-text path did.
      match odfWhitespace(child) {
        Some(ws) => odtLeafRun(ws, fmt),
        None =>
          -- Nested spans compose, so bold inside an italic span yields one run
          -- that is both.
          if tag == "text:span"
          then odtCollectRuns(child, styles,
                 odtMergeFmt(fmt, odtLookupFmt(styles, getOrElse(getAttr(child, "text:style-name"), ""))))
          -- draw:frame children are images, handled as their own blocks.
          else if tag == "draw:frame" then []
          else odtCollectRuns(child, styles, fmt)
      }
    }
  }

pure func odtMergeFmt(a: OdtFmt, b: OdtFmt) -> OdtFmt = {
  bold: a.bold || b.bold,
  italic: a.italic || b.italic,
  underline: a.underline || b.underline,
  strike: a.strike || b.strike,
  vertAlign: if length(b.vertAlign) > 0 then b.vertAlign else a.vertAlign
}

pure func odtLeafRun(text: string, fmt: OdtFmt) -> [InlineRun] =
  if length(text) == 0 then []
  else [{text: text, bold: fmt.bold, italic: fmt.italic, underline: fmt.underline,
         strike: fmt.strike, code: false, href: "", vertAlign: fmt.vertAlign}]

-- Process a single ODF node into blocks
pure func odtProcessNode(node: XmlNode, styles: Map[string, OdtFmt]) -> [Block] {
  let tag = getTag(node);

  -- Headings: text:h with text:outline-level attribute
  if tag == "text:h" then
    let text = trim(odfText(node)) in
    let level = odtHeadingLevel(node) in
    if length(text) > 0 then [mkHeadingRuns(text, level, odtRunsFor(node, styles))]
    else []

  -- Paragraphs: text:p (may contain embedded draw:frame children)
  else if tag == "text:p" then
    let text = trim(odfText(node)) in
    let embeddedFrames = flatMap(\c. odtProcessNode(c, styles), filter(\c. getTag(c) == "draw:frame", getChildren(node))) in
    let textBlocks = if length(text) > 0 then [mkTextRuns(text, "normal", 0, odtRunsFor(node, styles))] else [] in
    concat(textBlocks, embeddedFrames)

  -- Tables: table:table
  else if tag == "table:table" then [odtParseTable(node)]

  -- Lists: text:list
  else if tag == "text:list" then odtParseList(node, styles)

  -- Sections: text:section
  else if tag == "text:section" then
    let blocks = odtProcessChildren(getChildren(node), styles) in
    let name = getOrElse(getAttr(node, "text:name"), "section") in
    if listLength(blocks) > 0 then [mkSection(name, blocks)]
    else []

  -- Frames: draw:frame (may contain images or text boxes)
  else if tag == "draw:frame" then odtProcessFrame(node, styles)

  -- Skip everything else (office:forms, text:sequence-decls, etc.)
  else []
}

-- Get heading level from text:outline-level attribute.
-- Contract: result is in 1..6 (defaulting to 1). `ensures` omitted —
-- see ailang-core issue #236.
pure func odtHeadingLevel(node: XmlNode) -> int
{
  let levelStr = getOrElse(getAttr(node, "text:outline-level"), "1");
  if levelStr == "1" then 1
  else if levelStr == "2" then 2
  else if levelStr == "3" then 3
  else if levelStr == "4" then 4
  else if levelStr == "5" then 5
  else if levelStr == "6" then 6
  else 1
}

-- Parse an ODF table:table into a TableBlock
pure func odtParseTable(table: XmlNode) -> Block {
  let rows = findAll(table, "table:table-row");
  let parsedRows = map(odtParseTableRow, rows);
  match parsedRows {
    [] => mkTable([], []),
    firstRow :: dataRows =>
      mkTable(dataRows, firstRow)
  }
}

-- Parse a single table:table-row
pure func odtParseTableRow(tr: XmlNode) -> [TableCell] {
  let cells = findAll(tr, "table:table-cell");
  map(odtParseTableCell, cells)
}

-- Parse a table:table-cell into a TableCell
-- Handles table:number-columns-spanned for colspan
pure func odtParseTableCell(cell: XmlNode) -> TableCell {
  let text = trim(odfText(cell));
  let colSpanStr = getOrElse(getAttr(cell, "table:number-columns-spanned"), "1");
  let colSpan = odtParseSpan(colSpanStr);
  {text: text, colSpan: colSpan, rowSpan: 1, merged: false, scope: ""}
}

-- Parse colspan/rowspan value.
-- Contract: result >= 1. `ensures` omitted — see ailang-core issue #236.
pure func odtParseSpan(s: string) -> int
{
  if s == "1" then 1
  else if s == "2" then 2
  else if s == "3" then 3
  else if s == "4" then 4
  else if s == "5" then 5
  else if s == "6" then 6
  else if s == "7" then 7
  else if s == "8" then 8
  else if s == "9" then 9
  else if s == "10" then 10
  else 1
}

-- Parse a text:list into a ListBlock
pure func odtParseList(list: XmlNode, styles: Map[string, OdtFmt]) -> [Block] {
  let items = findAll(list, "text:list-item");
  -- Text and runs are carried together through the empty-item filter. Building
  -- them as separate lists and filtering only the texts would silently shift
  -- itemRuns out of alignment with items the moment any item is blank.
  let pairs = map(\i. {text: odtListItemText(i), runs: odtRunsFor(i, styles)}, items);
  let nonEmpty = filter(\pr. length(pr.text) > 0, pairs);
  if listLength(nonEmpty) > 0
  then {
    let texts = map(\pr. pr.text, nonEmpty);
    let itemRuns = map(\pr. pr.runs, nonEmpty);
    -- Plain lists keep the pre-runs shape rather than carrying [[],[],[]].
    if any(\r. listLength(r) > 0, itemRuns)
    then [mkListRuns(texts, false, itemRuns)]
    else [mkList(texts, false)]
  }
  else []
}

-- Extract text from a text:list-item (contains text:p children)
pure func odtListItemText(item: XmlNode) -> string =
  trim(odfText(item))

-- Process a draw:frame (may contain draw:image or draw:text-box)
pure func odtProcessFrame(frame: XmlNode, styles: Map[string, OdtFmt]) -> [Block] {
  -- Check for text box first
  match findFirst(frame, "draw:text-box") {
    Some(textBox) =>
      let blocks = odtProcessChildren(getChildren(textBox), styles) in
      if listLength(blocks) > 0 then [mkSection("textbox", blocks)]
      else [],
    None =>
      -- Check for image (draw:image with xlink:href)
      match findFirst(frame, "draw:image") {
        Some(img) =>
          let href = getOrElse(getAttr(img, "xlink:href"), "") in
          let desc = getOrElse(getAttr(frame, "draw:name"), "") in
          if length(href) > 0
          then [mkImage(href, desc, odtGuessMime(href))]
          else [],
        None => []
      }
  }
}

-- Guess MIME type from image path
pure func odtGuessMime(href: string) -> string
  tests [
    ("Pictures/image.png", "image/png"),
    ("photo.jpg", "image/jpeg"),
    ("photo.jpeg", "image/jpeg"),
    ("icon.gif", "image/gif"),
    ("logo.svg", "image/svg+xml"),
    ("scan.bmp", "image/bmp"),
    ("pic.webp", "image/webp"),
    ("unknown.xyz", "image/unknown")
  ]
{
  if endsWith(href, ".png") then "image/png"
  else if endsWith(href, ".jpg") || endsWith(href, ".jpeg") then "image/jpeg"
  else if endsWith(href, ".gif") then "image/gif"
  else if endsWith(href, ".svg") then "image/svg+xml"
  else if endsWith(href, ".bmp") then "image/bmp"
  else if endsWith(href, ".webp") then "image/webp"
  else "image/unknown"
}

-- Parse metadata from meta.xml
export pure func odtParseMetadata(root: XmlNode) -> DocMetadata {
  let title = odtFindMeta(root, "dc:title");
  let author = odtFindMeta(root, "dc:creator");
  let date = odtFindMeta(root, "dc:date");
  let pageCount = odtFindPageCount(root);
  {title: title, author: author, created: date, modified: "", pageCount: pageCount}
}

-- Find a metadata element's text
pure func odtFindMeta(root: XmlNode, tagName: string) -> string {
  let elements = findAll(root, tagName);
  match elements {
    [] => "",
    el :: _ => trim(getText(el))
  }
}

-- Find page count from meta:document-statistic
pure func odtFindPageCount(root: XmlNode) -> int {
  let stats = findAll(root, "meta:document-statistic");
  match stats {
    [] => 0,
    stat :: _ =>
      let countStr = getOrElse(getAttr(stat, "meta:page-count"), "0") in
      odtParsePageCount(countStr)
  }
}

-- Parse page count string.
-- Contract: result >= 0. `ensures` omitted — see ailang-core issue #236.
pure func odtParsePageCount(s: string) -> int
{
  if s == "0" then 0
  else if s == "1" then 1
  else if s == "2" then 2
  else if s == "3" then 3
  else if s == "4" then 4
  else if s == "5" then 5
  else if s == "10" then 10
  else if s == "20" then 20
  else if s == "50" then 50
  else if s == "100" then 100
  else 0
}
