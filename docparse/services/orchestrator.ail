-- Unified parse orchestration — one recipe per format, three thin callers.
--
-- WHY THIS EXISTS
--
-- The parsers in this package have always been shared. The *orchestration* —
-- which parser runs for which extension, and what gets merged in (headers,
-- footers, footnotes, comments, annotations, backend ladders) — was not. It was
-- written three times: docparse/main.ail (CLI), docparse/services/mcp/tools.ail
-- (stdio MCP), and api_server.ail in the private docparse repo (hosted API).
--
-- The result was ten silent divergences. Two were serious: the hosted API
-- dropped every PDF annotation on the default backend, and parsed multi-file
-- LaTeX without \input expansion, returning ~18% of a real arXiv paper with no
-- error. Nothing failed; the surfaces simply disagreed about what a document
-- contains.
--
-- This module owns the recipes. Callers become printers/serialisers over it.
--
-- DESIGN NOTES
--
-- 1. Data-returning, never effectful-printing. The CLI's parse* functions
--    returned () and printed as they worked, which is precisely why a server
--    could not reuse them (one even called exit(1) mid-parse). Here, progress
--    is accumulated as `notes` and the caller decides whether to print them.
--
-- 2. THREE entry points, tiered by capability — not one. AILANG has no working
--    effect-row polymorphism at v0.33.0: a lowercase `! {e}` parses and looks
--    polymorphic but behaves as an opaque concrete effect every caller must
--    also declare, so a pure caller passing a pure function still fails
--    (ailang#616). Effects are static, so a single signature would hand every
--    caller the union of all of them:
--
--      parseDocumentPure  ! {FS}                          deterministic only
--      parseDocumentAI    ! {AI, Clock, Env, FS, IO, Net} + AI, no subprocess
--      parseDocument      ! {..., Process}                 full ladder
--
--    This is not gratuitous. The published stdio-MCP embedder configs launch
--    with `--caps IO,FS,Env`; handing them Process would break every one at
--    runtime. Each tier shares the same per-format recipes — only the
--    capability envelope differs. Collapse to one the day effect rows unify.
--
-- 3. parseDocumentPure REFUSES formats it cannot do correctly rather than
--    doing them partially. Returning un-expanded LaTeX from the pure path
--    would recreate the exact silent-truncation bug this module exists to kill.

module docparse/services/orchestrator

import std/string (length, toLower, startsWith, endsWith)
import std/list (concat, length as listLength)
import std/fs (readFile, readFileBytes, fileExists, writeFileBytes, removeFile)
import std/bytes (fromBase64)
import std/option (Some, None)
import std/io (println)
import std/result (Ok, Err)
import std/ai (AIError)

import docparse/types/document (mkText, Block, TextBlock, SectionBlock, ParsedDocument, DocMetadata, emptyMetadata, countBlocks, filterImages, mkSection, mkNamedSection, ImageBlock, mkImage)
import docparse/services/format_router (detectFormat, getExtension, officeType)

-- Deterministic parsers (all ! {FS} or pure)
import docparse/services/docx_parser (
  parseDocx, parseDocxWithComments, parseDocxHeaders, parseDocxFooters,
  parseDocxFootnotes, parseDocxEndnotes, parseDocxImages, parseDocxMetadata
)
import docparse/services/pptx_parser (parsePptx, parsePptxImages, parsePptxMetadata)
import docparse/services/xlsx_parser (parseXlsx, parseXlsxMetadata)
import docparse/services/odt_parser (parseOdt, parseOdtMetadata, parseOdtHeadersFooters)
import docparse/services/odp_parser (parseOdp, parseOdpMetadata)
import docparse/services/ods_parser (parseOds, parseOdsMetadata)
import docparse/services/epub_parser (parseEpub, parseEpubMetadata)
import docparse/services/zip_extract (resolveBlockImages)
import docparse/services/html_parser (parseHtmlDoc)
import docparse/services/markdown_parser (parseMarkdown, parseMarkdownMeta)
import docparse/services/csv_parser (parseCsv)
import docparse/services/eml_parser (
  parseEml, parseMbox, parseMboxThreaded, parseEmlMetadata, parseMboxMetadata
)

import docparse/services/rtf_parser (parseRtf)

-- Full-ladder only
import docparse/services/tex_parser (parseLatex, parseLatexMetadata)
import docparse/services/tex_input_resolver (expandInputs, texDirname)
import docparse/services/tex_archive_extract (isTarGz, extractArxivBundle)
import docparse/services/pdf_backend_external (parsePdfViaBackend, parsePdfWithFallback, fetchPdfWords)
import docparse/services/pdf_annotations (scanAnnotations, annotationsAsBlocks, annotationsAsBlocksAnchored)
import docparse/services/direct_ai_parser (
  parsePdfResult, parsePdfMetadata, parseDocumentImage, parseAudio, parseVideo
)
import docparse/services/layout_ai (describeImages, enhanceBlocks, dirOf)

-- =====================================================================
-- Types
-- =====================================================================

-- Options controlling optional work. Everything defaults to the cheapest
-- correct behaviour: no AI, no shelling out, no recursion.
export type ParseOptions = {
  useAI: bool,          -- AI image description / layout repair
  pdfBackend: string,   -- "" (server default), pdftotext, docling, liteparse, ai
  deep: bool,           -- recurse into EML attachments
  extractImages: bool,  -- extract embedded binary images (DOCX/PPTX)
  threaded: bool,       -- MBOX: group messages into conversation threads
  projectRoot: string   -- root for Process shell-outs (PDF adapter)
}

export pure func defaultParseOptions() -> ParseOptions = {
  useAI: false,
  pdfBackend: "",
  deep: false,
  extractImages: true,
  threaded: false,
  projectRoot: ""
}

-- A parsed document plus everything a caller might want to report.
--
-- `notes` is progress/informational output the CLI used to println as it
-- worked ("Found 3 annotations"). `warnings` is degradation the user should
-- act on (an unreadable attachment, an incomplete annotation scan). Keeping
-- them separate lets a server log warnings while discarding notes.
--
-- Deliberately NOT an extension of types/document.ExtractionResult: that type
-- is exported and constructed in 17 places, so adding a field would break
-- every record literal and every external consumer.
export type ParseOutcome = {
  document: ParsedDocument,
  warnings: [string],
  notes: [string],
  aiCallsUsed: int
}

pure func mkOutcome(format: string, filepath: string, meta: DocMetadata,
                    blocks: [Block], notes: [string], warnings: [string],
                    aiCalls: int) -> ParseOutcome = {
  document: {format: format, filename: filepath, metadata: meta, blocks: blocks},
  warnings: warnings,
  notes: notes,
  aiCallsUsed: aiCalls
}

-- =====================================================================
-- Deterministic path — ! {FS}
-- =====================================================================

-- Parse a document using only filesystem access: no AI, no network, no
-- subprocess. Covers every format an MCP embedder granting {FS} can serve.
--
-- Returns Err for formats that genuinely need more capability (pdf, latex,
-- image, audio, video). It does NOT fall back to a partial parse — a caller
-- that gets Ok can trust the document is complete for its format.
export func parseDocumentPure(filepath: string, opts: ParseOptions)
  -> Result[ParseOutcome, string] ! {FS} = {
  let ext = toLower(getExtension(filepath));
  let format = detectFormat(ext);
  if format == "zip-office" then orchOffice(filepath, ext, opts)
  else if format == "zip-odf" then Ok(orchOdf(filepath, ext))
  else if format == "epub" then Ok(orchEpub(filepath))
  else if format == "html" then Ok(orchHtml(filepath))
  else if format == "markdown" then Ok(orchMarkdown(filepath))
  else if format == "csv" then Ok(orchCsv(filepath, ext))
  else if format == "email" then Ok(orchNoteDeepUnavailable(orchEmail(filepath, ext, opts), opts))
  else if format == "rtf" then Ok(orchRtf(filepath))
  else if format == "text" then Ok(orchText(filepath))
  else Err(orchPureRefusal(format))
}

-- Why a format is refused by the deterministic path, and what to call instead.
pure func orchPureRefusal(format: string) -> string =
  if format == "pdf" then
    "pdf requires parseDocument: backends shell out (Process) and the AI fallback needs {AI, Net}"
  else if format == "latex" then
    "latex requires parseDocument: \\input expansion needs {IO, FS}; parsing without it silently drops every fragment"
  else if format == "image" || format == "audio" || format == "video" then
    "${format} is AI-only; use parseDocument"
  else
    "unsupported format '${format}'"

-- --- DOCX / PPTX / XLSX ---
--
-- Block order is the standard for all three surfaces:
--   headers ++ body(comments spliced at anchors) ++ footers ++ footnotes
--   ++ endnotes ++ images
-- A header prints at the top of a page, so it precedes the body.
func orchOffice(filepath: string, ext: string, opts: ParseOptions)
  -> Result[ParseOutcome, string] ! {FS} = {
  let kind = officeType(ext);
  if kind == "word" then {
    let body = parseDocxWithComments(filepath);
    let images = if opts.extractImages then parseDocxImages(filepath) else [];
    let blocks = concat(parseDocxHeaders(filepath),
      concat(body,
        concat(parseDocxFooters(filepath),
          concat(parseDocxFootnotes(filepath),
            concat(parseDocxEndnotes(filepath), images)))));
    Ok(mkOutcome("docx", filepath, parseDocxMetadata(filepath), blocks,
      ["Parsed DOCX: ${show(countBlocks(blocks))} blocks"], [], 0))
  }
  else if kind == "powerpoint" then {
    let body = parsePptx(filepath);
    -- PPTX image extraction has always been opt-in behind useAI, unlike DOCX
    -- where it is unconditional. Preserved deliberately: switching PPTX to
    -- extractImages would change output for every existing caller. The
    -- inconsistency is worth resolving, but not silently inside a refactor.
    let images = if opts.useAI then parsePptxImages(filepath) else [];
    let blocks = concat(body, images);
    Ok(mkOutcome("pptx", filepath, parsePptxMetadata(filepath), blocks,
      ["Parsed PPTX: ${show(countBlocks(blocks))} blocks"], [], 0))
  }
  else if kind == "excel" then {
    let blocks = parseXlsx(filepath);
    Ok(mkOutcome("xlsx", filepath, parseXlsxMetadata(filepath), blocks,
      ["Parsed XLSX: ${show(countBlocks(blocks))} blocks"], [], 0))
  }
  else Err("unknown Office type for extension '${ext}'")
}

-- --- ODT / ODP / ODS ---
--
-- ODT headers/footers live in styles.xml and are APPENDED (unlike DOCX, where
-- headers lead) — this matches the CLI's long-standing behaviour.
-- ODF images are stored as ZIP-internal paths (Pictures/…, media/…), so they
-- must be resolved against the archive exactly as EPUB's are. Without this the
-- ImageBlock's `data` keeps the href string and `dataLength` reports the length
-- of the path rather than of the image.
func orchOdf(filepath: string, ext: string) -> ParseOutcome ! {FS} = {
  if ext == "odt" then {
    let parsed = concat(parseOdt(filepath), parseOdtHeadersFooters(filepath));
    let blocks = resolveBlockImages(filepath, parsed);
    mkOutcome("odt", filepath, parseOdtMetadata(filepath), blocks,
      ["Parsed ODT: ${show(countBlocks(blocks))} blocks"], [], 0)
  }
  else if ext == "odp" then {
    let blocks = resolveBlockImages(filepath, parseOdp(filepath));
    mkOutcome("odp", filepath, parseOdpMetadata(filepath), blocks,
      ["Parsed ODP: ${show(countBlocks(blocks))} blocks"], [], 0)
  }
  else {
    let blocks = resolveBlockImages(filepath, parseOds(filepath));
    mkOutcome("ods", filepath, parseOdsMetadata(filepath), blocks,
      ["Parsed ODS: ${show(countBlocks(blocks))} blocks"], [], 0)
  }
}

-- EPUB images are referenced inside the ZIP, so resolve them against the
-- archive rather than leaving dangling srcs.
func orchEpub(filepath: string) -> ParseOutcome ! {FS} = {
  let blocks = resolveBlockImages(filepath, parseEpub(filepath));
  mkOutcome("epub", filepath, parseEpubMetadata(filepath), blocks,
    ["Parsed EPUB: ${show(countBlocks(blocks))} blocks"], [], 0)
}

func orchHtml(filepath: string) -> ParseOutcome ! {FS} = {
  let parsed = parseHtmlDoc(readFile(filepath));
  mkOutcome("html", filepath, parsed.metadata, parsed.blocks,
    ["Parsed HTML: ${show(countBlocks(parsed.blocks))} blocks"], [], 0)
}

func orchMarkdown(filepath: string) -> ParseOutcome ! {FS} = {
  let content = readFile(filepath);
  let parsed = parseMarkdown(content);
  let blocks = orchResolveMdImages(parsed, dirOf(filepath));
  -- Front matter carries title/author, which every other format takes from
  -- its own core properties. Without it a generated document has none.
  mkOutcome("markdown", filepath, parseMarkdownMeta(content), blocks,
    ["Parsed Markdown: ${show(countBlocks(blocks))} blocks"], [], 0)
}

-- A Markdown image is a PATH, not bytes, so it reached the generators as a
-- "[Image: alt]" text placeholder — an AI writing Markdown could not put a
-- picture in a document at all. Read the file here (the parser is pure and
-- cannot) and hand the generators the base64 they already know how to embed.
--
-- A reference that does not resolve keeps its placeholder rather than failing
-- the parse: a broken image link should not cost you the document.
func orchResolveMdImages(blocks: [Block], baseDir: string) -> [Block] ! {FS} =
  match blocks {
    [] => [],
    b :: rest =>
      orchResolveMdImage(b, baseDir) :: orchResolveMdImages(rest, baseDir)
  }

func orchResolveMdImage(block: Block, baseDir: string) -> Block ! {FS} =
  match block {
    ImageBlock(i) =>
      if length(i.data) == 0 || i.mime != "image/unknown" then block
      else if startsWith(i.data, "http://") || startsWith(i.data, "https://")
      then block   -- remote reference: not ours to fetch
      else {
        let path = if startsWith(i.data, "/") then i.data else "${baseDir}/${i.data}";
        if not fileExists(path) then block
        else match readFileBytes(path) {
          Ok(b64) => mkImage(b64, i.description, orchImageMime(getExtension(i.data))),
          Err(_) => block
        }
      },
    SectionBlock(s) =>
      mkNamedSection(s.kind, s.name, orchResolveMdImages(s.blocks, baseDir)),
    _ => block
  }

-- `ext` is "csv" or "tsv" — detectFormat routes both here because they share a
-- parsing strategy, but the reported format must stay the one the user gave us.
func orchCsv(filepath: string, ext: string) -> ParseOutcome ! {FS} = {
  let delim = if ext == "tsv" then "\t" else ",";
  let blocks = parseCsv(readFile(filepath), delim);
  mkOutcome(ext, filepath, emptyMetadata(), blocks,
    ["Parsed ${ext}: ${show(countBlocks(blocks))} blocks"], [], 0)
}

-- Shallow email parse. Attachment recursion (opts.deep) needs Process for the
-- PDF backend ladder, so it lives in parseDocument.
--
-- `ext` is "eml" or "mbox" — as with orchCsv, detectFormat routes both here
-- because they share a strategy, but the reported format must stay the one the
-- user gave us.
func orchEmail(filepath: string, ext: string, opts: ParseOptions) -> ParseOutcome ! {FS} = {
  let content = readFile(filepath);
  let isMbox = ext == "mbox";
  let blocks = if isMbox && opts.threaded then parseMboxThreaded(content)
               else if isMbox then parseMbox(content)
               else parseEml(content);
  let meta = if isMbox then parseMboxMetadata(content) else parseEmlMetadata(content);
  mkOutcome(ext, filepath, meta, blocks,
    ["Parsed ${ext}: ${show(countBlocks(blocks))} blocks"], [], 0)
}

-- parseDocumentPure cannot resolve attachments (that needs Process for the PDF
-- ladder), so say so rather than quietly returning a shallow parse when the
-- caller explicitly asked for --deep. parseDocument does the real work.
pure func orchNoteDeepUnavailable(outcome: ParseOutcome, opts: ParseOptions) -> ParseOutcome =
  if opts.deep == false then outcome
  else {
    document: outcome.document,
    warnings: concat(outcome.warnings,
      ["deep attachment resolution skipped: parseDocumentPure cannot shell out; use parseDocument"]),
    notes: outcome.notes,
    aiCallsUsed: outcome.aiCallsUsed
  }

func orchRtf(filepath: string) -> ParseOutcome ! {FS} = {
  let blocks = parseRtf(readFile(filepath));
  mkOutcome("rtf", filepath, emptyMetadata(), blocks,
    ["Parsed RTF: ${show(countBlocks(blocks))} blocks"], [], 0)
}

func orchText(filepath: string) -> ParseOutcome ! {FS} = {
  let content = readFile(filepath);
  mkOutcome("text", filepath, emptyMetadata(),
    [mkText(content, "normal", 0)],
    ["Parsed as plain text (${show(length(content))} chars)"], [], 0)
}

-- =====================================================================
-- Full ladder — everything the deterministic path refuses
-- =====================================================================

-- Parse any supported document. Delegates to parseDocumentPure for the
-- deterministic formats so there is exactly ONE recipe per format, then
-- handles the formats that need more capability.
export func parseDocument(filepath: string, opts: ParseOptions)
  -> Result[ParseOutcome, AIError] ! {IO, FS, AI, Env, Net, Process, Clock} = {
  let ext = toLower(getExtension(filepath));
  -- getExtension returns only the last dotted suffix (".gz"), so arXiv source
  -- bundles must be recognised by full filename before format detection.
  let format = if isTarGz(filepath) then "latex" else detectFormat(ext);
  if format == "pdf" then orchPdf(filepath, opts)
  else if format == "latex" then Ok(orchEnrich(filepath, orchLatex(filepath), opts))
  else if format == "image" then Ok(orchMedia(filepath, "image", parseDocumentImage(filepath, orchImageMime(ext))))
  else if format == "audio" then Ok(orchMedia(filepath, "audio", parseAudio(filepath, orchAudioMime(ext))))
  else if format == "video" then Ok(orchMedia(filepath, "video", parseVideo(filepath, orchVideoMime(ext))))
  else match parseDocumentPure(filepath, opts) {
    -- Email + --deep is the one case the deterministic path cannot finish:
    -- resolving attachments shells out for the PDF ladder. Do it here, then
    -- enrich as normal.
    Ok(outcome) =>
      if format == "email" && opts.deep
        then Ok(orchEnrich(filepath, orchEmailDeep(outcome, opts), opts))
        else Ok(orchEnrich(filepath, outcome, opts)),
    -- Deterministic path refused. AI-only formats (image/audio/video) are not
    -- yet routed here; surface the refusal rather than returning empty blocks.
    Err(msg) => Ok(mkOutcome(format, filepath, emptyMetadata(),
      [mkText("Parse failed: ${msg}", "error", 0)],
      [], [msg], 0))
  }
}

-- Optional AI enrichment, applied to an already-parsed document when the
-- caller opts in: describe embedded images, then self-heal tables/layout.
--
-- This is orchestration, not presentation — the CLI's `describe`/`summarize`
-- modes are just this step turned on — so it belongs here rather than being
-- re-derived per caller. A no-op when useAI is false, which is the default.
-- Which formats the CLI has historically enriched. Deliberately NOT every
-- format: enhanceBlocks costs an AI call per block, so extending it to csv /
-- markdown / email / rtf / text would silently add spend that the previous
-- behaviour never incurred. A refactor should not change the bill.
pure func orchEnrichable(format: string) -> bool =
  format == "docx" || format == "pptx" || format == "xlsx"
  || format == "odt" || format == "odp" || format == "ods"
  || format == "html" || format == "epub" || format == "latex"

func orchEnrich(filepath: string, outcome: ParseOutcome, opts: ParseOptions)
  -> ParseOutcome ! {AI, FS} =
  if opts.useAI == false || orchEnrichable(outcome.document.format) == false
    then outcome
  else {
    let imageCount = countBlocks(filterImages(outcome.document.blocks));
    let described = if imageCount > 0
      then describeImages(dirOf(filepath), outcome.document.blocks)
      else {blocks: outcome.document.blocks, warnings: [], aiCalls: 0};
    let enhanced = enhanceBlocks(described.blocks);
    {
      document: {format: outcome.document.format, filename: outcome.document.filename,
                 metadata: outcome.document.metadata, blocks: enhanced},
      warnings: concat(outcome.warnings, described.warnings),
      notes: concat(outcome.notes,
        if imageCount > 0 then ["Described ${show(imageCount)} images with AI"] else []),
      aiCallsUsed: outcome.aiCallsUsed + described.aiCalls
    }
  }

-- AI-only media (image / audio / video). One shape for all three: the blocks
-- come straight from the multimodal parser, and the AI call is counted so a
-- caller can bill or budget it.
pure func orchMedia(filepath: string, kind: string, blocks: [Block]) -> ParseOutcome =
  mkOutcome(kind, filepath, emptyMetadata(), blocks,
    ["Parsed ${kind} via AI: ${show(countBlocks(blocks))} blocks"], [], 1)

-- MIME maps, hoisted out of main.ail — they are orchestration (choosing what
-- to tell the model a file is), not CLI presentation, so all three callers
-- need them rather than just the CLI.
pure func orchImageMime(ext: string) -> string =
  match ext {
    "png" => "image/png",
    "jpg" => "image/jpeg",
    "jpeg" => "image/jpeg",
    "gif" => "image/gif",
    "bmp" => "image/bmp",
    "webp" => "image/webp",
    "tiff" => "image/tiff",
    _ => "image/unknown"
  }

pure func orchAudioMime(ext: string) -> string =
  match ext {
    "wav" => "audio/wav",
    "mp3" => "audio/mp3",
    "aiff" => "audio/aiff",
    "aac" => "audio/aac",
    "ogg" => "audio/ogg",
    "flac" => "audio/flac",
    _ => "audio/unknown"
  }

pure func orchVideoMime(ext: string) -> string =
  match ext {
    "mp4" => "video/mp4",
    "mpeg" => "video/mpeg",
    "mov" => "video/mov",
    "avi" => "video/avi",
    "flv" => "video/x-flv",
    "mpg" => "video/mpg",
    "webm" => "video/webm",
    "wmv" => "video/wmv",
    "3gpp" => "video/3gpp",
    _ => "video/unknown"
  }

-- LaTeX: resolve \input/\include against the main file's directory BEFORE
-- parsing. Without this a multi-file paper yields its preamble and section
-- headings and nothing else — measured at 22 blocks vs 120 on a real arXiv
-- source bundle.
func orchLatex(filepath: string) -> ParseOutcome ! {IO, FS, Process} = {
  -- arXiv source bundles (.tar.gz/.tgz/.tex.gz) extract first; the main .tex
  -- is the one containing \documentclass. Without this the CLI would lose
  -- arXiv support in the migration.
  let resolved = orchResolveTexSource(filepath);
  let raw = readFile(resolved.path);
  let content = expandInputs(texDirname(resolved.path), raw);
  let expanded = length(content) != length(raw);
  let blocks = parseLatex(content);
  let m = parseLatexMetadata(content);
  let meta = { title: m.title, author: m.author, created: "", modified: "",
               pageCount: 0 };
  let expandNote = if expanded
    then ["Expanded \\input/\\include: ${show(length(raw))} -> ${show(length(content))} chars"]
    else [];
  mkOutcome("latex", filepath, meta, blocks,
    concat(resolved.notes,
      concat(expandNote, ["Parsed LaTeX: ${show(countBlocks(blocks))} blocks"])),
    resolved.warnings, 0)
}

-- Resolve a LaTeX input to the actual .tex file to parse. A plain path passes
-- through untouched; an archive is extracted to /tmp and its main .tex used.
-- A failed extraction degrades to parsing the archive path itself (which will
-- yield little) rather than aborting — the caller sees the warning.
func orchResolveTexSource(filepath: string)
  -> {path: string, notes: [string], warnings: [string]} ! {IO, FS, Process} =
  if isTarGz(filepath) == false
    then {path: filepath, notes: [], warnings: []}
    else match extractArxivBundle(filepath) {
      Ok(r) => {path: r.main,
                notes: ["Extracted archive to ${r.dir}; main .tex: ${r.main}"],
                warnings: []},
      Err(msg) => {path: filepath, notes: [],
                   warnings: ["Archive extraction failed: ${msg}"]}
    }

-- PDF: backend ladder, then annotations merged on EVERY path.
--
-- Annotations live in the /Annots object layer, which no text-extraction
-- backend reports. Merging them only on the AI path (the old CLI behaviour)
-- meant a reviewer's comments vanished silently on the default backend.
func orchPdf(filepath: string, opts: ParseOptions)
  -> Result[ParseOutcome, AIError] ! {IO, FS, AI, Env, Net, Process, Clock} = {
  let backend = if length(opts.pdfBackend) > 0 then opts.pdfBackend else "pdftotext";
  if backend == "ai" then match parsePdfResult(filepath) {
    Err(e) => Err(e),
    Ok(blocks) => {
      let ann = orchPdfAnnotations(filepath, opts.projectRoot);
      Ok(mkOutcome("pdf", filepath, parsePdfMetadata(filepath),
        concat(blocks, ann.blocks),
        concat(["Parsed PDF (ai): ${show(countBlocks(blocks))} blocks"], ann.notes),
        ann.warnings, 1))
    }
  }
  else match parsePdfViaBackend(backend, filepath, opts.projectRoot) {
    Ok(ext) => {
      let ann = orchPdfAnnotations(filepath, opts.projectRoot);
      Ok(mkOutcome("pdf", filepath, ext.metadata,
        concat(ext.blocks, ann.blocks),
        concat(["Parsed PDF (${backend}): ${show(countBlocks(ext.blocks))} blocks"], ann.notes),
        ann.warnings, 0))
    },
    -- An explicit backend choice is respected: no silent AI fallback, because
    -- AI costs money and the caller asked for something free.
    Err(msg) =>
      if length(opts.pdfBackend) > 0
        then Ok(mkOutcome("pdf", filepath, emptyMetadata(),
          [mkText("PDF extraction failed: ${msg}. If this is a scanned PDF, retry with pdfBackend=ai.", "error", 0)],
          [], ["PDF backend '${backend}' failed: ${msg}"], 0))
        else match parsePdfResult(filepath) {
          Err(e) => Err(e),
          Ok(blocks) => {
            let ann = orchPdfAnnotations(filepath, opts.projectRoot);
            Ok(mkOutcome("pdf", filepath, parsePdfMetadata(filepath),
              concat(blocks, ann.blocks),
              concat(["PDF backend '${backend}' found no text; fell back to AI"], ann.notes),
              ann.warnings, 1))
          }
        }
  }
}

-- Annotation blocks plus the notes/warnings describing what was found.
-- Anchoring is by word CENTRE, not overlap: a highlight drawn slightly wide
-- clips its neighbour, and any-overlap would claim words the reviewer never
-- marked. Missing word positions degrade to unanchored rather than dropped.
func orchPdfAnnotations(filepath: string, projectRoot: string)
  -> {blocks: [Block], notes: [string], warnings: [string]} ! {FS, Process} = {
  let scan = scanAnnotations(filepath);
  let anns = scan.annotations;
  let warns = if scan.mayBeIncomplete
    then ["PDF uses compressed object streams — annotations inside them are not visible"]
    else [];
  if listLength(anns) == 0
    then {blocks: [], notes: [], warnings: warns}
    else {
      blocks: annotationsAsBlocksAnchored(anns, fetchPdfWords(filepath, projectRoot)),
      notes: ["Found ${show(listLength(anns))} annotations"],
      warnings: warns
    }
}

-- =====================================================================
-- EML deep attachment resolution (moved from main.ail)
-- =====================================================================
--
-- Pass 1 (eml_parser) preserves attachment bytes as base64 for the MIME types
-- worth resolving; this is pass 2, which decodes them to /tmp and parses each
-- with the right parser. It was CLI-only, which is why `--deep` did nothing on
-- the MCP server or the hosted API.
--
-- Needs {IO, FS, Process}: Process for the PDF backend ladder, IO for the
-- progress/warning lines. Those printlns are preserved verbatim rather than
-- converted to accumulated notes — behaviour-preserving is the priority during
-- a migration, and threading an accumulator through a mutual recursion is a
-- separate change worth making on its own.

-- Resolve every attachment in a block tree, returning the rewritten blocks and
-- how many were resolved. `counter` makes temp filenames unique across a walk.
func orchEmlResolveAttachments(blocks: [Block], counter: int, projectRoot: string)
  -> { blocks: [Block], count: int } ! {IO, FS, Process} {
  match blocks {
    [] => { blocks: [], count: 0 },
    block :: rest => {
      let resolved = orchEmlResolveOneBlock(block, counter, projectRoot);
      let restResolved = orchEmlResolveAttachments(rest, counter + resolved.count, projectRoot);
      { blocks: resolved.block :: restResolved.blocks, count: resolved.count + restResolved.count }
    }
  }
}

-- Resolve a single block, recursing into SectionBlocks (threads, mbox messages).
func orchEmlResolveOneBlock(block: Block, counter: int, projectRoot: string)
  -> { block: Block, count: int } ! {IO, FS, Process} {
  match block {
    SectionBlock(s) => {
      if s.kind == "attachment" && orchEmlHasData(s.blocks) then {
        let b64 = orchEmlGetData(s.blocks);
        let ext = orchEmlGetExt(s.blocks);
        let meta = orchEmlGetMeta(s.blocks);
        let tmpPath = "/tmp/ailang_email_attach_${show(counter)}.${ext}";
        match fromBase64(b64) {
          Some(bytes) => {
            writeFileBytes(tmpPath, bytes);
            let parsedBlocks = orchEmlParseAttachment(tmpPath, ext, projectRoot);
            removeFile(tmpPath);
            let metaBlock = mkText(meta, "attachment-meta", 0);
            { block: mkSection("attachment", metaBlock :: parsedBlocks), count: 1 }
          },
          None => {
            println("  Warning: Failed to decode base64 for attachment");
            { block: block, count: 0 }
          }
        }
      }
      else {
        let inner = orchEmlResolveAttachments(s.blocks, counter, projectRoot);
        { block: mkNamedSection(s.kind, s.name, inner.blocks), count: inner.count }
      }
    },
    _ => { block: block, count: 0 }
  }
}

-- Parse a resolved attachment by extension.
--
-- PDFs go through the pdftotext -> docling ladder. Crucially this NEVER calls
-- exit(): an attachment that cannot be read is one bad file inside somebody's
-- mailbox, not a reason to abandon the message — let alone the rest of a batch
-- (ailang#607, where exit() inside a batch item panics the whole run). The
-- failure becomes a visible block instead, so it cannot pass for success.
func orchEmlParseAttachment(filepath: string, ext: string, projectRoot: string)
  -> [Block] ! {IO, FS, Process} {
  if ext == "docx" then parseDocx(filepath)
  else if ext == "xlsx" then parseXlsx(filepath)
  else if ext == "pptx" then parsePptx(filepath)
  else if ext == "pdf" then {
    match parsePdfWithFallback("pdftotext", filepath, projectRoot) {
      Ok(outcome) => {
        if outcome.backendUsed != "pdftotext"
        then println("    (no text layer — recovered via ${outcome.backendUsed} OCR)")
        else ();
        outcome.doc.blocks
      },
      Err(msg) => {
        println("    Warning: PDF attachment not readable: ${msg}");
        [mkText("[unreadable PDF attachment: ${msg}]", "error", 0)]
      }
    }
  }
  else [mkText("[unsupported attachment format: ${ext}]", "error", 0)]
}

pure func orchEmlHasData(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    TextBlock(t) :: rest => if t.style == "attachment-data" then true else orchEmlHasData(rest),
    _ :: rest => orchEmlHasData(rest)
  }

pure func orchEmlGetData(blocks: [Block]) -> string =
  match blocks {
    [] => "",
    TextBlock(t) :: rest => if t.style == "attachment-data" then t.text else orchEmlGetData(rest),
    _ :: rest => orchEmlGetData(rest)
  }

pure func orchEmlGetExt(blocks: [Block]) -> string =
  match blocks {
    [] => "bin",
    TextBlock(t) :: rest => if t.style == "attachment-ext" then t.text else orchEmlGetExt(rest),
    _ :: rest => orchEmlGetExt(rest)
  }

pure func orchEmlGetMeta(blocks: [Block]) -> string =
  match blocks {
    [] => "",
    TextBlock(t) :: rest => if t.style == "attachment-meta" then t.text else orchEmlGetMeta(rest),
    _ :: rest => orchEmlGetMeta(rest)
  }

-- Apply deep resolution to an already-parsed email outcome.
func orchEmailDeep(outcome: ParseOutcome, opts: ParseOptions)
  -> ParseOutcome ! {IO, FS, Process} = {
  println("Resolving attachments...");
  let resolved = orchEmlResolveAttachments(outcome.document.blocks, 0, opts.projectRoot);
  println("Resolved ${show(resolved.count)} attachment(s).");
  {
    document: {format: outcome.document.format, filename: outcome.document.filename,
               metadata: outcome.document.metadata, blocks: resolved.blocks},
    warnings: outcome.warnings,
    notes: concat(outcome.notes, ["Resolved ${show(resolved.count)} attachment(s)"]),
    aiCallsUsed: outcome.aiCallsUsed
  }
}

-- =====================================================================
-- AI path without subprocess — ! {AI, Clock, Env, FS, IO, Net}
-- =====================================================================

-- Parse with AI available but WITHOUT Process.
--
-- This exists because the stdio MCP server is launched by published embedder
-- configs (Claude Desktop, VS Code, Cursor, Claude Code) with `--caps IO,FS,Env`
-- — no Process. Routing it through parseDocument would statically require
-- Process and break every one of those configs at runtime, even though the AI
-- branch never shells out. Effects are static, and AILANG has no effect-row
-- polymorphism to express "Process only on the branch that uses it"
-- (ailang#616), so the capability tiers become separate entry points:
--
--   parseDocumentPure  ! {FS}                          deterministic only
--   parseDocumentAI    ! {AI, Clock, Env, FS, IO, Net} + AI, no subprocess
--   parseDocument      ! {..., Process}                 full ladder
--
-- All three share the same per-format recipes; only the capability envelope
-- differs. PDF here is AI-only (no pdftotext ladder, which needs Process), and
-- annotations are UNANCHORED — anchoring needs word positions from the adapter,
-- which is also a subprocess. Unanchored beats absent: the reviewer's comment
-- is still returned, with anchored:false stating plainly that its span is
-- unknown.
export func parseDocumentAI(filepath: string, opts: ParseOptions)
  -> Result[ParseOutcome, AIError] ! {AI, Clock, Env, FS, IO, Net} = {
  let ext = toLower(getExtension(filepath));
  let format = detectFormat(ext);
  if format == "pdf" then match parsePdfResult(filepath) {
    Err(e) => Err(e),
    Ok(blocks) => {
      let scan = scanAnnotations(filepath);
      let annBlocks = annotationsAsBlocks(scan.annotations);
      let warns = if scan.mayBeIncomplete
        then ["PDF uses compressed object streams — annotations inside them are not visible"]
        else [];
      Ok(mkOutcome("pdf", filepath, parsePdfMetadata(filepath),
        concat(blocks, annBlocks),
        ["Parsed PDF (ai): ${show(countBlocks(blocks))} blocks",
         "Found ${show(listLength(scan.annotations))} annotations (unanchored — anchoring needs Process)"],
        warns, 1))
    }
  }
  else if format == "image" then Ok(orchMedia(filepath, "image", parseDocumentImage(filepath, orchImageMime(ext))))
  else if format == "audio" then Ok(orchMedia(filepath, "audio", parseAudio(filepath, orchAudioMime(ext))))
  else if format == "video" then Ok(orchMedia(filepath, "video", parseVideo(filepath, orchVideoMime(ext))))
  else match parseDocumentPure(filepath, opts) {
    Ok(outcome) => Ok(orchEnrich(filepath, outcome, opts)),
    Err(msg) => Ok(mkOutcome(format, filepath, emptyMetadata(),
      [mkText("Parse failed: ${msg}", "error", 0)],
      [], [msg], 0))
  }
}
