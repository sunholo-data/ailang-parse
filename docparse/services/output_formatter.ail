module docparse/services/output_formatter

import std/io (println)
import std/json (encode, jo, kv, js, jnum, ja, jb, jn)
import std/string (length)
import std/math (intToFloat)
import std/list (map, foldl, filter, length as listLength, forEachE, concat)
import docparse/types/document (Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, InlineRun, ParsedDocument, ExtractionResult, DocMetadata, countBlocks, filterHeadings, filterTables, filterImages, filterChanges, filterSections, cellText)

-- Output Formatter
-- Converts ParsedDocument to structured JSON output with validation.
-- Uses contracts to guarantee output quality.
--
-- Run:
--   ailang run --entry main --caps IO,FS docparse/main.ail
--   ailang run --entry main --caps IO,FS --verify-contracts docparse/main.ail

-- Format a full extraction result as JSON
export func formatResult(result: ExtractionResult) -> string ! {}
  ensures { length(result) > 100 }
{
  encode(resultToJson(result))
}

-- Convert ExtractionResult to JSON value
pure func resultToJson(result: ExtractionResult) -> Json {
  jo([
    kv("document", documentToJson(result.document)),
    kv("warnings", ja(stringsToJson(result.warnings))),
    kv("aiCallsUsed", jnum(intToFloat(result.aiCallsUsed)))
  ])
}

-- Convert ParsedDocument to JSON value
pure func documentToJson(doc: ParsedDocument) -> Json {
  jo([
    kv("format", js(doc.format)),
    kv("filename", js(doc.filename)),
    kv("metadata", metadataToJson(doc.metadata)),
    kv("blocks", ja(blocksToJson(doc.blocks))),
    kv("summary", summaryToJson(doc.blocks))
  ])
}

-- Convert DocMetadata to JSON
export pure func metadataToJson(meta: DocMetadata) -> Json {
  jo([
    kv("title", js(meta.title)),
    kv("author", js(meta.author)),
    kv("created", js(meta.created)),
    kv("modified", js(meta.modified)),
    kv("pageCount", jnum(intToFloat(meta.pageCount)))
  ])
}

-- Generate a summary section
export pure func summaryToJson(blocks: [Block]) -> Json {
  let total = countBlocks(blocks);
  let headings = countBlocks(filterHeadings(blocks));
  let tables = countBlocks(filterTables(blocks));
  let images = countBlocks(filterImages(blocks));
  let changes = countBlocks(filterChanges(blocks));
  jo([
    kv("totalBlocks", jnum(intToFloat(total))),
    kv("headings", jnum(intToFloat(headings))),
    kv("tables", jnum(intToFloat(tables))),
    kv("images", jnum(intToFloat(images))),
    kv("changes", jnum(intToFloat(changes)))
  ])
}

-- Convert a list of blocks to JSON
export pure func blocksToJson(blocks: [Block]) -> [Json]
  ensures { listLength(result) == listLength(blocks) }
{
  map(blockToJson, blocks)
}

-- Convert a single Block to JSON
export pure func blockToJson(block: Block) -> Json =
  match block {
    TextBlock(b) => jo(textJsonFields(b)),
    HeadingBlock(b) => jo(headingJsonFields(b)),
    TableBlock(b) => jo(tableJsonFields(b)),
    ListBlock(b) => jo(listJsonFields(b)),
    ImageBlock(b) => jo(imageJsonFields(b)),
    AudioBlock(b) => jo(mediaJsonFields("audio", b.data, b.transcription, "transcription", b.mime)),
    VideoBlock(b) => jo(mediaJsonFields("video", b.data, b.description, "description", b.mime)),
    SectionBlock(b) => jo([
      kv("type", js("section")),
      kv("kind", js(b.kind)),
      kv("blocks", ja(blocksToJson(b.blocks)))
    ]),
    ChangeBlock(b) => jo([
      kv("type", js("change")),
      kv("changeType", js(b.changeType)),
      kv("author", js(b.author)),
      kv("date", js(b.date)),
      kv("text", js(b.text))
    ]),
    LinkBlock(b) => jo([
      kv("type", js("link")),
      kv("text", js(b.text)),
      kv("href", js(b.href)),
      kv("title", js(b.title))
    ]),
    CommentBlock(b) => jo([
      kv("type", js("comment")),
      kv("id", js(b.id)),
      kv("author", js(b.author)),
      kv("date", js(b.date)),
      kv("text", js(b.text)),
      kv("anchorText", js(b.anchorText)),
      kv("anchorKind", js(b.anchorKind)),
      kv("anchored", jb(b.anchored)),
      kv("anchorBlockIndex", jnum(intToFloat(b.anchorBlockIndex))),
      kv("parentId", js(b.parentId)),
      kv("resolved", jb(b.resolved))
    ])
  }

-- JSON serialization for TableBlock. Adds the optional `caption`
-- string (populated by HTML parser from <caption> elements; empty
-- for tables emitted by other parsers). Omitted from output when
-- empty so non-HTML parsers' JSON stays byte-identical.
-- TextBlock JSON. `runs` is omitted entirely when empty, which is the case for
-- every parser that cannot resolve character formatting — i.e. most of them
-- today. That keeps the output for unformatted documents byte-identical to the
-- pre-InlineRun shape, so the 93 golden files, the SDKs and the hosted API
-- contract are all unaffected by the field existing.
pure func textJsonFields(b: {text: string, style: string, level: int, runs: [InlineRun]}) -> [{key: string, value: Json}] {
  let base = [
    kv("type", js("text")),
    kv("text", js(b.text)),
    kv("style", js(b.style)),
    kv("level", jnum(intToFloat(b.level)))
  ];
  if listLength(b.runs) > 0
  then concat(base, [kv("runs", ja(runsToJson(b.runs)))])
  else base
}

-- Same omit-when-empty rule as TextBlock, so headings without character
-- formatting serialise exactly as they did before InlineRun existed.
pure func headingJsonFields(b: {text: string, level: int, runs: [InlineRun]}) -> [{key: string, value: Json}] {
  let base = [
    kv("type", js("heading")),
    kv("text", js(b.text)),
    kv("level", jnum(intToFloat(b.level)))
  ];
  if listLength(b.runs) > 0
  then concat(base, [kv("runs", ja(runsToJson(b.runs)))])
  else base
}

-- itemRuns is a parallel array to items (see mkListRuns). Emitted only when
-- some item is actually formatted, so an ordinary list is unchanged.
pure func listJsonFields(b: {items: [string], ordered: bool, itemRuns: [[InlineRun]]}) -> [{key: string, value: Json}] {
  let base = [
    kv("type", js("list")),
    kv("items", ja(stringsToJson(b.items))),
    kv("ordered", jb(b.ordered))
  ];
  if listLength(b.itemRuns) > 0
  then concat(base, [kv("itemRuns", ja(map(\rs. ja(runsToJson(rs)), b.itemRuns)))])
  else base
}

-- Flags are emitted only when true, for the same reason: a run that is merely
-- plain text should not cost six false booleans in every paragraph.
pure func runsToJson(runs: [InlineRun]) -> [Json] =
  map(\r. jo(runJsonFields(r)), runs)

pure func runJsonFields(r: InlineRun) -> [{key: string, value: Json}] {
  let base = [kv("text", js(r.text))];
  let withBold = if r.bold then concat(base, [kv("bold", jb(true))]) else base;
  let withItalic = if r.italic then concat(withBold, [kv("italic", jb(true))]) else withBold;
  let withUnder = if r.underline then concat(withItalic, [kv("underline", jb(true))]) else withItalic;
  let withStrike = if r.strike then concat(withUnder, [kv("strike", jb(true))]) else withUnder;
  let withCode = if r.code then concat(withStrike, [kv("code", jb(true))]) else withStrike;
  let withVert = if length(r.vertAlign) > 0
    then concat(withCode, [kv("vertAlign", js(r.vertAlign))])
    else withCode;
  -- Only when set, like every other run field: a plain run stays byte-identical
  -- to the pre-href JSON shape.
  if length(r.href) > 0
  then concat(withVert, [kv("href", js(r.href))])
  else withVert
}

pure func tableJsonFields(b: {rows: [[TableCell]], headers: [TableCell], caption: string}) -> [{key: string, value: Json}] {
  let base = [
    kv("type", js("table")),
    kv("headers", ja(cellsToJson(b.headers))),
    kv("rows", ja(cellRowsToJson(b.rows)))
  ];
  if length(b.caption) > 0
  then concat(base, [kv("caption", js(b.caption))])
  else base
}

-- Shared JSON shape for image/audio/video blocks. Surfaces `data` as
-- `src` only when it looks like a URL/path (length <= 2048) — large
-- embedded payloads (base64 from DOCX/PPTX, often megabytes) stay
-- represented by `dataLength` alone to keep JSON output tractable.
pure func mediaJsonFields(kind: string, data: string, descText: string, descKey: string, mime: string) -> [{key: string, value: Json}] {
  let dataLen = length(data);
  let base = [
    kv("type", js(kind)),
    kv(descKey, js(descText)),
    kv("mime", js(mime)),
    kv("dataLength", jnum(intToFloat(dataLen)))
  ];
  if dataLen > 0 && dataLen <= 2048
  then concat(base, [kv("src", js(data))])
  else base
}

-- JSON serialization for ImageBlock. Extends mediaJsonFields with the
-- HTML5 image attributes (width, height, srcset, title, loading). To
-- keep JSON output stable and compact, each extended field is only
-- emitted when it carries information (non-zero int, non-empty string).
-- Consumers that don't read these fields are unaffected.
--
-- Perf: builds the optional-field list once and concats once, instead
-- of chaining five concat calls (which allocated five intermediate
-- lists per image). Hot path on image-heavy pages.
pure func imageJsonFields(b: {data: string, description: string, mime: string, width: int, height: int, srcset: string, title: string, loading: string}) -> [{key: string, value: Json}] {
  let baseFields = mediaJsonFields("image", b.data, b.description, "description", b.mime);
  let optionals = imageOptionalFields(b);
  if listLength(optionals) == 0 then baseFields
  else concat(baseFields, optionals)
}

-- Collect ImageBlock's optional HTML5 attribute fields into one list.
-- Only fields with information (non-zero int, non-empty string) appear.
pure func imageOptionalFields(b: {data: string, description: string, mime: string, width: int, height: int, srcset: string, title: string, loading: string}) -> [{key: string, value: Json}] {
  let widthF = if b.width > 0 then [kv("width", jnum(intToFloat(b.width)))] else [];
  let heightF = if b.height > 0 then [kv("height", jnum(intToFloat(b.height)))] else [];
  let srcsetF = if length(b.srcset) > 0 then [kv("srcset", js(b.srcset))] else [];
  let titleF = if length(b.title) > 0 then [kv("title", js(b.title))] else [];
  let loadingF = if length(b.loading) > 0 then [kv("loading", js(b.loading))] else [];
  concat(concat(concat(concat(widthF, heightF), srcsetF), titleF), loadingF)
}

-- Convert rows of TableCells to JSON
export pure func cellRowsToJson(rows: [[TableCell]]) -> [Json]
  ensures { listLength(result) == listLength(rows) }
{
  map(\row. ja(cellsToJson(row)), rows)
}

-- Convert a list of TableCells to JSON values
-- Cells with colSpan > 1 or merged=true include span metadata
export pure func cellsToJson(cells: [TableCell]) -> [Json]
  ensures { listLength(result) == listLength(cells) }
{
  map(cellToJson, cells)
}

-- Convert a single TableCell to JSON
-- Simple cells (no merges) output as just the text string for compact JSON
-- Merged/spanned cells include full metadata
export pure func cellToJson(cell: TableCell) -> Json {
  if cell.colSpan == 1 && not cell.merged && length(cell.scope) == 0
  then js(cell.text)
  else {
    let base = [
      kv("text", js(cell.text)),
      kv("colSpan", jnum(intToFloat(cell.colSpan))),
      kv("merged", jb(cell.merged))
    ];
    let withScope = if length(cell.scope) > 0
                    then concat(base, [kv("scope", js(cell.scope))])
                    else base;
    jo(withScope)
  }
}

-- Convert a list of strings to JSON values
export pure func stringsToJson(strs: [string]) -> [Json]
  ensures { listLength(result) == listLength(strs) }
{
  map(js, strs)
}

-- Pretty print a document summary to console
export func printSummary(doc: ParsedDocument) -> () ! {IO} {
  println("=== Document Summary ===");
  println("Format:   ${doc.format}");
  println("Filename: ${doc.filename}");
  println("Title:    ${doc.metadata.title}");
  println("Author:   ${doc.metadata.author}");
  println("Blocks:   ${show(countBlocks(doc.blocks))}");
  println("Headings: ${show(countBlocks(filterHeadings(doc.blocks)))}");
  println("Tables:   ${show(countBlocks(filterTables(doc.blocks)))}");
  println("Images:   ${show(countBlocks(filterImages(doc.blocks)))}");
  println("Sections: ${show(countBlocks(filterSections(doc.blocks)))}");
  println("Changes:  ${show(countBlocks(filterChanges(doc.blocks)))}");
  println("========================")
}

-- Print each block with its type
export func printBlocks(blocks: [Block]) -> () ! {IO} =
  forEachE(printBlock, blocks)

func printBlock(block: Block) -> () ! {IO} =
  match block {
    TextBlock(b) =>
      println("[text:${b.style}] ${b.text}"),
    HeadingBlock(b) =>
      println("[h${show(b.level)}] ${b.text}"),
    TableBlock(b) =>
      println("[table] ${show(countCellRows(b.rows))} rows, ${show(countCells(b.headers))} cols${mergeInfo(b.headers, b.rows)}"),
    ListBlock(b) =>
      println("[list] ${show(countItems(b.items))} items"),
    ImageBlock(b) =>
      println("[image:${b.mime}] ${b.description}"),
    AudioBlock(b) =>
      println("[audio:${b.mime}] ${b.transcription}"),
    VideoBlock(b) =>
      println("[video:${b.mime}] ${b.description}"),
    SectionBlock(b) => {
      println("[${b.kind}]");
      printBlocks(b.blocks)
    },
    ChangeBlock(b) =>
      println("[${b.changeType}:${b.author}] ${b.text}"),
    LinkBlock(b) =>
      println("[link] ${b.text} → ${b.href}"),
    CommentBlock(b) =>
      if b.anchored
      then println("[comment:${b.author}] on \"${b.anchorText}\" → ${b.text}")
      else println("[comment:${b.author}] (unanchored) → ${b.text}")
  }

pure func countCellRows(rows: [[TableCell]]) -> int = listLength(rows)

pure func countCells(cells: [TableCell]) -> int = listLength(cells)

pure func countItems(items: [string]) -> int = listLength(items)

-- Check if any cells have merge info and return a summary string
pure func mergeInfo(headers: [TableCell], rows: [[TableCell]]) -> string {
  let mergedCount = countMergedCells(headers) + countMergedInRows(rows);
  let spanCount = countSpannedCells(headers) + countSpannedInRows(rows);
  if mergedCount > 0 || spanCount > 0
  then " (merged:${show(mergedCount)} spanned:${show(spanCount)})"
  else ""
}

pure func countMergedCells(cells: [TableCell]) -> int =
  foldl(\acc c. if c.merged then acc + 1 else acc, 0, cells)

pure func countSpannedCells(cells: [TableCell]) -> int =
  foldl(\acc c. if c.colSpan > 1 then acc + 1 else acc, 0, cells)

pure func countMergedInRows(rows: [[TableCell]]) -> int =
  foldl(\acc row. acc + countMergedCells(row), 0, rows)

pure func countSpannedInRows(rows: [[TableCell]]) -> int =
  foldl(\acc row. acc + countSpannedCells(row), 0, rows)

-- Render a markdown+metadata bundle as JSON.
-- Returns:
--   {
--     "format": "markdown+metadata",
--     "filename": "...",
--     "markdown": "...full markdown body...",
--     "metadata": {title, author, created, modified, pageCount},
--     "summary": {totalBlocks, headings, tables, images, changes},
--     "sections": [{"heading": "Intro", "level": 1, "markdown": "..."}, ...]
--   }
-- The "sections" array slices the document at heading boundaries so agents can
-- pick the part of the document they want without re-parsing the markdown body.
export pure func renderMarkdownMetaJson(doc: ParsedDocument) -> string {
  let body = renderMarkdown(doc);
  let sections = sliceSections(doc.blocks);
  encode(jo([
    kv("format", js("markdown+metadata")),
    kv("filename", js(doc.filename)),
    kv("markdown", js(body)),
    kv("metadata", metadataToJson(doc.metadata)),
    kv("summary", summaryToJson(doc.blocks)),
    kv("sections", ja(sections))
  ]))
}

-- Slice a flat block list into sections at heading boundaries.
-- Each section becomes {heading, level, markdown}. Content before the first
-- heading is emitted as a "preamble" section with level=0.
pure func sliceSections(blocks: [Block]) -> [Json] =
  reverseJsonList(sliceLoop(blocks, "", 0, "", []))

-- Tail-recursive scan over blocks. Accumulator is a list of section JSONs
-- in reverse order (so we don't have to ++ for every section).
pure func sliceLoop(blocks: [Block], curHeading: string, curLevel: int,
                    curMd: string, acc: [Json]) -> [Json] =
  match blocks {
    [] => if length(curMd) > 0 || length(curHeading) > 0
            then sectionJson(curHeading, curLevel, curMd) :: acc
            else acc,
    b :: rest => match b {
      HeadingBlock(h) => {
        let acc2 = if length(curMd) > 0 || length(curHeading) > 0
          then sectionJson(curHeading, curLevel, curMd) :: acc
          else acc;
        sliceLoop(rest, h.text, h.level, "${headingPrefix(h.level)}${h.text}\n\n", acc2)
      },
      _ => sliceLoop(rest, curHeading, curLevel, "${curMd}${renderBlockMd(b)}", acc)
    }
  }

pure func sectionJson(heading: string, level: int, md: string) -> Json =
  jo([
    kv("heading", js(heading)),
    kv("level", jnum(intToFloat(level))),
    kv("markdown", js(md))
  ])

-- Reverse a [Json] list (sliceLoop accumulates in reverse).
pure func reverseJsonList(xs: [Json]) -> [Json] =
  foldl(\acc x. x :: acc, [], xs)

-- Render blocks to markdown text suitable for LLM consumption
-- Strips binary image data, keeps descriptions, renders tables as markdown tables
export pure func renderMarkdown(doc: ParsedDocument) -> string {
  let header = renderMetadataHeader(doc.metadata, doc.format, doc.filename);
  let body = renderBlocksMd(doc.blocks);
  "${header}\n${body}"
}

pure func renderMetadataHeader(meta: DocMetadata, format: string, filename: string) -> string {
  let titleLine = if length(meta.title) > 0
    then "# ${meta.title}\n\n"
    else "";
  let metaLines = if length(meta.author) > 0
    then "**Author:** ${meta.author}\n"
    else "";
  "${titleLine}${metaLines}"
}

pure func renderBlocksMd(blocks: [Block]) -> string =
  foldl(\acc b. "${acc}${renderBlockMd(b)}", "", blocks)

pure func renderBlockMd(block: Block) -> string =
  match block {
    HeadingBlock(h) =>
      "${headingPrefix(h.level)}${h.text}\n\n",
    TextBlock(t) =>
      if length(t.text) > 0 then "${t.text}\n\n"
      else "",
    TableBlock(t) =>
      "${renderTableMd(t.headers, t.rows)}\n",
    ListBlock(l) =>
      "${renderListMd(l.items, l.ordered, 1)}\n",
    ImageBlock(i) =>
      if length(i.description) > 0
      then "[Image: ${i.description}]\n\n"
      else "[Image]\n\n",
    AudioBlock(a) =>
      if length(a.transcription) > 0
      then "[Audio transcription: ${a.transcription}]\n\n"
      else "[Audio]\n\n",
    VideoBlock(v) =>
      if length(v.description) > 0
      then "[Video: ${v.description}]\n\n"
      else "[Video]\n\n",
    SectionBlock(s) =>
      renderSectionMd(s.kind, s.blocks),
    ChangeBlock(b) =>
      renderChangeMd(b.changeType, b.author, b.date, b.text),
    LinkBlock(b) =>
      "[${b.text}](${b.href})\n\n",
    CommentBlock(b) =>
      renderCommentMd(b.author, b.date, b.text, b.anchorText, b.anchored)
  }

-- A comment renders as a blockquote of the annotated span followed by the
-- comment itself, so a linear reader meets the two together. Unanchored
-- comments are labelled, never quietly attached to the preceding block.
pure func renderCommentMd(author: string, date: string, text: string,
                          anchorText: string, anchored: bool) -> string {
  let byline = if length(date) > 0 then "${author}, ${date}" else author;
  if anchored && length(anchorText) > 0
  then "> ${anchorText}\n>\n> **Comment (${byline}):** ${text}\n\n"
  else "> **Comment (${byline}, unanchored):** ${text}\n\n"
}

pure func headingPrefix(level: int) -> string
  ensures { length(result) >= 2 }
{
  if level == 1 then "# "
  else if level == 2 then "## "
  else if level == 3 then "### "
  else if level == 4 then "#### "
  else if level == 5 then "##### "
  else if level == 6 then "###### "
  else "## "
}

pure func renderSectionMd(kind: string, blocks: [Block]) -> string {
  let label = if kind == "slide" then "---\n\n"
    else if kind == "sheet" then "---\n\n### Sheet\n\n"
    else if kind == "header" then "*Header:*\n"
    else if kind == "footer" then "*Footer:*\n"
    else if kind == "footnote" then "*Footnote:*\n"
    else if kind == "endnote" then "*Endnote:*\n"
    else if kind == "textbox" then "> "
    else "";
  "${label}${renderBlocksMd(blocks)}"
}

-- Render a track change annotation as markdown
-- Uses a blockquote with an attribution prefix:
--   > [insert by Alice on 2026-03-29] text
--   > [delete by Bob on 2026-03-29] ~~text~~
-- This format is easier for downstream LLMs to parse than inline bold/italic.
pure func renderChangeMd(changeType: string, author: string, date: string, text: string) -> string
  ensures { length(result) > 0 }
{
  let who = if length(author) > 0 then author else "unknown";
  let when = if length(date) > 0 then " on ${date}" else "";
  let prefix = "> [${changeType} by ${who}${when}] ";
  let body = if changeType == "delete" || changeType == "move-from"
    then "~~${text}~~"
    else text;
  "${prefix}${body}\n\n"
}

-- Render a table as markdown
pure func renderTableMd(headers: [TableCell], rows: [[TableCell]]) -> string {
  let headerLine = "| ${renderCellsMd(headers)}\n";
  let sepLine = "| ${renderSepMd(headers)}\n";
  let rowLines = renderRowsMd(rows);
  "${headerLine}${sepLine}${rowLines}"
}

pure func renderCellsMd(cells: [TableCell]) -> string =
  match cells {
    [] => "",
    c :: [] => "${cellTextMd(c)} |",
    c :: rest => "${cellTextMd(c)} | ${renderCellsMd(rest)}"
  }

-- Render a single cell to markdown text. Cells with colSpan > 1 or merged=true
-- get a Pandoc-style attribute suffix so downstream tools and LLMs can recover
-- the table topology from the markdown alone:
--   "Total {colspan=2}"      -- spans two columns
--   "Header {merged}"        -- continuation of a merged region
pure func cellTextMd(cell: TableCell) -> string {
  let suffix = if cell.colSpan > 1
    then " {colspan=${show(cell.colSpan)}}"
    else if cell.merged then " {merged}"
    else "";
  "${cell.text}${suffix}"
}

pure func renderSepMd(cells: [TableCell]) -> string =
  match cells {
    [] => "",
    _ :: [] => "--- |",
    _ :: rest => "--- | ${renderSepMd(rest)}"
  }

pure func renderRowsMd(rows: [[TableCell]]) -> string =
  foldl(\acc row. "${acc}| ${renderCellsMd(row)}\n", "", rows)

-- Render list items
pure func renderListMd(items: [string], ordered: bool, idx: int) -> string =
  match items {
    [] => "",
    item :: rest =>
      if ordered
      then "${show(idx)}. ${item}\n${renderListMd(rest, ordered, idx + 1)}"
      else "- ${item}\n${renderListMd(rest, ordered, idx + 1)}"
  }
