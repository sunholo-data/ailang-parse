module docparse/services/pdf_backend_external

-- External PDF backend bridge.
--
-- Invokes the Python adapter (docparse/services/pdf_backends/adapter.py) for
-- the chosen backend, decodes the resulting JSON, and returns the same
-- [Block] + DocMetadata that direct_ai_parser produces. This keeps AILANG in
-- control of output formatting while delegating PDF extraction to a chosen
-- third-party engine (docling, liteparse, …).
--
-- Architecture: pure core (decode logic + contracts) + thin effectful outer
-- (`parsePdfViaBackend`) that only owns exec and error reporting.
--
-- WHERE THE ADAPTER IS FOUND, AND HOW uv RUNS IT (priority order):
--
--   1. DOCPARSE_PROJECT_ROOT set (bin/docparse clone / installed-prefix flow):
--      <projectRoot>/docparse/services/pdf_backends/adapter.py, with
--      `uv run --project <projectRoot>` — unchanged.
--   2. Run from a clone without DOCPARSE_PROJECT_ROOT (the adapter exists at
--      the cwd-relative path): `uv run --project .` — unchanged.
--   3. `ailang install` shim flow (`docparse-pdf`): the adapter ships in the
--      package at assets/pdf_backends/adapter.py and std/package.assetPath
--      resolves its absolute installed location, independent of the caller's
--      cwd (the shim deliberately leaves you in your own directory). uv runs it
--      with `--no-project --with <backend dep>`: an ephemeral environment in
--      uv's own cache, so nothing is written into the registry cache, the
--      caller's cwd pyproject is ignored, and a liteparse/pdftotext run never
--      downloads docling (pdftotext and words need only the stdlib + poppler).
--   4. Nothing resolves: fall back to case 2's paths, so the failure names
--      the missing adapter rather than something stranger.
--
-- The FS effect on the exported functions exists only for that resolution
-- (fileExists + assetPath); every caller — the orchestrator's full ladder —
-- already declared {FS, Process}.

import std/json (decode, getArray, getString, getInt, getBool, getNumber, asString, asArray, asNumber, getOr)
import std/option (Some, None, getOrElse)
import std/list (map, any, length as listLength)
import std/result (Result, Ok, Err)
import std/string (length as strLength, join)
import std/fs (fileExists)
import std/package (assetPath)
import pkg/sunholo/external_backend/runner (runJson, formatError, BackendError)
import docparse/types/document (mkHeading, mkHeadingRuns, mkText, mkTextRuns, mkListNested, mkImageFull, mkSection, mkNamedSection, plainRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, TableCell, DocMetadata, InlineRun, simpleCell)
import docparse/services/pdf_annotations (PdfWord)

-- Output bundle from an external backend run.
export type ExternalDocResult = {
  metadata: DocMetadata,
  blocks: [Block]
}

-- =====================================================================
-- Pure core
-- =====================================================================

-- Resolve the absolute path to the Python adapter relative to a project root.
pure func adapterPath(projectRoot: string) -> string
  ensures { strLength(result) > 0 }
=
  if strLength(projectRoot) == 0
    then "docparse/services/pdf_backends/adapter.py"
    else "${projectRoot}/docparse/services/pdf_backends/adapter.py"

-- The uv project directory to resolve the backend env from. Empty projectRoot
-- means "invoked from the repo root", so cwd (".") is the project. This keeps
-- backend deps (docling, liteparse) resolving through uv's managed env rather
-- than whatever happens to be on the system python3 — see backendLayout.
pure func backendProject(projectRoot: string) -> string
  ensures { strLength(result) > 0 }
=
  if strLength(projectRoot) == 0 then "." else projectRoot

-- The installed package that ships the adapter, as std/package.assetPath
-- wants it: the canonical vendor/name, never a module path (a module path is
-- rejected with "invalid package name ... (want vendor/name)").
pure func adapterPackage() -> string = "sunholo/ailang_parse"

-- The adapter's path relative to the package's assets/ directory.
pure func adapterAsset() -> string = "pdf_backends/adapter.py"

-- Python distributions a backend needs in the ephemeral `--no-project` env.
-- pdftotext and words shell out to poppler and need only the stdlib.
pure func backendWithArgs(backend: string) -> [string] =
  if backend == "docling" then ["--with", "docling"]
  else if backend == "liteparse" then ["--with", "liteparse"]
  else []

-- Runtime layout for the adapter: its path, and the uv arguments that
-- precede `python <adapter>`. Priority order at the top of this file.
func backendLayout(projectRoot: string, backend: string) -> {adapter: string, uvArgs: [string]} ! {FS} =
  if strLength(projectRoot) > 0
    then {adapter: adapterPath(projectRoot), uvArgs: ["run", "--project", backendProject(projectRoot)]}
  else if fileExists(adapterPath(""))
    then {adapter: adapterPath(""), uvArgs: ["run", "--project", backendProject("")]}
  else match assetPath(adapterPackage(), adapterAsset()) {
    Ok(p) => {adapter: p, uvArgs: ["run", "--no-project"] ++ backendWithArgs(backend)},
    Err(_) => {adapter: adapterPath(""), uvArgs: ["run", "--project", backendProject("")]}
  }

-- Decode a single JSON block. Unknown "kind" values fall back to TextBlock.
--
-- A block tagged `region: "header" | "footer"` is page furniture the backend
-- located on the page (poppler, docling). It is wrapped in a header/footer
-- SectionBlock here, one per occurrence; pdf_furniture merges the occurrences
-- into the single header and footer section a document has. Untagged blocks
-- (every pdftotext block) decode exactly as before. `region: "notes"` is a
-- slide's speaker notes (a diagram page's labels, poppler-slides).
pure func decodeBlock(j: Json) -> Block = {
  let inner = decodeInnerBlock(j);
  let region = getOrElse(getString(j, "region"), "body");
  if region == "header" || region == "footer" || region == "notes" then mkSection(region, [inner]) else inner
}

pure func decodeInnerBlock(j: Json) -> Block = {
  let kind = getOrElse(getString(j, "kind"), "text");
  let text = getOrElse(getString(j, "text"), "");
  let runs = decodeRuns(getOrElse(getArray(j, "runs"), []));
  if kind == "heading" then {
    let lvl = getOrElse(getInt(j, "level"), 2);
    if listLength(runs) > 0 then mkHeadingRuns(text, lvl, runs) else mkHeading(text, lvl)
  }
  else if kind == "table" then {
    let caption = getOrElse(getString(j, "caption"), "");
    let hdrJson = getOrElse(getArray(j, "headers"), []);
    let headers = map(\h. simpleCell(getOrElse(asString(h), "")), hdrJson);
    let rowsJson = getOrElse(getArray(j, "rows"), []);
    let rows = map(\rowJ.
      map(\cellJ. simpleCell(getOrElse(asString(cellJ), "")),
          getOrElse(asArray(rowJ), [])),
      rowsJson);
    TableBlock({rows: rows, headers: headers, caption: caption})
  }
  else if kind == "list" then {
    let items = map(\i. getOrElse(asString(i), ""), getOrElse(getArray(j, "items"), []));
    let levels = map(\l. pdfBackendJsonInt(l), getOrElse(getArray(j, "levels"), []));
    -- itemLevels is parallel to items or empty (mkListNested's contract);
    -- a flat list keeps it empty so it serialises as an ordinary list.
    let keptLevels = if listLength(levels) == listLength(items) && any(\l. l > 0, levels)
      then levels else [];
    mkListNested(items, getOrElse(getBool(j, "ordered"), false), [], keptLevels)
  }
  else if kind == "image" then
    mkImageFull(getOrElse(getString(j, "data"), ""),
                getOrElse(getString(j, "description"), ""),
                getOrElse(getString(j, "mime"), "image/png"),
                getOrElse(getInt(j, "width"), 0),
                getOrElse(getInt(j, "height"), 0), "", "", "")
  else {
    let style = getOrElse(getString(j, "style"), "Normal");
    let level = getOrElse(getInt(j, "level"), 0);
    if listLength(runs) > 0 then mkTextRuns(text, style, level, runs) else mkText(text, style, level)
  }
}

-- Inline runs: [{text, bold, italic, href}]. Absent fields are off, so an
-- adapter only states the formatting it actually saw.
pure func decodeRuns(arr: [Json]) -> [InlineRun]
  ensures { listLength(result) == listLength(arr) }
=
  map(\r. {plainRun(getOrElse(getString(r, "text"), "")) |
            bold: getOrElse(getBool(r, "bold"), false),
            italic: getOrElse(getBool(r, "italic"), false),
            href: getOrElse(getString(r, "href"), "")}, arr)

pure func pdfBackendJsonInt(j: Json) -> int =
  match asNumber(j) {
    Some(n) => floatToInt(n),
    None => 0
  }

-- One-line shape of a decoded adapter block, for the inline tests below.
-- Exercises the whole decode path from JSON text, which is where the protocol
-- actually breaks (a kind or field name typo decodes silently as text).
export pure func pdfBackendDecodeShape(src: string) -> string
  tests [
    ("{\"kind\":\"list\",\"items\":[\"a\",\"b\"],\"ordered\":true,\"levels\":[0,1]}", "list:2:true:2"),
    ("{\"kind\":\"list\",\"items\":[\"a\",\"b\"],\"levels\":[0,0]}", "list:2:false:0"),
    ("{\"kind\":\"image\",\"data\":\"QUJD\",\"mime\":\"image/png\",\"width\":4,\"height\":2}", "image:image/png:4x2"),
    ("{\"kind\":\"text\",\"text\":\"Acme\",\"region\":\"footer\",\"page\":3}", "section:footer[text:Acme:runs=0]"),
    ("{\"kind\":\"heading\",\"text\":\"Intro\",\"level\":3,\"region\":\"body\"}", "heading:3:Intro"),
    ("{\"kind\":\"text\",\"text\":\"site\",\"runs\":[{\"text\":\"site\",\"href\":\"https://x.test\",\"bold\":true}]}", "text:site:runs=1:https://x.test:true"),
    ("{\"kind\":\"text\",\"text\":\"plain\"}", "text:plain:runs=0")
  ]
{
  match decode(src) {
    Err(e) => "err:${e}",
    Ok(j) => pdfBackendBlockShape(decodeBlock(j))
  }
}

pure func pdfBackendBlockShape(b: Block) -> string =
  match b {
    ListBlock(l) => "list:${show(listLength(l.items))}:${show(l.ordered)}:${show(listLength(l.itemLevels))}",
    ImageBlock(i) => "image:${i.mime}:${show(i.width)}x${show(i.height)}",
    SectionBlock(s) => "section:${s.kind}[${join(",", map(pdfBackendBlockShape, s.blocks))}]",
    HeadingBlock(h) => "heading:${show(h.level)}:${h.text}",
    TextBlock(t) => match t.runs {
      [] => "text:${t.text}:runs=0",
      r :: _ => "text:${t.text}:runs=${show(listLength(t.runs))}:${r.href}:${show(r.bold)}"
    },
    _ => "other"
  }

-- Decode a list of JSON blocks. Always preserves count (one Block per input).
pure func decodeBlocks(arr: [Json]) -> [Block]
  ensures { listLength(result) == listLength(arr) }
=
  map(decodeBlock, arr)

-- Decode with a page-break marker before the first block of every page.
-- Blocks with no page tag (0) never start a page.
pure func decodeBlocksPaged(arr: [Json], lastPage: int) -> [Block]
  ensures { listLength(result) >= listLength(arr) }
=
  match arr {
    [] => [],
    j :: rest =>
      let page = getOrElse(getInt(j, "page"), 0) in
      let block = decodeBlock(j) in
      if page > 0 && page != lastPage
      then mkNamedSection("page-break", show(page), []) :: block :: decodeBlocksPaged(rest, page)
      else block :: decodeBlocksPaged(rest, lastPage)
  }

-- Shape of a paged decode, for the inline tests: "pb:N" for a marker, the
-- block's kind otherwise.
export pure func pdfBackendPagedShape(src: string) -> string
  tests [
    ("[{\"kind\":\"heading\",\"text\":\"A\",\"page\":1},{\"kind\":\"text\",\"text\":\"b\",\"page\":1},{\"kind\":\"text\",\"text\":\"c\",\"page\":2}]", "pb:1|heading|text|pb:2|text"),
    ("[{\"kind\":\"text\",\"text\":\"untagged\"},{\"kind\":\"text\",\"text\":\"x\",\"page\":3}]", "text|pb:3|text"),
    ("[{\"kind\":\"text\",\"text\":\"f\",\"page\":1,\"region\":\"footer\"}]", "pb:1|section"),
    ("[]", "")
  ]
{
  match decode(src) {
    Err(e) => "err:${e}",
    Ok(j) => {
      let blocks = decodeBlocksPaged(getOrElse(asArray(j), []), 0);
      join("|", map(\b. match b {
        SectionBlock(s) => if s.kind == "page-break" then "pb:${s.name}" else "section",
        HeadingBlock(_) => "heading",
        TextBlock(_) => "text",
        _ => "other"
      }, blocks))
    }
  }
}

-- Decode metadata. Currently only pageCount is populated by adapters; title
-- and author remain empty until backends expose richer metadata.
pure func decodeMetadata(j: Json) -> DocMetadata = {
  let title = getOrElse(getString(j, "title"), "");
  let author = getOrElse(getString(j, "author"), "");
  let pages = getOrElse(getInt(j, "pageCount"), 0);
  {
    title: title,
    author: author,
    created: "",
    modified: "",
    pageCount: pages
  }
}

-- Decode the adapter's JSON document object into an ExternalDocResult.
-- Pure: takes an already-decoded Json, no exec, no IO. Page boundaries are
-- dropped; see decodeAdapterDocPages.
export pure func decodeAdapterDoc(doc: Json) -> ExternalDocResult =
  decodeAdapterDocPages(doc, false)

-- Same, keeping page boundaries when `keepPages`: every block's adapter
-- `page` tag starts a new page when it changes, and each page is preceded by
-- an empty "page-break" section named by its page number — the marker the
-- DOCX parser and html_layout already emit. Generators render it as nothing;
-- conversion to slides groups on it (pdfPagesAsSlides).
export pure func decodeAdapterDocPages(doc: Json, keepPages: bool) -> ExternalDocResult = {
  let blocksArr = getOrElse(getArray(doc, "blocks"), []);
  let blocks = if keepPages then decodeBlocksPaged(blocksArr, 0) else decodeBlocks(blocksArr);
  let metaJson = getOr(doc, "metadata", doc);
  let meta = decodeMetadata(metaJson);
  {metadata: meta, blocks: blocks}
}

-- =====================================================================
-- Effectful outer
-- =====================================================================

-- A parse plus which backend actually produced it.
export type PdfParseOutcome = {
  doc: ExternalDocResult,
  backendUsed: string
}

-- Parse a PDF, escalating from the fast text-layer backend to OCR if needed.
--
-- Tier 1 `pdftotext` is instant and free but sees nothing in a scanned page.
-- Tier 2 `docling` does local OCR — measured at ~9s against pdftotext's ~0s for
-- near-identical output on a text-layer PDF, so it is a fallback and never the
-- default. Both are free, so escalating between them needs no permission; tier
-- 3 (`ai`) costs money and is therefore never automatic — the caller must ask
-- for it explicitly.
--
-- Escalation only applies when the caller took the default. An explicit
-- `--pdf-backend docling|liteparse|ai` is a decision, not a starting point, and
-- is left alone. (Note `liteparse` is NOT an OCR fallback: it infers headings
-- from font sizes in the existing text layer and fails on scans exactly as
-- pdftotext does.)
export func parsePdfWithFallback(backend: string, filepath: string, projectRoot: string)
    -> Result[PdfParseOutcome, string] ! {FS, Process} =
  match parsePdfViaBackend(backend, filepath, projectRoot) {
    Ok(res) => Ok({doc: res, backendUsed: backend}),
    Err(firstErr) =>
      if backend != "pdftotext" then Err(firstErr)
      else match parsePdfViaBackend("docling", filepath, projectRoot) {
        Ok(res) => Ok({doc: res, backendUsed: "docling"}),
        Err(ocrErr) =>
          -- Name the fix. This message reads as "your PDF is broken", but by far
          -- the most common cause is that docling was never installed: the
          -- escalation above is automatic, so a scanned PDF hits it on the
          -- DEFAULT backend, not only when someone asks for docling by name.
          Err("no text layer (pdftotext: ${firstErr}) and OCR found nothing (docling: ${ocrErr}) — if docling is not installed, run: docparse --install-backends")
      }
  }

-- Fetch word positions for a PDF via the adapter's "words" backend
-- (poppler `pdftotext -bbox`), used to resolve what a highlight covers.
--
-- Returns [] on any failure. Missing word positions must degrade to unanchored
-- annotations, never block the parse: the comment text itself is still worth
-- returning, and an annotation that says "page 3" is honest where a guessed
-- span would not be.
export func fetchPdfWords(filepath: string, projectRoot: string) -> [PdfWord] ! {FS, Process} = {
  let layout = backendLayout(projectRoot, "words");
  match runJson("uv", layout.uvArgs ++ ["python", layout.adapter, "words", filepath]) {
    Err(_) => [],
    Ok(doc) => decodeWords(getOrElse(getArray(doc, "words"), []))
  }
}

pure func decodeWords(items: [Json]) -> [PdfWord] =
  map(decodeWord, items)

pure func decodeWord(j: Json) -> PdfWord = {
  page: getOrElse(getInt(j, "page"), 0),
  x0: getOrElse(getNumber(j, "x0"), 0.0),
  y0: getOrElse(getNumber(j, "y0"), 0.0),
  x1: getOrElse(getNumber(j, "x1"), 0.0),
  y1: getOrElse(getNumber(j, "y1"), 0.0),
  text: getOrElse(getString(j, "text"), "")
}

-- Run the external backend and return parsed result.
-- Backend names: "pdftotext", "poppler", "docling", "liteparse" (must match adapter.py
-- BACKENDS). Failures are propagated as Err, never swallowed into an empty
-- result: a backend that errors, exits non-zero, emits non-JSON, or extracts
-- zero blocks is a hard failure the caller must surface (no silent 1-byte
-- "successes"). Scanned/image-only PDFs land here too — the advice the user
-- sees is composed by the caller (orchestrator.orchPdf): docling (local,
-- free; --install-backends if missing) first, --pdf-backend ai (external,
-- paid) only as an explicit last resort.
export func parsePdfViaBackend(backend: string, filepath: string, projectRoot: string) -> Result[ExternalDocResult, string] ! {FS, Process} = {
  -- Resolve the adapter and the uv project WITHOUT depending on the caller's
  -- working directory (see backendLayout): the installed shim deliberately
  -- leaves you in your own cwd, where neither the historical relative adapter
  -- path nor "." as the uv project resolves to anything useful.
  let layout = backendLayout(projectRoot, backend);
  -- Run the adapter through `uv run` so backend deps (docling, liteparse)
  -- resolve from the project's managed env, not an arbitrary system python3.
  -- uv emits sync/resolution logs to stderr only, so adapter stdout stays the
  -- pure JSON the bridge parses.
  match runJson("uv", layout.uvArgs ++ ["python", layout.adapter, backend, filepath]) {
    Err(e) => Err(formatError(e)),
    Ok(doc) => {
      -- pdftotext keeps its parse output exactly as before v0.55.0: no page
      -- markers. Every other backend marks its pages.
      let res = decodeAdapterDocPages(doc, backend != "pdftotext");
      if listLength(res.blocks) == 0
        then Err("backend '${backend}' extracted 0 blocks from ${filepath}")
        else Ok(res)
    }
  }
}