module docparse/services/pptx_generator

import std/string (length, intToStr, find, substring)
import std/list (foldl, length as listLength)
import std/zip (createArchive, createArchiveWithBytes)
import std/bytes (fromString, toBase64)
import std/result (Ok, Err)
import docparse/types/document (InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, ParsedDocument, countBlocks)
import docparse/services/xml_helpers (xmlEscape, xmlDecl)
import docparse/services/pptx_template (PptxRefDoc, pptxTplNone, pptxTplLoad, pptxTplDropSpans, pptxTplDropElems, pptxTplInsertBeforeFirst, pptxTplInsertBeforeLast)

-- PPTX Generator — converts Block ADT to a valid .pptx file.
--
-- PPTX structure:
--   [Content_Types].xml
--   _rels/.rels
--   ppt/presentation.xml
--   ppt/_rels/presentation.xml.rels
--   ppt/slides/slide1.xml (one per SectionBlock kind="slide", or one for all blocks)
--   ppt/slides/_rels/slide1.xml.rels
--   ppt/slideLayouts/slideLayout1.xml
--   ppt/slideLayouts/_rels/slideLayout1.xml.rels
--   ppt/slideMasters/slideMaster1.xml
--   ppt/slideMasters/_rels/slideMaster1.xml.rels
--
-- Limitations:
--   - No embedded images (needs writeEntryBytes)
--   - Single blank slide layout (no themes)
--   - Minimal styling

-- Generate a PPTX file from ParsedDocument
-- Generate against a reference deck: an existing .pptx whose theme, slide
-- masters, layouts, table styles, embedded media and slide size are applied to
-- this document's content.
--
-- An unreadable, non-PPTX or master-less reference is an error and writes
-- NOTHING. Falling back to the built-in look would produce a plausible deck
-- missing exactly the branding it was asked for — the failure nobody catches,
-- because the file opens.
export func generatePptxWithReference(doc: ParsedDocument, outputPath: string,
                                      slideSize: string, referencePath: string) -> string ! {FS} =
  if length(referencePath) == 0
  then generatePptx(doc, outputPath, slideSize, pptxTplNone())
  else match pptxTplLoad(referencePath) {
    Err(e) => "Error generating PPTX: ${e}",
    Ok(ref) => generatePptx(doc, outputPath, slideSize, ref)
  }

-- slideSize is "16:9" (default, and what an empty string means) or "4:3".
-- Validated by the caller so an unknown value fails before anything is written.
-- ref is pptxTplNone() when no --reference-doc was given; the untemplated path
-- below is then byte-identical to what it produced before the flag existed.
export func generatePptx(doc: ParsedDocument, outputPath: string, slideSize: string, ref: PptxRefDoc) -> string ! {FS}
  ensures { length(result) > 0 }
{
  -- Split blocks into slides: each SectionBlock(kind="slide") is a slide,
  -- or if no slides, put all blocks on one slide
  let slideContents = pptxCollectSlides(doc.blocks);
  let slideCount = pptxCountSlides(slideContents);

  -- Build all ZIP entries
  let contentTypes = pptxContentTypes(slideCount);
  let rootRels = pptxRootRels();
  let presentation = pptxPresentation(slideCount, pptxSldSzFor(slideSize));
  let presRels = pptxPresentationRels(slideCount);
  let slideEntries = pptxBuildSlideEntries(slideContents, 1);
  let slideRelEntries = pptxBuildSlideRelEntries(slideCount, 1);
  let layout = pptxSlideLayout();
  let layoutRels = pptxSlideLayoutRels();
  let master = pptxSlideMaster();
  let masterRels = pptxSlideMasterRels();

  let theme = pptxTheme();
  let presProps = pptxPresProps();
  let viewProps = pptxViewProps();
  let tableStyles = pptxTableStyles();

  let baseEntries = [
    {name: "[Content_Types].xml", content: contentTypes},
    {name: "_rels/.rels", content: rootRels},
    {name: "ppt/presentation.xml", content: presentation},
    {name: "ppt/_rels/presentation.xml.rels", content: presRels},
    {name: "ppt/slideLayouts/slideLayout1.xml", content: layout},
    {name: "ppt/slideLayouts/_rels/slideLayout1.xml.rels", content: layoutRels},
    {name: "ppt/slideMasters/slideMaster1.xml", content: master},
    {name: "ppt/slideMasters/_rels/slideMaster1.xml.rels", content: masterRels},
    {name: "ppt/theme/theme1.xml", content: theme},
    {name: "ppt/presProps.xml", content: presProps},
    {name: "ppt/viewProps.xml", content: viewProps},
    {name: "ppt/tableStyles.xml", content: tableStyles}
  ];

  if ref.active then {
    -- Only four parts are ours; everything else the template declared is
    -- carried untouched, which is what makes the theme, masters, layouts,
    -- table styles and media all arrive without being re-derived.
    let ourParts = pptxAppendEntries(
      [
        {name: "[Content_Types].xml", content: pptxRefContentTypes(ref, slideCount)},
        {name: "ppt/presentation.xml", content: pptxRefPresentation(ref, slideCount, slideSize)},
        {name: "ppt/_rels/presentation.xml.rels", content: pptxRefPresRels(ref, slideCount)}
      ],
      pptxRefSlideEntries(slideContents, 1),
      pptxRefSlideRelEntries(slideCount, 1, ref.layoutTarget));
    -- Carried parts are already base64, so the whole archive goes through
    -- createArchiveWithBytes whether or not the content has images.
    let allBytes = pptxAppendByteEntries(pptxPartsToByteEntries(ourParts), ref.entries);
    match createArchiveWithBytes(outputPath, allBytes) {
      Ok(_) => "Generated PPTX: ${outputPath} (${intToStr(slideCount)} slides, reference deck applied: ${intToStr(listLength(ref.entries))} parts carried, ${intToStr(ref.masterCount)} master(s), ${intToStr(ref.layoutCount)} layout(s))",
      Err(e) => "Error generating PPTX: ${e}"
    }
  } else {
  let allEntries = pptxAppendEntries(baseEntries, slideEntries, slideRelEntries);

  let result = createArchive(outputPath, allEntries);
  match result {
    Ok(_) => "Generated PPTX: ${outputPath} (${intToStr(slideCount)} slides)",
    Err(e) => "Error generating PPTX: ${e}"
  }
  }
}

-- Collect blocks into slide groups. SectionBlock(kind="slide") boundaries define slides.
-- If no slides, all blocks go onto one slide.
type SlideGroup = { blocks: [Block], rest: [Block] }

pure func pptxCollectSlides(blocks: [Block]) -> [[Block]] {
  let hasSlides = pptxHasSlideBlocks(blocks);
  if hasSlides
  then pptxSplitBySlides(blocks, [])
  else [blocks]
}

pure func pptxHasSlideBlocks(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    -- Recurse on `rest`, not `blocks` — the same infinite loop odp_generator
    -- had. Hidden for the same reason: a PPTX's first section IS a slide, so it
    -- returns before reaching the bug; any document source hangs.
    SectionBlock(s) :: rest => if s.kind == "slide" then true else pptxHasSlideBlocks(rest),
    _ :: rest => pptxHasSlideBlocks(rest)
  }

-- Split blocks by SectionBlock(kind="slide") — each section's children become one slide
pure func pptxSplitBySlides(blocks: [Block], acc: [[Block]]) -> [[Block]] =
  match blocks {
    [] => acc,
    SectionBlock(s) :: rest =>
      if s.kind == "slide"
      then pptxSplitBySlides(rest, pptxAppendSlide(acc, s.blocks))
      else pptxSplitBySlides(rest, acc),
    b :: rest => pptxSplitBySlides(rest, acc)
  }

pure func pptxAppendSlide(acc: [[Block]], slide: [Block]) -> [[Block]] =
  match acc {
    [] => [slide],
    x :: [] => [x, slide],
    x :: rest => x :: pptxAppendSlide(rest, slide)
  }

pure func pptxCountSlides(slides: [[Block]]) -> int = listLength(slides)

-- Build slide XML entries
pure func pptxBuildSlideEntries(slides: [[Block]], idx: int) -> [{name: string, content: string}] =
  match slides {
    [] => [],
    slide :: rest =>
      let entry = {name: "ppt/slides/slide${intToStr(idx)}.xml", content: pptxSlideXml(slide)} in
      entry :: pptxBuildSlideEntries(rest, idx + 1)
  }

-- Build slide relationship entries
pure func pptxBuildSlideRelEntries(count: int, idx: int) -> [{name: string, content: string}] =
  if idx > count then []
  else
    let entry = {name: "ppt/slides/_rels/slide${intToStr(idx)}.xml.rels", content: pptxSlideRels()} in
    entry :: pptxBuildSlideRelEntries(count, idx + 1)

-- Append slide entries to base entries
pure func pptxAppendEntries(
  base: [{name: string, content: string}],
  slides: [{name: string, content: string}],
  rels: [{name: string, content: string}]
) -> [{name: string, content: string}] =
  match slides {
    [] => match rels {
      [] => base,
      r :: rrest => pptxAppendEntries(pptxAppendEntry(base, r), [], rrest)
    },
    s :: srest => pptxAppendEntries(pptxAppendEntry(base, s), srest, rels)
  }

pure func pptxAppendEntry(
  entries: [{name: string, content: string}],
  entry: {name: string, content: string}
) -> [{name: string, content: string}] =
  match entries {
    [] => [entry],
    x :: rest => x :: pptxAppendEntry(rest, entry)
  }

-- Build a single slide XML
pure func pptxSlideXml(blocks: [Block]) -> string {
  let ns = "xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"";
  let shapes = pptxBlocksToShapes(blocks, 1);
  "${xmlDecl()}<p:sld ${ns}><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/>${shapes}</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>"
}


-- ============================================================
-- Reference-deck assembly
-- ============================================================
--
-- Our slide relationship ids are NON-NUMERIC ("rIdDP1"). The template's own
-- presentation rels are carried whole and keep ids like rId1..rId12, so a
-- numeric counter would eventually land on one of them. There is no arithmetic
-- that makes "rIdDP1" collide.

pure func pptxRefSlideRelId(idx: int) -> string = "rIdDP${intToStr(idx)}"

-- The template's presentation.xml with ONLY <p:sldIdLst> swapped. Everything
-- else it declares — sldMasterIdLst, notesSz, defaultTextStyle, and sldSz
-- unless the user asked for a different one — is inherited by not being
-- touched. Schema order matters here: sldIdLst precedes sldSz, sldSz precedes
-- notesSz, so both inserts anchor on the element that must follow.
pure func pptxRefPresentation(ref: PptxRefDoc, slideCount: int, slideSize: string) -> string {
  let stripped = pptxTplDropElems(
    pptxTplDropSpans(ref.presentationXml, "<p:sldIdLst>", "</p:sldIdLst>"),
    "<p:sldIdLst", "sldIdLst");
  let withIds = pptxTplInsertBeforeFirst(stripped, "<p:sldSz",
    "<p:sldIdLst>${pptxRefSlideIds(slideCount, 1)}</p:sldIdLst>");
  -- An explicit --slide-size overrides the template; without one the
  -- template's own <p:sldSz> stands, which is the whole point of carrying it.
  if length(slideSize) == 0 then withIds
  else pptxTplInsertBeforeFirst(
    pptxTplDropElems(withIds, "<p:sldSz", "cx="),
    "<p:notesSz", pptxSldSzFor(slideSize))
}

pure func pptxRefSlideIds(count: int, idx: int) -> string =
  if idx > count then ""
  else "<p:sldId id=\"${intToStr(255 + idx)}\" r:id=\"${pptxRefSlideRelId(idx)}\"/>${pptxRefSlideIds(count, idx + 1)}"

-- The template's presentation rels minus its own slide relationships, plus
-- ours. Matched on the relationship TYPE, not the target: ".../relationships/slide"
-- is exact, where a target substring like "slides/slide" would be a guess about
-- naming that a hand-built deck need not follow.
pure func pptxRefPresRels(ref: PptxRefDoc, slideCount: int) -> string =
  pptxTplInsertBeforeLast(
    pptxTplDropElems(ref.presentationRelsXml, "<Relationship", "/relationships/slide\""),
    "</Relationships>",
    pptxRefSlideRelEntriesXml(slideCount, 1))

pure func pptxRefSlideRelEntriesXml(count: int, idx: int) -> string =
  if idx > count then ""
  else "<Relationship Id=\"${pptxRefSlideRelId(idx)}\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide\" Target=\"slides/slide${intToStr(idx)}.xml\"/>${pptxRefSlideRelEntriesXml(count, idx + 1)}"

-- The template's [Content_Types].xml minus overrides for the parts we dropped,
-- plus ours. The template's Default extension entries are what let its carried
-- media (png, jpeg, embedded fonts) resolve, so they are left alone.
pure func pptxRefContentTypes(ref: PptxRefDoc, slideCount: int) -> string =
  pptxTplInsertBeforeLast(
    pptxTplDropElems(
      pptxTplDropElems(ref.contentTypesXml, "<Override", "/ppt/slides/slide"),
      "<Override", "/ppt/notesSlides/"),
    "</Types>",
    pptxSlideContentTypes(slideCount, 1))

pure func pptxRefSlideRels(layoutTarget: string) -> string =
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout\" Target=\"../slideLayouts/${layoutTarget}\"/></Relationships>"

pure func pptxRefSlideRelEntries(count: int, idx: int, layoutTarget: string) -> [{name: string, content: string}] =
  if idx > count then []
  else
    let entry = {name: "ppt/slides/_rels/slide${intToStr(idx)}.xml.rels", content: pptxRefSlideRels(layoutTarget)} in
    entry :: pptxRefSlideRelEntries(count, idx + 1, layoutTarget)

pure func pptxRefSlideEntries(slides: [[Block]], idx: int) -> [{name: string, content: string}] =
  match slides {
    [] => [],
    slide :: rest =>
      let entry = {name: "ppt/slides/slide${intToStr(idx)}.xml", content: pptxStripOurTypography(pptxSlideXml(slide))} in
      entry :: pptxRefSlideEntries(rest, idx + 1)
  }

-- Remove the typography this generator invented, so the template's governs.
--
-- Two things go, and one deliberately stays:
--
--   sz="NNNN"              ALWAYS ours. No parser puts a font size into an
--                          InlineRun, so every sz in our output is one of this
--                          module's hardcoded constants.
--   <a:pPr algn="ctr"/>    ours, matched as a whole element so it cannot catch
--                          alignment that meant something.
--   b="1"                  STAYS. It is emitted both for our heading default
--                          AND for a run the source document actually marked
--                          bold, and the two are indistinguishable in the
--                          finished XML. Dropping it would silently discard
--                          real formatting to fix a cosmetic default. A title
--                          under a non-bold brand style therefore stays bold —
--                          a recorded limitation of the theme tier, and one
--                          that placeholder binding removes properly, because
--                          then the layout supplies typography and we emit no
--                          run properties at all.
export pure func pptxStripOurTypography(xml: string) -> string =
  pptxDropAttrs(pptxDropAll(xml, "<a:pPr algn=\"ctr\"/>"), " sz=\"")

pure func pptxDropAll(s: string, lit: string) -> string {
  let i = find(s, lit);
  if i < 0 then s
  else pptxDropAll("${substring(s, 0, i)}${substring(s, i + length(lit), length(s))}", lit)
}

-- Removes every ` name="..."` attribute whose prefix matches, closing quote
-- included. An unterminated attribute returns the input untouched rather than
-- truncating the element.
pure func pptxDropAttrs(s: string, prefix: string) -> string {
  let i = find(s, prefix);
  if i < 0 then s
  else pptxDropAttrAt(s, prefix, i)
}

pure func pptxDropAttrAt(s: string, prefix: string, i: int) -> string {
  let after = substring(s, i + length(prefix), length(s));
  let j = find(after, "\"");
  if j < 0 then s
  else pptxDropAttrs("${substring(s, 0, i)}${substring(after, j + 1, length(after))}", prefix)
}

pure func pptxPartsToByteEntries(parts: [{name: string, content: string}]) -> [{name: string, data: string}] =
  match parts {
    [] => [],
    p :: rest =>
      let entry = {name: p.name, data: toBase64(fromString(p.content))} in
      entry :: pptxPartsToByteEntries(rest)
  }

pure func pptxAppendByteEntries(a: [{name: string, data: string}], b: [{name: string, data: string}]) -> [{name: string, data: string}] =
  match a {
    [] => b,
    x :: rest => x :: pptxAppendByteEntries(rest, b)
  }

-- Convert blocks to PPTX shapes (text boxes positioned vertically)
-- yOff tracks vertical position in EMUs (English Metric Units, 914400 per inch)
pure func pptxBlocksToShapes(blocks: [Block], shapeId: int) -> string =
  match blocks {
    [] => "",
    block :: rest =>
      "${pptxBlockToShape(block, shapeId)}${pptxBlocksToShapes(rest, shapeId + 1)}"
  }

pure func pptxBlockToShape(block: Block, shapeId: int) -> string {
  let idStr = intToStr(shapeId + 1);
  let yOff = intToStr(shapeId * 1200000);
  match block {
    HeadingBlock(h) =>
      pptxTextBox(idStr, "Title ${idStr}", "457200", yOff, "8229600", "800000",
        "<a:p><a:pPr algn=\"ctr\"/>${pptxHeadingRuns(h.runs, h.text)}</a:p>"),

    TextBlock(t) =>
      if listLength(t.runs) > 0 || length(t.text) > 0
      then pptxTextBox(idStr, "Text ${idStr}", "457200", yOff, "8229600", "600000",
        "<a:p>${pptxParaRuns(t.runs, t.text)}</a:p>")
      else "",

    TableBlock(t) =>
      pptxTableShape(idStr, yOff, t.headers, t.rows),

    ListBlock(l) =>
      pptxTextBox(idStr, "List ${idStr}", "457200", yOff, "8229600", "1000000",
        pptxListParagraphs(l.items, l.itemRuns, l.ordered, 1)),

    ImageBlock(i) =>
      pptxTextBox(idStr, "Image ${idStr}", "457200", yOff, "8229600", "400000",
        "<a:p><a:r><a:rPr lang=\"en-US\" sz=\"1400\" i=\"1\"/><a:t>[Image: ${xmlEscape(i.description)}]</a:t></a:r></a:p>"),

    AudioBlock(a) =>
      pptxTextBox(idStr, "Audio ${idStr}", "457200", yOff, "8229600", "400000",
        "<a:p><a:r><a:rPr lang=\"en-US\" sz=\"1400\" i=\"1\"/><a:t>[Audio: ${xmlEscape(a.transcription)}]</a:t></a:r></a:p>"),

    VideoBlock(v) =>
      pptxTextBox(idStr, "Video ${idStr}", "457200", yOff, "8229600", "400000",
        "<a:p><a:r><a:rPr lang=\"en-US\" sz=\"1400\" i=\"1\"/><a:t>[Video: ${xmlEscape(v.description)}]</a:t></a:r></a:p>"),

    SectionBlock(s) =>
      pptxBlocksToShapes(s.blocks, shapeId),

    ChangeBlock(c) =>
      pptxTextBox(idStr, "Change ${idStr}", "457200", yOff, "8229600", "400000",
        "<a:p><a:r><a:rPr lang=\"en-US\" sz=\"1400\"/><a:t>${xmlEscape(c.text)} (${xmlEscape(c.changeType)} by ${xmlEscape(c.author)})</a:t></a:r></a:p>"),

    LinkBlock(l) =>
      pptxTextBox(idStr, "Link ${idStr}", "457200", yOff, "8229600", "400000",
        "<a:p><a:r><a:rPr lang=\"en-US\" sz=\"1400\"/><a:t>${xmlEscape(l.text)} (${xmlEscape(l.href)})</a:t></a:r></a:p>"),

    CommentBlock(c) =>
      pptxTextBox(idStr, "Comment ${idStr}", "457200", yOff, "8229600", "400000",
        "<a:p><a:r><a:rPr lang=\"en-US\" sz=\"1400\"/><a:t>${xmlEscape(commentText(c.author, c.text, c.anchorText, c.anchored))}</a:t></a:r></a:p>")
  }
}

-- Build a text box shape
-- === Character formatting (P2 phase 4, DrawingML) ========================
--
-- Falls back to a single unformatted run when the block carries no runs, which
-- keeps output identical for every parser that does not populate them.
pure func pptxParaRuns(runs: [InlineRun], text: string) -> string =
  if listLength(runs) > 0
  then foldl(\acc r. "${acc}${pptxFormattedRun(r)}", "", runs)
  else "<a:r><a:rPr lang=\"en-US\" sz=\"1800\"/><a:t>${xmlEscape(text)}</a:t></a:r>"

-- DrawingML carries run properties as ATTRIBUTES on a:rPr, not as child
-- elements the way WordprocessingML does.
pure func pptxFormattedRun(r: InlineRun) -> string =
  "<a:r><a:rPr lang=\"en-US\" sz=\"1800\"${pptxRunAttrs(r)}/><a:t>${xmlEscape(r.text)}</a:t></a:r>"

pure func pptxRunAttrs(r: InlineRun) -> string {
  let bold = if r.bold then " b=\"1\"" else "";
  let italic = if r.italic then " i=\"1\"" else "";
  let under = if r.underline then " u=\"sng\"" else "";
  let strike = if r.strike then " strike=\"sngStrike\"" else "";
  -- baseline is signed thousandths of a percent; these are PowerPoint's own
  -- defaults for super/subscript.
  let base = if r.vertAlign == "superscript" then " baseline=\"30000\""
    else if r.vertAlign == "subscript" then " baseline=\"-25000\""
    else "";
  "${bold}${italic}${under}${strike}${base}"
}

pure func pptxTextBox(id: string, name: string, x: string, y: string, cx: string, cy: string, bodyContent: string) -> string =
  "<p:sp><p:nvSpPr><p:cNvPr id=\"${id}\" name=\"${xmlEscape(name)}\"/><p:cNvSpPr txBox=\"1\"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x=\"${x}\" y=\"${y}\"/><a:ext cx=\"${cx}\" cy=\"${cy}\"/></a:xfrm><a:prstGeom prst=\"rect\"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr wrap=\"square\" rtlCol=\"0\"/><a:lstStyle/>${bodyContent}</p:txBody></p:sp>"

-- Build a table shape in PPTX (using a:tbl inside p:graphicFrame)
pure func pptxTableShape(id: string, yOff: string, headers: [TableCell], rows: [[TableCell]]) -> string {
  let colCount = if listLength(headers) > 0 then listLength(headers) else pptxGuessColCount(rows);
  let colWidth = if colCount > 0 then intToStr(8229600 / colCount) else "2000000";
  let gridCols = pptxGridCols(colCount, colWidth);
  let headerRow = if listLength(headers) > 0
    then "<a:tr h=\"370840\">${pptxTableCells(headers, true)}</a:tr>"
    else "";
  let dataRows = foldl(\acc row. "${acc}<a:tr h=\"370840\">${pptxTableCells(row, false)}</a:tr>", "", rows);

  "<p:graphicFrame><p:nvGraphicFramePr><p:cNvPr id=\"${id}\" name=\"Table ${id}\"/><p:cNvGraphicFramePr><a:graphicFrameLocks noGrp=\"1\"/></p:cNvGraphicFramePr><p:nvPr/></p:nvGraphicFramePr><p:xfrm><a:off x=\"457200\" y=\"${yOff}\"/><a:ext cx=\"8229600\" cy=\"1500000\"/></p:xfrm><a:graphic><a:graphicData uri=\"http://schemas.openxmlformats.org/drawingml/2006/table\"><a:tbl><a:tblPr firstRow=\"1\" bandRow=\"1\"/><a:tblGrid>${gridCols}</a:tblGrid>${headerRow}${dataRows}</a:tbl></a:graphicData></a:graphic></p:graphicFrame>"
}

pure func pptxGuessColCount(rows: [[TableCell]]) -> int =
  match rows {
    [] => 1,
    r :: _ => if listLength(r) > 0 then listLength(r) else 1
  }

pure func pptxGridCols(count: int, width: string) -> string =
  if count <= 0 then ""
  else "<a:gridCol w=\"${width}\"/>${pptxGridCols(count - 1, width)}"

pure func pptxTableCells(cells: [TableCell], isHeader: bool) -> string =
  foldl(\acc c. "${acc}${pptxTableCell(c, isHeader)}", "", cells)

pure func pptxTableCell(cell: TableCell, isHeader: bool) -> string {
  let spanAttr = if cell.colSpan > 1 then " gridSpan=\"${intToStr(cell.colSpan)}\"" else "";
  let boldPr = if isHeader then "<a:rPr lang=\"en-US\" b=\"1\"/>" else "<a:rPr lang=\"en-US\"/>";
  if cell.merged then "<a:tc hMerge=\"1\"><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr/></a:p></a:txBody><a:tcPr/></a:tc>"
  else "<a:tc${spanAttr}><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r>${boldPr}<a:t>${xmlEscape(cell.text)}</a:t></a:r></a:p></a:txBody><a:tcPr/></a:tc>"
}

-- Build list as multiple paragraphs with bullet/number prefix
-- itemRuns is parallel to items but may be empty; the two are walked together
-- so a short or absent itemRuns falls back to plain text per item rather than
-- pairing formatting with the wrong item.
--
-- The bullet/number prefix stays a plain leading run: DrawingML has real
-- autonumbering via a:buChar / a:buAutoNum, but this generator has always
-- written the marker as text and changing that is a separate concern from
-- carrying character formatting.
pure func pptxListParagraphs(items: [string], itemRuns: [[InlineRun]], ordered: bool, idx: int) -> string =
  match items {
    [] => "",
    item :: rest =>
      let prefix = if ordered then "${intToStr(idx)}. " else "\u2022 " in
      match itemRuns {
        [] =>
          "<a:p>${pptxPlainRun("${prefix}${item}")}</a:p>${pptxListParagraphs(rest, [], ordered, idx + 1)}",
        r :: rrest =>
          let body = if listLength(r) > 0
            then "${pptxPlainRun(prefix)}${foldl(\acc x. "${acc}${pptxFormattedRun(x)}", "", r)}"
            else pptxPlainRun("${prefix}${item}") in
          "<a:p>${body}</a:p>${pptxListParagraphs(rest, rrest, ordered, idx + 1)}"
      }
  }

pure func pptxPlainRun(text: string) -> string =
  "<a:r><a:rPr lang=\"en-US\" sz=\"1800\"/><a:t>${xmlEscape(text)}</a:t></a:r>"

-- Headings keep their larger size and stay bold by default — that is the title
-- look this generator has always produced — while italic/underline/strike and
-- baseline come from the run.
pure func pptxHeadingRuns(runs: [InlineRun], text: string) -> string =
  if listLength(runs) > 0
  then foldl(\acc r. "${acc}${pptxHeadingRun(r)}", "", runs)
  else "<a:r><a:rPr lang=\"en-US\" sz=\"2800\" b=\"1\"/><a:t>${xmlEscape(text)}</a:t></a:r>"

pure func pptxHeadingRun(r: InlineRun) -> string {
  let italic = if r.italic then " i=\"1\"" else "";
  let under = if r.underline then " u=\"sng\"" else "";
  let strike = if r.strike then " strike=\"sngStrike\"" else "";
  let base = if r.vertAlign == "superscript" then " baseline=\"30000\""
    else if r.vertAlign == "subscript" then " baseline=\"-25000\""
    else "";
  "<a:r><a:rPr lang=\"en-US\" sz=\"2800\" b=\"1\"${italic}${under}${strike}${base}/><a:t>${xmlEscape(r.text)}</a:t></a:r>"
}

-- [Content_Types].xml
pure func pptxContentTypes(slideCount: int) -> string {
  "${xmlDecl()}<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/ppt/presentation.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml\"/><Override PartName=\"/ppt/slideMasters/slideMaster1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.slideMaster+xml\"/><Override PartName=\"/ppt/slideLayouts/slideLayout1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.slideLayout+xml\"/><Override PartName=\"/ppt/theme/theme1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.theme+xml\"/><Override PartName=\"/ppt/presProps.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.presProps+xml\"/><Override PartName=\"/ppt/viewProps.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.viewProps+xml\"/><Override PartName=\"/ppt/tableStyles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.tableStyles+xml\"/>${pptxSlideContentTypes(slideCount, 1)}</Types>"
}

pure func pptxSlideContentTypes(count: int, idx: int) -> string =
  if idx > count then ""
  else "<Override PartName=\"/ppt/slides/slide${intToStr(idx)}.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.slide+xml\"/>${pptxSlideContentTypes(count, idx + 1)}"

-- Root relationships
pure func pptxRootRels() -> string =
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"ppt/presentation.xml\"/></Relationships>"

-- The <p:sldSz> element for a named aspect ratio.
--
-- 16:9 is the default: PowerPoint has defaulted to widescreen since 2013, and
-- every deck this generator produced before v0.41.0 came out 4:3 regardless of
-- what the content wanted.
--
-- This returns the whole ELEMENT rather than cx/cy, because a reference doc
-- supplies its own <p:sldSz> verbatim — one substitution point serves both the
-- flag and the template.
export pure func pptxSldSzFor(kind: string) -> string =
  if kind == "4:3"
  then "<p:sldSz cx=\"9144000\" cy=\"6858000\" type=\"screen4x3\"/>"
  else "<p:sldSz cx=\"12192000\" cy=\"6858000\"/>"

-- Presentation XML
pure func pptxPresentation(slideCount: int, sldSz: string) -> string =
  "${xmlDecl()}<p:presentation xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:sldMasterIdLst><p:sldMasterId id=\"2147483648\" r:id=\"rId1\"/></p:sldMasterIdLst><p:sldIdLst>${pptxSlideIds(slideCount, 1)}</p:sldIdLst>${sldSz}<p:notesSz cx=\"6858000\" cy=\"9144000\"/></p:presentation>"

pure func pptxSlideIds(count: int, idx: int) -> string =
  if idx > count then ""
  else "<p:sldId id=\"${intToStr(255 + idx)}\" r:id=\"rId${intToStr(idx + 5)}\"/>${pptxSlideIds(count, idx + 1)}"

-- Presentation relationships
-- Presentation relationships: slideMaster=rId1, presProps=rId2, viewProps=rId3, theme=rId4, tableStyles=rId5, slides=rId6+
pure func pptxPresentationRels(slideCount: int) -> string =
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"slideMasters/slideMaster1.xml\"/><Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/presProps\" Target=\"presProps.xml\"/><Relationship Id=\"rId3\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/viewProps\" Target=\"viewProps.xml\"/><Relationship Id=\"rId4\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme\" Target=\"theme/theme1.xml\"/><Relationship Id=\"rId5\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/tableStyles\" Target=\"tableStyles.xml\"/>${pptxSlideRelsEntries(slideCount, 1)}</Relationships>"

pure func pptxSlideRelsEntries(count: int, idx: int) -> string =
  if idx > count then ""
  else "<Relationship Id=\"rId${intToStr(idx + 5)}\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide\" Target=\"slides/slide${intToStr(idx)}.xml\"/>${pptxSlideRelsEntries(count, idx + 1)}"

-- Slide relationship file (each slide references the layout)
pure func pptxSlideRels() -> string =
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout\" Target=\"../slideLayouts/slideLayout1.xml\"/></Relationships>"

-- Minimal slide layout (must include clrMapOvr for Keynote)
pure func pptxSlideLayout() -> string =
  "${xmlDecl()}<p:sldLayout xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\" type=\"blank\"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sldLayout>"

pure func pptxSlideLayoutRels() -> string =
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"../slideMasters/slideMaster1.xml\"/></Relationships>"

-- Minimal slide master (must include clrMap for Keynote to resolve theme colors)
pure func pptxSlideMaster() -> string =
  "${xmlDecl()}<p:sldMaster xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:cSld><p:bg><p:bgRef idx=\"1001\"><a:schemeClr val=\"bg1\"/></p:bgRef></p:bg><p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/></p:spTree></p:cSld><p:clrMap bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/><p:sldLayoutIdLst><p:sldLayoutId id=\"2147483649\" r:id=\"rId1\"/></p:sldLayoutIdLst></p:sldMaster>"

pure func pptxSlideMasterRels() -> string =
  "${xmlDecl()}<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout\" Target=\"../slideLayouts/slideLayout1.xml\"/><Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme\" Target=\"../theme/theme1.xml\"/></Relationships>"

-- Presentation properties (required by Keynote)
pure func pptxPresProps() -> string =
  "${xmlDecl()}<p:presentationPr xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"/>"

-- View properties (required by Keynote)
pure func pptxViewProps() -> string =
  "${xmlDecl()}<p:viewPr xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:slideViewPr><p:cSldViewPr><p:cViewPr varScale=\"1\"><p:scale><a:sx n=\"100\" d=\"100\"/><a:sy n=\"100\" d=\"100\"/></p:scale><p:origin x=\"0\" y=\"0\"/></p:cViewPr></p:cSldViewPr></p:slideViewPr></p:viewPr>"

-- Table styles (required by Keynote for tables)
pure func pptxTableStyles() -> string =
  "${xmlDecl()}<a:tblStyleLst xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" def=\"{5C22544A-7EE6-4342-B048-85BDC9FD1C3A}\"/>"

-- Minimal Office theme (required by Keynote and most PPTX readers)
-- Defines a color scheme + font scheme. Without this, Keynote refuses to open the file.
pure func pptxTheme() -> string =
  "${xmlDecl()}<a:theme xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" name=\"AILANG Parse\"><a:themeElements><a:clrScheme name=\"AILANG Parse\"><a:dk1><a:srgbClr val=\"000000\"/></a:dk1><a:lt1><a:srgbClr val=\"FFFFFF\"/></a:lt1><a:dk2><a:srgbClr val=\"1F497D\"/></a:dk2><a:lt2><a:srgbClr val=\"EEECE1\"/></a:lt2><a:accent1><a:srgbClr val=\"4F81BD\"/></a:accent1><a:accent2><a:srgbClr val=\"C0504D\"/></a:accent2><a:accent3><a:srgbClr val=\"9BBB59\"/></a:accent3><a:accent4><a:srgbClr val=\"8064A2\"/></a:accent4><a:accent5><a:srgbClr val=\"4BACC6\"/></a:accent5><a:accent6><a:srgbClr val=\"F79646\"/></a:accent6><a:hlink><a:srgbClr val=\"0000FF\"/></a:hlink><a:folHlink><a:srgbClr val=\"800080\"/></a:folHlink></a:clrScheme><a:fontScheme name=\"AILANG Parse\"><a:majorFont><a:latin typeface=\"Calibri\"/><a:ea typeface=\"\"/><a:cs typeface=\"\"/></a:majorFont><a:minorFont><a:latin typeface=\"Calibri\"/><a:ea typeface=\"\"/><a:cs typeface=\"\"/></a:minorFont></a:fontScheme><a:fmtScheme name=\"AILANG Parse\"><a:fillStyleLst><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:fillStyleLst><a:lnStyleLst><a:ln w=\"9525\"><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:ln><a:ln w=\"25400\"><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:ln><a:ln w=\"38100\"><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:ln></a:lnStyleLst><a:effectStyleLst><a:effectStyle><a:effectLst/></a:effectStyle><a:effectStyle><a:effectLst/></a:effectStyle><a:effectStyle><a:effectLst/></a:effectStyle></a:effectStyleLst><a:bgFillStyleLst><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:bgFillStyleLst></a:fmtScheme></a:themeElements><a:objectDefaults/><a:extraClrSchemeLst/></a:theme>"
