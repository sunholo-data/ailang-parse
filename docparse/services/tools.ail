module docparse/services/tools

import std/json (encode, jo, kv, js, ja, jb)
import std/list (map)

-- Tool Definitions Endpoint
--
-- Returns canonical tool definitions for major agent frameworks:
-- Claude, OpenAI, MCP, and A2A.

@nowrap
@route("GET", "/api/v1/tools")
export pure func tools() -> string {
  encode(jo([
    kv("claude", jo([
      kv("name", js("ailang_parse")),
      kv("description", js("Parse any document (DOCX, PPTX, XLSX, PDF, images, audio, video) into structured blocks. Returns blocks, markdown, HTML, or A2UI format. Office formats are deterministic; PDF/images use AI.")),
      kv("input_schema", toolsParseInputSchema())
    ])),
    kv("openai", jo([
      kv("type", js("function")),
      kv("function", jo([
        kv("name", js("ailang_parse")),
        kv("description", js("Parse any document into structured blocks. Supports DOCX, PPTX, XLSX, ODT, ODP, ODS, HTML, Markdown, CSV, EPUB, PDF, PNG, JPG, MP3, MP4.")),
        kv("parameters", toolsParseInputSchema())
      ]))
    ])),
    kv("mcp", js("/mcp/")),
    kv("a2a", js("/.well-known/agent.json"))
  ]))
}

pure func toolsParseInputSchema() -> Json =
  jo([
    kv("type", js("object")),
    kv("properties", jo([
      kv("filepath", jo([
        kv("type", js("string")),
        kv("description", js("File path to parse or sample_id from /api/v1/samples"))
      ])),
      kv("sample_id", jo([
        kv("type", js("string")),
        kv("description", js("Sample document ID from /api/v1/samples"))
      ])),
      kv("outputFormat", jo([
        kv("type", js("string")),
        kv("enum", ja(map(js, ["blocks", "markdown", "html", "a2ui"]))),
        kv("default", js("blocks")),
        kv("description", js("Output format: blocks (structured JSON), markdown, html, or a2ui (cross-platform UI)"))
      ]))
    ])),
    kv("required", ja([]))
  ])
