module docparse/services/xlsx_parser

import std/xml (parseLenient, sanitizeXml, parseElements, parseFold, findAll, findAllTexts, findAllAttrs, findFirst, getText, getAttr, getChildren, getTag)
import std/zip (scanFold)
import std/option (Some, None, flatMap as optFlatMap, map as optMap, getOrElse)
import std/result (Ok, Err)
import std/string (contains, length, trim, stringToInt, join, startsWith, substring, intToStr)
import std/list (map, flatMap, filter, nth, length as listLength, concat, take, reverse, foldl)
import std/map (empty as emptyMap, insert as mapInsert, lookup as mapLookup, size as mapSize, fromList as mapFromList)
import docparse/types/document (mkHeading, mkText, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, TableCell, DocMetadata, emptyMetadata, simpleCell, mkTable, mkAnchoredComment, mkUnanchoredComment)
import docparse/services/zip_extract (readCoreProperties, findSheetEntries, readZipEntry, findXlsxCommentEntries, findXlsxThreadedEntries, findXlsxPersonEntries)

-- XLSX Parser
-- Parses Excel worksheets into content Blocks.
--
-- XLSX structure:
--   xl/workbook.xml           - sheet list
--   xl/sharedStrings.xml      - string table (cells reference by index)
--   xl/worksheets/sheetN.xml  - cell data
--
-- Cell types (t= attribute on <c>):
--   t="s"          - shared string (value is index into sharedStrings)
--   t="inlineStr"  - inline string (text in <is><t>)
--   t="b"          - boolean (1/0)
--   t="e"          - error (#REF!, etc.)
--   t="n" or none  - number
--
-- Each worksheet becomes a TableBlock with the first row as headers.

-- Parse all worksheets from an XLSX file
export func parseXlsx(filepath: string) -> [Block] ! {FS} {
  -- Load shared strings table via streaming fold (O(1) memory per element, capped at 100K)
  let sharedStrings = loadSharedStrings(filepath);
  let stringCount = mapSize(sharedStrings);
  -- Get real sheet names from workbook.xml
  let sheetNames = readWorkbookSheetNames(filepath);
  -- Find and parse each sheet
  let sheetEntries = findSheetEntries(filepath);
  let sheetBlocks = parseSheetsWithNames(filepath, sheetEntries, sharedStrings, sheetNames, 0);
  -- Warn if shared strings were truncated
  if stringCount >= 50000
  then {
    let warning = mkText(
      "Warning: spreadsheet has more than 50,000 unique text values. Some cell text may be missing. For large datasets, consider CSV format.",
      "warning", 0
    );
    warning :: sheetBlocks
  }
  else sheetBlocks
}

-- === Cell comments (ECMA-376 §18.7) ======================================
--
-- Unlike Word, Excel does not split a comment from its anchor: each comment
-- carries ref="B5" naming the cell it belongs to. So there is no correlation
-- pass here — the anchor is present in the comment itself. We resolve the
-- cell's displayed text as well, so a reader gets "Under budget" attached to
-- the value being commented on rather than to a bare coordinate.
--
-- Two shapes exist in the wild and both are handled:
--   xl/comments1.xml            legacy notes: <comment ref authorId><text>
--   xl/threadedComments/*.xml   review threads: personId -> xl/persons/*.xml,
--                               with parentId linking replies
-- Modern Excel writes BOTH (the legacy part is a compatibility shim whose
-- author is a placeholder), so when a threaded comment exists for a cell it
-- wins and the legacy duplicate is dropped.

type XlsxComment = {
  ref: string,
  author: string,
  date: string,
  text: string,
  id: string,
  parentId: string,
  threaded: bool
}

-- Read every comment attached to one worksheet, anchored to its cell.
func xlsxSheetComments(filepath: string, sheetXml: string, ss: Map[int, string],
                        sheetIdx: int) -> [Block] ! {FS} {
  let legacy = xlsxReadLegacyComments(filepath, sheetIdx);
  let threaded = xlsxReadThreadedComments(filepath, sheetIdx);
  -- Threaded comments supersede the legacy compatibility copy for the same cell
  let threadedRefs = map(\c. c.ref, threaded);
  let keptLegacy = filter(\c. not xlsxRefSeen(c.ref, threadedRefs), legacy);
  let all = concat(threaded, keptLegacy);
  map(\c. xlsxCommentBlock(c, sheetXml, ss), all)
}

pure func xlsxRefSeen(ref: string, refs: [string]) -> bool =
  match filter(\r. r == ref, refs) {
    [] => false,
    _ => true
  }

-- Build the CommentBlock, resolving the commented cell's text as the anchor.
-- A comment on an empty cell still anchors — to the cell reference — because
-- the reference is itself an unambiguous target; only a missing ref degrades.
pure func xlsxCommentBlock(c: XlsxComment, sheetXml: string, ss: Map[int, string]) -> Block {
  if length(c.ref) == 0
  then mkUnanchoredComment(c.id, c.author, c.date, c.text, c.parentId, false)
  else {
    let cellText = xlsxCellTextAt(sheetXml, ss, c.ref);
    let anchor = if length(cellText) > 0 then "${c.ref}: ${cellText}" else c.ref;
    mkAnchoredComment(c.id, c.author, c.date, c.text, anchor, "cell", 0, c.parentId, false)
  }
}

-- Find one cell's displayed text by reference. Streams over <c> elements so a
-- large sheet costs O(1) memory; only runs when a sheet actually has comments.
pure func xlsxCellTextAt(sheetXml: string, ss: Map[int, string], ref: string) -> string {
  if length(sheetXml) == 0 then ""
  else match parseFold(sanitizeXml(sheetXml), "c", { ss: ss, ref: ref, found: "" }, xlsxFoldFindCell) {
    Ok(acc) => acc.found,
    Err(_) => ""
  }
}

pure func xlsxFoldFindCell(acc: { ss: Map[int, string], ref: string, found: string }, c: XmlNode)
    -> { ss: Map[int, string], ref: string, found: string } {
  if length(acc.found) > 0 then acc
  else if getOrElse(getAttr(c, "r"), "") == acc.ref
  then { ss: acc.ss, ref: acc.ref, found: trim(parseXlsxCell(c, acc.ss).text) }
  else acc
}

-- Legacy notes: xl/comments1.xml (or xl/comments/comment1.xml)
func xlsxReadLegacyComments(filepath: string, sheetIdx: int) -> [XlsxComment] ! {FS} {
  let entries = findXlsxCommentEntries(filepath);
  match nth(entries, sheetIdx) {
    Some(entry) => {
      let xml = readZipEntry(filepath, entry);
      if length(xml) == 0 then []
      else match parseLenient(xml) {
        Ok(root) => {
          let authors = findAllTexts(root, "author");
          map(\n. xlsxLegacyComment(n, authors), findAll(root, "comment"))
        },
        Err(_) => []
      }
    },
    None => []
  }
}

pure func xlsxLegacyComment(node: XmlNode, authors: [string]) -> XlsxComment {
  let authorId = getOrElse(optMap(\v. parseIntOr(v, 0 - 1), getAttr(node, "authorId")), 0 - 1);
  {
    ref: getOrElse(getAttr(node, "ref"), ""),
    author: xlsxAuthorAt(authors, authorId),
    date: "",
    text: trim(join("", findAllTexts(node, "t"))),
    id: getOrElse(getAttr(node, "ref"), ""),
    parentId: "",
    threaded: false
  }
}

pure func xlsxAuthorAt(authors: [string], idx: int) -> string =
  if idx < 0 then "Unknown"
  else match nth(authors, idx) {
    Some(a) => if length(trim(a)) > 0 then a else "Unknown",
    None => "Unknown"
  }

pure func parseIntOr(s: string, dflt: int) -> int = getOrElse(stringToInt(s), dflt)

-- Threaded comments: xl/threadedComments/*.xml, authors in xl/persons/*.xml
func xlsxReadThreadedComments(filepath: string, sheetIdx: int) -> [XlsxComment] ! {FS} {
  let entries = findXlsxThreadedEntries(filepath);
  match nth(entries, sheetIdx) {
    Some(entry) => {
      let xml = readZipEntry(filepath, entry);
      if length(xml) == 0 then []
      else {
        let persons = xlsxReadPersons(filepath);
        match parseLenient(xml) {
          Ok(root) => map(\n. xlsxThreadedComment(n, persons),
                          findAll(root, "threadedComment")),
          Err(_) => []
        }
      }
    },
    None => []
  }
}

-- personId GUID -> display name
func xlsxReadPersons(filepath: string) -> [(string, string)] ! {FS} {
  let entries = findXlsxPersonEntries(filepath);
  xlsxReadPersonEntries(filepath, entries)
}

func xlsxReadPersonEntries(filepath: string, entries: [string]) -> [(string, string)] ! {FS} =
  match entries {
    [] => [],
    e :: rest => {
      let xml = readZipEntry(filepath, e);
      let here = match parseLenient(xml) {
        Ok(root) => map(\p. (getOrElse(getAttr(p, "id"), ""),
                             getOrElse(getAttr(p, "displayName"), "Unknown")),
                        findAll(root, "person")),
        Err(_) => []
      };
      concat(here, xlsxReadPersonEntries(filepath, rest))
    }
  }

pure func xlsxThreadedComment(node: XmlNode, persons: [(string, string)]) -> XlsxComment {
  let personId = getOrElse(getAttr(node, "personId"), "");
  {
    ref: getOrElse(getAttr(node, "ref"), ""),
    author: xlsxPersonName(persons, personId),
    date: getOrElse(getAttr(node, "dT"), ""),
    text: trim(join("", findAllTexts(node, "text"))),
    id: getOrElse(getAttr(node, "id"), ""),
    parentId: getOrElse(getAttr(node, "parentId"), ""),
    threaded: true
  }
}

pure func xlsxPersonName(persons: [(string, string)], id: string) -> string =
  match filter(\p. xlsxPairKey(p) == id, persons) {
    [] => "Unknown",
    p :: _ => xlsxPairVal(p)
  }

pure func xlsxPairKey(p: (string, string)) -> string = match p { (k, _) => k }
pure func xlsxPairVal(p: (string, string)) -> string = match p { (_, v) => v }

-- Parse metadata from XLSX (same core.xml format)
export func parseXlsxMetadata(filepath: string) -> DocMetadata ! {FS} {
  let coreXml = readCoreProperties(filepath);
  match parseLenient(coreXml) {
    Ok(root) => extractXlsxMeta(root),
    Err(_) => emptyMetadata()
  }
}

-- Load the shared strings table from xl/sharedStrings.xml
-- Uses scanFold for zero-copy streaming: reads ZIP entry directly into XML
-- decoder without materializing the decompressed XML string.
-- Cap at 100K strings to bound memory and time. Cells referencing strings
-- beyond the cap get empty text. Covers 99%+ of business spreadsheets.
func loadSharedStrings(filepath: string) -> Map[int, string] ! {FS} {
  match scanFold(filepath, "xl/sharedStrings.xml", "si", { pairs: [], idx: 0 }, xlsxFoldSi) {
    Ok(acc) => mapFromList(acc.pairs),
    Err(_) => emptyMap()
  }
}

-- Fold function for scanFold: extract text from <si> and prepend (idx, text) pair
-- Stops accumulating after 100K strings (scanFold still scans but fold is O(1) skip)
pure func xlsxFoldSi(acc: { pairs: [(int, string)], idx: int }, si: XmlNode) -> { pairs: [(int, string)], idx: int } {
  if acc.idx >= 50000 then acc
  else {
    let text = extractSiText(si);
    { pairs: (acc.idx, text) :: acc.pairs, idx: acc.idx + 1 }
  }
}

-- Fold function for parseFold: parse row and accumulate cells
-- Carries sharedStrings in the accumulator to avoid closure capture
pure func xlsxFoldRow(acc: { rows: [[TableCell]], count: int, ss: Map[int, string] }, rowNode: XmlNode) -> { rows: [[TableCell]], count: int, ss: Map[int, string] } {
  if acc.count >= 5000 then acc
  else {
    let cells = parseXlsxRow(rowNode, acc.ss);
    if listLength(cells) > 0
    then { rows: cells :: acc.rows, count: acc.count + 1, ss: acc.ss }
    else acc
  }
}

-- Extract text from each <si> element
-- Handles both <si><t>text</t></si> and <si><r><t>text</t></r></si> (rich text)
export pure func extractSharedStrings(items: [XmlNode]) -> [string]
  ensures { listLength(result) == listLength(items) }
{
  map(extractSiText, items)
}

-- Get text from a single <si> element
pure func extractSiText(si: XmlNode) -> string {
  -- Try simple form: <si><t>text</t></si>
  match findFirst(si, "t") {
    Some(t) => getText(t),
    None => {
      -- Rich text form: <si><r><t>text</t></r><r><t>more</t></r></si>
      let runs = findAll(si, "r");
      extractRichText(runs)
    }
  }
}

-- Concatenate text from rich text runs
pure func extractRichText(runs: [XmlNode]) -> string =
  join("", map(\r. getOrElse(optMap(getText, findFirst(r, "t")), ""), runs))

-- Read real sheet names from xl/workbook.xml
-- Returns ordered list of sheet names (e.g. ["Main", "Secondary"])
func readWorkbookSheetNames(filepath: string) -> [string] ! {FS} {
  let xml = readZipEntry(filepath, "xl/workbook.xml");
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => {
      findAllAttrs(root, "sheet", "name")
    },
    Err(_) => []
  }
}

-- Get sheet name by index, falling back to cleaned entry path
pure func xlsxGetSheetName(names: [string], idx: int, entry: string) -> string =
  match nth(names, idx) {
    Some(name) => if length(name) > 0 then name else xlsxCleanSheetName(entry),
    None => xlsxCleanSheetName(entry)
  }

-- Parse each sheet entry into blocks, using real sheet names
-- Uses readZipEntry + parseElements for worksheets (benefits from early termination
-- at 5000-row cap), while shared strings use scanFold (no XML string materialization).
func parseSheetsWithNames(filepath: string, entries: [string], sharedStrings: Map[int, string], names: [string], idx: int) -> [Block] ! {FS} =
  match entries {
    [] => [],
    entry :: rest => {
      let xml = readZipEntry(filepath, entry);
      let sheetName = xlsxGetSheetName(names, idx, entry);
      let blocks = parseSheetXml(xml, sharedStrings, sheetName);
      -- Cell comments follow their sheet, each anchored to the cell (and the
      -- cell's value) it annotates.
      let comments = xlsxSheetComments(filepath, xml, sharedStrings, idx);
      let wrapped = map(xlsxWrapComment, comments);
      let moreBlocks = parseSheetsWithNames(filepath, rest, sharedStrings, names, idx + 1);
      concat(concat(blocks, wrapped), moreBlocks)
    }
  }

-- Keep the SectionBlock(kind: "comment") wrapper used by every other format
pure func xlsxWrapComment(b: Block) -> Block =
  SectionBlock({kind: "comment", blocks: [b]})

-- Parse a single worksheet's XML into blocks
-- Emits a HeadingBlock with the sheet name followed by the table data.
export func parseSheetXml(xml: string, sharedStrings: Map[int, string], sheetName: string) -> [Block] ! {} {
  if length(xml) == 0 then []
  else {
    -- Use parseFold for streaming: fold directly over <row> elements without
    -- collecting them into a list first. O(1) memory per row, 5K row cap.
    let foldResult = parseFold(sanitizeXml(xml), "row",
      { rows: [], count: 0, ss: sharedStrings },
      xlsxFoldRow);
    let parsedRows = match foldResult {
      Ok(acc2) => reverse(acc2.rows),
      Err(_) => []
    };
    let heading = mkHeading(xlsxCleanSheetName(sheetName), 1);
    match parsedRows {
      [] => [heading],
      firstRow :: dataRows => {
        let tableBlock = mkTable(dataRows, firstRow);
        let section = SectionBlock({kind: "sheet", blocks: [heading, tableBlock]});
        [section]
      }
    }
  }
}

-- Clean sheet entry path to a human-readable sheet name
-- Input: "xl/worksheets/sheet1.xml" -> "Sheet 1"
pure func xlsxCleanSheetName(entry: string) -> string {
  -- Strip path prefix and .xml suffix to get e.g. "sheet1"
  let stripped = xlsxStripPrefix(entry);
  let name = xlsxStripSuffix(stripped);
  xlsxFormatSheetName(name)
}

-- Strip "xl/worksheets/" prefix
pure func xlsxStripPrefix(s: string) -> string {
  let prefix = "xl/worksheets/";
  if startsWith(s, prefix)
  then substring(s, length(prefix), length(s))
  else s
}

-- Strip ".xml" suffix
pure func xlsxStripSuffix(s: string) -> string {
  let suffix = ".xml";
  let sLen = length(s);
  let suffixLen = length(suffix);
  if sLen > suffixLen then {
    let ending = substring(s, sLen - suffixLen, sLen);
    if ending == suffix
    then substring(s, 0, sLen - suffixLen)
    else s
  }
  else s
}

-- Format "sheet1" -> "Sheet 1", "sheet12" -> "Sheet 12"
pure func xlsxFormatSheetName(name: string) -> string {
  if startsWith(name, "sheet") then {
    let numPart = substring(name, 5, length(name));
    "Sheet ${numPart}"
  }
  else name
}

-- Row cap per sheet: 5000 (inlined in parseSheetXml to work around Go codegen bug
-- where module-level let bindings used as function args kill codegen)

-- Parse all rows (direct recursion to avoid closure allocation)
pure func parseXlsxRows(rows: [XmlNode], sharedStrings: Map[int, string]) -> [[TableCell]] =
  match rows {
    [] => [],
    row :: rest => {
      let cells = parseXlsxRow(row, sharedStrings);
      if listLength(cells) > 0
      then cells :: parseXlsxRows(rest, sharedStrings)
      else parseXlsxRows(rest, sharedStrings)
    }
  }

-- Parse a single row
pure func parseXlsxRow(row: XmlNode, sharedStrings: Map[int, string]) -> [TableCell] {
  let cells = findAll(row, "c");
  parseXlsxCells(cells, sharedStrings)
}

-- Parse all cells in a row
-- Uses direct recursion instead of map+lambda to avoid per-cell
-- environment cloning (sharedStrings map clone per cell was 13.9% of CPU)
pure func parseXlsxCells(cells: [XmlNode], sharedStrings: Map[int, string]) -> [TableCell]
  ensures { listLength(result) == listLength(cells) }
{
  match cells {
    [] => [],
    cell :: rest => parseXlsxCell(cell, sharedStrings) :: parseXlsxCells(rest, sharedStrings)
  }
}

-- Parse a single cell
-- Reads t= attribute for type, resolves shared strings
pure func parseXlsxCell(c: XmlNode, sharedStrings: Map[int, string]) -> TableCell {
  let cellType = getCellType(c);
  let text = if cellType == "s" then resolveSharedString(c, sharedStrings)
    else if cellType == "inlineStr" then getInlineString(c)
    else if cellType == "b" then getBooleanValue(c)
    else if cellType == "e" then getErrorValue(c)
    else getNumericValue(c);
  simpleCell(text)
}

-- Get cell type from t= attribute (default "n" for number)
pure func getCellType(c: XmlNode) -> string =
  getOrElse(getAttr(c, "t"), "n")

-- Resolve a shared string reference: <v>INDEX</v> -> sharedStrings[INDEX]
pure func resolveSharedString(c: XmlNode, sharedStrings: Map[int, string]) -> string {
  match optMap(getText, findFirst(c, "v")) {
    Some(indexStr) =>
      match stringToInt(indexStr) {
        Some(idx) => getOrElse(mapLookup(sharedStrings, idx), ""),
        None => indexStr
      },
    None => ""
  }
}

-- Get inline string: <is><t>text</t></is>
pure func getInlineString(c: XmlNode) -> string =
  getOrElse(
    optFlatMap(\is_.
      optMap(getText, findFirst(is_, "t")),
      findFirst(c, "is")),
    "")

-- Get boolean value
pure func getBooleanValue(c: XmlNode) -> string =
  getOrElse(optMap(\v. if getText(v) == "1" then "TRUE" else "FALSE", findFirst(c, "v")), "")

-- Get error value (e.g., #REF!)
pure func getErrorValue(c: XmlNode) -> string =
  getOrElse(optMap(getText, findFirst(c, "v")), "")

-- Get numeric value
pure func getNumericValue(c: XmlNode) -> string =
  getOrElse(optMap(getText, findFirst(c, "v")), "")

-- Extract metadata from core.xml
pure func extractXlsxMeta(root: XmlNode) -> DocMetadata {
  let title = getXlsxMetaField(root, "dc:title");
  let author = getXlsxMetaField(root, "dc:creator");
  let created = getXlsxMetaField(root, "dcterms:created");
  let modified = getXlsxMetaField(root, "dcterms:modified");
  { title: title, author: author, created: created, modified: modified, pageCount: 0 }
}

pure func getXlsxMetaField(root: XmlNode, tagName: string) -> string =
  getOrElse(optMap(getText, findFirst(root, tagName)), "")
