module docparse/services/xlsx_parser

import std/xml (parseLenient, sanitizeXml, parseElements, parseFoldStep, findAll, findAllTexts, findAllAttrs, findFirst, getText, getAttr, getChildren, getTag)
import std/zip (scanFold, scanFoldStep)
import std/iter (FoldStep, Continue, Stop)
import std/option (Some, None, flatMap as optFlatMap, map as optMap, getOrElse)
import std/result (Ok, Err)
import std/string (contains, length, trim, stringToInt, join, startsWith, substring, intToStr, split, find)
import std/list (map, flatMap, filter, nth, length as listLength, concat, take, reverse, foldl, foldlE, any, dedup)
import std/map (empty as emptyMap, insert as mapInsert, lookup as mapLookup, size as mapSize, fromList as mapFromList, values as mapValues)
import docparse/types/document (mkHeading, mkText, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, TableCell, DocMetadata, emptyMetadata, simpleCell, spanCell, mergedCell, mkTable, mkAnchoredComment, mkUnanchoredComment, mkSection, mkNamedSection, withCellColours)
import docparse/services/colour (normaliseHex, applyTint, parseTint, indexedColour, themeSlotName)
import docparse/services/zip_extract (readCoreProperties, findSheetEntries, readZipEntry, findXlsxCommentEntries, findXlsxThreadedEntries, findXlsxPersonEntries)

-- XLSX Parser
-- Parses Excel worksheets into content Blocks.
--
-- XLSX structure:
--   xl/workbook.xml           - sheet list
--   xl/sharedStrings.xml      - string table (cells reference by index)
--   xl/worksheets/sheetN.xml  - cell data
--
-- Cell types (t= attribute on <c>):
--   t="s"          - shared string (value is index into sharedStrings)
--   t="inlineStr"  - inline string (text in <is><t>)
--   t="b"          - boolean (1/0)
--   t="e"          - error (#REF!, etc.)
--   t="n" or none  - number
--
-- Each worksheet becomes a TableBlock with the first row as headers.

-- Parse all worksheets from an XLSX file
export func parseXlsx(filepath: string) -> [Block] ! {FS} =
  parseXlsxWithWarnings(filepath).blocks

-- Parse all worksheets, plus the warnings a caller should see: colour the
-- workbook carries that the blocks do not (conditional formatting, gradient
-- and pattern fills, theme colours with no theme to resolve them against).
-- A file whose colour is silently dropped reads exactly like a file with no
-- colour — that is the defect these exist to prevent.
export func parseXlsxWithWarnings(filepath: string) -> XlsxParsed ! {FS} {
  -- Load shared strings table via streaming fold (O(1) memory per element, capped at 100K)
  let sharedStrings = loadSharedStrings(filepath);
  let stringCount = mapSize(sharedStrings);
  -- Direct cell colours, resolved once per workbook and keyed by xf index
  let styles = loadXlsxStyles(filepath);
  -- Get real sheet names from workbook.xml
  let sheetNames = readWorkbookSheetNames(filepath);
  -- Find and parse each sheet
  let sheetEntries = findSheetEntries(filepath);
  let parsed = parseSheetsWithNames(filepath, sheetEntries, sharedStrings, styles, sheetNames);
  -- Warn if shared strings were truncated
  let blocks = if stringCount >= 50000
  then {
    let warning = mkText(
      "Warning: spreadsheet has more than 50,000 unique text values. Some cell text may be missing. For large datasets, consider CSV format.",
      "warning", 0
    );
    warning :: parsed.blocks
  }
  else parsed.blocks;
  { blocks: blocks, warnings: parsed.warnings }
}

-- === Cell comments (ECMA-376 §18.7) ======================================
--
-- Unlike Word, Excel does not split a comment from its anchor: each comment
-- carries ref="B5" naming the cell it belongs to. So there is no correlation
-- pass here — the anchor is present in the comment itself. We resolve the
-- cell's displayed text as well, so a reader gets "Under budget" attached to
-- the value being commented on rather than to a bare coordinate.
--
-- Two shapes exist in the wild and both are handled:
--   xl/comments1.xml            legacy notes: <comment ref authorId><text>
--   xl/threadedComments/*.xml   review threads: personId -> xl/persons/*.xml,
--                               with parentId linking replies
-- Modern Excel writes BOTH (the legacy part is a compatibility shim whose
-- author is a placeholder), so when a threaded comment exists for a cell it
-- wins and the legacy duplicate is dropped.

type XlsxComment = {
  ref: string,
  author: string,
  date: string,
  text: string,
  id: string,
  parentId: string,
  threaded: bool
}

-- Read every comment attached to one worksheet as raw records. The threaded
-- copy wins over the legacy compatibility shim for the same cell. Anchor
-- resolution happens against the streamed sheet rows in the caller.
func xlsxSheetCommentRecords(filepath: string, sheetIdx: int) -> [XlsxComment] ! {FS} {
  let legacy = xlsxReadLegacyComments(filepath, sheetIdx);
  let threaded = xlsxReadThreadedComments(filepath, sheetIdx);
  -- Threaded comments supersede the legacy compatibility copy for the same cell
  let threadedRefs = map(\c. c.ref, threaded);
  concat(threaded, filter(\c. not xlsxRefSeen(c.ref, threadedRefs), legacy))
}

pure func xlsxRefSeen(ref: string, refs: [string]) -> bool =
  match filter(\r. r == ref, refs) {
    [] => false,
    _ => true
  }

-- Build the CommentBlock, resolving the commented cell's text as the anchor.
-- A comment on an empty cell still anchors — to the cell reference — because
-- the reference is itself an unambiguous target; only a missing ref degrades.
-- The cell texts were collected during the sheet's streaming row pass, so no
-- second (materialised) parse of the sheet is needed.
pure func xlsxCommentBlock(c: XlsxComment, texts: [(string, string)]) -> Block {
  if length(c.ref) == 0
  then mkUnanchoredComment(c.id, c.author, c.date, c.text, c.parentId, false)
  else {
    let cellText = match filter(\t. xlsxPairKey(t) == c.ref, texts) {
      [] => "",
      t :: _ => xlsxPairVal(t)
    };
    let anchor = if length(cellText) > 0 then "${c.ref}: ${cellText}" else c.ref;
    mkAnchoredComment(c.id, c.author, c.date, c.text, anchor, "cell", 0, c.parentId, false)
  }
}

-- Legacy notes: xl/comments1.xml (or xl/comments/comment1.xml)
func xlsxReadLegacyComments(filepath: string, sheetIdx: int) -> [XlsxComment] ! {FS} {
  let entries = findXlsxCommentEntries(filepath);
  match nth(entries, sheetIdx) {
    Some(entry) => {
      let xml = readZipEntry(filepath, entry);
      if length(xml) == 0 then []
      else match parseLenient(xml) {
        Ok(root) => {
          let authors = findAllTexts(root, "author");
          map(\n. xlsxLegacyComment(n, authors), findAll(root, "comment"))
        },
        Err(_) => []
      }
    },
    None => []
  }
}

pure func xlsxLegacyComment(node: XmlNode, authors: [string]) -> XlsxComment {
  let authorId = getOrElse(optMap(\v. parseIntOr(v, 0 - 1), getAttr(node, "authorId")), 0 - 1);
  {
    ref: getOrElse(getAttr(node, "ref"), ""),
    author: xlsxAuthorAt(authors, authorId),
    date: "",
    text: trim(join("", findAllTexts(node, "t"))),
    id: getOrElse(getAttr(node, "ref"), ""),
    parentId: "",
    threaded: false
  }
}

pure func xlsxAuthorAt(authors: [string], idx: int) -> string =
  if idx < 0 then "Unknown"
  else match nth(authors, idx) {
    Some(a) => if length(trim(a)) > 0 then a else "Unknown",
    None => "Unknown"
  }

pure func parseIntOr(s: string, dflt: int) -> int = getOrElse(stringToInt(s), dflt)

-- Threaded comments: xl/threadedComments/*.xml, authors in xl/persons/*.xml
func xlsxReadThreadedComments(filepath: string, sheetIdx: int) -> [XlsxComment] ! {FS} {
  let entries = findXlsxThreadedEntries(filepath);
  match nth(entries, sheetIdx) {
    Some(entry) => {
      let xml = readZipEntry(filepath, entry);
      if length(xml) == 0 then []
      else {
        let persons = xlsxReadPersons(filepath);
        match parseLenient(xml) {
          Ok(root) => map(\n. xlsxThreadedComment(n, persons),
                          findAll(root, "threadedComment")),
          Err(_) => []
        }
      }
    },
    None => []
  }
}

-- personId GUID -> display name
func xlsxReadPersons(filepath: string) -> [(string, string)] ! {FS} {
  let entries = findXlsxPersonEntries(filepath);
  xlsxReadPersonEntries(filepath, entries)
}

func xlsxReadPersonEntries(filepath: string, entries: [string]) -> [(string, string)] ! {FS} =
  match entries {
    [] => [],
    e :: rest => {
      let xml = readZipEntry(filepath, e);
      let here = match parseLenient(xml) {
        Ok(root) => map(\p. (getOrElse(getAttr(p, "id"), ""),
                             getOrElse(getAttr(p, "displayName"), "Unknown")),
                        findAll(root, "person")),
        Err(_) => []
      };
      concat(here, xlsxReadPersonEntries(filepath, rest))
    }
  }

pure func xlsxThreadedComment(node: XmlNode, persons: [(string, string)]) -> XlsxComment {
  let personId = getOrElse(getAttr(node, "personId"), "");
  {
    ref: getOrElse(getAttr(node, "ref"), ""),
    author: xlsxPersonName(persons, personId),
    date: getOrElse(getAttr(node, "dT"), ""),
    text: trim(join("", findAllTexts(node, "text"))),
    id: getOrElse(getAttr(node, "id"), ""),
    parentId: getOrElse(getAttr(node, "parentId"), ""),
    threaded: true
  }
}

pure func xlsxPersonName(persons: [(string, string)], id: string) -> string =
  match filter(\p. xlsxPairKey(p) == id, persons) {
    [] => "Unknown",
    p :: _ => xlsxPairVal(p)
  }

pure func xlsxPairKey(p: (string, string)) -> string = match p { (k, _) => k }
pure func xlsxPairVal(p: (string, string)) -> string = match p { (_, v) => v }

-- Parse metadata from XLSX (same core.xml format)
export func parseXlsxMetadata(filepath: string) -> DocMetadata ! {FS} {
  let coreXml = readCoreProperties(filepath);
  match parseLenient(coreXml) {
    Ok(root) => extractXlsxMeta(root),
    Err(_) => emptyMetadata()
  }
}

-- Load the shared strings table from xl/sharedStrings.xml
-- Uses scanFold for zero-copy streaming: reads ZIP entry directly into XML
-- decoder without materializing the decompressed XML string.
-- Cap at 100K strings to bound memory and time. Cells referencing strings
-- beyond the cap get empty text. Covers 99%+ of business spreadsheets.
func loadSharedStrings(filepath: string) -> Map[int, string] ! {FS} {
  match scanFold(filepath, "xl/sharedStrings.xml", "si", { pairs: [], idx: 0 }, xlsxFoldSi) {
    Ok(acc) => mapFromList(acc.pairs),
    Err(_) => emptyMap()
  }
}

-- Fold function for scanFold: extract text from <si> and prepend (idx, text) pair
-- Stops accumulating after 100K strings (scanFold still scans but fold is O(1) skip)
pure func xlsxFoldSi(acc: { pairs: [(int, string)], idx: int }, si: XmlNode) -> { pairs: [(int, string)], idx: int } {
  if acc.idx >= 50000 then acc
  else {
    let text = extractSiText(si);
    { pairs: (acc.idx, text) :: acc.pairs, idx: acc.idx + 1 }
  }
}

-- Fold function for parseFold: parse row and accumulate cells
-- Carries sharedStrings in the accumulator to avoid closure capture
pure func xlsxFoldRow(acc: { rows: [[TableCell]], count: int, ss: Map[int, string], merges: [XlsxMerge] }, rowNode: XmlNode) -> { rows: [[TableCell]], count: int, ss: Map[int, string], merges: [XlsxMerge] } {
  if acc.count >= 5000 then acc
  else {
    -- The merge-aware walk also fills the cells Excel omits, so it is only
    -- worth its cost when the sheet actually declares merge regions.
    let cells = if listLength(acc.merges) > 0
      then xlsxBuildRowWithMerges(findAll(rowNode, "c"), acc.ss, emptyMap(), acc.merges,
                                  xlsxRowNumber(rowNode), 0)
      else parseXlsxRow(rowNode, acc.ss, emptyMap());
    if listLength(cells) > 0
    then { rows: cells :: acc.rows, count: acc.count + 1, ss: acc.ss, merges: acc.merges }
    else acc
  }
}

-- === Merged cells (ECMA-376 §18.3.1.55) ==================================
--
-- <mergeCells><mergeCell ref="A1:D1"/></mergeCells> declares merge regions.
-- Excel writes only the origin cell of a region and omits the rest, so without
-- this a merged row comes back short and the spans are invisible.
--
-- Deleted by e9de665 along with 277 other lines of this module. Restored, but
-- adapted: the row walk has since been rewritten to stream via parseFold, so
-- merges ride in the fold accumulator instead of being passed down a list walk.
type XlsxMerge = {startCol: int, endCol: int, startRow: int, endRow: int}

pure func xlsxSingleColIndex(c: string) -> int
  tests [("A", 0), ("B", 1), ("D", 3), ("Z", 25)]
{
  if c == "A" then 0 else if c == "B" then 1 else if c == "C" then 2
  else if c == "D" then 3 else if c == "E" then 4 else if c == "F" then 5
  else if c == "G" then 6 else if c == "H" then 7 else if c == "I" then 8
  else if c == "J" then 9 else if c == "K" then 10 else if c == "L" then 11
  else if c == "M" then 12 else if c == "N" then 13 else if c == "O" then 14
  else if c == "P" then 15 else if c == "Q" then 16 else if c == "R" then 17
  else if c == "S" then 18 else if c == "T" then 19 else if c == "U" then 20
  else if c == "V" then 21 else if c == "W" then 22 else if c == "X" then 23
  else if c == "Y" then 24 else if c == "Z" then 25 else 0
}

pure func xlsxColToIndex(col: string) -> int
  tests [("A", 0), ("B", 1), ("Z", 25), ("AA", 26), ("AB", 27)]
{
  if length(col) == 1 then xlsxSingleColIndex(col)
  else if length(col) == 2 then {
    let hi = xlsxSingleColIndex(substring(col, 0, 1));
    let lo = xlsxSingleColIndex(substring(col, 1, 2));
    (hi + 1) * 26 + lo
  }
  else 0
}

-- Split a cell ref into its column letters: "B3" -> "B", "AB12" -> "AB"
pure func xlsxCellRefColStr(ref: string) -> string
  tests [("A1", "A"), ("B3", "B"), ("D12", "D"), ("AA5", "AA")]
{
  if length(ref) >= 2 then {
    match stringToInt(substring(ref, 1, length(ref))) {
      Some(_) => substring(ref, 0, 1),
      None => if length(ref) >= 3 then {
        match stringToInt(substring(ref, 2, length(ref))) {
          Some(_) => substring(ref, 0, 2),
          None => "A"
        }
      } else "A"
    }
  } else "A"
}

pure func xlsxCellRefCol(ref: string) -> int
  tests [("A1", 0), ("B3", 1), ("D1", 3), ("E2", 4)]
{
  xlsxColToIndex(xlsxCellRefColStr(ref))
}

pure func xlsxCellRefRow(ref: string) -> int
  tests [("A1", 1), ("B3", 3), ("D12", 12)]
{
  let colStr = xlsxCellRefColStr(ref);
  getOrElse(stringToInt(substring(ref, length(colStr), length(ref))), 0)
}

-- "A1:D1" -> region. A bare "A9" is a 1x1 region.
pure func xlsxParseMergeRef(ref: string) -> XlsxMerge {
  let parts = split(ref, ":");
  let startRef = getOrElse(nth(parts, 0), "A1");
  let endRef = getOrElse(nth(parts, 1), startRef);
  { startCol: xlsxCellRefCol(startRef), endCol: xlsxCellRefCol(endRef),
    startRow: xlsxCellRefRow(startRef), endRow: xlsxCellRefRow(endRef) }
}

pure func xlsxParseMergeNodes(nodes: [XmlNode]) -> [XlsxMerge] =
  map(\n. xlsxParseMergeRef(getOrElse(getAttr(n, "ref"), "")), nodes)

pure func xlsxGetColSpan(merges: [XlsxMerge], col: int, row: int) -> int =
  match merges {
    [] => 1,
    m :: rest =>
      if m.startCol == col && m.startRow == row then {
        let span = m.endCol - m.startCol + 1;
        if span >= 1 then span else 1
      }
      else xlsxGetColSpan(rest, col, row)
  }

-- Inside a region but not at its origin — i.e. a cell Excel omitted.
pure func xlsxIsInMergeNotOrigin(m: XlsxMerge, col: int, row: int) -> bool =
  col >= m.startCol && col <= m.endCol &&
  row >= m.startRow && row <= m.endRow &&
  (col != m.startCol || row != m.startRow)

pure func xlsxIsMergedAt(merges: [XlsxMerge], col: int, row: int) -> bool =
  match merges {
    [] => false,
    m :: rest =>
      if xlsxIsInMergeNotOrigin(m, col, row) then true
      else xlsxIsMergedAt(rest, col, row)
  }

-- Widest column any region reaches on this row, so trailing omitted cells
-- are still emitted.
pure func xlsxMaxColForRow(merges: [XlsxMerge], rowNum: int) -> int =
  match merges {
    [] => 0,
    m :: rest => {
      let restMax = xlsxMaxColForRow(rest, rowNum);
      if rowNum >= m.startRow && rowNum <= m.endRow && m.endCol > restMax
      then m.endCol else restMax
    }
  }

pure func xlsxFillGap(merges: [XlsxMerge], rowNum: int, from: int, to: int) -> [TableCell] =
  if from >= to then []
  else {
    let cell = if xlsxIsMergedAt(merges, from, rowNum) then mergedCell() else simpleCell("");
    cell :: xlsxFillGap(merges, rowNum, from + 1, to)
  }

-- Walk the row's cells in order, filling the gaps Excel left out and marking
-- span widths on the origins.
pure func xlsxBuildRowWithMerges(cells: [XmlNode], ss: Map[int, string], styles: Map[int, XlsxXfColour],
                                 merges: [XlsxMerge], rowNum: int, nextCol: int) -> [TableCell] =
  match cells {
    [] => xlsxFillGap(merges, rowNum, nextCol, xlsxMaxColForRow(merges, rowNum) + 1),
    c :: rest => {
      let cellCol = xlsxCellRefCol(getOrElse(getAttr(c, "r"), "A1"));
      let gapCells = xlsxFillGap(merges, rowNum, nextCol, cellCol);
      let base = parseXlsxStyledCell(c, ss, styles);
      let cs = xlsxGetColSpan(merges, cellCol, rowNum);
      let cell = if cs > 1 then withCellColours(spanCell(base.text, cs), base.fill, base.color) else base;
      concat(concat(gapCells, [cell]),
             xlsxBuildRowWithMerges(rest, ss, styles, merges, rowNum, cellCol + 1))
    }
  }

pure func xlsxRowNumber(row: XmlNode) -> int =
  getOrElse(stringToInt(getOrElse(getAttr(row, "r"), "0")), 0)

-- Extract text from each <si> element
-- Handles both <si><t>text</t></si> and <si><r><t>text</t></r></si> (rich text)
export pure func extractSharedStrings(items: [XmlNode]) -> [string]
  ensures { listLength(result) == listLength(items) }
{
  map(extractSiText, items)
}

-- Get text from a single <si> element
pure func extractSiText(si: XmlNode) -> string {
  -- Try simple form: <si><t>text</t></si>
  match findFirst(si, "t") {
    Some(t) => getText(t),
    None => {
      -- Rich text form: <si><r><t>text</t></r><r><t>more</t></r></si>
      let runs = findAll(si, "r");
      extractRichText(runs)
    }
  }
}

-- Concatenate text from rich text runs
pure func extractRichText(runs: [XmlNode]) -> string =
  join("", map(\r. getOrElse(optMap(getText, findFirst(r, "t")), ""), runs))

-- Read real sheet names from xl/workbook.xml
-- Returns ordered list of sheet names (e.g. ["Main", "Secondary"])
func readWorkbookSheetNames(filepath: string) -> [string] ! {FS} {
  let xml = readZipEntry(filepath, "xl/workbook.xml");
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => {
      findAllAttrs(root, "sheet", "name")
    },
    Err(_) => []
  }
}

-- Get sheet name by index, falling back to cleaned entry path
pure func xlsxGetSheetName(names: [string], idx: int, entry: string) -> string =
  match nth(names, idx) {
    Some(name) => if length(name) > 0 then name else xlsxCleanSheetName(entry),
    None => xlsxCleanSheetName(entry)
  }

-- Parse each sheet entry into blocks, using real sheet names.
--
-- Memory discipline (m-v1-memory-footprint): the per-sheet work lives in
-- xlsxParseOneSheet, a function the loop CALLS via foldlE. The tree-walking
-- evaluator has no tail-call optimisation, so a self-recursive loop keeps
-- every frame's let bindings reachable until the whole recursion unwinds —
-- a binding only dies with the callee's frame. Here each sheet's data (and
-- the streaming fold state) dies when xlsxParseOneSheet returns; only the
-- small blocks accumulator stays live across sheets.
--
-- Worksheets are streamed with std/zip.scanFoldStep on "row" (and
-- "mergeCell"), like shared strings already are, so the sheet XML string is
-- never materialised and readZipEntry no longer appears on this path.
type XlsxParsed = { blocks: [Block], warnings: [string] }

func parseSheetsWithNames(filepath: string, entries: [string], sharedStrings: Map[int, string],
                          styles: Map[int, XlsxXfColour], names: [string]) -> XlsxParsed ! {FS} =
  foldlE(func(acc: XlsxParsed, item: (string, int)) -> XlsxParsed ! {FS} {
    let one = xlsxParseOneSheet(filepath, xlsxEntryName(item), sharedStrings, styles, names, xlsxEntryIdx(item));
    { blocks: concat(acc.blocks, one.blocks), warnings: concat(acc.warnings, one.warnings) }
  }, { blocks: [], warnings: [] }, xlsxIndexed(entries, 0))

pure func xlsxEntryName(item: (string, int)) -> string = match item { (e, _) => e }
pure func xlsxEntryIdx(item: (string, int)) -> int = match item { (_, i) => i }

-- Pair each sheet entry with its ordinal for the fold above.
pure func xlsxIndexed(entries: [string], idx: int) -> [(string, int)] =
  match entries {
    [] => [],
    e :: rest => (e, idx) :: xlsxIndexed(rest, idx + 1)
  }

-- Parse ONE worksheet entry completely: comments first (their anchor cells
-- are resolved from the streamed rows), then the sheet itself, streamed.
-- Everything large here is local to this frame, so it is freeable on return.
func xlsxParseOneSheet(filepath: string, entry: string, sharedStrings: Map[int, string],
                       styles: Map[int, XlsxXfColour], names: [string], idx: int) -> XlsxParsed ! {FS} {
  let sheetName = xlsxGetSheetName(names, idx, entry);
  -- Cell comments follow their sheet, each anchored to the cell (and the
  -- cell's value) it annotates. Read the comment records before streaming so
  -- the row fold can collect the anchor cells' text as it goes.
  let comments = xlsxSheetCommentRecords(filepath, idx);
  let refs = filter(\r. length(r) > 0, dedup(map(\c. c.ref, comments)));
  let streamed = xlsxStreamSheet(filepath, entry, sharedStrings, styles, refs);
  let blocks = xlsxSheetBlocks(streamed.rows, sheetName);
  let wrapped = map(\c. xlsxWrapComment(xlsxCommentBlock(c, streamed.texts)), comments);
  let condFmt = xlsxConditionalFormats(filepath, entry);
  let cleanName = xlsxCleanSheetName(sheetName);
  { blocks: concat(blocks, wrapped),
    warnings: concat(xlsxCondFmtWarning(cleanName, condFmt), xlsxFlagWarnings(cleanName, streamed.flags)) }
}

-- Fold-accumulator record for streaming one worksheet out of the ZIP.
type XlsxStreamFold = {
  rows: [[TableCell]],
  count: int,
  ss: Map[int, string],
  -- Carried in the accumulator for the same reason ss is: a closure over it
  -- would be cloned per cell (see parseXlsxCells).
  styles: Map[int, XlsxXfColour],
  -- Only when some xf carries a flag is a row re-scanned to collect flags,
  -- so a workbook with plain solid fills pays nothing for the warnings.
  flagged: bool,
  flags: [string],
  merges: [XlsxMerge],
  refs: [string],
  texts: [(string, string)]
}

-- Stream one worksheet straight out of the ZIP archive: one streaming pass
-- over <mergeCell> (capped at 500, matching parseElements) and one over
-- <row>. Returns rows in document order plus the displayed text of any cell
-- referenced by a comment. The sheet XML string is never materialised.
func xlsxStreamSheet(filepath: string, entry: string, ss: Map[int, string], styles: Map[int, XlsxXfColour], refs: [string])
    -> { rows: [[TableCell]], texts: [(string, string)], flags: [string] } ! {FS} {
  let merges = match scanFoldStep(filepath, entry, "mergeCell", { merges: [], count: 0 }, xlsxFoldMerge) {
    Ok(acc) => reverse(acc.merges),
    Err(_) => []
  };
  match scanFoldStep(filepath, entry, "row",
    { rows: [], count: 0, ss: ss, styles: styles, flagged: xlsxAnyFlagged(styles), flags: [],
      merges: merges, refs: refs, texts: [] },
    xlsxFoldRowStep) {
    Ok(acc) => { rows: reverse(acc.rows), texts: acc.texts, flags: acc.flags },
    Err(_) => { rows: [], texts: [], flags: [] }
  }
}

-- Streaming fold over <mergeCell>: accumulate regions, cap at 500.
pure func xlsxFoldMerge(acc: { merges: [XlsxMerge], count: int }, node: XmlNode)
    -> FoldStep[{ merges: [XlsxMerge], count: int }] {
  if acc.count >= 500 then Stop(acc)
  else Continue({ merges: xlsxParseMergeRef(getOrElse(getAttr(node, "ref"), "")) :: acc.merges,
                  count: acc.count + 1 })
}

-- Streaming fold over <row>: parse rows (merge-aware, capped at 5000) and
-- collect the displayed text of any comment-anchor cell on the way past.
-- Stops early once the row cap is reached AND every anchor has been found;
-- otherwise keeps scanning (O(1) per skipped row) so anchors beyond the cap
-- still resolve, as the previous whole-XML pass did.
pure func xlsxFoldRowStep(acc: XlsxStreamFold, rowNode: XmlNode) -> FoldStep[XlsxStreamFold] {
  if acc.count >= 5000 then
    (if xlsxRefsAllFound(acc.refs, acc.texts) then Stop(acc) else Continue(acc))
  else {
    let cells = if listLength(acc.merges) > 0
      then xlsxBuildRowWithMerges(findAll(rowNode, "c"), acc.ss, acc.styles, acc.merges,
                                  xlsxRowNumber(rowNode), 0)
      else parseXlsxRow(rowNode, acc.ss, acc.styles);
    let texts = if listLength(acc.refs) > 0
      then xlsxCollectRefTexts(findAll(rowNode, "c"), acc.ss, acc.refs, acc.texts)
      else acc.texts;
    let flags = if acc.flagged
      then xlsxCollectFlags(findAll(rowNode, "c"), acc.styles, acc.flags)
      else acc.flags;
    let acc2 = { acc | texts: texts, flags: flags };
    let acc3 = if listLength(cells) > 0
      then { acc2 | rows: cells :: acc2.rows, count: acc2.count + 1 }
      else acc2;
    if acc3.count >= 5000 && xlsxRefsAllFound(acc3.refs, acc3.texts)
    then Stop(acc3)
    else Continue(acc3)
  }
}

-- Collect the displayed text of any cell in this row whose ref is a comment
-- anchor. parseXlsxCell is the exact resolver the whole-XML pass used.
pure func xlsxCollectRefTexts(cells: [XmlNode], ss: Map[int, string], refs: [string], texts: [(string, string)]) -> [(string, string)] =
  foldl(func(acc: [(string, string)], c: XmlNode) -> [(string, string)] {
    let ref = getOrElse(getAttr(c, "r"), "");
    if length(ref) > 0 && xlsxRefSeen(ref, refs) && not xlsxRefCollected(ref, acc)
    then (ref, trim(parseXlsxCell(c, ss).text)) :: acc
    else acc
  }, texts, cells)

pure func xlsxRefCollected(ref: string, texts: [(string, string)]) -> bool =
  any(\t. xlsxPairKey(t) == ref, texts)

pure func xlsxRefsAllFound(refs: [string], texts: [(string, string)]) -> bool =
  not any(\r. not xlsxRefCollected(r, texts), refs)

-- Keep the SectionBlock(kind: "comment") wrapper used by every other format
pure func xlsxWrapComment(b: Block) -> Block =
  mkSection("comment", [b])

-- Build a sheet's blocks (heading, or a named section with heading + table)
-- from parsed rows. Shared by the streaming ZIP path and parseSheetXml.
pure func xlsxSheetBlocks(parsedRows: [[TableCell]], sheetName: string) -> [Block] {
  let cleanName = xlsxCleanSheetName(sheetName);
  let heading = mkHeading(cleanName, 1);
  match parsedRows {
    [] => [heading],
    firstRow :: dataRows => {
      let tableBlock = mkTable(dataRows, firstRow);
      let section = mkNamedSection("sheet", cleanName, [heading, tableBlock]);
      [section]
    }
  }
}

-- Parse a single worksheet's XML into blocks (materialised-string variant).
-- Kept for API compatibility; the in-package parse path uses xlsxStreamSheet
-- so the XML string is never materialised. Emits a HeadingBlock with the
-- sheet name followed by the table data.
export func parseSheetXml(xml: string, sharedStrings: Map[int, string], sheetName: string) -> [Block] ! {} {
  if length(xml) == 0 then []
  else {
    -- Same streaming row fold as the ZIP path, but over a held string; no
    -- comment pass here, so the anchor refs are empty.
    let merges = match parseElements(xml, "mergeCell", 500) {
      Ok(nodes) => xlsxParseMergeNodes(nodes),
      Err(_) => []
    };
    -- No styles.xml here (the caller hands over one sheet's XML), so cells
    -- carry no colour on this path.
    let foldResult = parseFoldStep(sanitizeXml(xml), "row",
      { rows: [], count: 0, ss: sharedStrings, styles: emptyMap(), flagged: false, flags: [],
        merges: merges, refs: [], texts: [] },
      xlsxFoldRowStep);
    let parsedRows = match foldResult {
      Ok(acc2) => reverse(acc2.rows),
      Err(_) => []
    };
    xlsxSheetBlocks(parsedRows, sheetName)
  }
}

-- Clean sheet entry path to a human-readable sheet name
-- Input: "xl/worksheets/sheet1.xml" -> "Sheet 1"
pure func xlsxCleanSheetName(entry: string) -> string {
  -- Strip path prefix and .xml suffix to get e.g. "sheet1"
  let stripped = xlsxStripPrefix(entry);
  let name = xlsxStripSuffix(stripped);
  xlsxFormatSheetName(name)
}

-- Strip "xl/worksheets/" prefix
pure func xlsxStripPrefix(s: string) -> string {
  let prefix = "xl/worksheets/";
  if startsWith(s, prefix)
  then substring(s, length(prefix), length(s))
  else s
}

-- Strip ".xml" suffix
pure func xlsxStripSuffix(s: string) -> string {
  let suffix = ".xml";
  let sLen = length(s);
  let suffixLen = length(suffix);
  if sLen > suffixLen then {
    let ending = substring(s, sLen - suffixLen, sLen);
    if ending == suffix
    then substring(s, 0, sLen - suffixLen)
    else s
  }
  else s
}

-- Format "sheet1" -> "Sheet 1", "sheet12" -> "Sheet 12"
pure func xlsxFormatSheetName(name: string) -> string {
  if startsWith(name, "sheet") then {
    let numPart = substring(name, 5, length(name));
    "Sheet ${numPart}"
  }
  else name
}

-- Row cap per sheet: 5000 (inlined in parseSheetXml to work around Go codegen bug
-- where module-level let bindings used as function args kill codegen)

-- Parse all rows (direct recursion to avoid closure allocation)
pure func parseXlsxRows(rows: [XmlNode], sharedStrings: Map[int, string]) -> [[TableCell]] =
  match rows {
    [] => [],
    row :: rest => {
      let cells = parseXlsxRow(row, sharedStrings, emptyMap());
      if listLength(cells) > 0
      then cells :: parseXlsxRows(rest, sharedStrings)
      else parseXlsxRows(rest, sharedStrings)
    }
  }

-- Parse a single row
pure func parseXlsxRow(row: XmlNode, sharedStrings: Map[int, string], styles: Map[int, XlsxXfColour]) -> [TableCell] {
  let cells = findAll(row, "c");
  parseXlsxCells(cells, sharedStrings, styles)
}

-- Parse all cells in a row
-- Uses direct recursion instead of map+lambda to avoid per-cell
-- environment cloning (sharedStrings map clone per cell was 13.9% of CPU)
pure func parseXlsxCells(cells: [XmlNode], sharedStrings: Map[int, string], styles: Map[int, XlsxXfColour]) -> [TableCell]
  ensures { listLength(result) == listLength(cells) }
{
  match cells {
    [] => [],
    cell :: rest => parseXlsxStyledCell(cell, sharedStrings, styles) :: parseXlsxCells(rest, sharedStrings, styles)
  }
}

-- A cell with its direct colour: <c s="n"> indexes cellXfs, resolved once per
-- workbook into `styles`. A cell with no s, or an xf with no colour, is
-- returned exactly as parseXlsxCell gives it.
pure func parseXlsxStyledCell(c: XmlNode, sharedStrings: Map[int, string], styles: Map[int, XlsxXfColour]) -> TableCell {
  let base = parseXlsxCell(c, sharedStrings);
  match xlsxCellXf(c, styles) {
    Some(x) => withCellColours(base, x.fill, x.color),
    None => base
  }
}

pure func xlsxCellXf(c: XmlNode, styles: Map[int, XlsxXfColour]) -> Option[XlsxXfColour] =
  match getAttr(c, "s") {
    Some(sv) => match stringToInt(sv) {
      Some(i) => mapLookup(styles, i),
      None => None
    },
    None => None
  }

-- Parse a single cell
-- Reads t= attribute for type, resolves shared strings
pure func parseXlsxCell(c: XmlNode, sharedStrings: Map[int, string]) -> TableCell {
  let cellType = getCellType(c);
  let text = if cellType == "s" then resolveSharedString(c, sharedStrings)
    else if cellType == "inlineStr" then getInlineString(c)
    else if cellType == "b" then getBooleanValue(c)
    else if cellType == "e" then getErrorValue(c)
    else getNumericValue(c);
  simpleCell(text)
}

-- Get cell type from t= attribute (default "n" for number)
pure func getCellType(c: XmlNode) -> string =
  getOrElse(getAttr(c, "t"), "n")

-- Resolve a shared string reference: <v>INDEX</v> -> sharedStrings[INDEX]
pure func resolveSharedString(c: XmlNode, sharedStrings: Map[int, string]) -> string {
  match optMap(getText, findFirst(c, "v")) {
    Some(indexStr) =>
      match stringToInt(indexStr) {
        Some(idx) => getOrElse(mapLookup(sharedStrings, idx), ""),
        None => indexStr
      },
    None => ""
  }
}

-- Get inline string: <is><t>text</t></is>
pure func getInlineString(c: XmlNode) -> string =
  getOrElse(
    optFlatMap(\is_.
      optMap(getText, findFirst(is_, "t")),
      findFirst(c, "is")),
    "")

-- Get boolean value
pure func getBooleanValue(c: XmlNode) -> string =
  getOrElse(optMap(\v. if getText(v) == "1" then "TRUE" else "FALSE", findFirst(c, "v")), "")

-- Get error value (e.g., #REF!)
pure func getErrorValue(c: XmlNode) -> string =
  getOrElse(optMap(getText, findFirst(c, "v")), "")

-- Get numeric value
pure func getNumericValue(c: XmlNode) -> string =
  getOrElse(optMap(getText, findFirst(c, "v")), "")

-- Extract metadata from core.xml
pure func extractXlsxMeta(root: XmlNode) -> DocMetadata {
  let title = getXlsxMetaField(root, "dc:title");
  let author = getXlsxMetaField(root, "dc:creator");
  let created = getXlsxMetaField(root, "dcterms:created");
  let modified = getXlsxMetaField(root, "dcterms:modified");
  { title: title, author: author, created: created, modified: modified, pageCount: 0 }
}

pure func getXlsxMetaField(root: XmlNode, tagName: string) -> string =
  getOrElse(optMap(getText, findFirst(root, tagName)), "")

-- === Cell colour (ECMA-376 §18.8: styles part; §20.1.6.2 theme) ===========
--
-- A cell's colour is three hops from the cell: <c s="n"> -> cellXfs/xf[n]
-- -> fills/fill[fillId] and fonts/font[fontId] -> a CT_Color that is one of
-- rgb (ARGB), theme (+tint), indexed (legacy palette) or auto. Everything is
-- resolved ONCE per workbook into a map keyed by xf index, so the per-cell
-- cost in the streaming fold is a single lookup.
--
-- Only these sections are read, and only by their direct children: <fill>
-- and <xf> also appear under <dxfs> (conditional-formatting styles) and
-- <cellStyleXfs>, and a document-wide findAll would index into the wrong list.
--
-- Colour that is NOT extracted is flagged, and the flag becomes a warning on
-- the outcome: a gradient has no single colour; a non-solid pattern is
-- reported as its foreground; a theme reference with no theme part cannot be
-- resolved. Direct formatting only — row/column default styles and table
-- styles are not applied (design doc, Phase 4).

-- fill/color are "#rrggbb" or ""; flag is "" | "pattern" | "gradient" | "theme-missing"
type XlsxXfColour = { fill: string, color: string, flag: string }

type XlsxColourCtx = { theme: Map[string, string], palette: [string] }

func loadXlsxStyles(filepath: string) -> Map[int, XlsxXfColour] ! {FS} {
  let xml = readZipEntry(filepath, "xl/styles.xml");
  if length(xml) == 0 then emptyMap()
  else match parseLenient(xml) {
    Ok(root) => {
      let ctx = { theme: loadXlsxTheme(filepath), palette: xlsxCustomPalette(root) };
      let fills = mapFromList(xlsxIndexedList(map(\n. xlsxFillColour(n, ctx), xlsxSectionChildren(root, "fills", "fill")), 0));
      let fonts = mapFromList(xlsxIndexedList(map(\n. xlsxFontColour(n, ctx), xlsxSectionChildren(root, "fonts", "font")), 0));
      -- fonts[0] is the Normal style's font. Its colour (typically theme 1,
      -- black) is the workbook's default text colour, not something an author
      -- applied: reporting it would colour every styled cell #000000.
      let defaultColour = getOrElse(mapLookup(fonts, 0), xlsxNoColour()).color;
      xlsxXfMap(xlsxSectionChildren(root, "cellXfs", "xf"), fills, fonts, defaultColour, 0, emptyMap())
    },
    Err(_) => emptyMap()
  }
}

-- Direct children with tag `child` of the first `section` element.
pure func xlsxSectionChildren(root: XmlNode, section: string, child: string) -> [XmlNode] =
  match findFirst(root, section) {
    Some(sec) => filter(\n. getTag(n) == child, getChildren(sec)),
    None => []
  }

pure func xlsxIndexedList(xs: [XlsxXfColour], i: int) -> [(int, XlsxXfColour)] =
  match xs {
    [] => [],
    x :: rest => (i, x) :: xlsxIndexedList(rest, i + 1)
  }

-- Keep only xfs that carry a colour or a flag: most xfs in a real workbook
-- exist for number formats and borders, and an absent key is the same answer.
func xlsxXfMap(xfs: [XmlNode], fills: Map[int, XlsxXfColour], fonts: Map[int, XlsxXfColour],
               defaultColour: string, i: int, acc: Map[int, XlsxXfColour]) -> Map[int, XlsxXfColour] =
  match xfs {
    [] => acc,
    xf :: rest => {
      let fill = getOrElse(mapLookup(fills, xlsxAttrInt(xf, "fillId", 0 - 1)), xlsxNoColour());
      let fontId = xlsxAttrInt(xf, "fontId", 0 - 1);
      let font = getOrElse(mapLookup(fonts, fontId), xlsxNoColour());
      -- The default font's colour is ignored below, so its unresolvable
      -- theme reference is not a loss worth warning about either.
      let fontFlag = if fontId == 0 then "" else font.flag;
      let flag = if length(fill.flag) > 0 then fill.flag else fontFlag;
      let color = if font.color == defaultColour then "" else font.color;
      let entry = { fill: fill.fill, color: color, flag: flag };
      let acc2 = if length(entry.fill) > 0 || length(entry.color) > 0 || length(entry.flag) > 0
                 then mapInsert(acc, i, entry) else acc;
      xlsxXfMap(rest, fills, fonts, defaultColour, i + 1, acc2)
    }
  }

pure func xlsxNoColour() -> XlsxXfColour = { fill: "", color: "", flag: "" }

pure func xlsxAttrInt(n: XmlNode, name: string, dflt: int) -> int =
  match getAttr(n, name) {
    Some(v) => getOrElse(stringToInt(v), dflt),
    None => dflt
  }

-- <fill><patternFill patternType="solid"><fgColor .../></patternFill></fill>
-- A patternFill without patternType is "none" (§18.18.55 default); gray125 is
-- the reserved fill 1 and carries no colour of its own.
pure func xlsxFillColour(fill: XmlNode, ctx: XlsxColourCtx) -> XlsxXfColour =
  match findFirst(fill, "gradientFill") {
    Some(_) => { fill: "", color: "", flag: "gradient" },
    None => match findFirst(fill, "patternFill") {
      None => xlsxNoColour(),
      Some(pf) => {
        let ptype = getOrElse(getAttr(pf, "patternType"), "none");
        if ptype == "none" || ptype == "gray125" then xlsxNoColour()
        else {
          let fg = match findFirst(pf, "fgColor") {
            Some(c) => xlsxResolveColour(c, ctx),
            None => { hex: "", themeMissing: false }
          };
          let flag = if fg.themeMissing then "theme-missing"
                     else if ptype == "solid" then "" else "pattern";
          { fill: fg.hex, color: "", flag: flag }
        }
      }
    }
  }

-- <font><color .../></font>; the font's own children only.
pure func xlsxFontColour(font: XmlNode, ctx: XlsxColourCtx) -> XlsxXfColour =
  match filter(\n. getTag(n) == "color", getChildren(font)) {
    c :: _ => {
      let r = xlsxResolveColour(c, ctx);
      { fill: "", color: r.hex, flag: if r.themeMissing then "theme-missing" else "" }
    },
    [] => xlsxNoColour()
  }

-- CT_Color: rgb | theme | indexed | auto, then @tint applied to whichever base.
pure func xlsxResolveColour(c: XmlNode, ctx: XlsxColourCtx) -> { hex: string, themeMissing: bool } {
  let base = match getAttr(c, "rgb") {
    Some(rgb) => { hex: normaliseHex(rgb), themeMissing: false },
    None => match getAttr(c, "theme") {
      Some(t) => {
        let slot = themeSlotName(getOrElse(stringToInt(t), 0 - 1));
        match mapLookup(ctx.theme, slot) {
          Some(h) => { hex: h, themeMissing: false },
          None => { hex: "", themeMissing: true }
        }
      },
      None => match getAttr(c, "indexed") {
        Some(ix) => { hex: xlsxPaletteColour(ctx.palette, getOrElse(stringToInt(ix), 0 - 1)), themeMissing: false },
        None => { hex: "", themeMissing: false }
      }
    }
  };
  match getAttr(c, "tint") {
    Some(t) => { hex: applyTint(base.hex, parseTint(t)), themeMissing: base.themeMissing },
    None => base
  }
}

-- A workbook may replace the legacy palette (<colors><indexedColors>). 64/65
-- stay viewer-decided either way.
pure func xlsxPaletteColour(palette: [string], i: int) -> string =
  if i >= 64 then ""
  else match palette {
    [] => indexedColour(i),
    _ => getOrElse(nth(palette, i), indexedColour(i))
  }

pure func xlsxCustomPalette(root: XmlNode) -> [string] =
  match findFirst(root, "indexedColors") {
    Some(ic) => map(\n. normaliseHex(getOrElse(getAttr(n, "rgb"), "")),
                    filter(\n. getTag(n) == "rgbColor", getChildren(ic))),
    None => []
  }

-- Scheme colours by element NAME (dk1, lt1, accent1, ...). theme="n" is then
-- resolved through themeSlotName, which carries the lt/dk index swap; looking
-- slots up by position in this file would silently swap text and background.
-- sysClr (window/windowText) uses its lastClr, the value Excel last rendered.
func loadXlsxTheme(filepath: string) -> Map[string, string] ! {FS} {
  let xml = readZipEntry(filepath, "xl/theme/theme1.xml");
  if length(xml) == 0 then emptyMap()
  else match parseLenient(xml) {
    Ok(root) => match findFirst(root, "a:clrScheme") {
      Some(scheme) => mapFromList(flatMap(xlsxThemeSlot, getChildren(scheme))),
      None => emptyMap()
    },
    Err(_) => emptyMap()
  }
}

pure func xlsxThemeSlot(n: XmlNode) -> [(string, string)] {
  let name = xlsxLocalName(getTag(n));
  let hex = match findFirst(n, "a:srgbClr") {
    Some(c) => normaliseHex(getOrElse(getAttr(c, "val"), "")),
    None => match findFirst(n, "a:sysClr") {
      Some(c) => normaliseHex(getOrElse(getAttr(c, "lastClr"), "")),
      None => ""
    }
  };
  if length(name) > 0 && length(hex) > 0 then [(name, hex)] else []
}

-- "a:dk1" -> "dk1"
pure func xlsxLocalName(tag: string) -> string {
  let i = find(tag, ":");
  if i >= 0 then substring(tag, i + 1, length(tag)) else tag
}

pure func xlsxAnyFlagged(styles: Map[int, XlsxXfColour]) -> bool =
  any(\x. length(x.flag) > 0, mapValues(styles))

func xlsxCollectFlags(cells: [XmlNode], styles: Map[int, XlsxXfColour], flags: [string]) -> [string] =
  foldl(func(acc: [string], c: XmlNode) -> [string] {
    match xlsxCellXf(c, styles) {
      Some(x) => if length(x.flag) > 0 then x.flag :: acc else acc,
      None => acc
    }
  }, flags, cells)

-- One warning per sheet and kind, with the number of cells affected.
pure func xlsxFlagWarnings(sheet: string, flags: [string]) -> [string] {
  let n = \k. listLength(filter(\f. f == k, flags));
  let pattern = n("pattern");
  let gradient = n("gradient");
  let theme = n("theme-missing");
  concat(
    if pattern > 0 then ["Sheet \"${sheet}\": ${show(pattern)} cell(s) use pattern fills; reported as the pattern's foreground colour"] else [],
    concat(
      if gradient > 0 then ["Sheet \"${sheet}\": ${show(gradient)} cell(s) use gradient fills; their colour is not extracted"] else [],
      if theme > 0 then ["Sheet \"${sheet}\": ${show(theme)} cell(s) use theme colours but the workbook has no readable theme; those colours are not extracted"] else []))
}

-- Conditional formatting (§18.3.1.18) is a set of rules the VIEWER evaluates,
-- not colour stored on a cell, so it cannot be extracted without a formula
-- engine. It is counted instead, so the caller knows colour exists that the
-- output does not carry. Streamed like rows; capped at 200 blocks.
func xlsxConditionalFormats(filepath: string, entry: string) -> { ranges: [string], rules: int } ! {FS} =
  match scanFoldStep(filepath, entry, "conditionalFormatting", { ranges: [], rules: 0, count: 0 }, xlsxFoldCondFmt) {
    Ok(acc) => { ranges: reverse(acc.ranges), rules: acc.rules },
    Err(_) => { ranges: [], rules: 0 }
  }

pure func xlsxFoldCondFmt(acc: { ranges: [string], rules: int, count: int }, node: XmlNode)
    -> FoldStep[{ ranges: [string], rules: int, count: int }] {
  if acc.count >= 200 then Stop(acc)
  else Continue({ ranges: getOrElse(getAttr(node, "sqref"), "") :: acc.ranges,
                  rules: acc.rules + listLength(findAll(node, "cfRule")),
                  count: acc.count + 1 })
}

pure func xlsxCondFmtWarning(sheet: string, cf: { ranges: [string], rules: int }) -> [string] =
  if cf.rules == 0 then []
  else {
    let shown = take(5, cf.ranges);
    let more = if listLength(cf.ranges) > 5 then ", …" else "";
    ["Sheet \"${sheet}\": ${show(cf.rules)} conditional formatting rule(s) on ${join(", ", shown)}${more} — colours they produce are not extracted"]
  }
