module docparse/services/zip_extract

import std/zip (listEntries, readEntry, readEntryBytes)
import std/string (contains, length, endsWith, startsWith, split, substring, stringToInt, compare, join)
import std/list (last as listLast, reverse, length as listLength, sortBy, filter, flatMap, foldl, any, concat, map)
import std/option (Some, None, getOrElse)
import std/xml (parseLenient, findAll, findFirst, getAttr)
import std/result (Ok, Err)
import std/bytes (fromBase64)
import std/fs (mkdirAllResult, writeFileBytes, readFileBytes, renameFileResult)
import std/crypto (sha256Bytes, sha256Hex)
import docparse/types/document (Block, ImageBlock, SectionBlock, mkImage, mkNamedSection)

-- ZIP extraction layer for Office documents
-- DOCX, PPTX, XLSX are all ZIP archives containing XML parts.
--
-- DOCX structure:
--   word/document.xml    - main content (paragraphs, runs, tables)
--   word/styles.xml      - style definitions
--   word/media/          - embedded images
--   docProps/core.xml    - metadata (title, author, dates)
--   docProps/app.xml     - app metadata (pages, words count)
--   [Content_Types].xml  - MIME type registry
--   word/_rels/document.xml.rels - relationships (image refs)

-- List all entries in an Office ZIP file
export func listOfficeEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => entries,
    Err(_) => []
  }
}

-- Read the main document XML from a DOCX
export func readDocxContent(path: string) -> string ! {FS} {
  match readEntry(path, "word/document.xml") {
    Ok(content) => content,
    Err(e) => ""
  }
}

-- Read the styles XML from a DOCX
export func readDocxStyles(path: string) -> string ! {FS} {
  match readEntry(path, "word/styles.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read the core properties (metadata) from an Office file
export func readCoreProperties(path: string) -> string ! {FS} {
  match readEntry(path, "docProps/core.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read the app properties (page count, etc.)
export func readAppProperties(path: string) -> string ! {FS} {
  match readEntry(path, "docProps/app.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read the relationships file (maps rId -> target for images etc.)
export func readDocxRelationships(path: string) -> string ! {FS} {
  match readEntry(path, "word/_rels/document.xml.rels") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read word/numbering.xml (§17.9 — abstract numbering definitions). Absent
-- part yields "": documents numbered purely by style or with direct numPr but
-- no definitions keep the parser's legacy bullet-vs-numbered convention.
export func readDocxNumbering(path: string) -> string ! {FS} {
  match readEntry(path, "word/numbering.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read word/styles.xml (§17.7). Absent part yields "" — paragraphs numbered
-- through a style then fall back to the direct-numPr reading, which is what
-- they got before style resolution existed.
export func readDocxStyles(path: string) -> string ! {FS} {
  match readEntry(path, "word/styles.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read an embedded image as base64
-- Read an embedded image by its full ZIP entry path (e.g. "word/media/image1.jpg").
-- findMediaEntries already yields full paths, so we must NOT re-prepend
-- "word/media/" here — doing so looked up "word/media/word/media/…" and always
-- missed, leaving every DOCX image with empty data (and describe with nothing to do).
export func readEmbeddedImage(path: string, imageName: string) -> string ! {FS} {
  match readEntryBytes(path, imageName) {
    Ok(data) => data,
    Err(_) => ""
  }
}

-- Read a ZIP entry by name, returning empty string on failure
export func readZipEntry(path: string, entryName: string) -> string ! {FS} {
  match readEntry(path, entryName) {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Find all header XML entries in the ZIP
export func findHeaderEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "word/header"),
    Err(_) => []
  }
}

-- Find all footer XML entries in the ZIP
export func findFooterEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "word/footer"),
    Err(_) => []
  }
}

-- Read the comments XML from a DOCX
export func readComments(path: string) -> string ! {FS} {
  match readEntry(path, "word/comments.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Read commentsExtended.xml from a DOCX (comment threading: which comment
-- replies to which, and whether a thread is marked resolved). Absent in
-- documents produced by older tools — an empty string is the normal "no
-- threading information" case, not an error.
export func readCommentsExtended(path: string) -> string ! {FS} {
  match readEntry(path, "word/commentsExtended.xml") {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- Find footnotes.xml if present
export func findFootnoteEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "word/footnotes"),
    Err(_) => []
  }
}

-- Find endnotes.xml if present
export func findEndnoteEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "word/endnotes"),
    Err(_) => []
  }
}

-- Filter entries that start with a given prefix
pure func filterByPrefix(entries: [string], prefix: string) -> [string] =
  match entries {
    [] => [],
    e :: rest =>
      if startsWith(e, prefix)
      then e :: filterByPrefix(rest, prefix)
      else filterByPrefix(rest, prefix)
  }

-- Find all slide entries in a PPTX ZIP, in PRESENTATION order.
--
-- The deck's order is ppt/presentation.xml's <p:sldIdLst>: each
-- <p:sldId r:id="rIdN"/> names a relationship in
-- ppt/_rels/presentation.xml.rels whose Target is the slide part. File names
-- are NOT the order — PowerPoint keeps slide7.xml as slide7.xml when the user
-- drags it to the front — and the ZIP directory order is whatever the writer
-- happened to emit. Filtering listEntries() with no ordering at all produced
-- 1,10,11,...,19,2,20,21,3,... on a real 21-slide deck.
--
-- When presentation.xml or its rels are missing or unparsable the fallback is
-- a NUMERIC sort on the number in the file name, never a lexicographic one.
export func findSlideEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => pptxOrderSlideEntries(
      readZipEntry(path, "ppt/presentation.xml"),
      readZipEntry(path, "ppt/_rels/presentation.xml.rels"),
      filterSlides(entries)),
    Err(_) => []
  }
}

-- Order slide parts: the ones presentation.xml lists, in its order, then any
-- slide part it does not list (an orphan left behind by a writer), numerically.
-- Orphans are kept rather than dropped so no text disappears silently; in a
-- well-formed deck there are none.
export pure func pptxOrderSlideEntries(presXml: string, relsXml: string, entries: [string]) -> [string]
{
  let listed = foldl(\acc p. if zipListHas(entries, p) && zipListHas(acc, p) == false
                            then concat(acc, [p]) else acc,
                     [], pptxPresentationSlidePaths(presXml, relsXml));
  let unlisted = filter(\e. zipListHas(listed, e) == false, entries);
  concat(listed, pptxSortNumerically(unlisted))
}

-- Inline tests cannot state a list as the expected value, so the ordering is
-- tested through this comma-joined view of it. The fixtures declare xmlns:p and
-- xmlns:r because std/xml drops an undeclared prefix ("p:sldId" -> "sldId").
pure func pptxOrderSlideEntriesJoined(presXml: string, relsXml: string, entries: [string]) -> string
  tests [
    -- presentation order wins over file numbering
    (("<p:presentation xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><p:sldIdLst><p:sldId id=\"256\" r:id=\"rId3\"/><p:sldId id=\"257\" r:id=\"rId2\"/></p:sldIdLst></p:presentation>",
      "<Relationships><Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide\" Target=\"slides/slide1.xml\"/><Relationship Id=\"rId3\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide\" Target=\"slides/slide2.xml\"/><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"slideMasters/slideMaster1.xml\"/></Relationships>",
      ["ppt/slides/slide1.xml", "ppt/slides/slide2.xml"]),
     "ppt/slides/slide2.xml,ppt/slides/slide1.xml"),
    -- no presentation.xml: numeric, not lexicographic
    (("", "", ["ppt/slides/slide10.xml", "ppt/slides/slide2.xml", "ppt/slides/slide1.xml"]),
     "ppt/slides/slide1.xml,ppt/slides/slide2.xml,ppt/slides/slide10.xml"),
    -- absolute target; unlisted orphan goes last
    (("<p:presentation xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><p:sldIdLst><p:sldId r:id=\"rId9\"/></p:sldIdLst></p:presentation>",
      "<Relationships><Relationship Id=\"rId9\" Type=\"x/relationships/slide\" Target=\"/ppt/slides/slide3.xml\"/></Relationships>",
      ["ppt/slides/slide1.xml", "ppt/slides/slide3.xml"]),
     "ppt/slides/slide3.xml,ppt/slides/slide1.xml")
  ]
{
  join(",", pptxOrderSlideEntries(presXml, relsXml, entries))
}

-- Slide part paths in <p:sldIdLst> order, resolved through the presentation
-- relationships. [] when either part is absent or unparsable.
pure func pptxPresentationSlidePaths(presXml: string, relsXml: string) -> [string] =
  if length(presXml) == 0 || length(relsXml) == 0 then []
  else match parseLenient(presXml) {
    Err(_) => [],
    Ok(pres) => match parseLenient(relsXml) {
      Err(_) => [],
      Ok(rels) => {
        let slideRels = filter(pptxIsSlideRel, findAll(rels, "Relationship"));
        let ids = match findFirst(pres, "p:sldIdLst") {
          Some(lst) => findAll(lst, "p:sldId"),
          None => []
        };
        flatMap(\sid. pptxPresTargetFor(slideRels, getOrElse(getAttr(sid, "r:id"), "")), ids)
      }
    }
  }

-- ".../relationships/slide" exactly — not slideMaster, slideLayout, notesSlide.
pure func pptxIsSlideRel(r: XmlNode) -> bool =
  endsWith(getOrElse(getAttr(r, "Type"), ""), "/slide")

pure func pptxPresTargetFor(rels: [XmlNode], rid: string) -> [string] =
  if length(rid) == 0 then []
  else map(\r. pptxResolvePresTarget(getOrElse(getAttr(r, "Target"), "")),
           filter(\r. getOrElse(getAttr(r, "Id"), "") == rid, rels))

-- Presentation relationship targets are relative to ppt/.
-- "slides/slide1.xml" -> "ppt/slides/slide1.xml"; "/ppt/slides/slide1.xml" -> "ppt/slides/slide1.xml"
pure func pptxResolvePresTarget(target: string) -> string =
  if startsWith(target, "/") then substring(target, 1, length(target))
  else "ppt/${target}"

pure func zipListHas(xs: [string], x: string) -> bool = any(\y. y == x, xs)

-- Sort part names by the integer in the file name ("slide10.xml" after
-- "slide9.xml"), falling back to the name itself to break ties.
export pure func pptxSortNumerically(entries: [string]) -> [string] =
  sortBy(pptxCompareByNumber, entries)

pure func pptxCompareByNumber(a: string, b: string) -> int {
  let na = pptxPartNumber(a);
  let nb = pptxPartNumber(b);
  if na < nb then -1 else if na > nb then 1 else compare(a, b)
}

-- "ppt/slides/slide12.xml" -> 12. The digits run from the first digit in the
-- base name up to ".xml". A name with no number sorts after every numbered one.
export pure func pptxPartNumber(entry: string) -> int
  tests [
    ("ppt/slides/slide12.xml", 12),
    ("ppt/notesSlides/notesSlide3.xml", 3),
    ("ppt/slides/slide.xml", 1000000000)
  ]
{
  let base = pptxBaseName(entry);
  let stem = if endsWith(base, ".xml") then substring(base, 0, length(base) - 4) else base;
  let digits = pptxTrailingDigits(stem, length(stem));
  match stringToInt(digits) {
    Some(n) => if length(digits) > 0 then n else 1000000000,
    None => 1000000000
  }
}

-- The run of digits at the end of s (s[0..i) considered)
pure func pptxTrailingDigits(s: string, i: int) -> string =
  if i <= 0 then substring(s, 0, length(s))
  else if contains("0123456789", substring(s, i - 1, i)) then pptxTrailingDigits(s, i - 1)
  else substring(s, i, length(s))

-- Filter entries to find slide XMLs: ppt/slides/slideN.xml only (not _rels,
-- not anything nested deeper)
pure func filterSlides(entries: [string]) -> [string] =
  filter(isSlideEntry, entries)

-- Check if an entry is a slide XML
pure func isSlideEntry(entry: string) -> bool {
  startsWith(entry, "ppt/slides/slide") &&
  endsWith(entry, ".xml") &&
  contains(substring(entry, 11, length(entry)), "/") == false
}

-- Find all notes slide entries in a PPTX ZIP (ppt/notesSlides/notesSlide*.xml),
-- numerically sorted. The parser does NOT use this to attach notes: a notes
-- part belongs to the slide whose relationships name it, and notesSlideN's
-- number need not match its slide's.
export func findNotesSlideEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => pptxSortNumerically(filter(isNotesSlideEntry, entries)),
    Err(_) => []
  }
}

-- Check if an entry is a notes slide XML
pure func isNotesSlideEntry(entry: string) -> bool {
  startsWith(entry, "ppt/notesSlides/notesSlide") &&
  endsWith(entry, ".xml")
}

-- Find all worksheet entries in an XLSX ZIP (xl/worksheets/sheet*.xml)
export func findSheetEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterSheets(entries),
    Err(_) => []
  }
}

-- Filter entries to find worksheet XMLs
pure func filterSheets(entries: [string]) -> [string] =
  match entries {
    [] => [],
    e :: rest =>
      if isSheetEntry(e)
      then e :: filterSheets(rest)
      else filterSheets(rest)
  }

-- Check if an entry is a worksheet XML
pure func isSheetEntry(entry: string) -> bool {
  startsWith(entry, "xl/worksheets/sheet") &&
  endsWith(entry, ".xml")
}

-- Find XLSX cell-comment parts. Excel normally writes xl/comments1.xml, but
-- some producers nest them as xl/comments/comment1.xml — both are in the wild,
-- so match on the prefix rather than an exact path.
export func findXlsxCommentEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "xl/comments"),
    Err(_) => []
  }
}

-- Find XLSX threaded-comment parts (modern Excel review threads)
export func findXlsxThreadedEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "xl/threadedComments/"),
    Err(_) => []
  }
}

-- Find xl/persons/*.xml — display names for threaded-comment authors
export func findXlsxPersonEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "xl/persons/"),
    Err(_) => []
  }
}

-- Find PPTX comment parts. Covers both the legacy per-slide
-- ppt/comments/comment1.xml and the modern ppt/comments/modernComment_*.xml
-- that current PowerPoint writes.
export func findPptxCommentEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterByPrefix(entries, "ppt/comments/"),
    Err(_) => []
  }
}

-- Read a slide's relationship part (ppt/slides/_rels/slideN.xml.rels).
-- Which comment part belongs to which slide is defined by these relationships,
-- not by the file numbering — matching "comment1.xml" to "slide1.xml" happens
-- to work for simple decks and silently mis-attributes on the rest.
export func readPptxSlideRels(path: string, slideEntry: string) -> string ! {FS} {
  let relsPath = pptxRelsPathFor(slideEntry);
  match readEntry(path, relsPath) {
    Ok(content) => content,
    Err(_) => ""
  }
}

-- "ppt/slides/slide3.xml" -> "ppt/slides/_rels/slide3.xml.rels"
export pure func pptxRelsPathFor(slideEntry: string) -> string {
  let base = pptxBaseName(slideEntry);
  if length(base) == 0 then ""
  else "ppt/slides/_rels/${base}.rels"
}

pure func pptxBaseName(entry: string) -> string {
  let parts = split(entry, "/");
  match parts {
    [] => "",
    _ => match listLast(parts) {
      Some(b) => b,
      None => ""
    }
  }
}

-- Resolve a relationship target relative to ppt/slides/ into a ZIP path.
-- "../comments/comment1.xml" -> "ppt/comments/comment1.xml"
export pure func pptxResolveTarget(target: string) -> string =
  if startsWith(target, "../") then "ppt/${substring(target, 3, length(target))}"
  else if startsWith(target, "/") then substring(target, 1, length(target))
  else "ppt/slides/${target}"

-- Read a binary ZIP entry by full path (format-agnostic image reading)
export func readImageEntry(path: string, entryPath: string) -> string ! {FS} {
  match readEntryBytes(path, entryPath) {
    Ok(data) => data,
    Err(_) => ""
  }
}

-- Find all media entries in the ZIP
export func findMediaEntries(path: string) -> [string] ! {FS} {
  match listEntries(path) {
    Ok(entries) => filterMedia(entries),
    Err(_) => []
  }
}

-- Filter entries to only media files
pure func filterMedia(entries: [string]) -> [string] =
  match entries {
    [] => [],
    e :: rest =>
      if isMediaEntry(e)
      then e :: filterMedia(rest)
      else filterMedia(rest)
  }

-- Check if a ZIP entry is a media file
-- A media file entry — but NOT the "word/media/" directory entry itself, which
-- ZIP listings include as a 0-byte name ending in "/". Without this guard the
-- directory was emitted as a phantom image with empty data and an octet-stream mime.
pure func isMediaEntry(entry: string) -> bool {
  endsWith(entry, "/") == false &&
  (contains(entry, "word/media/") ||
   contains(entry, "ppt/media/") ||
   contains(entry, "xl/media/"))
}

-- Determine the MIME type from a media filename.
-- Contract: result is a non-empty MIME string. The `ensures` form is omitted
-- because of ailang-core issue #236 (v0.19.2 property-test generator bug for
-- pure + string -> string + ensures).
export pure func mediaMimeType(filename: string) -> string
  tests [
    ("image1.png", "image/png"),
    ("image2.jpg", "image/jpeg"),
    ("image3.jpeg", "image/jpeg"),
    ("image4.gif", "image/gif"),
    ("image5.bmp", "image/bmp"),
    ("image6.tiff", "image/tiff"),
    ("image7.emf", "image/emf"),
    ("image8.wmf", "image/wmf"),
    ("image9.svg", "image/svg+xml"),
    ("image10.webp", "image/webp"),
    ("unknown.xyz", "application/octet-stream")
  ]
{
  if endsWith(filename, ".png") then "image/png"
  else if endsWith(filename, ".jpg") then "image/jpeg"
  else if endsWith(filename, ".jpeg") then "image/jpeg"
  else if endsWith(filename, ".gif") then "image/gif"
  else if endsWith(filename, ".bmp") then "image/bmp"
  else if endsWith(filename, ".tiff") then "image/tiff"
  else if endsWith(filename, ".emf") then "image/emf"
  else if endsWith(filename, ".wmf") then "image/wmf"
  -- svg/webp are what ODF actually ships; without them resolving an image
  -- downgrades the parser's own correct guess to application/octet-stream.
  else if endsWith(filename, ".svg") then "image/svg+xml"
  else if endsWith(filename, ".webp") then "image/webp"
  else "application/octet-stream"
}

-- Resolve image references in blocks to binary data from a ZIP file.
-- Walks blocks recursively (including SectionBlock children).
-- For each ImageBlock whose data looks like a ZIP path, reads the binary.
export func resolveBlockImages(zipPath: string, blocks: [Block]) -> [Block] ! {FS} =
  match blocks {
    [] => [],
    b :: rest => {
      let resolved = zipResolveOneBlock(zipPath, b);
      let moreResolved = resolveBlockImages(zipPath, rest);
      resolved :: moreResolved
    }
  }

-- Resolve a single block's image reference
func zipResolveOneBlock(zipPath: string, b: Block) -> Block ! {FS} =
  match b {
    ImageBlock(img) =>
      if zipIsZipPath(img.data) then {
        let imageData = readImageEntry(zipPath, img.data);
        let mime = if length(imageData) > 0 then mediaMimeType(img.data) else img.mime;
        mkImage(imageData, img.description, mime)
      } else b,
    SectionBlock(s) => {
      let resolvedInner = resolveBlockImages(zipPath, s.blocks);
      mkNamedSection(s.kind, s.name, resolvedInner)
    },
    _ => b
  }

-- Check if data looks like a ZIP-internal path (not base64, not URL, not empty)
pure func zipIsZipPath(data: string) -> bool {
  length(data) > 0 &&
  length(data) < 500 &&
  startsWith(data, "http://") == false &&
  startsWith(data, "https://") == false &&
  startsWith(data, "data:") == false &&
  (contains(data, "/") || contains(data, "."))
}

-- ============================================================
-- Temp-file image extraction (memory audit m-v1-memory-footprint, ask D3)
-- ============================================================
--
-- The Office parsers used to read every media entry straight into an
-- ImageBlock as base64 — a 4/3 blow-up on top of the raw bytes, held for the
-- document's lifetime and copied again by every downstream consumer. These
-- helpers instead write each image to a temp file and put the PATH in the
-- block (classifyImageSource reads it back as LocalFile, and mediaJsonFields
-- emits it as `src`); bytes re-enter memory only on demand, via
-- imageDataUriFromFile. A per-document cap on the decoded byte total bounds a
-- media-heavy (or malicious) archive to a typed error instead of unbounded
-- memory growth.

export type ImageExtractError
  = ImageCapExceeded({entry: string, capBytes: int, runningBytes: int})
  | ImageWriteFailed({entry: string, detail: string})

-- Cap on decoded image bytes per document. Also the de-facto per-image cap:
-- a single entry over the budget trips it immediately.
export pure func imageBytesCap() -> int = 67108864   -- 64 MiB

export pure func imageTempDir() -> string = "/tmp/docparse-images"

-- Temp file for one image: named by the SHA-256 of its decoded bytes.
--
-- The name used to be `docparse-img-${counter}` with the counter restarting at
-- 0 for every document, so two documents parsed in one batch, or concurrently
-- under serve-api, wrote the same paths and the earlier document's `src` ended
-- up naming the later document's image (G9, v0.47.0 partner follow-ups).
-- A content name cannot collide across different images, needs no effect
-- beyond FS (the CLI runs without Rand/Clock), and is deterministic: the same
-- image always gets the same path on every machine, so goldens are stable and
-- `shasum -a 256` of the file matches its name. Two documents holding the
-- same image share one file with identical bytes.
export pure func imageTempPath(tempDir: string, bytesSha256: string, entry: string) -> string =
  "${tempDir}/docparse-img-${bytesSha256}${mediaExtension(entry)}"

-- Human-readable form for warnings/notes. The parse functions return [Block]
-- and cannot surface the ADT itself without a breaking export change, so they
-- render the typed error through this.
export pure func imageExtractErrorText(e: ImageExtractError) -> string =
  match e {
    ImageCapExceeded(c) =>
      "Warning: image extraction stopped at ${c.entry} — ${show(c.runningBytes)} bytes of embedded images exceeds the ${show(c.capBytes)}-byte per-document cap; remaining media entries were not extracted",
    ImageWriteFailed(w) =>
      "Warning: could not write image temp file for ${w.entry}: ${w.detail}"
  }

export type MediaFiles = {
  blocks: [Block],      -- one ImageBlock per media entry, data = temp path
  bytesWritten: int,    -- decoded bytes written under tempDir
  fileCount: int
}

-- Extract media entries to temp files, one ImageBlock per entry whose `data`
-- holds the temp file PATH. Fails with a typed Err once the running decoded
-- total would exceed imageBytesCap().
export func extractMediaToFiles(zipPath: string, entries: [string], tempDir: string)
  -> Result[MediaFiles, ImageExtractError] ! {FS} = {
  match mkdirAllResult(tempDir) {
    Err(msg) => Err(ImageWriteFailed({entry: tempDir, detail: msg})),
    Ok(_) => mediaToFilesFrom(zipPath, entries, tempDir, 0, [], 0, 0)
  }
}

func mediaToFilesFrom(zipPath: string, entries: [string], tempDir: string,
                      counter: int, acc: [Block], bytesSoFar: int, files: int)
  -> Result[MediaFiles, ImageExtractError] ! {FS} =
  match entries {
    [] => Ok({blocks: reverse(acc), bytesWritten: bytesSoFar, fileCount: files}),
    entry :: rest => {
      let b64 = readImageEntry(zipPath, entry);
      let mime = mediaMimeType(entry);
      if length(b64) == 0
        -- Read failure keeps the historical shape: an empty-data block, not a
        -- hole in the list — and it does not count against the cap.
      then mediaToFilesFrom(zipPath, rest, tempDir, counter,
                            mkImage("", "", mime) :: acc, bytesSoFar, files)
      else {
        -- Raw size estimated from the base64 length (ceil(n*3/4)) and checked
        -- BEFORE decoding, so an oversized entry costs nothing to reject.
        let rawLen = (length(b64) * 3) / 4;
        if bytesSoFar + rawLen > imageBytesCap()
        then Err(ImageCapExceeded({entry: entry, capBytes: imageBytesCap(),
                                   runningBytes: bytesSoFar + rawLen}))
        else {
          match fromBase64(b64) {
            Some(bytes) => {
              let path = imageTempPath(tempDir, sha256Bytes(bytes), entry);
              -- Write beside the target, then rename over it: a reader of
              -- `path` sees either no file or the whole image, never a
              -- half-written one while another parse writes the same bytes.
              -- The part name is unique per (source document, entry index),
              -- so concurrent writers of a shared image use different parts.
              let part = "${path}.${substring(sha256Hex(zipPath), 0, 16)}-${show(counter)}.part";
              writeFileBytes(part, bytes);
              match renameFileResult(part, path) {
                Err(msg) => Err(ImageWriteFailed({entry: entry, detail: msg})),
                Ok(_) =>
                  mediaToFilesFrom(zipPath, rest, tempDir, counter + 1,
                                   mkImage(path, "", mime) :: acc,
                                   bytesSoFar + rawLen, files + 1)
              }
            },
            -- Not valid base64: keep the empty-data block rather than failing
            -- the whole document over one corrupt entry.
            None => mediaToFilesFrom(zipPath, rest, tempDir, counter,
                                     mkImage("", "", mime) :: acc, bytesSoFar, files)
          }
        }
      }
    }
  }

-- "word/media/image1.png" -> ".png". Extension-less names get ".bin" so the
-- temp file still carries a usable name for mime-sniffing consumers.
pure func mediaExtension(filename: string) -> string {
  let parts = split(filename, "/");
  match listLast(parts) {
    Some(base) => {
      let segs = split(base, ".");
      if listLength(segs) < 2 then ".bin"
      else match listLast(segs) {
        Some(ext) => ".${ext}",
        None => ".bin"
      }
    },
    None => ".bin"
  }
}

-- Inline bytes ON DEMAND, at output time. Nothing in the parse path calls
-- this: the point of the temp-file layout is that a document's images never
-- sit in memory as base64. A caller that genuinely needs a data: URI (an SDK
-- response shape that promises inline bytes) reads the file back here, per
-- image, at the moment it serialises.
export func imageDataUriFromFile(path: string, mime: string) -> Result[string, string] ! {FS} =
  match readFileBytes(path) {
    Ok(b64) => Ok("data:${mime};base64,${b64}"),
    Err(msg) => Err(msg)
  }
