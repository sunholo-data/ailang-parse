module docparse/services/a2ui_formatter

-- A2UI Output Formatter
--
-- Converts AILANG Parse Block ADT to A2UI component JSON for cross-platform
-- rendering. Uses the sunholo/a2ui package for component builders and
-- JSON serialization.
--
-- The output is a flat adjacency-list JSON array where each element is a
-- component node. SectionBlocks are flattened: the section becomes a
-- container with child IDs, and children are emitted as top-level siblings.
--
-- Usage:
--   import docparse/services/a2ui_formatter (documentToA2UI)

import std/json (encode, decode, ja, js, jo, kv, jnum, jb, getString, getInt, getBool, getArray, asArray, asString, getStringArrayOrEmpty)
import std/string (join, length)
import std/list (map, foldl, concat, length as listLength, flatMap)
import std/math (intToFloat)
import std/option (getOrElse)
import pkg/sunholo/a2ui/components (A2UINode, A2UIProp, prop, a2uiContainer, a2uiLabeledContainer, a2uiHeading, a2uiText, a2uiPlainText, a2uiTable, a2uiList, a2uiImageRef, a2uiMedia, a2uiCalloutMeta, a2uiKeyValue, a2uiDivider, renderA2UI, a2uiTextField, a2uiHeadingField, a2uiTableEditable, a2uiListEditable)
import docparse/types/document (InlineRun, mkHeadingRuns, mkListRuns, mkTextRuns, mkHeading, mkList, mkText, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, ParsedDocument, DocMetadata, emptyMetadata, countBlocks, filterHeadings, filterTables, filterImages, mkImage, mkTable, mkNamedSection)

-- Convert a full ParsedDocument to A2UI JSON string.
-- When editable=true, content nodes use editable component variants
-- (text-field, heading-field, table-editable, list-editable) and every
-- content node carries a block_index prop for edit delta correlation.
export pure func documentToA2UI(doc: ParsedDocument, editable: bool) -> string {
  let metaNodes = a2uiMetadataNodes(doc.metadata, doc.format, doc.filename);
  let blockResult = a2uiFlattenBlocks(doc.blocks, 0, editable);
  let blockNodes = blockResult.nodes;
  let topIds = blockResult.topIds;
  let metaIds = map(\n. n.id, metaNodes);
  let allChildIds = concat(metaIds, topIds);
  let root = a2uiContainer("doc", allChildIds);
  let allNodes = concat([root], concat(metaNodes, blockNodes));
  renderA2UI(allNodes)
}

-- Convert blocks to A2UI nodes (for partial rendering without metadata)
export pure func blocksToA2UINodes(blocks: [Block], editable: bool) -> [A2UINode] {
  let result = a2uiFlattenBlocks(blocks, 0, editable);
  result.nodes
}

-- Internal: result of flattening blocks.
-- editable is threaded through the accumulator so a2uiFlattenOne can be
-- passed directly to foldl without changing its binary (acc, item) signature.
type FlatResult = {
  nodes: [A2UINode],
  topIds: [string],
  nextIdx: int,
  editable: bool
}

-- Flatten a list of blocks into A2UI nodes with sequential IDs.
-- SectionBlocks become containers; their children are emitted at the top level.
pure func a2uiFlattenBlocks(blocks: [Block], startIdx: int, editable: bool) -> FlatResult {
  foldl(a2uiFlattenOne, {nodes: [], topIds: [], nextIdx: startIdx, editable: editable}, blocks)
}

-- Flatten one block, accumulating into FlatResult.
-- Adds a block_index prop to every content node so frontends can correlate
-- edit events back to the originating Block at that position.
pure func a2uiFlattenOne(acc: FlatResult, block: Block) -> FlatResult {
  let idx = acc.nextIdx;
  let editable = acc.editable;
  let id = "b_${show(idx)}";
  match block {
    SectionBlock(s) => {
      -- Recursively flatten child blocks (preserve editable flag)
      let childResult = a2uiFlattenBlocks(s.blocks, idx + 1, editable);
      let childIds = childResult.topIds;
      -- Label with the container's own name when it has one (sheet, slide,
      -- chapter); the kind alone renders every sheet as "sheet".
      let sectionLabel = if length(s.name) > 0 then "${s.kind}: ${s.name}" else s.kind;
      let baseSection = a2uiLabeledContainer(id, sectionLabel, childIds);
      let sectionNode = if editable then a2uiFmtr_withBlockIndex(baseSection, idx) else baseSection;
      {
        nodes: concat(concat(acc.nodes, [sectionNode]), childResult.nodes),
        topIds: concat(acc.topIds, [id]),
        nextIdx: childResult.nextIdx,
        editable: editable
      }
    },
    _ => {
      let baseNode = a2uiBlockToNode(id, block, editable);
      let node = if editable then a2uiFmtr_withBlockIndex(baseNode, idx) else baseNode;
      {
        nodes: concat(acc.nodes, [node]),
        topIds: concat(acc.topIds, [id]),
        nextIdx: idx + 1,
        editable: editable
      }
    }
  }
}

-- Append a block_index prop to a node (prefixed to avoid cross-module name collision)
pure func a2uiFmtr_withBlockIndex(node: A2UINode, idx: int) -> A2UINode =
  {id: node.id, nodeType: node.nodeType, children: node.children,
   props: concat(node.props, [prop("block_index", show(idx))])}

-- Convert a single non-section Block to an A2UINode.
-- When editable=true, text/heading/table/list use their editable variants.
-- Image, audio, video, change, and section nodes are always read-only.
pure func a2uiBlockToNode(id: string, block: Block, editable: bool) -> A2UINode =
  match block {
    HeadingBlock(h) =>
      if editable then a2uiHeadingField(id, h.text, h.level)
      else a2uiHeading(id, h.text, h.level),
    TextBlock(t) =>
      if editable then a2uiTextField(id, t.text, t.style)
      else a2uiText(id, t.text, t.style),
    TableBlock(t) =>
      if editable then a2uiTableEditable(id, a2uiCellsToJsonStr(t.headers), a2uiRowsToJsonStr(t.rows))
      else a2uiTable(id, a2uiCellsToJsonStr(t.headers), a2uiRowsToJsonStr(t.rows)),
    ListBlock(l) =>
      if editable then a2uiListEditable(id, a2uiItemsToJsonStr(l.items), l.ordered)
      else a2uiList(id, a2uiItemsToJsonStr(l.items), l.ordered),
    ImageBlock(i) =>
      a2uiImageRef(id, i.description, i.mime),
    AudioBlock(a) =>
      a2uiMedia(id, "audio", a.transcription, a.mime),
    VideoBlock(v) =>
      a2uiMedia(id, "video", v.description, v.mime),
    ChangeBlock(c) =>
      a2uiCalloutMeta(id, c.changeType, c.text,
        encode(jo([kv("author", js(c.author)), kv("date", js(c.date))]))),
    LinkBlock(l) =>
      a2uiCalloutMeta(id, "link", l.text,
        encode(jo([kv("href", js(l.href)), kv("title", js(l.title))]))),
    CommentBlock(c) =>
      a2uiCalloutMeta(id, "comment", c.text,
        encode(jo([kv("author", js(c.author)), kv("date", js(c.date)),
                   kv("anchorText", js(c.anchorText)), kv("anchored", jb(c.anchored))]))),
    SectionBlock(_) =>
      -- Should not reach here (handled in a2uiFlattenOne)
      a2uiPlainText(id, "[section]")
  }

-- ============================================================
-- JSON encoding helpers for table/list data in props
-- ============================================================

-- Encode table headers (list of TableCells) as a JSON array string
pure func a2uiCellsToJsonStr(cells: [TableCell]) -> string {
  encode(ja(map(a2uiCellToJson, cells)))
}

-- Encode a single cell, including span info if merged
pure func a2uiCellToJson(cell: TableCell) -> Json {
  if cell.colSpan == 1 && not cell.merged
  then js(cell.text)
  else jo([
    kv("text", js(cell.text)),
    kv("colSpan", jnum(intToFloat(cell.colSpan))),
    kv("merged", if cell.merged then js("true") else js("false"))
  ])
}

-- Encode table rows as a JSON array of arrays string
pure func a2uiRowsToJsonStr(rows: [[TableCell]]) -> string {
  encode(ja(map(\row. ja(map(a2uiCellToJson, row)), rows)))
}

-- Encode list items as a JSON array string
pure func a2uiItemsToJsonStr(items: [string]) -> string {
  encode(ja(map(js, items)))
}

-- ============================================================
-- Metadata panel
-- ============================================================

-- Generate A2UI nodes for document metadata
pure func a2uiMetadataNodes(meta: DocMetadata, format: string, filename: string) -> [A2UINode] {
  let nodes = [a2uiKeyValue("meta_format", "Format", format)];
  let nodes2 = if length(meta.title) > 0
    then concat(nodes, [a2uiKeyValue("meta_title", "Title", meta.title)])
    else nodes;
  let nodes3 = if length(meta.author) > 0
    then concat(nodes2, [a2uiKeyValue("meta_author", "Author", meta.author)])
    else nodes2;
  let nodes4 = if length(meta.created) > 0
    then concat(nodes3, [a2uiKeyValue("meta_created", "Created", meta.created)])
    else nodes3;
  if meta.pageCount > 0
    then concat(nodes4, [a2uiKeyValue("meta_pages", "Pages", show(meta.pageCount))])
    else nodes4
}

-- ============================================================
-- JSON → Block ADT decoder (inverse of output_formatter.blockToJson)
-- Used by the WASM browser demo to convert block JSON back to
-- Block ADT for A2UI conversion, eliminating the duplicate JS impl.
-- ============================================================

-- Decode a JSON string of block array into Block ADT values, then convert to A2UI.
-- This is the bridge function called from docparse_browser.ail in WASM.
export pure func convertBlocksJsonToA2UI(blocksJson: string) -> string {
  match decode(blocksJson) {
    Ok(json) => {
      let blocks = a2ui_jsonToBlockList(json);
      let doc = {format: "", filename: "", metadata: emptyMetadata(), blocks: blocks};
      documentToA2UI(doc, false)
    },
    Err(_) => "[]"
  }
}

-- Decode a Json value (array) into a list of Blocks
export pure func a2ui_jsonToBlockList(jsonVal: Json) -> [Block] {
  match asArray(jsonVal) {
    Some(arr) => map(a2ui_jsonToBlock, arr),
    None => []
  }
}

-- Decode a list of Json values into Blocks (for recursive SectionBlock use)
pure func a2ui_jsonArrayToBlocks(arr: [Json]) -> [Block] =
  map(a2ui_jsonToBlock, arr)

-- Inline formatting must survive a JSON round-trip, or every consumer that
-- rebuilds blocks from JSON silently flattens the document. That includes
-- browser-side generation, which parses to JSON and generates from it.
pure func a2ui_jsonToRuns(j: Json, key: string) -> [InlineRun] =
  a2ui_jsonArrayToRuns(getOrElse(getArray(j, key), []))

pure func a2ui_jsonArrayToRuns(arr: [Json]) -> [InlineRun] =
  map(a2ui_jsonToRun, arr)

pure func a2ui_jsonToRun(j: Json) -> InlineRun = {
  text: getOrElse(getString(j, "text"), ""),
  bold: getOrElse(getBool(j, "bold"), false),
  italic: getOrElse(getBool(j, "italic"), false),
  underline: getOrElse(getBool(j, "underline"), false),
  strike: getOrElse(getBool(j, "strike"), false),
  code: getOrElse(getBool(j, "code"), false),
  href: getOrElse(getString(j, "href"), ""),
  vertAlign: getOrElse(getString(j, "vertAlign"), "")
}

-- Decode a single Json object into a Block ADT value
pure func a2ui_jsonToBlock(j: Json) -> Block {
  let t = getOrElse(getString(j, "type"), "text");
  if t == "heading" then
    mkHeadingRuns(
      getOrElse(getString(j, "text"), ""),
      getOrElse(getInt(j, "level"), 1),
      a2ui_jsonToRuns(j, "runs")
    )
  else if t == "table" then
    mkTable(
      a2ui_jsonToCellRows(getOrElse(getArray(j, "rows"), [])),
      a2ui_jsonToCells(getOrElse(getArray(j, "headers"), []))
    )
  else if t == "list" then
    mkListRuns(
      getStringArrayOrEmpty(j, "items"),
      getOrElse(getBool(j, "ordered"), false),
      map(\ir. a2ui_jsonArrayToRuns(getOrElse(asArray(ir), [])),
          getOrElse(getArray(j, "itemRuns"), []))
    )
  else if t == "image" then
    -- `data` is the base64 payload. Discarding it here meant every JSON -> blocks
    -- round-trip silently dropped the picture itself, keeping only its
    -- description and mime — the same shape of loss the runs fields had.
    mkImage(getOrElse(getString(j, "data"), ""),
            getOrElse(getString(j, "description"), ""),
            getOrElse(getString(j, "mime"), ""))
  else if t == "audio" then
    AudioBlock({
      data: "",
      transcription: getOrElse(getString(j, "transcription"), ""),
      mime: getOrElse(getString(j, "mime"), "")
    })
  else if t == "video" then
    VideoBlock({
      data: "",
      description: getOrElse(getString(j, "description"), ""),
      mime: getOrElse(getString(j, "mime"), "")
    })
  else if t == "section" then
    mkNamedSection(
      getOrElse(getString(j, "kind"), ""),
      getOrElse(getString(j, "name"), ""),
      a2ui_jsonArrayToBlocks(getOrElse(getArray(j, "blocks"), []))
    )
  else if t == "change" then
    ChangeBlock({
      changeType: getOrElse(getString(j, "changeType"), ""),
      author: getOrElse(getString(j, "author"), ""),
      date: getOrElse(getString(j, "date"), ""),
      text: getOrElse(getString(j, "text"), "")
    })
  else
    mkTextRuns(
      getOrElse(getString(j, "text"), ""),
      getOrElse(getString(j, "style"), ""),
      getOrElse(getInt(j, "level"), 0),
      a2ui_jsonToRuns(j, "runs")
    )
}

-- Decode table cells. Compact form: just a string. Expanded form: {text, colSpan, merged}.
pure func a2ui_jsonToCells(arr: [Json]) -> [TableCell] =
  map(a2ui_jsonToCell, arr)

pure func a2ui_jsonToCell(j: Json) -> TableCell {
  match asString(j) {
    Some(s) => {text: s, colSpan: 1, rowSpan: 1, merged: false, scope: ""},
    None => {
      text: getOrElse(getString(j, "text"), ""),
      colSpan: getOrElse(getInt(j, "colSpan"), 1),
      rowSpan: getOrElse(getInt(j, "rowSpan"), 1),
      merged: getOrElse(getBool(j, "merged"), false),
      scope: getOrElse(getString(j, "scope"), "")
    }
  }
}

pure func a2ui_jsonToCellRows(arr: [Json]) -> [[TableCell]] =
  map(\row. match asArray(row) {
    Some(cells) => a2ui_jsonToCells(cells),
    None => []
  }, arr)
