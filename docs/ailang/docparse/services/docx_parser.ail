module docparse/services/docx_parser

import std/xml (parseLenient, findAll, findFirst, getText, getAttr, getChildren, getTag, findAllAttrs)
import std/option (Some, None, flatMap as optFlatMap, map as optMap, getOrElse)
import std/result (Ok, Err)
import std/string (contains, length, trim, stringToInt, join, charCode, chars, substring)
import std/map (empty as emptyMap, fromList as mapFromList, lookup as mapLookup, member as mapMember, insert as mapInsert)
import std/list (map, flatMap, any, concat, length as listLength, filter, reverse, last, dedup)
import docparse/types/document (mkHeading, mkHeadingRuns, mkList, mkListRuns, mkListNested, mkText, mkTextRuns, mkNamedSection, plainRun, InlineRun, Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, ChangeBlock, CommentBlock, TableCell, DocMetadata, emptyMetadata, simpleCell, mergedCell, spanCell, mkImage, mkTable, mkAnchoredComment, mkUnanchoredComment, mkSection)
import docparse/services/zip_extract (readDocxContent, readCoreProperties, readAppProperties, readDocxRelationships, readDocxNumbering, readDocxStyles, findMediaEntries, readEmbeddedImage, mediaMimeType, findHeaderEntries, findFooterEntries, readZipEntry, findFootnoteEntries, findEndnoteEntries, readComments, readCommentsExtended, extractMediaToFiles, imageTempDir, imageExtractErrorText)
import docparse/services/omml (renderOmml)
import docparse/services/colour (normaliseHex)

-- DOCX Parser
-- Parses Word document XML into a list of content Blocks.
--
-- DOCX XML structure (word/document.xml):
--   <w:document>
--     <w:body>
--       <w:p>            -- paragraph
--         <w:pPr>        -- paragraph properties
--           <w:pStyle w:val="Heading1"/>
--           <w:numPr/>   -- numbering (lists)
--         </w:pPr>
--         <w:r>          -- run (text with formatting)
--           <w:rPr/>     -- run properties (bold, italic, etc.)
--           <w:t>text</w:t>
--         </w:r>
--       </w:p>
--       <w:tbl>          -- table
--         <w:tr>         -- row
--           <w:tc>       -- cell
--             <w:p>...</w:p>
--           </w:tc>
--         </w:tr>
--       </w:tbl>
--     </w:body>
--   </w:document>
--
-- Run: ailang run --entry main --caps IO,FS docparse/main.ail

-- Parse a DOCX file into content blocks
export func parseDocx(filepath: string) -> [Block] ! {FS} {
  let xml = readDocxContent(filepath);
  let rels = docxLoadRels(filepath);
  let nums = docxLoadNumberingContext(filepath);
  let hlevels = docxLoadHeadingLevels(filepath);
  match parseLenient(xml) {
    Ok(root) => concat(extractBodyBlocksWithNums(root, rels, nums),
                       docxPartWarnings(root, readDocxStyles(filepath),
                                        listLength(findFootnoteEntries(filepath)) > 0)),
    Err(e) => [mkText("XML parse error: ${e}", "error", 0)]
  }
}

-- Numbering definitions and style-level numbering, parsed once per document
-- and threaded through the otherwise-pure walk — the same shape docxLoadRels
-- uses for hyperlink targets. Empty map (neither part present) = every lookup
-- falls back to the legacy numId != "1" convention, which is what those
-- documents always got.
func docxLoadNumberingContext(filepath: string) -> Map[string, string] ! {FS} =
  docxNumberingContext(readDocxNumbering(filepath), readDocxStyles(filepath))

-- Custom heading styles resolved to levels, parsed once per document
-- (P1: a style like ChapterTitle basedOn Heading1 is a level-1 heading, and
-- every consumer of the outline should see it as one).
func docxLoadHeadingLevels(filepath: string) -> Map[string, int] ! {FS} =
  docxStyleHeadingLevels(readDocxStyles(filepath))

-- === Custom heading styles (ECMA-376 §17.7 styles.xml) ===================
--
-- A custom style like ChapterTitle defined with basedOn Heading1 IS a heading:
-- Word shows it in the navigation pane, and the outline is what consumers of
-- this parser's blocks actually read. Without resolving the chain, such a
-- paragraph comes back as a text block with style="ChapterTitle" and every
-- outline silently misses it.
--
-- Resolution, in priority order for a paragraph:
--   1. the paragraph's own w:pPr/w:outlineLvl (a direct outline level);
--   2. the pStyle's built-in level (styleId Heading1..6, Title, Subtitle);
--   3. the style's own w:outlineLvl in styles.xml (0-based; 9 means body text);
--   4. the basedOn chain walked with a cycle guard, taking the nearest
--      ancestor with an outline level or a built-in heading name.
-- The original style name is kept on the emitted block either way.

-- The resolved level for every paragraph style defined in styles.xml.
-- Empty input (no styles part) yields an empty map: every paragraph then
-- resolves exactly as it did before style resolution existed.
export pure func docxStyleHeadingLevels(stylesXml: string) -> Map[string, int] =
  if length(stylesXml) == 0 then emptyMap()
  else match parseLenient(stylesXml) {
    Ok(root) => {
      let styles = findAll(root, "w:style");
      let basedOn = mapFromList(flatMap(docxStyleBasedOnEntry, styles));
      let outline = mapFromList(flatMap(docxStyleOutlineEntry, styles));
      mapFromList(flatMap(\sid. docxLevelEntry(sid, basedOn, outline),
                          docxDefinedStyleIds(styles)))
    },
    Err(_) => emptyMap()
  }

-- styleIds of the styles defined in styles.xml (the w:styleId attribute).
pure func docxDefinedStyleIds(styles: [XmlNode]) -> [string] =
  flatMap(\s. match getAttr(s, "w:styleId") { Some(sid) => [sid], None => [] }, styles)

pure func docxLevelEntry(sid: string, basedOn: Map[string, string], outline: Map[string, string])
    -> [(string, int)] =
  [(sid, docxResolveHeadingLevel(sid, basedOn, outline, 0))]

-- basedOn edge for one style: (styleId, parentStyleId)
pure func docxStyleBasedOnEntry(style: XmlNode) -> [(string, string)] =
  match getAttr(style, "w:styleId") {
    Some(sid) =>
      match optFlatMap(\b. getAttr(b, "w:val"), findFirst(style, "w:basedOn")) {
        Some(parent) => [(sid, parent)],
        None => []
      },
    None => []
  }

-- Own outlineLvl for one style, RAW (0-based, 9 = body text; absent = inherit)
pure func docxStyleOutlineEntry(style: XmlNode) -> [(string, string)] =
  match getAttr(style, "w:styleId") {
    Some(sid) =>
      match optFlatMap(\ol. getAttr(ol, "w:val"),
                       optFlatMap(\ppr. findFirst(ppr, "w:outlineLvl"),
                                  findFirst(style, "w:pPr"))) {
        Some(v) => [(sid, v)],
        None => []
      },
    None => []
  }

-- Resolve one styleId to a heading level (0 = not a heading).
-- depth bounds the basedOn walk: a cycle (A basedOn B basedOn A) or a chain
-- longer than 16 resolves to 0 rather than hanging the parser.
pure func docxResolveHeadingLevel(sid: string, basedOn: Map[string, string],
                                  outline: Map[string, string], depth: int) -> int {
  if length(sid) == 0 || depth > 16 then 0
  else {
    let builtin = headingLevelFromStyle(sid);
    if builtin > 0 then builtin
    else match mapLookup(outline, sid) {
      -- The style declares its own outline level; it wins over the chain.
      -- outlineLvl 9 (and anything unparsable) means body text.
      Some(v) => docxOutlineLevel(v),
      None => match mapLookup(basedOn, sid) {
        Some(parent) => docxResolveHeadingLevel(parent, basedOn, outline, depth + 1),
        None => 0
      }
    }
  }
}

-- w:outlineLvl val -> heading level: 0-based 0..5 map to H1..H6, 6..8 clamp
-- to H6, 9+ is body text.
pure func docxOutlineLevel(v: string) -> int =
  match stringToInt(v) {
    Some(n) => if n <= 5 then n + 1 else if n <= 8 then 6 else 0,
    None => 0
  }

-- A paragraph's own w:pPr/w:outlineLvl, as a heading level (0 = none)
pure func docxParaOutlineLevel(p: XmlNode) -> int =
  match optFlatMap(\ol. getAttr(ol, "w:val"),
                   optFlatMap(\ppr. findFirst(ppr, "w:outlineLvl"),
                              findFirst(p, "w:pPr"))) {
    Some(v) => docxOutlineLevel(v),
    None => 0
  }

-- The heading level for a paragraph: built-in style name, then its own
-- outlineLvl, then the style's resolved level.
pure func docxParaHeadingLevel(style: string, p: XmlNode, hlevels: Map[string, int]) -> int {
  let byName = headingLevelFromStyle(style);
  if byName > 0 then byName
  else {
    let direct = docxParaOutlineLevel(p);
    if direct > 0 then direct
    else getOrElse(mapLookup(hlevels, style), 0)
  }
}

-- === Hyperlink targets (ECMA-376 §17.16.22) ==============================
--
-- A <w:hyperlink> carries only r:id; the URL lives in
-- word/_rels/document.xml.rels. Resolving it needs FS, so the map is read once
-- in parseDocx and threaded through the otherwise-pure walk — the same shape
-- odt_parser uses for its automatic styles.
--
-- Deleted by e9de665 along with the rest of the rels subsystem, which left
-- readDocxRelationships imported but never called. Without it a link reads
-- "Sunholo Homepage" and the target is simply gone.
func docxLoadRels(filepath: string) -> Map[string, string] ! {FS} {
  let xml = readDocxRelationships(filepath);
  if length(xml) == 0 then emptyMap()
  else match parseLenient(xml) {
    Ok(root) => docxParseRels(root),
    Err(_) => emptyMap()
  }
}

pure func docxParseRels(root: XmlNode) -> Map[string, string] =
  mapFromList(flatMap(docxExtractHyperlinkRel, findAll(root, "Relationship")))

-- Only hyperlink relationships matter here; images and styles resolve elsewhere.
pure func docxExtractHyperlinkRel(rel: XmlNode) -> [(string, string)] {
  let relType = getOrElse(getAttr(rel, "Type"), "");
  if contains(relType, "hyperlink")
  then [(getOrElse(getAttr(rel, "Id"), ""), getOrElse(getAttr(rel, "Target"), ""))]
  else []
}

pure func docxRelTarget(rels: Map[string, string], rId: string) -> string =
  getOrElse(mapLookup(rels, rId), "")

-- Rendered as "text (url)", matching how this parser has always surfaced a
-- link target inline rather than as a separate block.
pure func docxHyperlinkSuffixRuns(node: XmlNode, rels: Map[string, string]) -> [InlineRun] {
  let suffix = docxHyperlinkSuffix(node, rels);
  if length(suffix) > 0 then [plainRun(suffix)] else []
}

-- Only when the link HAS text. A <w:hyperlink> can wrap an image instead
-- (pandoc_inline_images.docx links an identicon), and appending a bare URL
-- where there is no anchor text injects it mid-sentence:
-- "Here is one that (http://www.google.com) links."
pure func docxHyperlinkSuffix(node: XmlNode, rels: Map[string, string]) -> string {
  let url = docxRelTarget(rels, getOrElse(getAttr(node, "r:id"), ""));
  if length(url) > 0 && length(extractNestedRunText(node)) > 0
  then " (${url})"
  else ""
}

-- Extract metadata from a DOCX file
export func parseDocxMetadata(filepath: string) -> DocMetadata ! {FS} {
  let coreXml = readCoreProperties(filepath);
  match parseLenient(coreXml) {
    Ok(root) => extractMetadata(root),
    Err(_) => emptyMetadata()
  }
}

-- Extract images from a DOCX file
export func parseDocxImages(filepath: string) -> [Block] ! {FS} {
  let mediaEntries = findMediaEntries(filepath);
  extractImages(filepath, mediaEntries)
}

-- Extract headers from a DOCX file
export func parseDocxHeaders(filepath: string) -> [Block] ! {FS} {
  let entries = findHeaderEntries(filepath);
  parseSectionEntries(filepath, entries, "header")
}

-- Extract footers from a DOCX file
export func parseDocxFooters(filepath: string) -> [Block] ! {FS} {
  let entries = findFooterEntries(filepath);
  parseSectionEntries(filepath, entries, "footer")
}

-- Extract footnotes from a DOCX file
export func parseDocxFootnotes(filepath: string) -> [Block] ! {FS} {
  let entries = findFootnoteEntries(filepath);
  parseSectionEntries(filepath, entries, "footnote")
}

-- Extract endnotes from a DOCX file
export func parseDocxEndnotes(filepath: string) -> [Block] ! {FS} {
  let entries = findEndnoteEntries(filepath);
  parseSectionEntries(filepath, entries, "endnote")
}

-- Parse a list of ZIP entries as section blocks
func parseSectionEntries(filepath: string, entries: [string], kind: string) -> [Block] ! {FS} =
  match entries {
    [] => [],
    entry :: rest => {
      let xml = readZipEntry(filepath, entry);
      let blocks = parseSectionXml(xml);
      let moreBlocks = parseSectionEntries(filepath, rest, kind);
      if hasContent(blocks)
      then {
        let section = mkSection(kind, blocks);
        section :: moreBlocks
      }
      else moreBlocks
    }
  }

-- Parse XML from a header/footer/footnote part into blocks
-- Headers, footers, footnotes and endnotes each have their own rels part
-- (word/_rels/headerN.xml.rels …) which is not loaded, so hyperlink targets
-- inside them stay unresolved rather than being resolved against the wrong map.
--
-- Footnotes and endnotes wrap each note in a w:footnote / w:endnote element,
-- which is NOT a body node — without unwrapping it, every note parsed to zero
-- blocks and its text was silently dropped. The separator/continuation notes
-- (w:type="separator" / "continuationSeparator") carry no text and are
-- skipped; they are Word's rendering furniture, not content.
export pure func parseSectionXml(xml: string) -> [Block] {
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => {
      let children = getChildren(root);
      processBodyChildren(docxUnwrapNoteChildren(children), emptyMap(), emptyMap(), emptyMap())
    },
    Err(_) => []
  }
}

-- Unwrap w:footnote / w:endnote wrappers into their body nodes. Anything else
-- (a header's w:p children) passes through untouched.
pure func docxUnwrapNoteChildren(nodes: [XmlNode]) -> [XmlNode] =
  flatMap(docxUnwrapNoteNode, nodes)

pure func docxUnwrapNoteNode(node: XmlNode) -> [XmlNode] {
  let tag = getTag(node);
  if tag == "w:footnote" || tag == "w:endnote" then
    if isNoteSeparatorType(node) then []
    else getChildren(node)
  else [node]
}

pure func isNoteSeparatorType(node: XmlNode) -> bool =
  let t = getOrElse(getAttr(node, "w:type"), "") in
  t == "separator" || t == "continuationSeparator"
-- Check if a block list has any non-empty content
export pure func hasContent(blocks: [Block]) -> bool =
  any(blockHasContent, blocks)

-- Check if a single block has meaningful content
pure func blockHasContent(b: Block) -> bool =
  match b {
    TextBlock(t) => length(trim(t.text)) > 0,
    HeadingBlock(h) => length(trim(h.text)) > 0,
    TableBlock(_) => true,
    ListBlock(_) => true,
    ImageBlock(_) => true,
    SectionBlock(s) => hasContent(s.blocks),
    ChangeBlock(c) => length(trim(c.text)) > 0,
    _ => true
  }

-- Navigate to w:body and extract blocks from its children
-- Kept at this arity for docparse_browser, which parses a bare document.xml
-- with no access to the ZIP's rels part.
export pure func extractBodyBlocks(root: XmlNode) -> [Block] =
  extractBodyBlocksWithRels(root, emptyMap())

export pure func extractBodyBlocksWithRels(root: XmlNode, rels: Map[string, string]) -> [Block] =
  extractBodyBlocksWithNums(root, rels, emptyMap())

export pure func extractBodyBlocksWithNums(root: XmlNode, rels: Map[string, string], nums: Map[string, string]) -> [Block] =
  extractBodyBlocksWithStyles(root, rels, nums, emptyMap())

-- Same walk, with custom heading styles resolved from styles.xml (empty map =
-- only built-in style names are headings, exactly as before style resolution).
export pure func extractBodyBlocksWithStyles(root: XmlNode, rels: Map[string, string],
                                             nums: Map[string, string],
                                             hlevels: Map[string, int]) -> [Block] {
  match findFirst(root, "w:body") {
    Some(body) => {
      let children = getChildren(body);
      processBodyChildren(children, rels, nums, hlevels)
    },
    None => []
  }
}

-- Process children of w:body (paragraphs and tables), then merge the
-- consecutive one-item list paragraphs into single list blocks with their
-- nesting levels (see docxGroupLists).
pure func processBodyChildren(nodes: [XmlNode], rels: Map[string, string], nums: Map[string, string],
                              hlevels: Map[string, int]) -> [Block] =
  docxGroupLists(flatMap(\n. processBodyNode(n, rels, nums, hlevels), nodes))

-- Process a single body-level node
pure func processBodyNode(node: XmlNode, rels: Map[string, string], nums: Map[string, string],
                          hlevels: Map[string, int]) -> [Block] {
  let tag = getTag(node);
  if tag == "w:p" then {
    let mainBlock = parseParagraph(node, rels, nums, hlevels);
    let changeBlocks = extractParagraphChanges(node);
    let textBoxBlocks = extractTextBoxes(node, rels, nums, hlevels);
    let breaks = docxParaBreakBlocks(node);
    -- A paragraph that holds nothing but a page/column/section break used to
    -- come back as an EMPTY text block — indistinguishable from a blank line.
    -- The break marker replaces it. A paragraph with text keeps the text and
    -- gains the break marker after it.
    let dropMain = listLength(breaks) > 0 && docxIsBlankTextBlock(mainBlock);
    concat(docxParaBookmarks(node),
           concat(if dropMain then [] else [mainBlock],
                  concat(changeBlocks, concat(textBoxBlocks, breaks))))
  }
  else if tag == "w:tbl" then [parseTable(node, rels)]
  else if tag == "w:sdt" then extractSdtBodyBlocks(node, rels, nums, hlevels)
  -- A body-level w:sectPr is a section break. Emitted as an empty marker block
  -- so consumers can see where a section ends; also deleted by e9de665.
  else if tag == "w:sectPr" then [mkSection("section-break", [])]
  else []
}

-- Is this block an empty (or whitespace-only) TextBlock?
pure func docxIsBlankTextBlock(b: Block) -> bool =
  match b {
    TextBlock(t) => length(trim(t.text)) == 0 && listLength(t.runs) == 0,
    _ => false
  }

-- === Page / column / section breaks (ECMA-376 §17.16.18, §17.6) ==========
--
-- A w:br with w:type="page" (inside a run) and a w:sectPr inside a paragraph's
-- w:pPr are real structure: Word starts a new page / a new section there.
-- They used to become empty text blocks indistinguishable from blank
-- paragraphs (and only the FINAL body-level sectPr was emitted at all). Each
-- is now an explicit marker section, keeping the kind the document declared.
-- w:lastRenderedPageBreak is deliberately NOT emitted: it marks where Word
-- last RENDERED a page boundary, not where the document declares one.

-- Break markers declared by one paragraph, in document order: page, column,
-- then the mid-document section break from pPr/sectPr.
pure func docxParaBreakBlocks(p: XmlNode) -> [Block] {
  let brs = findAll(p, "w:br");
  let page = any(\b. getOrElse(getAttr(b, "w:type"), "") == "page", brs);
  let col = any(\b. getOrElse(getAttr(b, "w:type"), "") == "column", brs);
  let sect = match optFlatMap(\ppr. findFirst(ppr, "w:sectPr"), findFirst(p, "w:pPr")) {
    Some(_) => true,
    None => false
  };
  concat(if page then [mkSection("page-break", [])] else [],
         concat(if col then [mkSection("column-break", [])] else [],
                if sect then [mkSection("section-break", [])] else []))
}

-- === Bookmark anchors (ECMA-376 §17.13.22) ===============================
--
-- w:bookmarkStart/End name a position in the text that internal links point
-- at. They were dropped entirely, so a TOC entry's target (or any cross
-- reference) resolved to nothing. Each named start is now an anchor block
-- carrying the bookmark's name; the End is implied by the next block.
pure func docxParaBookmarks(p: XmlNode) -> [Block] =
  map(\b. mkNamedSection("bookmark", getOrElse(getAttr(b, "w:name"), ""), []),
      filter(\b. length(getOrElse(getAttr(b, "w:name"), "")) > 0,
             findAll(p, "w:bookmarkStart")))

-- Extract blocks from a body-level structured document tag (w:sdt)
-- SDTs can wrap paragraphs, tables, and nested SDTs at the body level
pure func extractSdtBodyBlocks(sdt: XmlNode, rels: Map[string, string], nums: Map[string, string],
                               hlevels: Map[string, int]) -> [Block] =
  match findFirst(sdt, "w:sdtContent") {
    Some(content) => processBodyChildren(getChildren(content), rels, nums, hlevels),
    None => []
  }

-- Extract text from text boxes (wps:txbx / w:txbxContent) inside a node
-- Text boxes appear inside drawings within paragraphs
pure func extractTextBoxes(node: XmlNode, rels: Map[string, string], nums: Map[string, string],
                           hlevels: Map[string, int]) -> [Block] {
  let txbxContents = findAll(node, "w:txbxContent");
  extractTextBoxContent(txbxContents, rels, nums, hlevels)
}

-- Parse text box content nodes into blocks wrapped in a SectionBlock
pure func extractTextBoxContent(nodes: [XmlNode], rels: Map[string, string], nums: Map[string, string],
                                hlevels: Map[string, int]) -> [Block] =
  flatMap(\txbx.
    let blocks = processBodyChildren(getChildren(txbx), rels, nums, hlevels) in
    if hasContent(blocks) then [mkSection("textbox", blocks)]
    else [],
    nodes)

-- === List grouping (ECMA-376 §17.9) ======================================
--
-- One DOCX list paragraph used to become one ONE-ITEM list block, so a
-- three-item bulleted list read as three unrelated lists and a nested list
-- carried no depth at all. Consecutive list paragraphs are now merged into
-- ONE list block: items concatenated, per-item nesting level carried in
-- itemLevels (0 = top level), and the block stays flat (no itemLevels in the
-- JSON) when every item sits at level 0 — so ordinary lists serialise exactly
-- as they did before nesting existed.
--
-- A merge requires the SAME ordered flag: a bullet followed by a numbered item
-- stays two blocks, because a single ListBlock cannot say both.

-- Merge `b` into the reversed accumulator, extending a preceding list when
-- b is a single-item list paragraph with the same ordered flag.
pure func docxMergeListInto(acc: [Block], b: Block) -> [Block] =
  match (acc, b) {
    (ListBlock(l1) :: rest, ListBlock(l2)) =>
      if l1.ordered == l2.ordered && listLength(l2.items) == 1
      then ListBlock(docxMergeListRec(l1, l2)) :: rest
      else b :: acc,
    _ => b :: acc
  }

pure func docxMergeListRec(l1: {items: [string], ordered: bool, itemRuns: [[InlineRun]], itemLevels: [int]},
                           l2: {items: [string], ordered: bool, itemRuns: [[InlineRun]], itemLevels: [int]})
    -> {items: [string], ordered: bool, itemRuns: [[InlineRun]], itemLevels: [int]} {
  let n1 = listLength(l1.items);
  let n2 = listLength(l2.items);
  { items: concat(l1.items, l2.items),
    ordered: l1.ordered,
    itemRuns: concat(docxRunsRows(l1.itemRuns, n1), docxRunsRows(l2.itemRuns, n2)),
    itemLevels: concat(docxLevelRows(l1.itemLevels, n1), docxLevelRows(l2.itemLevels, n2)) }
}

-- Parallel-array padding: itemRuns is either empty (nothing formatted) or
-- exactly as long as items. Padding keeps the parallel invariant across merges.
pure func docxRunsRows(runs: [[InlineRun]], n: int) -> [[InlineRun]] =
  if listLength(runs) == n then runs
  else if listLength(runs) == 0 then docxNEmptyRunRows(n)
  else runs

pure func docxNEmptyRunRows(n: int) -> [[InlineRun]] =
  if n <= 0 then [] else [] :: docxNEmptyRunRows(n - 1)

pure func docxLevelRows(levels: [int], n: int) -> [int] =
  if listLength(levels) == n then levels
  else if listLength(levels) == 0 then docxNZeroLevels(n)
  else levels

pure func docxNZeroLevels(n: int) -> [int] =
  if n <= 0 then [] else 0 :: docxNZeroLevels(n - 1)

-- Merge consecutive one-item list paragraphs across a produced block list.
-- After merging, every list is normalised: a list whose items are ALL at
-- level 0 loses itemLevels, and one where NO item is formatted loses
-- itemRuns — so an ordinary flat list serialises exactly as it did before
-- nesting existed, and only genuinely nested lists carry the field.
pure func docxGroupLists(blocks: [Block]) -> [Block] =
  map(docxFinalizeListBlock, reverse(docxGroupListsStep(blocks, [])))

pure func docxGroupListsStep(blocks: [Block], acc: [Block]) -> [Block] =
  match blocks {
    [] => acc,
    b :: rest => docxGroupListsStep(rest, docxMergeListInto(acc, b))
  }

pure func docxFinalizeListBlock(b: Block) -> Block =
  match b {
    ListBlock(l) =>
      ListBlock({ l | itemRuns: docxTrimEmptyRunRows(l.itemRuns),
                      itemLevels: if docxAnyNested(l.itemLevels) then l.itemLevels else [] }),
    _ => b
  }

-- itemRuns stays only when some item actually carries formatting
pure func docxTrimEmptyRunRows(runs: [[InlineRun]]) -> [[InlineRun]] =
  if any(\r. listLength(r) > 0, runs) then runs else []

pure func docxAnyNested(levels: [int]) -> bool =
  match levels {
    [] => false,
    n :: rest => n > 0 || docxAnyNested(rest)
  }

-- Parse a w:p (paragraph) element into a Block
pure func parseParagraph(p: XmlNode, rels: Map[string, string], nums: Map[string, string],
                         hlevels: Map[string, int]) -> Block {
  let text = extractParagraphText(p, rels);
  let style = extractParagraphStyle(p);
  let headingLevel = docxParaHeadingLevel(style, p, hlevels);
  let runs = extractParagraphRuns(p, rels);
  if headingLevel > 0
  then mkHeadingRuns(text, headingLevel, runs)
  else if isListParagraph(p, nums)
  -- One DOCX list paragraph is one item, at its own nesting level; the
  -- grouping pass merges consecutive paragraphs into one block. Kept empty
  -- when the item has no formatting, so the field only appears where it
  -- carries information.
  then ListBlock({items: [text],
                  ordered: isOrderedList(p, nums),
                  itemRuns: if listLength(runs) > 0 then [runs] else [],
                  itemLevels: [docxParaLevelInt(p, nums)]})
  else mkTextRuns(text, style, 0, runs)
}

-- The paragraph's nesting level as an int. w:ilvl is 0-based; when the
-- paragraph has no explicit level, the STYLE's numbering level is used —
-- python-docx's List Bullet 2 / List Number 3 styles carry numPr WITHOUT an
-- ilvl, and their nesting is the style NAME's trailing number (N -> N-1).
pure func docxParaLevelInt(p: XmlNode, nums: Map[string, string]) -> int {
  let lvl = match stringToInt(docxParaIlvl(p, nums)) {
    Some(n) => if n < 0 then 0 else n,
    None => 0
  };
  if lvl > 0 then lvl
  else docxStyleSuffixLevel(docxParaStyleId(p))
}

-- "ListBullet2" / "List Number 3" -> 1 / 2; anything without a trailing
-- number >= 2 is top level. Only consulted for paragraphs that have no
-- explicit ilvl anywhere.
pure func docxStyleSuffixLevel(sid: Option[string]) -> int =
  match sid {
    Some(name) =>
      match stringToInt(docxTrailingDigits(name)) {
        Some(n) => if n >= 2 then n - 1 else 0,
        None => 0
      },
    None => 0
  }

-- The run of digits at the end of s, "" when there is none
pure func docxTrailingDigits(s: string) -> string =
  if length(s) == 0 then ""
  else {
    let last = substring(s, length(s) - 1, length(s));
    if last == "0" || last == "1" || last == "2" || last == "3" || last == "4"
       || last == "5" || last == "6" || last == "7" || last == "8" || last == "9"
    then "${docxTrailingDigits(substring(s, 0, length(s) - 1))}${last}"
    else ""
  }

-- Extract all text from a paragraph by concatenating runs
-- Handles track changes: includes w:ins and w:moveTo text,
-- skips w:del and w:moveFrom (deleted/moved-away text)
pure func extractParagraphText(p: XmlNode, rels: Map[string, string]) -> string {
  let children = getChildren(p);
  extractTextFromChildren(children, rels)
}

-- Walk paragraph children, skipping deleted/moved-away content
pure func extractTextFromChildren(nodes: [XmlNode], rels: Map[string, string]) -> string =
  join("", map(\n. childNodeText(n, rels), nodes))

-- === Character formatting (ECMA-376 §17.3.2) =============================
--
-- w:rPr has been sitting in every run this parser walks, read only for font
-- names, while bold/italic/underline were dropped on the floor. These build the
-- InlineRun list that carries it.
--
-- childNodeRuns MUST mirror childNodeText's tag handling exactly — same
-- inclusions, same skips — or `runs` and `text` describe different content for
-- the same paragraph. They are permitted to differ in general (see InlineRun in
-- types/document.ail), but for DOCX there are no Markdown markers involved, so
-- any divergence here would be a bug rather than the intended split.
pure func extractParagraphRuns(p: XmlNode, rels: Map[string, string]) -> [InlineRun] {
  let runs = flatMap(\n. childNodeRuns(n, rels), getChildren(p));
  -- Emit nothing unless something is actually formatted. A plain paragraph
  -- gains no information from a single unstyled run, and suppressing it keeps
  -- the JSON for unformatted documents byte-identical to the pre-InlineRun
  -- shape — which is most documents, and all but a handful of the goldens.
  if any(docxRunIsFormatted, runs) then runs else []
}

pure func childNodeRuns(node: XmlNode, rels: Map[string, string]) -> [InlineRun] {
  let tag = getTag(node);
  if tag == "w:r" then [extractRun(node)]
  else if tag == "w:del" then []
  else if tag == "w:moveFrom" then []
  else if tag == "w:ins" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:moveTo" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:smartTag" then map(extractRun, findAll(node, "w:r"))
  -- The URL suffix is a plain run so `runs` still concatenates to `text`.
  else if tag == "w:hyperlink" then
    concat(map(extractRun, findAll(node, "w:r")),
           docxHyperlinkSuffixRuns(node, rels))
  -- w:fldSimple wraps the field's cached result run (DATE, NUMPAGES, FILENAME).
  -- Deleted by e9de665; without it the result text vanishes and a paragraph
  -- reads "Total pages in document: ".
  else if tag == "w:fldSimple" then map(extractRun, findAll(node, "w:r"))
  else if tag == "w:sdt" then childNodeSdtRuns(node)
  else if tag == "m:oMath" then [plainRun(renderOmml(node))]
  else if tag == "m:oMathPara" then [plainRun(renderOmml(node))]
  else []
}

pure func childNodeSdtRuns(sdt: XmlNode) -> [InlineRun] =
  match findFirst(sdt, "w:sdtContent") {
    Some(content) => map(extractRun, findAll(content, "w:r")),
    None => []
  }

pure func extractRun(run: XmlNode) -> InlineRun {
  let text = extractRunText(run);
  match findFirst(run, "w:rPr") {
    Some(rPr) => {
      text: text,
      bold: docxToggleProp(rPr, "w:b"),
      italic: docxToggleProp(rPr, "w:i"),
      underline: docxHasUnderline(rPr),
      strike: docxToggleProp(rPr, "w:strike"),
      -- DOCX has no "code" run property. Inferring one from a monospace font
      -- would be a guess, so it stays false rather than fabricated.
      code: false, href: "",
      vertAlign: docxVertAlign(rPr),
      color: docxRunColor(rPr)
    },
    None => plainRun(text)
  }
}

-- w:color (§17.3.2.35): the run's own font colour, "#rrggbb" lowercase or ""
-- when the run declares none (or "auto"). A colour the run merely INHERITS
-- from a paragraph or character style is not extracted.
pure func docxRunColor(rPr: XmlNode) -> string =
  match findFirst(rPr, "w:color") {
    Some(c) => normaliseHex(getOrElse(getAttr(c, "w:val"), "")),
    None => ""
  }

pure func docxRunIsFormatted(r: InlineRun) -> bool =
  r.bold || r.italic || r.underline || r.strike || r.code || length(r.vertAlign) > 0 || length(r.color) > 0

-- ECMA-376 toggle properties: a bare <w:b/> means ON, but <w:b w:val="0"/>
-- means OFF. Presence alone is not the signal — a paragraph that explicitly
-- turns bold off would otherwise come back bold.
pure func docxToggleProp(rPr: XmlNode, tag: string) -> bool =
  match findFirst(rPr, tag) {
    Some(el) => docxToggleOn(getOrElse(getAttr(el, "w:val"), "true")),
    None => false
  }

pure func docxToggleOn(val: string) -> bool =
  val != "0" && val != "false" && val != "off"

-- w:u is not a toggle: it names an underline style, and w:val="none" is the
-- off state.
pure func docxHasUnderline(rPr: XmlNode) -> bool =
  match findFirst(rPr, "w:u") {
    Some(el) => {
      let v = getOrElse(getAttr(el, "w:val"), "none");
      v != "none" && length(v) > 0
    },
    None => false
  }

pure func docxVertAlign(rPr: XmlNode) -> string =
  match findFirst(rPr, "w:vertAlign") {
    Some(el) => {
      let v = getOrElse(getAttr(el, "w:val"), "");
      if v == "superscript" || v == "subscript" then v else ""
    },
    None => ""
  }

-- Extract text contribution from a single child node
pure func childNodeText(node: XmlNode, rels: Map[string, string]) -> string {
  let tag = getTag(node);
  if tag == "w:r" then extractRunText(node)
  else if tag == "w:del" then ""
  else if tag == "w:moveFrom" then ""
  else if tag == "w:ins" then extractNestedRunText(node)
  else if tag == "w:moveTo" then extractNestedRunText(node)
  else if tag == "w:smartTag" then extractNestedRunText(node)
  else if tag == "w:hyperlink" then
    "${extractNestedRunText(node)}${docxHyperlinkSuffix(node, rels)}"
  else if tag == "w:fldSimple" then extractNestedRunText(node)
  else if tag == "w:sdt" then extractSdtText(node)
  else if tag == "m:oMath" then renderOmml(node)
  else if tag == "m:oMathPara" then renderOmml(node)
  else ""
}

-- Extract text from runs nested inside ins/moveTo/smartTag/hyperlink elements
pure func extractNestedRunText(parent: XmlNode) -> string {
  let runs = findAll(parent, "w:r");
  joinRunTexts(runs)
}

-- Extract track change annotations from a paragraph
-- Finds w:ins, w:del, w:moveTo, w:moveFrom and creates ChangeBlocks
-- with author, date, change type, and affected text.
pure func extractParagraphChanges(p: XmlNode) -> [Block] {
  let children = getChildren(p);
  flatMap(extractChangeFromNode, children)
}

-- Extract a ChangeBlock from a node if it's a track change element
pure func extractChangeFromNode(node: XmlNode) -> [Block] {
  let tag = getTag(node);
  if tag == "w:ins" then [makeChangeBlock("insert", node)]
  else if tag == "w:del" then [makeChangeBlock("delete", node)]
  else if tag == "w:moveTo" then [makeChangeBlock("move-to", node)]
  else if tag == "w:moveFrom" then [makeChangeBlock("move-from", node)]
  else []
}

-- Create a ChangeBlock from a track change XML node
pure func makeChangeBlock(changeType: string, node: XmlNode) -> Block {
  let author = getOrElse(getAttr(node, "w:author"), "Unknown");
  let date = getOrElse(getAttr(node, "w:date"), "");
  let text = extractChangeText(node);
  ChangeBlock({changeType: changeType, author: author, date: date, text: text})
}

-- Extract text from a track change node (handles both w:t and w:delText)
pure func extractChangeText(node: XmlNode) -> string {
  let runs = findAll(node, "w:r");
  join("", map(extractRunChangeText, runs))
}

-- Extract text from a run in a track change
-- Same child walk as extractRunText, with w:delText (used by w:del and
-- w:moveFrom) in place of w:t — so deletions split by a line break or tab
-- keep their full text too.
pure func extractRunChangeText(run: XmlNode) -> string =
  join("", map(docxRunChangeChildText, getChildren(run)))

pure func docxRunChangeChildText(node: XmlNode) -> string {
  let tag = getTag(node);
  if tag == "w:delText" then getText(node)
  else if tag == "w:t" then getText(node)
  else if tag == "w:br" || tag == "w:cr" then docxBrText(node)
  else if tag == "w:tab" then "\t"
  else if tag == "w:noBreakHyphen" then "-"
  else ""
}

-- Extract text from structured document tags (w:sdt -> w:sdtContent)
pure func extractSdtText(sdt: XmlNode) -> string {
  match findFirst(sdt, "w:sdtContent") {
    Some(content) => {
      let runs = findAll(content, "w:r");
      joinRunTexts(runs)
    },
    None => ""
  }
}

-- Concatenate text from all runs
pure func joinRunTexts(runs: [XmlNode]) -> string =
  join("", map(extractRunText, runs))

-- Check if a font name is a symbol/dingbat font that uses PUA codepoints
pure func docxIsSymbolFont(fontName: string) -> bool =
  contains(fontName, "Wingdings") ||
  contains(fontName, "Webdings") ||
  fontName == "Symbol"

-- Strip Private Use Area characters (U+F000-U+F0FF) from text
-- These only render with the matching symbol font installed
pure func docxStripPuaChars(text: string) -> string {
  let charList = chars(text);
  let filtered = filter(\c. {
    let code = charCode(c);
    code < 61440 || code > 61695
  }, charList);
  join("", filtered)
}

-- Get the ASCII font name from a run's properties (w:rPr/w:rFonts[@w:ascii])
pure func docxGetRunFont(run: XmlNode) -> string =
  getOrElse(
    optFlatMap(\rpr.
      optFlatMap(\rfonts.
        getAttr(rfonts, "w:ascii"),
        findFirst(rpr, "w:rFonts")),
      findFirst(run, "w:rPr")),
    "")

-- Text contribution of one child of a run, in document order (ECMA-376
-- §17.3.3): w:t carries text; w:br/w:cr are line breaks (soft line breaks —
-- Shift+Enter in Word, which Google Docs exports use to lay out Q/A pairs);
-- w:tab is a tab; w:noBreakHyphen renders as a hyphen; w:softHyphen is an
-- optional break hint that contributes nothing. Anything else (w:rPr, marks,
-- drawing anchors) contributes no text.
pure func docxRunChildText(node: XmlNode) -> string {
  let tag = getTag(node);
  if tag == "w:t" then getText(node)
  else if tag == "w:br" || tag == "w:cr" then docxBrText(node)
  else if tag == "w:tab" then "\t"
  else if tag == "w:noBreakHyphen" then "-"
  else ""
}

-- A w:br is a soft line break ("\n") UNLESS it names a structural break
-- (w:type="page" / "column"), which is emitted as its own marker block and
-- contributes nothing to the paragraph text.
pure func docxBrText(br: XmlNode) -> string =
  let t = getOrElse(getAttr(br, "w:type"), "") in
  if t == "page" || t == "column" then "" else "\n"

-- Extract text from a single w:r (run)
-- Walks ALL children in order: a run may hold several <w:t> elements split by
-- <w:br>/<w:tab> (a single Shift+Enter in Google Docs produces exactly this),
-- and taking only the first w:t silently dropped every line after the break.
-- Strips PUA characters from symbol font runs (Wingdings, Webdings, Symbol)
pure func extractRunText(run: XmlNode) -> string {
  let text = join("", map(docxRunChildText, getChildren(run)));
  let font = docxGetRunFont(run);
  if docxIsSymbolFont(font) then docxStripPuaChars(text)
  else text
}

-- Extract the paragraph style name from w:pPr/w:pStyle
pure func extractParagraphStyle(p: XmlNode) -> string =
  getOrElse(
    optFlatMap(\ppr.
      optFlatMap(\pstyle.
        getAttr(pstyle, "w:val"),
        findFirst(ppr, "w:pStyle")),
      findFirst(p, "w:pPr")),
    "Normal")

-- Determine heading level from style name.
-- Recognizes the conformant ECMA-376 styleIds (Heading1..Heading6, Title,
-- Subtitle), the space-separated display names some non-conformant tools
-- emit ("Heading 1"..), and maps Word's Title/Subtitle to H1/H2.
-- Contract: result is in 0..6. Inline tests below enforce all real cases;
-- the `ensures` form is omitted because of ailang-core issue #236 (v0.19.2
-- property-test generator emits invalid _test.ail for several pure-func
-- shapes with ensures).
pure func headingLevelFromStyle(style: string) -> int
  tests [
    ("Heading1", 1),
    ("Heading2", 2),
    ("Heading3", 3),
    ("Heading 1", 1),
    ("Heading 4", 4),
    ("Title", 1),
    ("Subtitle", 2),
    ("Normal", 0),
    ("BodyText", 0)
  ]
{
  if style == "Heading1" || style == "Heading 1" then 1
  else if style == "Heading2" || style == "Heading 2" then 2
  else if style == "Heading3" || style == "Heading 3" then 3
  else if style == "Heading4" || style == "Heading 4" then 4
  else if style == "Heading5" || style == "Heading 5" then 5
  else if style == "Heading6" || style == "Heading 6" then 6
  else if style == "Title" then 1
  else if style == "Subtitle" then 2
  else 0
}

-- Check if paragraph is a list item: a direct w:numPr, or numbered through
-- its pStyle (the style carries numPr in styles.xml — python-docx's List
-- Bullet / List Number do exactly this, and before style resolution those
-- paragraphs were invisible to the list reader entirely).
pure func isListParagraph(p: XmlNode, nums: Map[string, string]) -> bool =
  match docxParaNumPr(p) {
    Some(_) => true,
    None => match docxParaStyleId(p) {
      Some(sid) => mapMember(nums, "s:${sid}"),
      None => false
    }
  }

-- Check if a list paragraph is ordered (numbered) vs unordered (bullet).
--
-- Resolved, not guessed: numId -> abstractNumId -> w:numFmt of the lvl entry
-- matching the paragraph's own w:ilvl (Word falls back to ilvl 0 when the
-- paragraph's level has no entry — singleLevel abstracts define only lvl 0).
-- The numId itself comes from the paragraph's direct w:numPr first, else from
-- its style's numPr (python-docx numbers through List Bullet / List Number
-- styles, which carry numPr in styles.xml). The old convention — numId != "1"
-- — agreed with pandoc files by coincidence (pandoc assigns bullets numId 1)
-- and misread everything else, including our own reference-doc output, whose
-- list ids sit above the template's max.
--
-- Unresolvable (no numbering.xml, dangling numId, numStyleLink indirection)
-- falls back to that same legacy convention, so documents the resolver cannot
-- see keep the behaviour they always had.
pure func isOrderedList(p: XmlNode, nums: Map[string, string]) -> bool {
  match docxParaNumId(p, nums) {
    Some(numId) =>
      match mapLookup(nums, "n:${numId}") {
        Some(absId) => docxNumFmtOrdered(nums, absId, docxParaIlvl(p, nums), numId),
        None => docxLegacyOrdered(numId)
      },
    None => false
  }
}

-- The paragraph's effective numId: direct w:numPr/w:numId first, else the
-- pStyle's style-level numPr
pure func docxParaNumId(p: XmlNode, nums: Map[string, string]) -> Option[string] =
  match docxParaDirectNumId(p) {
    Some(id) => Some(id),
    None => match docxParaStyleId(p) {
      Some(sid) => mapLookup(nums, "s:${sid}"),
      None => None
    }
  }

pure func docxParaDirectNumId(p: XmlNode) -> Option[string] =
  optFlatMap(\numPr.
    optFlatMap(\numId. getAttr(numId, "w:val"), findFirst(numPr, "w:numId")),
    docxParaNumPr(p))

-- The paragraph's pStyle value, if it names one
pure func docxParaStyleId(p: XmlNode) -> Option[string] =
  optFlatMap(\ppr. optFlatMap(\ps. getAttr(ps, "w:val"), findFirst(ppr, "w:pStyle")),
             findFirst(p, "w:pPr"))

pure func docxParaNumPr(p: XmlNode) -> Option[XmlNode] =
  optFlatMap(\ppr. findFirst(ppr, "w:numPr"), findFirst(p, "w:pPr"))

-- The paragraph's effective nesting depth: direct w:ilvl, else the style's,
-- else 0 (absent w:ilvl means level 0)
pure func docxParaIlvl(p: XmlNode, nums: Map[string, string]) -> string =
  let direct = optFlatMap(\numPr.
    optFlatMap(\ilvl. getAttr(ilvl, "w:val"), findFirst(numPr, "w:ilvl")),
    docxParaNumPr(p)) in
  match direct {
    Some(lvl) => lvl,
    None => match docxParaStyleId(p) {
      Some(sid) => getOrElse(mapLookup(nums, "s:${sid}:ilvl"), "0"),
      None => "0"
    }
  }

-- numFmt of the abstract's lvl at ilvl, falling back to lvl 0 (singleLevel
-- abstracts), then to the legacy convention when neither exists
pure func docxNumFmtOrdered(nums: Map[string, string], absId: string, ilvl: string, numId: string) -> bool =
  match mapLookup(nums, "a:${absId}:${ilvl}") {
    Some(fmt) => fmt != "bullet",
    None =>
      match mapLookup(nums, "a:${absId}:0") {
        Some(fmt) => fmt != "bullet",
        None => docxLegacyOrdered(numId)
      }
  }

-- The pre-numbering-resolution convention, kept for anything unresolvable.
-- Takes the effective numId (direct or style-derived) so both numbering routes
-- fall back identically.
pure func docxLegacyOrdered(numId: string) -> bool =
  length(numId) > 0 && numId != "1"

-- One map, three key spaces, built in one pass over each part:
--   "n:<numId>"                -> abstractNumId   (from <w:num>)
--   "a:<abstractNumId>:<ilvl>" -> w:numFmt        (from each <w:lvl>)
--   "s:<styleId>"             -> numId           (from a style's pPr/numPr)
--   "s:<styleId>:ilvl"        -> ilvl            (absent = 0)
-- Encoding the lvl into the key keeps the per-paragraph lookup to O(1) map
-- hits; the numId->abstract indirection is what the spec requires, so the map
-- cannot be flattened below two lookups anyway.
-- The numbering-definitions entries alone (n:/a: key spaces)
pure func docxNumberingEntries(numberingXml: string) -> [(string, string)] =
  if length(numberingXml) == 0 then []
  else match parseLenient(numberingXml) {
    Err(_) => [],
    Ok(root) => concat(flatMap(docxNumEntries, findAll(root, "w:num")),
                       flatMap(docxAbstractNumEntries, findAll(root, "w:abstractNum")))
  }

export pure func docxNumberingMaps(numberingXml: string) -> Map[string, string] =
  mapFromList(docxNumberingEntries(numberingXml))

-- The full context: numbering definitions plus style-level numbering, in one
-- map. Style entries never collide with n:/a: keys, so concatenating the
-- entry lists before mapFromList is safe.
export pure func docxNumberingContext(numberingXml: string, stylesXml: string) -> Map[string, string] =
  mapFromList(concat(docxNumberingEntries(numberingXml), docxStyleNumEntries(stylesXml)))

pure func docxStyleNumEntries(stylesXml: string) -> [(string, string)] =
  if length(stylesXml) == 0 then []
  else match parseLenient(stylesXml) {
    Err(_) => [],
    Ok(root) => flatMap(docxStyleNumEntry, findAll(root, "w:style"))
  }

pure func docxStyleNumEntry(style: XmlNode) -> [(string, string)] =
  match getAttr(style, "w:styleId") {
    Some(sid) =>
      match docxStyleNumPr(style) {
        Some(numId) => [("s:${sid}", numId), ("s:${sid}:ilvl", docxStyleIlvl(style))],
        None => []
      },
    None => []
  }

-- numId declared by a style's own pPr/numPr, if any
pure func docxStyleNumPr(style: XmlNode) -> Option[string] =
  optFlatMap(\numPr.
    optFlatMap(\numId. getAttr(numId, "w:val"), findFirst(numPr, "w:numId")),
    findFirst(style, "w:pPr"))

pure func docxStyleIlvl(style: XmlNode) -> string =
  getOrElse(
    optFlatMap(\numPr.
      optFlatMap(\ilvl. getAttr(ilvl, "w:val"), findFirst(numPr, "w:ilvl")),
      findFirst(style, "w:pPr")),
    "0")

pure func docxNumEntries(num: XmlNode) -> [(string, string)] =
  match getAttr(num, "w:numId") {
    Some(numId) =>
      match optFlatMap(\abs. getAttr(abs, "w:val"), findFirst(num, "w:abstractNumId")) {
        Some(absId) => [("n:${numId}", absId)],
        None => []
      },
    None => []
  }

pure func docxAbstractNumEntries(abs: XmlNode) -> [(string, string)] =
  match getAttr(abs, "w:abstractNumId") {
    Some(absId) => map(\lvl. docxLvlEntry(absId, lvl), findAll(abs, "w:lvl")),
    None => []
  }

pure func docxLvlEntry(absId: string, lvl: XmlNode) -> (string, string) =
  let ilvl = getOrElse(getAttr(lvl, "w:ilvl"), "0") in
  let fmt = getOrElse(optFlatMap(\f. getAttr(f, "w:val"), findFirst(lvl, "w:numFmt")), "") in
  ("a:${absId}:${ilvl}", fmt)

-- Parse a w:tbl (table) element into a TableBlock
-- Handles merged cells via gridSpan (horizontal) and vMerge (vertical)
pure func parseTable(tbl: XmlNode, rels: Map[string, string]) -> Block {
  let rows = findAll(tbl, "w:tr");
  let parsedRows = parseTableRows(rows, rels);
  match parsedRows {
    [] => mkTable([], []),
    firstRow :: dataRows =>
      mkTable(dataRows, firstRow)
  }
}

-- Parse all table rows
-- Contract: result has the same row count as the input rows. The `ensures`
-- form is omitted because of ailang-core issue #236 (v0.19.2 property-test
-- generator emits invalid _test.ail for pure funcs with ensures).
pure func parseTableRows(rows: [XmlNode], rels: Map[string, string]) -> [[TableCell]]
{
  map(\r. parseTableRow(r, rels), rows)
}

-- Parse a single table row into TableCells with span info
pure func parseTableRow(tr: XmlNode, rels: Map[string, string]) -> [TableCell] {
  let cells = findAll(tr, "w:tc");
  parseCells(cells, rels)
}

-- Extract TableCells from all cells in a row
-- Contract: result has the same cell count as the input cells. The `ensures`
-- form is omitted because of ailang-core issue #236.
pure func parseCells(cells: [XmlNode], rels: Map[string, string]) -> [TableCell]
{
  map(\c. parseCell(c, rels), cells)
}

-- Parse a single w:tc into a TableCell with merge info
-- Reads w:tcPr for gridSpan and vMerge attributes
pure func parseCell(tc: XmlNode, rels: Map[string, string]) -> TableCell {
  let text = getCellText(tc, rels);
  let cs = getCellGridSpan(tc);
  let vm = getCellVMerge(tc);
  if vm == "continue"
  then { text: "", colSpan: cs, rowSpan: 1, merged: true, scope: "" , align: "", runs: [], fill: "", color: "", formula: ""}
  else { text: text, colSpan: cs, rowSpan: 1, merged: false, scope: "" , align: "", runs: [], fill: "", color: "", formula: ""}
}

-- Get gridSpan value from w:tcPr/w:gridSpan[@w:val]
-- Returns 1 if not present (normal single-column cell)
-- Contract: result is >= 1 (a cell always spans at least one column). The
-- `ensures` form is omitted because of ailang-core issue #236.
pure func getCellGridSpan(tc: XmlNode) -> int
{
  getOrElse(
    optFlatMap(\tcPr.
      optFlatMap(\gs.
        optMap(\val. parseIntOrDefault(val, 1), getAttr(gs, "w:val")),
        findFirst(tcPr, "w:gridSpan")),
      findFirst(tc, "w:tcPr")),
    1)
}

-- Get vMerge status from w:tcPr/w:vMerge
-- Returns "restart" for merge start, "continue" for continuation, "" for no merge
pure func getCellVMerge(tc: XmlNode) -> string {
  match optFlatMap(\tcPr. findFirst(tcPr, "w:vMerge"), findFirst(tc, "w:tcPr")) {
    Some(vm) => getOrElse(getAttr(vm, "w:val"), "continue"),
    None => ""
  }
}

-- Parse an integer string, returning default if not a valid number
pure func parseIntOrDefault(s: string, default: int) -> int =
  getOrElse(stringToInt(s), default)

-- Get text from a table cell (concatenate all paragraph text within)
pure func getCellText(tc: XmlNode, rels: Map[string, string]) -> string {
  let paragraphs = findAll(tc, "w:p");
  joinParagraphTexts(paragraphs, rels)
}

-- Concatenate text from multiple paragraphs
pure func joinParagraphTexts(ps: [XmlNode], rels: Map[string, string]) -> string =
  join("\n", map(\pp. extractParagraphText(pp, rels), ps))

-- Extract metadata from core.xml
export pure func extractMetadata(root: XmlNode) -> DocMetadata {
  let title = getMetaField(root, "dc:title");
  let author = getMetaField(root, "dc:creator");
  let created = getMetaField(root, "dcterms:created");
  let modified = getMetaField(root, "dcterms:modified");
  { title: title, author: author, created: created, modified: modified, pageCount: 0 }
}

-- Get a text field from metadata XML
export pure func getMetaField(root: XmlNode, tagName: string) -> string =
  getOrElse(optMap(getText, findFirst(root, tagName)), "")

-- Extract images from media entries
--
-- Memory audit (m-v1-memory-footprint, ask D3): this loop used to read every
-- media entry through readEmbeddedImage and keep the base64 in the ImageBlock
-- for the document's lifetime — a 4/3 blow-up held in memory per image. The
-- block now carries a temp-file PATH (a LocalFile to classifyImageSource and
-- every generator, emitted as `src` in JSON); inline base64 is available on
-- demand at output time via zip_extract.imageDataUriFromFile. A per-document
-- byte cap returns a typed Err, surfaced here as a warning block so the rest
-- of the document still parses.
func extractImages(filepath: string, entries: [string]) -> [Block] ! {FS} =
  match extractMediaToFiles(filepath, entries, imageTempDir()) {
    Ok(m) => m.blocks,
    Err(e) => [mkText(imageExtractErrorText(e), "warning", 0)]
  }

-- === Comment anchoring (ECMA-376 §17.13.1) ================================
--
-- A comment's body lives in word/comments.xml keyed by w:id; the span it
-- annotates lives in word/document.xml as w:commentRangeStart /
-- w:commentRangeEnd markers carrying the same w:id. Correlating the two is
-- what makes a comment usable — "this is nonsense" is noise without the text
-- it points at, and an agent handed a detached comment will guess a target.
--
-- Ranges are stateful: they open at one node and close at a later one, which
-- may be a different paragraph or a different table cell. So the anchor walk
-- is a fold threading the set of currently-open ranges, not a stateless map
-- like processBodyChildren.
--
-- Note: w:bookmarkStart also carries a w:id, in a SEPARATE numbering space.
-- Ids are therefore only ever read off comment-specific tags.

-- A range opened but not yet closed. `parts` holds run text in REVERSE order
-- (prepend during the walk, reverse at close — never concat onto the tail
-- inside a fold).
type DocxOpenRange = {
  id: string,
  parts: [string],
  startIndex: int
}

-- A resolved anchor: the exact text a comment points at.
-- kind is "range" (w:commentRangeStart/End pair) or "point" (a bare
-- w:commentReference, which anchors to its containing paragraph).
-- startIndex/endIndex are body block indices, so a consumer can render the
-- comment in place.
type DocxAnchor = {
  id: string,
  text: string,
  kind: string,
  startIndex: int,
  endIndex: int
}

-- Body walk state. blocks and anchors accumulate REVERSED.
type DocxWalk = {
  blocks: [Block],
  anchors: [DocxAnchor],
  open: [DocxOpenRange],
  count: int
}

-- Walk the body once, producing content blocks and comment anchors together.
-- Doing both in one pass keeps the block indices honest (an anchor's index is
-- the position of its paragraph in the emitted block list, which only this
-- walk knows) and avoids parsing document.xml twice.
export pure func docxWalkBodyRoot(root: XmlNode) -> DocxWalk =
  docxWalkBodyRootWithRels(root, emptyMap())

export pure func docxWalkBodyRootWithRels(root: XmlNode, rels: Map[string, string]) -> DocxWalk =
  docxWalkBodyRootFull(root, rels, emptyMap())

export pure func docxWalkBodyRootFull(root: XmlNode, rels: Map[string, string], nums: Map[string, string]) -> DocxWalk =
  docxWalkBodyRootFullWithStyles(root, rels, nums, emptyMap())

-- Same walk, with custom heading styles resolved from styles.xml.
export pure func docxWalkBodyRootFullWithStyles(root: XmlNode, rels: Map[string, string],
                                                nums: Map[string, string],
                                                hlevels: Map[string, int]) -> DocxWalk =
  match findFirst(root, "w:body") {
    Some(body) => {
      let st = docxWalkNodes(getChildren(body), docxEmptyWalk(), rels, nums, hlevels);
      { blocks: map(docxFinalizeListBlock, reverse(st.blocks)), anchors: reverse(st.anchors),
        open: st.open, count: st.count }
    },
    None => docxEmptyWalk()
  }

pure func docxEmptyWalk() -> DocxWalk =
  { blocks: [], anchors: [], open: [], count: 0 }

pure func docxWalkNodes(nodes: [XmlNode], st: DocxWalk, rels: Map[string, string], nums: Map[string, string],
                        hlevels: Map[string, int]) -> DocxWalk =
  match nodes {
    [] => st,
    node :: rest => docxWalkNodes(rest, docxWalkNode(node, st, rels, nums, hlevels), rels, nums, hlevels)
  }

-- Process one body-level node: emit its blocks (reusing processBodyNode so
-- block extraction stays in one place) and scan it for comment markers.
-- Consecutive one-item lists merge here too, so the anchor block indices the
-- walk reports are indices into the SAME list the caller sees.
pure func docxWalkNode(node: XmlNode, st: DocxWalk, rels: Map[string, string], nums: Map[string, string],
                       hlevels: Map[string, int]) -> DocxWalk {
  let tag = getTag(node);
  if tag == "w:sdt" then
    -- SDTs emit their content's blocks, so recurse rather than counting them
    -- as one node; the recursion keeps the index accounting correct.
    match findFirst(node, "w:sdtContent") {
      Some(content) => docxWalkNodes(getChildren(content), st, rels, nums, hlevels),
      None => st
    }
  else {
    let emitted = processBodyNode(node, rels, nums, hlevels);
    let scanned =
      if tag == "w:p" then docxScanParagraph(node, st)
      else if tag == "w:tbl" then docxScanParagraphs(findAll(node, "w:p"), st)
      else st;
    let before = listLength(scanned.blocks);
    let mergedBlocks = docxPrependMergeAll(emitted, scanned.blocks);
    { blocks: mergedBlocks,
      anchors: scanned.anchors,
      open: scanned.open,
      count: scanned.count + (listLength(mergedBlocks) - before) }
  }
}

-- Prepend a list onto a reversed accumulator, merging list paragraphs
pure func docxPrependMergeAll(xs: [Block], acc: [Block]) -> [Block] =
  match xs {
    [] => acc,
    x :: rest => docxPrependMergeAll(rest, docxMergeListInto(acc, x))
  }

-- Scan several paragraphs in document order (table cells, nested tables)
pure func docxScanParagraphs(ps: [XmlNode], st: DocxWalk) -> DocxWalk =
  match ps {
    [] => st,
    p :: rest => docxScanParagraphs(rest, docxScanParagraph(p, st))
  }

-- Scan one paragraph's children in document order, then close the paragraph
pure func docxScanParagraph(p: XmlNode, st: DocxWalk) -> DocxWalk {
  -- Anchor text is matched against comment ranges, so it deliberately stays
  -- rels-free: appending a URL here would shift every anchor that spans a link.
  let paraText = extractParagraphText(p, emptyMap());
  let scanned = docxScanChildren(getChildren(p), paraText, st);
  docxEndParagraph(scanned)
}

pure func docxScanChildren(nodes: [XmlNode], paraText: string, st: DocxWalk) -> DocxWalk =
  match nodes {
    [] => st,
    n :: rest => docxScanChildren(rest, paraText, docxScanChild(n, paraText, st))
  }

-- One paragraph child. Text is appended to EVERY currently-open range, which
-- is what makes nested and overlapping ranges fall out for free.
pure func docxScanChild(node: XmlNode, paraText: string, st: DocxWalk) -> DocxWalk {
  let tag = getTag(node);
  if tag == "w:commentRangeStart" then
    match getAttr(node, "w:id") {
      Some(id) => docxOpenRange(id, st),
      None => st
    }
  else if tag == "w:commentRangeEnd" then
    match getAttr(node, "w:id") {
      Some(id) => docxCloseRange(id, st),
      None => st
    }
  else {
    let withRefs = docxScanRefs(findAll(node, "w:commentReference"), paraText, st);
    let text = childNodeText(node, emptyMap());
    if length(text) == 0 then withRefs
    else docxAppendOpen(text, withRefs)
  }
}

-- A w:commentReference whose id never had a range is a point anchor, not an
-- error: attach the containing paragraph and mark it as such.
pure func docxScanRefs(refs: [XmlNode], paraText: string, st: DocxWalk) -> DocxWalk =
  match refs {
    [] => st,
    r :: rest => {
      let next = match getAttr(r, "w:id") {
        Some(id) =>
          if docxKnowsId(id, st) then st
          else {
            let anchor = { id: id, text: trim(paraText), kind: "point",
                           startIndex: st.count, endIndex: st.count };
            { blocks: st.blocks, anchors: anchor :: st.anchors,
              open: st.open, count: st.count }
          },
        None => st
      };
      docxScanRefs(rest, paraText, next)
    }
  }

-- Is this id already open, or already resolved?
pure func docxKnowsId(id: string, st: DocxWalk) -> bool =
  any(\r. r.id == id, st.open) || any(\a. a.id == id, st.anchors)

pure func docxOpenRange(id: string, st: DocxWalk) -> DocxWalk =
  { blocks: st.blocks, anchors: st.anchors, count: st.count,
    open: { id: id, parts: [], startIndex: st.count } :: st.open }

-- Close a range: reverse its collected fragments into the anchor text.
-- A close with no matching open is ignored — it degrades to unanchored
-- rather than anchoring to whatever text happens to be nearby.
pure func docxCloseRange(id: string, st: DocxWalk) -> DocxWalk =
  match filter(\r. r.id == id, st.open) {
    [] => st,
    r :: _ => {
      let anchor = { id: id, text: trim(join("", reverse(r.parts))),
                     kind: "range", startIndex: r.startIndex, endIndex: st.count };
      { blocks: st.blocks,
        anchors: anchor :: st.anchors,
        open: filter(\o. o.id != id, st.open),
        count: st.count }
    }
  }

pure func docxAppendOpen(text: string, st: DocxWalk) -> DocxWalk =
  { blocks: st.blocks, anchors: st.anchors, count: st.count,
    open: map(\r. { id: r.id, parts: text :: r.parts, startIndex: r.startIndex }, st.open) }

-- A range still open at a paragraph break keeps collecting across it, so
-- record the boundary rather than running the two paragraphs together.
pure func docxEndParagraph(st: DocxWalk) -> DocxWalk =
  match st.open {
    [] => st,
    _ => docxAppendOpen("\n", st)
  }

-- A comment body read from comments.xml, before the anchor join.
-- lastParaId is the w14:paraId of its final paragraph — the key
-- commentsExtended.xml uses to express threading.
type DocxCommentBody = {
  id: string,
  author: string,
  date: string,
  text: string,
  lastParaId: string
}

-- A comment together with the body block index it should follow.
-- index < 0 means unanchored: the comment goes in the trailing group.
type DocxPlacedComment = {
  index: int,
  block: Block
}

-- Parse a DOCX body with its comments spliced in at their anchors.
--
-- Comments appear exactly once, immediately after the block holding the end
-- of the span they annotate, so a linear reader (or an agent walking blocks in
-- order) meets each comment beside its target. Comments whose anchor could not
-- be resolved go in a trailing group, explicitly labelled unanchored.
export func parseDocxWithComments(filepath: string) -> [Block] ! {FS} =
  docxBodyWithComments(readDocxContent(filepath),
                       readComments(filepath),
                       readCommentsExtended(filepath),
                       docxLoadRels(filepath),
                       docxLoadNumberingContext(filepath),
                       docxLoadHeadingLevels(filepath),
                       readDocxStyles(filepath),
                       listLength(findFootnoteEntries(filepath)) > 0)

-- The full CLI entry: comments spliced at anchors, custom heading styles
-- resolved, and approximation warnings appended.
export pure func docxBodyWithComments(documentXml: string, commentsXml: string,
                                      extXml: string, rels: Map[string, string],
                                      nums: Map[string, string], hlevels: Map[string, int],
                                      stylesXml: string, hasFootnotesPart: bool) -> [Block] {
  match parseLenient(documentXml) {
    Ok(root) => {
      let walk = docxWalkBodyRootFullWithStyles(root, rels, nums, hlevels);
      let placed = docxCommentsFromXml(commentsXml, extXml, walk.anchors);
      concat(docxSpliceComments(walk.blocks, placed),
             docxPartWarnings(root, stylesXml, hasFootnotesPart))
    },
    Err(e) => [mkText("XML parse error: ${e}", "error", 0)]
  }
}

-- Pure core of the anchored parse, over raw XML strings.
--
-- The browser (WASM) build has no filesystem — JavaScript unzips and hands the
-- parts over as strings — so both the CLI and the browser go through this one
-- function. Anchoring that worked on the CLI but silently degraded in the
-- browser demo would be worse than either being consistently unanchored.
export pure func parseDocxWithCommentsXml(documentXml: string, commentsXml: string,
                                           extXml: string) -> [Block] =
  parseDocxWithCommentsXmlRels(documentXml, commentsXml, extXml, emptyMap())

-- Same, with hyperlink relationships resolved. The CLI reads document.xml.rels
-- and uses this; the browser has no rels part and uses the arity-3 form above.
export pure func parseDocxWithCommentsXmlRels(documentXml: string, commentsXml: string,
                                              extXml: string, rels: Map[string, string]) -> [Block] =
  parseDocxWithCommentsXmlRelsNum(documentXml, commentsXml, extXml, rels, emptyMap())

-- Same, with word/numbering.xml definitions so list classification matches the
-- plain parse. The browser hands over the numbering part as a string when it
-- has one; without it, list paragraphs keep the legacy convention.
export pure func parseDocxWithCommentsXmlRelsNum(documentXml: string, commentsXml: string,
                                                 extXml: string, rels: Map[string, string],
                                                 nums: Map[string, string]) -> [Block] =
  match parseLenient(documentXml) {
    Ok(root) => {
      let walk = docxWalkBodyRootFull(root, rels, nums);
      let placed = docxCommentsFromXml(commentsXml, extXml, walk.anchors);
      docxSpliceComments(walk.blocks, placed)
    },
    Err(e) => [mkText("XML parse error: ${e}", "error", 0)]
  }

-- Extract comments from a DOCX file (word/comments.xml), each anchored to the
-- span of document.xml text it annotates. Returned as a flat list for callers
-- that want comments alone; parseDocxWithComments splices them into the body.
export func parseDocxComments(filepath: string) -> [Block] ! {FS} {
  let anchors = match parseLenient(readDocxContent(filepath)) {
    Ok(root) => docxWalkBodyRoot(root).anchors,
    Err(_) => []
  };
  let placed = docxCommentsFromXml(readComments(filepath), readCommentsExtended(filepath), anchors);
  map(\p. docxWrapComment(p.block), placed)
}

-- Anchored comments alone, over raw XML strings (browser/WASM entry point).
export pure func docxCommentsOnlyXml(commentsXml: string, documentXml: string,
                                      extXml: string) -> [Block] {
  let anchors = match parseLenient(documentXml) {
    Ok(root) => docxWalkBodyRoot(root).anchors,
    Err(_) => []
  };
  map(\p. docxWrapComment(p.block), docxCommentsFromXml(commentsXml, extXml, anchors))
}

-- Join comments.xml + commentsExtended.xml to the anchors collected from
-- document.xml.
pure func docxCommentsFromXml(commentsXml: string, extXml: string,
                               anchors: [DocxAnchor]) -> [DocxPlacedComment] =
  if length(commentsXml) == 0 then []
  else match parseLenient(commentsXml) {
    Ok(root) => {
      let bodies = map(docxCommentBody, findAll(root, "w:comment"));
      let exNodes = docxReadCommentExNodes(extXml);
      let placed = map(\b. docxPlaceComment(b, anchors, bodies, exNodes), bodies);
      docxInheritReplyAnchors(placed, bodies, anchors, exNodes)
    },
    Err(_) => []
  }

-- Read one w:comment element into a body record
pure func docxCommentBody(node: XmlNode) -> DocxCommentBody {
  let paragraphs = findAll(node, "w:p");
  {
    id: getOrElse(getAttr(node, "w:id"), ""),
    author: getOrElse(getAttr(node, "w:author"), "Unknown"),
    date: getOrElse(getAttr(node, "w:date"), ""),
    text: join(" ", docxExtractCommentTexts(paragraphs)),
    lastParaId: docxLastParaId(paragraphs)
  }
}

-- commentsExtended.xml keys threading on the LAST paragraph of a comment body
pure func docxLastParaId(ps: [XmlNode]) -> string =
  match last(ps) {
    Some(p) => getOrElse(getAttr(p, "w14:paraId"), ""),
    None => ""
  }

pure func docxReadCommentExNodes(xml: string) -> [XmlNode] =
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => findAll(root, "w15:commentEx"),
    Err(_) => []
  }

-- Join one comment body to its anchor.
--
-- Every path that cannot resolve an anchor with certainty produces an
-- unanchored comment: no matching range, an empty range, a missing w:id. The
-- one thing this must never do is fall back to nearby text — a comment
-- confidently pinned to the wrong clause is worse than one with no target,
-- because nothing signals that it was a guess.
pure func docxPlaceComment(body: DocxCommentBody, anchors: [DocxAnchor],
                            bodies: [DocxCommentBody], exNodes: [XmlNode]) -> DocxPlacedComment {
  let parentId = docxParentIdOf(body, bodies, exNodes);
  let resolved = docxIsResolved(body, exNodes);
  match filter(\a. a.id == body.id, anchors) {
    [] => docxUnplaced(body, parentId, resolved),
    a :: _ =>
      if length(trim(a.text)) == 0 then docxUnplaced(body, parentId, resolved)
      else {
        index: a.endIndex,
        block: mkAnchoredComment(body.id, body.author, body.date, body.text,
                                 a.text, a.kind, a.startIndex, parentId, resolved)
      }
  }
}

pure func docxUnplaced(body: DocxCommentBody, parentId: string, resolved: bool) -> DocxPlacedComment =
  { index: 0 - 1,
    block: mkUnanchoredComment(body.id, body.author, body.date, body.text, parentId, resolved) }

-- Which comment does this one reply to?
-- commentsExtended maps a comment's last paraId to its parent's last paraId;
-- we resolve that back to the parent's w:id.
pure func docxParentIdOf(body: DocxCommentBody, bodies: [DocxCommentBody], exNodes: [XmlNode]) -> string {
  if length(body.lastParaId) == 0 then ""
  else match filter(\n. getOrElse(getAttr(n, "w15:paraId"), "") == body.lastParaId, exNodes) {
    [] => "",
    ex :: _ => {
      let parentPara = getOrElse(getAttr(ex, "w15:paraIdParent"), "");
      if length(parentPara) == 0 then ""
      else match filter(\b. b.lastParaId == parentPara, bodies) {
        [] => "",
        parent :: _ => parent.id
      }
    }
  }
}

pure func docxIsResolved(body: DocxCommentBody, exNodes: [XmlNode]) -> bool =
  match filter(\n. getOrElse(getAttr(n, "w15:paraId"), "") == body.lastParaId, exNodes) {
    [] => false,
    ex :: _ => getOrElse(getAttr(ex, "w15:done"), "0") == "1"
  }

-- A reply annotates the same span as the comment it replies to. Word does not
-- always write a separate range for replies, so an unanchored reply inherits
-- its parent's anchor. This is the OOXML thread model, not a proximity guess:
-- the parent link is explicit in commentsExtended.xml.
pure func docxInheritReplyAnchors(placed: [DocxPlacedComment], bodies: [DocxCommentBody],
                                   anchors: [DocxAnchor], exNodes: [XmlNode]) -> [DocxPlacedComment] =
  map(\p. docxInheritOne(p, bodies, anchors, exNodes), placed)

pure func docxInheritOne(p: DocxPlacedComment, bodies: [DocxCommentBody],
                          anchors: [DocxAnchor], exNodes: [XmlNode]) -> DocxPlacedComment =
  match p.block {
    CommentBlock(c) =>
      if c.anchored || length(c.parentId) == 0 then p
      else match filter(\a. a.id == c.parentId, anchors) {
        [] => p,
        a :: _ =>
          if length(trim(a.text)) == 0 then p
          else {
            index: a.endIndex,
            block: mkAnchoredComment(c.id, c.author, c.date, c.text,
                                     a.text, a.kind, a.startIndex, c.parentId, c.resolved)
          }
      },
    _ => p
  }

-- Keep the SectionBlock(kind: "comment") wrapper so consumers written against
-- the pre-anchoring shape still find comments where they expect them.
pure func docxWrapComment(b: Block) -> Block =
  mkSection("comment", [b])

-- Place each comment directly after the block its span ends in; anything
-- unanchored (or pointing past the end of the body) trails the document.
pure func docxSpliceComments(blocks: [Block], placed: [DocxPlacedComment]) -> [Block] {
  let n = listLength(blocks);
  let inline = filter(\p. p.index >= 0 && p.index < n, placed);
  let trailing = filter(\p. p.index < 0 || p.index >= n, placed);
  concat(docxSpliceAt(blocks, 0, inline),
         map(\p. docxWrapComment(p.block), trailing))
}

pure func docxSpliceAt(blocks: [Block], idx: int, placed: [DocxPlacedComment]) -> [Block] =
  match blocks {
    [] => [],
    b :: rest => {
      let here = map(\p. docxWrapComment(p.block), filter(\p. p.index == idx, placed));
      b :: concat(here, docxSpliceAt(rest, idx + 1, placed))
    }
  }

-- Extract text from comment paragraphs
pure func docxExtractCommentTexts(paragraphs: [XmlNode]) -> [string] =
  match paragraphs {
    [] => [],
    p :: rest => {
      let pText = extractParagraphText(p, emptyMap());
      if length(pText) > 0
      then pText :: docxExtractCommentTexts(rest)
      else docxExtractCommentTexts(rest)
    }
  }

-- === Parse warnings (what the output approximates) ========================
--
-- The parsers in this package return [Block] and cannot surface a warnings
-- list in their exported type, so approximations are emitted as warning-styled
-- text blocks at the end of the body — the convention the image-extraction
-- cap and the XLSX shared-strings truncation already use. A reader (or an
-- agent) that sees output MUST be able to see when that output is not the
-- source document.
--
-- Deliberately quiet by construction: a well-formed document with defined
-- styles, no fields, terminated comment ranges and a footnotes part emits NO
-- warning blocks at all, so existing output stays byte-identical.
export pure func docxPartWarnings(root: XmlNode, stylesXml: string, hasFootnotesPart: bool) -> [Block] =
  map(\w. mkText(w, "warning", 0),
      concat(docxUndefinedStyleWarnings(root, stylesXml),
             concat(docxFieldWarning(root),
                    concat(docxFootnoteWarning(root, hasFootnotesPart),
                           docxUnterminatedRangeWarning(root)))))

-- Paragraph styles the document references but styles.xml does not define,
-- and which are not a built-in heading name. They are rendered as plain text;
-- a reader should know that the source styled them at all.
pure func docxUndefinedStyleWarnings(root: XmlNode, stylesXml: string) -> [string] {
  let referenced = dedup(findAllAttrs(root, "w:pStyle", "w:val"));
  let defined = docxDefinedStyleSet(stylesXml);
  let unknown = filter(\sid. length(sid) > 0 && not docxStyleKnown(sid, defined), referenced);
  if listLength(unknown) == 0 then []
  else ["Warning: ${show(listLength(unknown))} paragraph style(s) are not defined in styles.xml and were rendered as plain text: ${join(", ", unknown)}"]
}

pure func docxDefinedStyleSet(stylesXml: string) -> [string] =
  if length(stylesXml) == 0 then []
  else match parseLenient(stylesXml) {
    Ok(root) => docxDefinedStyleIds(findAll(root, "w:style")),
    Err(_) => []
  }

-- Built-in style names resolve without styles.xml, so they are never "unknown"
pure func docxStyleKnown(sid: string, defined: [string]) -> bool =
  headingLevelFromStyle(sid) > 0 || any(\d. d == sid, defined)

-- Fields (w:fldSimple / w:instrText) come back as their LAST CACHED result;
-- the formula is never evaluated here.
pure func docxFieldWarning(root: XmlNode) -> [string] =
  if listLength(findAll(root, "w:fldSimple")) + listLength(findAll(root, "w:instrText")) == 0 then []
  else ["Warning: field results are returned as the values last cached in the document; field codes are not evaluated"]

-- A w:footnoteReference with no word/footnotes.xml part at all: the note text
-- does not exist in the package, only the marker does.
pure func docxFootnoteWarning(root: XmlNode, hasFootnotesPart: bool) -> [string] =
  if hasFootnotesPart || listLength(findAll(root, "w:footnoteReference")) == 0 then []
  else ["Warning: the document references footnote(s) but contains no word/footnotes.xml part; the note text is not available"]

-- commentRangeStart with no matching commentRangeEnd: the comment degrades to
-- unanchored, which is the correct behaviour — but it is a degradation, so say so.
pure func docxUnterminatedRangeWarning(root: XmlNode) -> [string] {
  let starts = findAllAttrs(root, "w:commentRangeStart", "w:id");
  let ends = findAllAttrs(root, "w:commentRangeEnd", "w:id");
  let open = filter(\id. not docxIdIn(id, ends), starts);
  if listLength(open) == 0 then []
  else ["Warning: ${show(listLength(open))} comment range(s) start but never end; their comments are unanchored"]
}

pure func docxIdIn(id: string, ids: [string]) -> bool =
  any(\x. x == id, ids)

-- === Test helper: paragraph texts from a body-only document.xml ============
--
-- Pure, so the inline tests below can exercise run-level text extraction
-- (w:t, w:br, w:cr, w:tab inside one run) without the filesystem. Golden
-- fixtures that only count blocks cannot catch a lost line break: the block
-- count is identical before and after the fix, so the exact block text is
-- what these tests assert.
-- Plain text of the body's blocks, one per line, in block order — a flat,
-- exact-text view for inline tests (the test harness compares against scalar
-- literals only). Empty blocks contribute empty lines, so the line count is
-- also part of the assertion.
pure func docxXmlBodyText(xml: string) -> string
  tests [
    ("<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:t>P1 before</w:t><w:br/><w:t>P1 AFTER BREAK same run</w:t></w:r></w:p><w:p><w:r><w:t>P2 before</w:t><w:br w:type=\"textWrapping\"/><w:t>P2 AFTER textWrapping break</w:t></w:r></w:p><w:p><w:r><w:t>P3 before</w:t><w:br/></w:r><w:r><w:t>P3 AFTER BREAK next run</w:t></w:r></w:p><w:p><w:r><w:t>P4 tab</w:t><w:tab/><w:t>P4 AFTER TAB</w:t></w:r></w:p></w:body></w:document>",
     "P1 before\nP1 AFTER BREAK same run\nP2 before\nP2 AFTER textWrapping break\nP3 before\nP3 AFTER BREAK next run\nP4 tab\tP4 AFTER TAB"),
    ("<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:t>plain</w:t></w:r></w:p></w:body></w:document>",
     "plain"),
    ("<w:document xmlns:w=\"x\"><w:body><w:p><w:ins w:id=\"1\" w:author=\"a\" w:date=\"2024-01-01\"><w:r><w:t>added</w:t><w:br/><w:t>more</w:t></w:r></w:ins></w:p><w:p><w:del w:id=\"2\" w:author=\"a\" w:date=\"2024-01-01\"><w:r><w:delText>gone</w:delText><w:br/><w:delText>still gone</w:delText></w:r></w:del></w:p></w:body></w:document>",
     "added\nmore\nadded\nmore\n\ngone\nstill gone"),
    ("<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:t>hy</w:t><w:noBreakHyphen/><w:t>phen and</w:t><w:softHyphen/><w:t>soft</w:t></w:r></w:p></w:body></w:document>",
     "hy-phen andsoft")
  ]
{
  match parseLenient(xml) {
    Ok(root) =>
      match findFirst(root, "w:body") {
        Some(body) =>
          join("\n", map(docxBlockPlainText, processBodyChildren(getChildren(body), emptyMap(), emptyMap(), emptyMap()))),
        None => ""
      },
    Err(_) => ""
  }
}

-- Plain text of one content block, for tests and text-only consumers.
pure func docxBlockPlainText(b: Block) -> string =
  match b {
    TextBlock(t) => t.text,
    HeadingBlock(h) => h.text,
    ChangeBlock(c) => c.text,
    _ => ""
  }

-- === Inline tests: block shapes over raw document.xml ======================
--
-- The test harness compares scalar literals only, so block shapes are asserted
-- through this compact view: one entry per block, comma-joined, in block order.
--   text:T            a TextBlock with text T
--   hN:T              a level-N HeadingBlock
--   list:i1@0|i2@1    a ListBlock with items and their nesting levels
--                     (no @ when the list is flat)
--   section:K[N]      a SectionBlock kind K, name N when set
--   change:T          a ChangeBlock
--   other             anything else
pure func docxXmlBodyView(xml: string) -> string =
  docxXmlBodyViewWith(xml, emptyMap())

pure func docxXmlBodyViewWith(xml: string, hlevels: Map[string, int]) -> string =
  match parseLenient(xml) {
    Ok(root) =>
      match findFirst(root, "w:body") {
        Some(body) =>
          join(",", map(docxBlockView, processBodyChildren(getChildren(body), emptyMap(), emptyMap(), hlevels))),
        None => ""
      },
    Err(_) => ""
  }

pure func docxBlockView(b: Block) -> string =
  match b {
    TextBlock(t) => "text:${t.text}",
    HeadingBlock(h) => "h${show(h.level)}:${h.text}",
    ListBlock(l) => docxListView(l),
    SectionBlock(s) => docxSectionView(s),
    ChangeBlock(c) => "change:${c.changeType}",
    _ => "other"
  }

pure func docxListView(l: {items: [string], ordered: bool, itemRuns: [[InlineRun]], itemLevels: [int]}) -> string =
  "list:${join("|", map(docxItemView, docxZipItemsLevels(l.items, l.itemLevels)))}"

-- Items paired with their levels; a flat list has no levels to pair.
pure func docxZipItemsLevels(items: [string], levels: [int]) -> [(string, int)] =
  match (items, levels) {
    (i :: ir, l :: lr) => (i, l) :: docxZipItemsLevels(ir, lr),
    (i :: ir, _) => (i, 0) :: docxZipItemsLevels(ir, []),
    _ => []
  }

pure func docxItemView(p: (string, int)) -> string =
  match p {
    (item, lvl) => if lvl == 0 then item else "${item}@${show(lvl)}"
  }

pure func docxSectionView(s: {kind: string, name: string, blocks: [Block]}) -> string =
  if length(s.name) > 0 then "section:${s.kind}[${s.name}]" else "section:${s.kind}"

-- P1: custom styles resolve through basedOn to a heading level; an own
-- outlineLvl wins over the chain (9 = body text); a cycle resolves to 0.
pure func docxStyleLevelsView(stylesXml: string) -> string
  tests [
    -- ChapterTitle/SectionHeader are basedOn Heading1/Heading2
    ("<w:styles xmlns:w=\"x\"><w:style w:styleId=\"Heading1\"><w:name w:val=\"heading 1\"/><w:pPr><w:outlineLvl w:val=\"0\"/></w:pPr></w:style><w:style w:styleId=\"Heading2\"><w:name w:val=\"heading 2\"/><w:pPr><w:outlineLvl w:val=\"1\"/></w:pPr></w:style><w:style w:styleId=\"ChapterTitle\"><w:basedOn w:val=\"Heading1\"/></w:style><w:style w:styleId=\"SectionHeader\"><w:basedOn w:val=\"Heading2\"/></w:style></w:styles>",
     "Heading1=1,Heading2=2,ChapterTitle=1,SectionHeader=2"),
    -- an own outlineLvl wins over the chain; 9 means body text; a two-hop
    -- basedOn chain resolves through the middle style
    ("<w:styles xmlns:w=\"x\"><w:style w:styleId=\"Heading1\"><w:pPr><w:outlineLvl w:val=\"0\"/></w:pPr></w:style><w:style w:styleId=\"TOCHeading\"><w:basedOn w:val=\"Heading1\"/><w:pPr><w:outlineLvl w:val=\"9\"/></w:pPr></w:style><w:style w:styleId=\"Deep\"><w:basedOn w:val=\"Middle\"/></w:style><w:style w:styleId=\"Middle\"><w:basedOn w:val=\"Heading1\"/></w:style></w:styles>",
     "Heading1=1,TOCHeading=0,Deep=1,Middle=1"),
    -- a basedOn cycle resolves to 0, not a hang
    ("<w:styles xmlns:w=\"x\"><w:style w:styleId=\"A\"><w:basedOn w:val=\"B\"/></w:style><w:style w:styleId=\"B\"><w:basedOn w:val=\"A\"/></w:style></w:styles>",
     "A=0,B=0"),
    -- no styles part: nothing resolves
    ("", "")
  ]
{
  let levels = docxStyleHeadingLevels(stylesXml);
  join(",", map(\sid. docxLevelPairView((sid, getOrElse(mapLookup(levels, sid), 0))),
                docxStyleIdsOf(stylesXml)))
}

pure func docxStyleIdsOf(stylesXml: string) -> [string] =
  match parseLenient(stylesXml) {
    Ok(r) => docxDefinedStyleIds(findAll(r, "w:style")),
    Err(_) => []
  }

pure func docxLevelPairView(p: (string, int)) -> string =
  match p { (k, v) => "${k}=${show(v)}" }

-- P1: a ChapterTitle paragraph IS a heading, and a paragraph's own outlineLvl
-- makes one too.
pure func docxCustomHeadingView() -> string
  tests [((), "h1:Annual Report")]
{
  docxXmlBodyViewWith(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:pStyle w:val=\"ChapterTitle\"/></w:pPr><w:r><w:t>Annual Report</w:t></w:r></w:p></w:body></w:document>",
    docxStyleHeadingLevels(docxShapeStylesXml()))
}

pure func docxShapeStylesXml() -> string =
  "<w:styles xmlns:w=\"x\"><w:style w:styleId=\"Heading1\"><w:pPr><w:outlineLvl w:val=\"0\"/></w:pPr></w:style><w:style w:styleId=\"ChapterTitle\"><w:basedOn w:val=\"Heading1\"/></w:style></w:styles>"

-- A paragraph's own w:outlineLvl makes it a heading even with no pStyle
pure func docxDirectOutlineView() -> string
  tests [((), "h3:outlined")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:outlineLvl w:val=\"2\"/></w:pPr><w:r><w:t>outlined</w:t></w:r></w:p></w:body></w:document>")
}

-- P3: a paragraph that holds nothing but a break is a break MARKER, not an
-- empty text block indistinguishable from a blank line.
pure func docxPageBreakOnlyView() -> string
  tests [((), "section:page-break")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:br w:type=\"page\"/></w:r></w:p></w:body></w:document>")
}

-- Text followed by a break keeps both, in order
pure func docxPageBreakAfterTextView() -> string
  tests [((), "text:before,section:page-break")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:t>before</w:t></w:r><w:r><w:br w:type=\"page\"/></w:r></w:p></w:body></w:document>")
}

pure func docxColumnBreakView() -> string
  tests [((), "text:one,section:column-break")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:t>one</w:t></w:r><w:r><w:br w:type=\"column\"/></w:r></w:p></w:body></w:document>")
}

-- A mid-document pPr/sectPr is a section break (the body-level one already was)
pure func docxMidSectionBreakView() -> string
  tests [((), "section:section-break")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:sectPr/></w:pPr><w:r><w:t/></w:r></w:p></w:body></w:document>")
}

-- P6: bookmark anchors carry their names
pure func docxBookmarkView() -> string
  tests [((), "section:bookmark[sec1],text:hi")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:bookmarkStart w:id=\"1\" w:name=\"sec1\"/><w:r><w:t>hi</w:t></w:r></w:p></w:body></w:document>")
}

-- P2: consecutive list paragraphs merge into ONE block, with per-item levels;
-- a flat list stays flat (no itemLevels), and a text block between lists
-- keeps them separate.
pure func docxFlatListMergeView() -> string
  tests [((), "list:first|second|third")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>first</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>second</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>third</w:t></w:r></w:p></w:body></w:document>")
}

pure func docxNestedListMergeView() -> string
  tests [((), "list:top|sub@1")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/><w:ilvl w:val=\"0\"/></w:numPr></w:pPr><w:r><w:t>top</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/><w:ilvl w:val=\"1\"/></w:numPr></w:pPr><w:r><w:t>sub</w:t></w:r></w:p></w:body></w:document>")
}

pure func docxListSplitByTextView() -> string
  tests [((), "list:a,text:mid,list:b")]
{
  docxXmlBodyView(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>a</w:t></w:r></w:p><w:p><w:r><w:t>mid</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>b</w:t></w:r></w:p></w:body></w:document>")
}

-- P2b: footnote text survives; separator/continuation notes are furniture,
-- and the same unwrapping covers endnotes.
pure func docxFootnotesView() -> string
  tests [((), "text:note text")]
{
  join(",", map(docxBlockView, parseSectionXml(
    "<w:footnotes xmlns:w=\"x\"><w:footnote w:type=\"separator\" w:id=\"-1\"><w:p><w:r><w:separator/></w:r></w:p></w:footnote><w:footnote w:id=\"1\"><w:p><w:r><w:t>note text</w:t></w:r></w:p></w:footnote></w:footnotes>")))
}

pure func docxEndnotesView() -> string
  tests [((), "text:end note")]
{
  join(",", map(docxBlockView, parseSectionXml(
    "<w:endnotes xmlns:w=\"x\"><w:endnote w:type=\"continuationSeparator\" w:id=\"0\"><w:p><w:r><w:continuationSeparator/></w:r></w:p></w:endnote><w:endnote w:id=\"2\"><w:p><w:r><w:t>end note</w:t></w:r></w:p></w:endnote></w:endnotes>")))
}

-- P4: the warning MESSAGES fire only when the source approximates.
pure func docxWarningTexts(xml: string, stylesXml: string, hasFootnotesPart: bool) -> [string] =
  match parseLenient(xml) {
    Ok(root) => concat(docxUndefinedStyleWarnings(root, stylesXml),
                       concat(docxFieldWarning(root),
                              concat(docxFootnoteWarning(root, hasFootnotesPart),
                                     docxUnterminatedRangeWarning(root)))),
    Err(_) => []
  }

pure func docxUndefinedStyleWarningMsg() -> string
  tests [((), "Warning: 1 paragraph style(s) are not defined in styles.xml and were rendered as plain text: Mystery")]
{
  join(" | ", docxWarningTexts(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:pPr><w:pStyle w:val=\"Mystery\"/></w:pPr><w:r><w:t>x</w:t></w:r></w:p></w:body></w:document>",
    "<w:styles xmlns:w=\"x\"/>", true))
}

pure func docxFieldWarningMsg() -> string
  tests [((), "Warning: field results are returned as the values last cached in the document; field codes are not evaluated")]
{
  join(" | ", docxWarningTexts(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:fldSimple w:instr=\"FILENAME\"><w:t>cached</w:t></w:fldSimple></w:r></w:p></w:body></w:document>",
    "", true))
}

pure func docxFootnoteWarningMsg() -> string
  tests [((), "Warning: the document references footnote(s) but contains no word/footnotes.xml part; the note text is not available")]
{
  join(" | ", docxWarningTexts(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:footnoteReference w:id=\"1\"/></w:r></w:p></w:body></w:document>",
    "", false))
}

pure func docxUnterminatedRangeWarningMsg() -> string
  tests [((), "Warning: 1 comment range(s) start but never end; their comments are unanchored")]
{
  join(" | ", docxWarningTexts(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:commentRangeStart w:id=\"1\"/><w:r><w:t>x</w:t></w:r></w:p></w:body></w:document>",
    "", true))
}

-- A clean document warns about nothing at all
pure func docxNoWarnings() -> string
  tests [((), "")]
{
  join(" | ", docxWarningTexts(
    "<w:document xmlns:w=\"x\"><w:body><w:p><w:r><w:t>plain</w:t></w:r></w:p></w:body></w:document>",
    "", true))
}

