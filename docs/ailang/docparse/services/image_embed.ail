module docparse/services/image_embed

-- Shared rules for which ImageBlocks become embedded picture parts, and the
-- file extension each one is written under. Every generator that embeds a
-- picture (DOCX, PPTX, XLSX, ODT, ODP, ODS) asks these, so they agree on what
-- counts as embeddable.

import std/string (contains, length)

-- Whether an ImageBlock's payload can be embedded as a binary part.
--
-- ImageBlock.data is overloaded across parsers. DOCX/PPTX put base64 bytes in
-- it, but html_parser stores the <img src> URL (html_parser.ail:378) and
-- odt_parser stores the package href (odt_parser.ail:247). Embedding on
-- `length(data) > 0 && length(mime) > 0` therefore fed "hero-small.png" and
-- "Pictures/10000...svg" to the base64 decoder, and the archive writer failed
-- the ENTIRE document with "invalid base64: illegal base64 data at input byte
-- N" — every HTML file with an <img>, and two ODTs, could not be converted to
-- DOCX at all.
--
-- Mime alone cannot discriminate: odt_parser guesses a real mime
-- ("image/svg+xml") from the href's extension, so the reference looks
-- embeddable by every metadata check. The payload itself is the only reliable
-- signal, so require both a mime we can name an extension for and a payload
-- that is not obviously a path or URL.
--
-- References fall back to the "[Image: description]" text placeholder, which is
-- what external images already got.
export pure func embedIsEmbeddableMime(mime: string) -> bool =
  mime == "image/png" || mime == "image/jpeg" || mime == "image/gif"
  || mime == "image/bmp" || mime == "image/tiff" || mime == "image/svg+xml"

-- "." " " and ":" are outside both the standard and URL-safe base64 alphabets,
-- and are near-universal in paths and URLs ("hero-small.png",
-- "Pictures/x.svg", "data:image/png;base64,..."). Checked with `contains`
-- builtins rather than a per-character scan, which would walk multi-megabyte
-- payloads in the interpreter.
export pure func embedIsBinaryPayload(data: string, mime: string) -> bool {
  if length(data) == 0 then false
  else if embedIsEmbeddableMime(mime) == false then false
  else if contains(data, ".") then false
  else if contains(data, " ") then false
  else if contains(data, ":") then false
  else true
}

-- MIME type to file extension (the name a media part is written under)
export pure func embedExt(mime: string) -> string =
  if mime == "image/png" then "png"
  else if mime == "image/jpeg" then "jpeg"
  else if mime == "image/gif" then "gif"
  else if mime == "image/bmp" then "bmp"
  else if mime == "image/tiff" then "tiff"
  else if mime == "image/svg+xml" then "svg"
  else "png"


export pure func testImageEmbedRules() -> bool
  tests [((), true)]
{
  embedIsBinaryPayload("iVBORw0KGgo=", "image/png") &&
  embedIsBinaryPayload("hero-small.png", "image/png") == false &&
  embedIsBinaryPayload("iVBORw0KGgo=", "image/unknown") == false &&
  embedExt("image/jpeg") == "jpeg" &&
  embedExt("image/svg+xml") == "svg"
}
