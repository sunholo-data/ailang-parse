module docparse/services/markdown_writer

import std/string (length, replaceMany, startsWith, substring, repeat)
import std/list (foldl, length as listLength)
import docparse/types/document (Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, AudioBlock, VideoBlock, SectionBlock, ChangeBlock, LinkBlock, CommentBlock, commentText, TableCell, InlineRun, ParsedDocument, DocMetadata, cellText)

-- Markdown writer — renders a ParsedDocument to markdown for LLM consumption.
--
-- Split out of output_formatter because the in-browser WASM type-checker has a
-- 2 second PER-MODULE budget, and the combined module reached 67% of it on a
-- fast laptop — which is over budget on CI hardware and on a slow visitor's
-- machine. The browser demo failed to boot with:
--
--   Module docparse/services/output_formatter failed: type error in
--   renderMarkdown: WASM type-checker budget exceeded (2s)
--
-- No single function dominated: the cost was the accumulation of several
-- whole-ADT matches over Block in one module (renderBlockMd, printBlock,
-- blockToJson each contributed ~200-330ms). Since the budget is per module,
-- splitting is the fix that scales; micro-optimising one match was not going
-- to buy back enough headroom.
--
-- The seam is clean by construction: this half needs nothing from the JSON
-- half, and the JSON half needs only renderMarkdown, renderBlockMd and
-- headingPrefix, which are exported below.

-- Render blocks to markdown text suitable for LLM consumption
-- Strips binary image data, keeps descriptions, renders tables as markdown tables
export pure func renderMarkdown(doc: ParsedDocument) -> string {
  let header = renderMetadataHeader(doc.metadata, doc.format, doc.filename);
  let body = renderBlocksMd(doc.blocks);
  "${header}\n${body}"
}

pure func renderMetadataHeader(meta: DocMetadata, format: string, filename: string) -> string {
  let titleLine = if length(meta.title) > 0
    then "# ${meta.title}\n\n"
    else "";
  let metaLines = if length(meta.author) > 0
    then "**Author:** ${meta.author}\n"
    else "";
  "${titleLine}${metaLines}"
}

pure func renderBlocksMd(blocks: [Block]) -> string =
  foldl(\acc b. "${acc}${renderBlockMd(b)}", "", blocks)

export pure func renderBlockMd(block: Block) -> string =
  match block {
    HeadingBlock(h) =>
      "${headingPrefix(h.level)}${mdOneLine(inlineMd(h.text, h.runs))}\n\n",
    TextBlock(t) =>
      if t.style == "hr" then "---\n\n"
      else if t.style == "quote" then "> ${mdOneLine(inlineMd(t.text, t.runs))}\n\n"
      else if isCodeStyle(t.style) then "```${codeStyleLang(t.style)}\n${t.text}\n```\n\n"
      else if length(t.text) > 0 || listLength(t.runs) > 0
      then "${inlineMd(t.text, t.runs)}\n\n"
      else "",
    TableBlock(t) =>
      "${renderTableMd(t.headers, t.rows)}\n",
    ListBlock(l) =>
      "${renderListMd(l.items, l.itemRuns, l.ordered, 1, l.itemLevels)}\n",
    ImageBlock(i) =>
      if length(i.description) > 0
      then "[Image: ${i.description}]\n\n"
      else "[Image]\n\n",
    AudioBlock(a) =>
      if length(a.transcription) > 0
      then "[Audio transcription: ${a.transcription}]\n\n"
      else "[Audio]\n\n",
    VideoBlock(v) =>
      if length(v.description) > 0
      then "[Video: ${v.description}]\n\n"
      else "[Video]\n\n",
    SectionBlock(s) =>
      renderSectionMd(s.kind, s.name, s.blocks),
    ChangeBlock(b) =>
      renderChangeMd(b.changeType, b.author, b.date, b.text),
    LinkBlock(b) =>
      "[${b.text}](${b.href})\n\n",
    CommentBlock(b) =>
      renderCommentMd(b.author, b.date, b.text, b.anchorText, b.anchored)
  }

-- A comment renders as a blockquote of the annotated span followed by the
-- comment itself, so a linear reader meets the two together. Unanchored
-- comments are labelled, never quietly attached to the preceding block.
pure func renderCommentMd(author: string, date: string, text: string,
                          anchorText: string, anchored: bool) -> string {
  let byline = if length(date) > 0 then "${author}, ${date}" else author;
  if anchored && length(anchorText) > 0
  then "> ${anchorText}\n>\n> **Comment (${byline}):** ${text}\n\n"
  else "> **Comment (${byline}, unanchored):** ${text}\n\n"
}

-- A fenced code block is carried as a TextBlock whose style is "code" or
-- "code:<lang>". Keeping the fence as a style rather than as literal backticks
-- in `text` is what stops the inline reader from eating them on the way back.
export pure func isCodeStyle(style: string) -> bool =
  style == "code" || startsWith(style, "code:")

export pure func codeStyleLang(style: string) -> string =
  if startsWith(style, "code:") then substring(style, 5, length(style)) else ""

export pure func headingPrefix(level: int) -> string
  ensures { length(result) >= 2 }
{
  if level == 1 then "# "
  else if level == 2 then "## "
  else if level == 3 then "### "
  else if level == 4 then "#### "
  else if level == 5 then "##### "
  else if level == 6 then "###### "
  else "## "
}

-- A container renders as a rule separating it from what came before, plus a
-- heading naming it.
--
-- The name comes from the section, not from the kind string: sheets used to be
-- labelled with a hardcoded "### Sheet" that both discarded the real sheet name
-- and sat three levels below the level-1 heading inside it, while ODS sheets,
-- ODP slides and EPUB chapters — whose names were packed into the kind as
-- "sheet:Q1" — matched no branch at all and rendered with no boundary
-- whatsoever, running every sheet of a workbook together into one stream.
--
-- When the section's first block is already a heading, that heading is the
-- label; adding another would restate it.
pure func renderSectionMd(kind: string, name: string, blocks: [Block]) -> string {
  let isDivision = kind == "slide" || kind == "sheet" || kind == "chapter";
  let rule = if isDivision then "---\n\n" else "";
  let label = if isDivision && length(name) > 0 && not startsWithHeading(blocks)
    then "${headingPrefix(2)}${name}\n\n"
    else if kind == "header" then "*Header:*\n"
    else if kind == "footer" then "*Footer:*\n"
    else if kind == "footnote" then "*Footnote:*\n"
    else if kind == "endnote" then "*Endnote:*\n"
    else if kind == "textbox" then "> "
    else "";
  "${rule}${label}${renderBlocksMd(blocks)}"
}

pure func startsWithHeading(blocks: [Block]) -> bool =
  match blocks {
    [] => false,
    b :: _ => match b { HeadingBlock(_) => true, _ => false }
  }

-- Render a track change annotation as markdown
-- Uses a blockquote with an attribution prefix:
--   > [insert by Alice on 2026-03-29] text
--   > [delete by Bob on 2026-03-29] ~~text~~
-- This format is easier for downstream LLMs to parse than inline bold/italic.
pure func renderChangeMd(changeType: string, author: string, date: string, text: string) -> string
  ensures { length(result) > 0 }
{
  let who = if length(author) > 0 then author else "unknown";
  let when = if length(date) > 0 then " on ${date}" else "";
  let prefix = "> [${changeType} by ${who}${when}] ";
  let body = if changeType == "delete" || changeType == "move-from"
    then "~~${text}~~"
    else text;
  "${prefix}${body}\n\n"
}

-- Render a table as markdown
pure func renderTableMd(headers: [TableCell], rows: [[TableCell]]) -> string {
  let headerLine = "| ${renderCellsMd(headers)}\n";
  let sepLine = "| ${renderSepMd(headers)}\n";
  let rowLines = renderRowsMd(rows);
  "${headerLine}${sepLine}${rowLines}"
}

pure func renderCellsMd(cells: [TableCell]) -> string =
  match cells {
    [] => "",
    c :: [] => "${cellTextMd(c)} |",
    c :: rest => "${cellTextMd(c)} | ${renderCellsMd(rest)}"
  }

-- Render a single cell to markdown text. Cells with colSpan > 1 or merged=true
-- get a Pandoc-style attribute suffix so downstream tools and LLMs can recover
-- the table topology from the markdown alone:
--   "Total {colspan=2}"      -- spans two columns
--   "Header {merged}"        -- continuation of a merged region
-- markdown_parser reads both back, so a table survives the round trip.
pure func cellTextMd(cell: TableCell) -> string {
  let suffix = if cell.colSpan > 1
    then " {colspan=${show(cell.colSpan)}}"
    else if cell.merged then " {merged}"
    else "";
  "${mdEscapeCell(cell.text)}${suffix}"
}

-- A markdown table row is one line, with cells separated by pipes. Cell text
-- that contains either breaks the grammar: a DOCX cell holding two paragraphs
-- used to split the row across three lines and shatter the table, and a pipe
-- inside a cell silently invented a column. Both are escaped on the way out
-- and restored by markdown_parser on the way back in.
-- A heading or a list item is one line by definition. Text carrying a newline
-- — a PPTX title split across two lines, say — would otherwise end the
-- construct early and leave the remainder as a stray paragraph.
-- Runs back to Markdown markers. The reader turns "**bold**" into a run; without
-- the inverse, every conversion THROUGH markdown quietly flattened formatting —
-- docx(bold) -> md -> docx came out plain.
pure func inlineMd(text: string, runs: [InlineRun]) -> string =
  if listLength(runs) == 0 then text
  else mdEmitRuns(runs, false, false, false, "")

-- Markers are emitted as TRANSITIONS, not per run: adjacent runs sharing a
-- format share one pair. Wrapping each run on its own produced ambiguous
-- output — "bold with *italic* inside" came out as five consecutive asterisks,
-- which does not read back as what it was.
--
-- When the format changes at all, every open marker is closed innermost-first
-- and the new set reopened. Slightly more markers than strictly necessary,
-- never a malformed nest.
pure func mdEmitRuns(runs: [InlineRun], b: bool, i: bool, st: bool, acc: string) -> string =
  match runs {
    [] => "${acc}${mdCloseMarks(b, i, st)}",
    r :: rest => {
      -- Close only what must close, innermost first; a marker nested inside a
      -- closing one has to close with it and reopen after. Closing everything
      -- on any change is what produced "*****".
      let closeB = b && not r.bold;
      let closeI = (i && not r.italic) || (closeB && i);
      let closeS = (st && not r.strike) || ((closeB || closeI) && st);
      let openB = r.bold && (not b || closeB);
      let openI = r.italic && (not i || closeI);
      let openS = r.strike && (not st || closeS);
      let head = "${acc}${mdCloseMarks(closeB, closeI, closeS)}${mdOpenMarks(openB, openI, openS)}";
      -- Code content is literal: it must not be escaped, and its own markers
      -- must not be re-wrapped.
      let body = if r.code then "`${r.text}`" else mdEscapeInline(r.text);
      let piece = if length(r.href) > 0 then "[${body}](${r.href})" else body;
      mdEmitRuns(rest, r.bold, r.italic, r.strike, "${head}${piece}")
    }
  }

pure func mdOpenMarks(b: bool, i: bool, st: bool) -> string =
  "${if b then "**" else ""}${if i then "*" else ""}${if st then "~~" else ""}"

pure func mdCloseMarks(b: bool, i: bool, st: bool) -> string =
  "${if st then "~~" else ""}${if i then "*" else ""}${if b then "**" else ""}"

-- A marker character in ordinary text would be read back as formatting.
pure func mdEscapeInline(text: string) -> string =
  replaceMany(text, [("\\", "\\\\"), ("*", "\\*"), ("_", "\\_"),
                     ("`", "\\`"), ("[", "\\[")])

pure func mdOneLine(text: string) -> string =
  replaceMany(text, [("\r\n", " "), ("\r", " "), ("\n", " ")])

pure func mdEscapeCell(text: string) -> string =
  replaceMany(text, [("\\", "\\\\"), ("|", "\\|"), ("\r\n", "<br>"), ("\r", "<br>"), ("\n", "<br>")])

-- The separator row carries alignment back out, so ":---:" survives a round
-- trip instead of being read once and dropped.
pure func renderSepMd(cells: [TableCell]) -> string =
  match cells {
    [] => "",
    c :: [] => "${alignDashes(c.align)} |",
    c :: rest => "${alignDashes(c.align)} | ${renderSepMd(rest)}"
  }

pure func alignDashes(align: string) -> string =
  if align == "center" then ":---:"
  else if align == "right" then "---:"
  else if align == "left" then ":---"
  else "---"

pure func renderRowsMd(rows: [[TableCell]]) -> string =
  foldl(\acc row. "${acc}| ${renderCellsMd(row)}\n", "", rows)

-- Render list items. itemRuns is parallel to items but may be empty entirely
-- (nothing formatted) or shorter than items, so both are walked together and
-- a missing/empty run list simply falls back to the flattened item text --
-- mirroring docx_generator's docxListItemsToXml. Without this a list item's
-- bold/italic/code markers survived into `blocks` but were dropped on the way
-- to markdown, since only the flattened plain-text `items` were ever read.
pure func renderListMd(items: [string], itemRuns: [[InlineRun]], ordered: bool, idx: int, levels: [int]) -> string =
  match items {
    [] => "",
    item :: rest => {
      -- Two spaces per level, which is what the reader measures back.
      let lvl = match levels { [] => 0, n :: _ => n };
      let restLevels = match levels { [] => [], _ :: t => t };
      let pad = repeat("  ", lvl);
      let marker = if ordered then "${show(idx)}. " else "- ";
      let body = match itemRuns { [] => item, r :: _ => inlineMd(item, r) };
      let restRuns = match itemRuns { [] => [], _ :: t => t };
      "${pad}${marker}${mdOneLine(body)}\n${renderListMd(rest, restRuns, ordered, idx + 1, restLevels)}"
    }
  }
