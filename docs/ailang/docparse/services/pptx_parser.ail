module docparse/services/pptx_parser

import std/xml (parseLenient, findAll, findFirst, getText, getAttr, getChildren, getTag)
import std/option (Some, None, flatMap as optFlatMap, map as optMap, getOrElse)
import std/result (Ok, Err)
import std/string (contains, length, trim, stringToInt, join, intToStr)
import std/list (map, flatMap, any, filter, concat, length as listLength, take)
import docparse/types/document (Block, TextBlock, HeadingBlock, TableBlock, ListBlock, ImageBlock, SectionBlock, TableCell, DocMetadata, emptyMetadata, mkImage, mkTable, mkAnchoredComment)
import docparse/services/zip_extract (readCoreProperties, findSlideEntries, readZipEntry, findMediaEntries, readImageEntry, mediaMimeType, readPptxSlideRels, pptxResolveTarget)
import docparse/services/omml (renderOmml)

-- PPTX Parser
-- Parses PowerPoint slides into content Blocks.
--
-- PPTX XML structure (ppt/slides/slideN.xml):
--   <p:sld>
--     <p:cSld>
--       <p:spTree>             -- shape tree (all slide content)
--         <p:sp>               -- shape (text box, title, body)
--           <p:nvSpPr>         -- non-visual properties
--             <p:nvPr>
--               <p:ph type="title"/>  -- placeholder type
--             </p:nvPr>
--           </p:nvSpPr>
--           <p:txBody>         -- text body
--             <a:p>            -- paragraph
--               <a:r>          -- run
--                 <a:t>text</a:t>
--               </a:r>
--             </a:p>
--           </p:txBody>
--         </p:sp>
--         <p:graphicFrame>     -- table or chart
--           <a:graphic>
--             <a:graphicData>
--               <a:tbl>        -- table
--                 <a:tr><a:tc>...</a:tc></a:tr>
--               </a:tbl>
--             </a:graphicData>
--           </a:graphic>
--         </p:graphicFrame>
--         <p:pic>              -- image
--           <p:blipFill><a:blip r:embed="rId2"/></p:blipFill>
--         </p:pic>
--       </p:spTree>
--     </p:cSld>
--   </p:sld>

-- Parse all slides from a PPTX file
export func parsePptx(filepath: string) -> [Block] ! {FS} {
  let slideEntries = findSlideEntries(filepath);
  let totalSlides = listLength(slideEntries);
  let cappedEntries = take(500, slideEntries);
  let slideBlocks = parseSlides(filepath, cappedEntries);
  if totalSlides > 500
  then {
    let warning = TextBlock({
      text: "Warning: truncated from ${intToStr(totalSlides)} to 500 slides.",
      style: "warning", level: 0
    });
    warning :: slideBlocks
  }
  else slideBlocks
}

-- Parse metadata from PPTX (same core.xml format as DOCX)
export func parsePptxMetadata(filepath: string) -> DocMetadata ! {FS} {
  let coreXml = readCoreProperties(filepath);
  match parseLenient(coreXml) {
    Ok(root) => extractPptxMeta(root),
    Err(_) => emptyMetadata()
  }
}

-- Parse images from PPTX
export func parsePptxImages(filepath: string) -> [Block] ! {FS} {
  let entries = findMediaEntries(filepath);
  extractPptxImages(filepath, entries)
}

-- Parse each slide entry into a SectionBlock
func parseSlides(filepath: string, entries: [string]) -> [Block] ! {FS} =
  pptxParseSlidesFrom(filepath, entries, 1)

func pptxParseSlidesFrom(filepath: string, entries: [string], slideNo: int) -> [Block] ! {FS} =
  match entries {
    [] => [],
    entry :: rest => {
      let xml = readZipEntry(filepath, entry);
      let blocks = parseSlideXml(xml);
      let comments = pptxSlideComments(filepath, entry, xml, slideNo);
      let moreBlocks = pptxParseSlidesFrom(filepath, rest, slideNo + 1);
      if pptxHasContent(blocks)
      then {
        let section = SectionBlock({kind: "slide", blocks: blocks});
        section :: concat(comments, moreBlocks)
      }
      else concat(comments, moreBlocks)
    }
  }

-- === Slide comments (ECMA-376 §19.3 + modern PowerPoint) =================
--
-- A PowerPoint comment is pinned to a point on a slide, not to a run of text,
-- so the honest anchor is the slide itself — we use the slide number plus its
-- opening line, which is what a reader needs to locate it. Claiming a text
-- range here would be inventing precision the format does not carry.
--
-- Two shapes, both handled:
--   ppt/comments/comment1.xml         legacy <p:cm authorId> + ppt/commentAuthors.xml
--   ppt/comments/modernComment_*.xml  modern <p188:cm authorId=GUID> + ppt/authors.xml
--
-- Which comment part belongs to which slide comes from the slide's own
-- relationships, not from matching "comment1.xml" to "slide1.xml" — that
-- numbering coincidence holds for simple decks and mis-attributes on the rest.
func pptxSlideComments(filepath: string, slideEntry: string, slideXml: string,
                        slideNo: int) -> [Block] ! {FS} {
  let relsXml = readPptxSlideRels(filepath, slideEntry);
  let targets = pptxCommentTargets(relsXml);
  let anchor = pptxSlideAnchor(slideXml, slideNo);
  pptxReadCommentParts(filepath, targets, anchor)
}

-- Comment-part targets declared by a slide's relationships
pure func pptxCommentTargets(relsXml: string) -> [string] =
  if length(relsXml) == 0 then []
  else match parseLenient(relsXml) {
    Ok(root) =>
      map(\r. pptxResolveTarget(getOrElse(getAttr(r, "Target"), "")),
          filter(pptxIsCommentRel, findAll(root, "Relationship"))),
    Err(_) => []
  }

-- Legacy relationships end in "/comments"; modern PowerPoint uses the SINGULAR
-- ".../2018/8/relationships/modernComment", so match both spellings.
pure func pptxIsCommentRel(r: XmlNode) -> bool {
  let relType = getOrElse(getAttr(r, "Type"), "");
  contains(relType, "/comments") || contains(relType, "modernComment")
}

-- "Slide 3: Q3 Revenue Forecast" — the slide number plus its opening line
pure func pptxSlideAnchor(slideXml: string, slideNo: int) -> string {
  let first = pptxFirstSlideText(slideXml);
  if length(first) > 0 then "Slide ${intToStr(slideNo)}: ${first}"
  else "Slide ${intToStr(slideNo)}"
}

pure func pptxFirstSlideText(slideXml: string) -> string =
  match parseLenient(slideXml) {
    Ok(root) => match findAll(root, "a:t") {
      [] => "",
      t :: _ => trim(getText(t))
    },
    Err(_) => ""
  }

func pptxReadCommentParts(filepath: string, targets: [string], anchor: string) -> [Block] ! {FS} =
  match targets {
    [] => [],
    target :: rest => {
      let xml = readZipEntry(filepath, target);
      let here = pptxParseCommentPart(filepath, xml, anchor);
      concat(here, pptxReadCommentParts(filepath, rest, anchor))
    }
  }

func pptxParseCommentPart(filepath: string, xml: string, anchor: string) -> [Block] ! {FS} {
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => {
      let modern = findAll(root, "p188:cm");
      match modern {
        [] => {
          let authors = pptxLegacyAuthors(filepath);
          map(\n. pptxLegacyComment(n, authors, anchor), findAll(root, "p:cm"))
        },
        _ => {
          let authors = pptxModernAuthors(filepath);
          map(\n. pptxModernComment(n, authors, anchor), modern)
        }
      }
    },
    Err(_) => []
  }
}

-- Legacy: ppt/commentAuthors.xml maps numeric id -> name
func pptxLegacyAuthors(filepath: string) -> [(string, string)] ! {FS} {
  let xml = readZipEntry(filepath, "ppt/commentAuthors.xml");
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => map(\a. (getOrElse(getAttr(a, "id"), ""),
                         getOrElse(getAttr(a, "name"), "Unknown")),
                    findAll(root, "p:cmAuthor")),
    Err(_) => []
  }
}

-- Modern: ppt/authors.xml maps GUID -> name
func pptxModernAuthors(filepath: string) -> [(string, string)] ! {FS} {
  let xml = readZipEntry(filepath, "ppt/authors.xml");
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => map(\a. (getOrElse(getAttr(a, "id"), ""),
                         getOrElse(getAttr(a, "name"), "Unknown")),
                    findAll(root, "p188:author")),
    Err(_) => []
  }
}

pure func pptxLegacyComment(node: XmlNode, authors: [(string, string)], anchor: string) -> Block {
  let authorId = getOrElse(getAttr(node, "authorId"), "");
  let text = trim(join(" ", map(getText, findAll(node, "p:text"))));
  mkAnchoredComment(getOrElse(getAttr(node, "idx"), ""),
                    pptxAuthorName(authors, authorId),
                    getOrElse(getAttr(node, "dt"), ""),
                    text, anchor, "slide", 0, "", false)
}

pure func pptxModernComment(node: XmlNode, authors: [(string, string)], anchor: string) -> Block {
  let authorId = getOrElse(getAttr(node, "authorId"), "");
  let text = trim(join(" ", map(getText, findAll(node, "a:t"))));
  mkAnchoredComment(getOrElse(getAttr(node, "id"), ""),
                    pptxAuthorName(authors, authorId),
                    getOrElse(getAttr(node, "created"), ""),
                    text, anchor, "slide", 0,
                    getOrElse(getAttr(node, "parentId"), ""), false)
}

pure func pptxAuthorName(authors: [(string, string)], id: string) -> string =
  match filter(\a. pptxPairKey(a) == id, authors) {
    [] => "Unknown",
    a :: _ => pptxPairVal(a)
  }

pure func pptxPairKey(p: (string, string)) -> string = match p { (k, _) => k }
pure func pptxPairVal(p: (string, string)) -> string = match p { (_, v) => v }

-- Parse a single slide's XML into blocks
export pure func parseSlideXml(xml: string) -> [Block] {
  if length(xml) == 0 then []
  else match parseLenient(xml) {
    Ok(root) => extractSlideBlocks(root),
    Err(_) => []
  }
}

-- Extract blocks from a slide root element
export pure func extractSlideBlocks(root: XmlNode) -> [Block] =
  getOrElse(
    optFlatMap(\csld.
      optMap(\spTree. processShapeTree(getChildren(spTree)),
        findFirst(csld, "p:spTree")),
      findFirst(root, "p:cSld")),
    [])

-- Process all children of the shape tree
pure func processShapeTree(nodes: [XmlNode]) -> [Block] =
  flatMap(processShapeNode, nodes)

-- Process a single shape tree node
pure func processShapeNode(node: XmlNode) -> [Block] {
  let tag = getTag(node);
  if tag == "p:sp" then parseShape(node)
  else if tag == "p:graphicFrame" then parseGraphicFrame(node)
  else if tag == "p:pic" then parsePicture(node)
  else if tag == "p:grpSp" then parseGroupShape(node)
  else []
}

-- Parse a shape (p:sp) into blocks
-- Checks placeholder type to determine heading level
pure func parseShape(sp: XmlNode) -> [Block] {
  let phType = getPlaceholderType(sp);
  match findFirst(sp, "p:txBody") {
    Some(txBody) => {
      let children = getChildren(txBody);
      extractShapeParagraphs(children, phType)
    },
    None => []
  }
}

-- Get placeholder type from p:nvSpPr/p:nvPr/p:ph@type
pure func getPlaceholderType(sp: XmlNode) -> string {
  match optFlatMap(\nvSpPr.
    optFlatMap(\nvPr.
      findFirst(nvPr, "p:ph"),
      findFirst(nvSpPr, "p:nvPr")),
    findFirst(sp, "p:nvSpPr"))
  {
    Some(ph) => getOrElse(getAttr(ph, "type"), "body"),
    None => "none"
  }
}

-- Extract paragraphs from a text body
pure func extractShapeParagraphs(nodes: [XmlNode], phType: string) -> [Block] =
  flatMap(\node.
    if getTag(node) == "a:p" then
      let text = extractDrawingMLText(node) in
      if length(trim(text)) > 0 then
        [if phType == "title" || phType == "ctrTitle"
          then HeadingBlock({text: text, level: 1})
          else if phType == "subTitle"
          then HeadingBlock({text: text, level: 2})
          else TextBlock({text: text, style: phType, level: 0})]
      else []
    else [],
    nodes)

-- Extract text from a DrawingML paragraph (a:p -> a:r -> a:t)
pure func extractDrawingMLText(p: XmlNode) -> string {
  let children = getChildren(p);
  extractDrawingMLRuns(children)
}

pure func extractDrawingMLRuns(nodes: [XmlNode]) -> string =
  join("", map(drawingMLNodeText, nodes))

-- Extract text contribution from a single DrawingML node
pure func drawingMLNodeText(node: XmlNode) -> string {
  let tag = getTag(node);
  if tag == "a:r" then extractDrawingMLRunText(node)
  else if tag == "a:br" then "\n"
  else if tag == "m:oMath" then renderOmml(node)
  else if tag == "m:oMathPara" then renderOmml(node)
  else ""
}

-- Extract text from a single a:r run
pure func extractDrawingMLRunText(run: XmlNode) -> string =
  getOrElse(optMap(getText, findFirst(run, "a:t")), "")

-- Parse a graphic frame (contains tables or charts)
pure func parseGraphicFrame(gf: XmlNode) -> [Block] {
  match findFirst(gf, "a:tbl") {
    Some(tbl) => [parsePptxTable(tbl)],
    None => []
  }
}

-- Parse a PPTX table (a:tbl -> a:tr -> a:tc)
pure func parsePptxTable(tbl: XmlNode) -> Block {
  let rows = findAll(tbl, "a:tr");
  let parsedRows = parsePptxRows(rows);
  match parsedRows {
    [] => mkTable([], []),
    firstRow :: dataRows =>
      mkTable(dataRows, firstRow)
  }
}

pure func parsePptxRows(rows: [XmlNode]) -> [[TableCell]]
  ensures { listLength(result) == listLength(rows) }
{
  map(parsePptxRow, rows)
}

pure func parsePptxRow(tr: XmlNode) -> [TableCell] {
  let cells = findAll(tr, "a:tc");
  parsePptxCells(cells)
}

pure func parsePptxCells(cells: [XmlNode]) -> [TableCell]
  ensures { listLength(result) == listLength(cells) }
{
  map(parsePptxCell, cells)
}

-- Parse a single PPTX table cell with merge info
-- gridSpan, hMerge, vMerge are attributes on a:tc
pure func parsePptxCell(tc: XmlNode) -> TableCell {
  let text = extractPptxCellText(tc);
  let cs = getPptxGridSpan(tc);
  let hm = getPptxHMerge(tc);
  let vm = getPptxVMerge(tc);
  if hm || vm
  then { text: "", colSpan: cs, rowSpan: 1, merged: true, scope: "" }
  else { text: text, colSpan: cs, rowSpan: 1, merged: false, scope: "" }
}

pure func extractPptxCellText(tc: XmlNode) -> string {
  match findFirst(tc, "a:txBody") {
    Some(txBody) => {
      let paragraphs = findAll(txBody, "a:p");
      joinPptxParagraphTexts(paragraphs)
    },
    None => ""
  }
}

pure func joinPptxParagraphTexts(ps: [XmlNode]) -> string =
  join("\n", map(extractDrawingMLText, ps))

pure func getPptxGridSpan(tc: XmlNode) -> int
  ensures { result >= 1 }
{
  getOrElse(optMap(\val. pptxParseIntOrDefault(val, 1), getAttr(tc, "gridSpan")), 1)
}

pure func getPptxHMerge(tc: XmlNode) -> bool =
  getOrElse(optMap(\val. val == "1" || val == "true", getAttr(tc, "hMerge")), false)

pure func getPptxVMerge(tc: XmlNode) -> bool =
  getOrElse(optMap(\val. val == "1" || val == "true", getAttr(tc, "vMerge")), false)

-- Parse a picture element
pure func parsePicture(pic: XmlNode) -> [Block] {
  let descr = getPictureDescription(pic);
  [mkImage("", descr, "image/unknown")]
}

pure func getPictureDescription(pic: XmlNode) -> string =
  getOrElse(
    optFlatMap(\nvPicPr.
      optFlatMap(\cNvPr.
        getAttr(cNvPr, "descr"),
        findFirst(nvPicPr, "p:cNvPr")),
      findFirst(pic, "p:nvPicPr")),
    "")

-- Parse a group shape (recursively process children)
pure func parseGroupShape(grpSp: XmlNode) -> [Block] {
  let children = getChildren(grpSp);
  processShapeTree(children)
}

-- Extract metadata from core.xml (shared format across Office)
pure func extractPptxMeta(root: XmlNode) -> DocMetadata {
  let title = getPptxMetaField(root, "dc:title");
  let author = getPptxMetaField(root, "dc:creator");
  let created = getPptxMetaField(root, "dcterms:created");
  let modified = getPptxMetaField(root, "dcterms:modified");
  { title: title, author: author, created: created, modified: modified, pageCount: 0 }
}

pure func getPptxMetaField(root: XmlNode, tagName: string) -> string =
  getOrElse(optMap(getText, findFirst(root, tagName)), "")

-- Extract images from media entries
func extractPptxImages(filepath: string, entries: [string]) -> [Block] ! {FS} =
  match entries {
    [] => [],
    entry :: rest => {
      let imageData = readImageEntry(filepath, entry);
      let mime = mediaMimeType(entry);
      let block = mkImage(imageData, "", mime);
      let moreBlocks = extractPptxImages(filepath, rest);
      block :: moreBlocks
    }
  }

-- Check if a block list has content
pure func pptxHasContent(blocks: [Block]) -> bool =
  any(pptxBlockHasContent, blocks)

pure func pptxBlockHasContent(b: Block) -> bool =
  match b {
    TextBlock(t) => length(trim(t.text)) > 0,
    HeadingBlock(h) => length(trim(h.text)) > 0,
    TableBlock(_) => true,
    ListBlock(_) => true,
    ImageBlock(_) => true,
    SectionBlock(s) => pptxHasContent(s.blocks)
  }

pure func pptxParseIntOrDefault(s: string, default: int) -> int =
  getOrElse(stringToInt(s), default)
