module docparse/types/document

-- Core document content model for AILANG Parse
-- Represents the universal output of parsing any document format.
-- All parsers (docx, pptx, xlsx) produce [Block] lists.

import std/string (length, join, startsWith, contains, find, substring)
import std/list (filter, map, reverse, length as listLength)

-- A table cell with merge span info
-- colSpan: number of columns this cell spans (1 = normal)
-- rowSpan: number of rows this cell spans (1 = normal)
-- merged: true if this is a continuation cell (content lives in the span origin)
-- scope: "row" | "col" | "rowgroup" | "colgroup" | "" — populated by HTML
--        parser for <th scope=…>. Empty for normal data cells.
export type TableCell = {
  text: string,
  colSpan: int,
  rowSpan: int,
  merged: bool,
  scope: string,
  -- "" | "left" | "center" | "right". Markdown states it with colons in the
  -- separator row (|:---|---:|); every other format has its own notion. Empty
  -- means "not specified", which is not the same as left.
  align: string
}

-- A span of text within a paragraph carrying character formatting.
--
-- TextBlock.text stays the authoritative *readable* form and is never rewritten
-- to accommodate runs. text and runs are therefore ALLOWED TO DISAGREE, and
-- this is deliberate — do not "fix" it:
--
--   html_parser encodes formatting into text as Markdown markers ("**bold**",
--   "`code`", "~~del~~"), chosen for CommonMark/Pandoc/LLM compatibility, and
--   11 golden files depend on that. A parser that populates runs may therefore
--   emit text with markers AND runs with clean text for the same paragraph.
--
-- So: `text` is for reading, `runs` is for rendering. Nothing asserts that runs
-- concatenate to text, and a contract claiming so would be wrong.
--
-- `runs` is empty whenever a parser has no formatting information — which is
-- most of them today — and generators fall back to plain `text` in that case,
-- so an empty list is the normal, valid state rather than missing data.
export type InlineRun = {
  text: string,
  bold: bool,
  italic: bool,
  underline: bool,
  strike: bool,
  code: bool,
  -- Link target, "" when the run is not a link. Markdown markers in `text`
  -- cannot carry a URL into a generator: HTML→DOCX leaked a literal
  -- "[A2UI](https://…)" into Word until this existed.
  href: string,
  vertAlign: string   -- "" | "superscript" | "subscript"
}

-- A content block extracted from a document
--
-- LinkBlock represents an HTML anchor with href. Generators that don't
-- preserve link semantics (DOCX/PPTX paragraph writers, plain-text
-- renderers) treat it as a TextBlock with the anchor's visible text.
--
-- CommentBlock is a review comment together with the span of document text it
-- annotates (DOCX §17.13.1). A comment without its anchor is noise — "this is
-- nonsense" is only actionable if you know which clause is nonsense — so when
-- the anchor cannot be resolved with certainty, `anchored` is false and
-- `anchorText` is empty rather than a nearby guess. It stays wrapped in a
-- SectionBlock(kind: "comment") so consumers of the older shape keep working.
--   anchorKind:        what kind of thing the comment is attached to —
--                      "range" (DOCX commentRangeStart/End text span)
--                      "point" (DOCX bare commentReference, its paragraph)
--                      "cell"  (XLSX ref="B5", plus that cell's value)
--                      "slide" (PPTX — pinned to an x/y point on a slide, so
--                               the slide is the honest anchor, not a text run)
--                      "none"  (unresolvable; anchorText is empty)
--   anchorBlockIndex:  index of the annotated block; -1 when unanchored
--   parentId:          id of the comment this replies to; "" for top-level
export type Block = TextBlock({text: string, style: string, level: int, runs: [InlineRun]})
                  | TableBlock({rows: [[TableCell]], headers: [TableCell], caption: string})
                  | ImageBlock({data: string, description: string, mime: string, width: int, height: int, srcset: string, title: string, loading: string})
                  | AudioBlock({data: string, transcription: string, mime: string})
                  | VideoBlock({data: string, description: string, mime: string})
                  | ListBlock({items: [string], ordered: bool, itemRuns: [[InlineRun]], itemLevels: [int]})
                  | HeadingBlock({text: string, level: int, runs: [InlineRun]})
                  | SectionBlock({kind: string, name: string, blocks: [Block]})
                  | ChangeBlock({changeType: string, author: string, date: string, text: string})
                  | LinkBlock({text: string, href: string, title: string})
                  | CommentBlock({id: string, author: string, date: string, text: string,
                                  anchorText: string, anchorKind: string, anchored: bool,
                                  anchorBlockIndex: int, parentId: string, resolved: bool})

-- Document metadata from core.xml / app.xml
export type DocMetadata = {
  title: string,
  author: string,
  created: string,
  modified: string,
  pageCount: int
}

-- Full parsed document
export type ParsedDocument = {
  format: string,
  filename: string,
  metadata: DocMetadata,
  blocks: [Block]
}

-- Extraction result with quality info
export type ExtractionResult = {
  document: ParsedDocument,
  warnings: [string],
  aiCallsUsed: int
}

-- Helpers for working with blocks

export pure func blockText(block: Block) -> string =
  match block {
    TextBlock(b) => b.text,
    TableBlock(_) => "[table]",
    ImageBlock(b) => "[image: ${b.description}]",
    AudioBlock(b) => "[audio: ${b.transcription}]",
    VideoBlock(b) => "[video: ${b.description}]",
    ListBlock(b) => join(", ", b.items),
    HeadingBlock(b) => b.text,
    SectionBlock(b) => "[${b.kind}]",
    ChangeBlock(b) => "[${b.changeType} by ${b.author}] ${b.text}",
    LinkBlock(b) => "${b.text} <${b.href}>",
    CommentBlock(b) => commentText(b.author, b.text, b.anchorText, b.anchored)
  }

-- Render a comment so the pairing with its anchor is unambiguous to a reader
-- (human or agent). An unanchored comment says so explicitly — the one thing
-- it must never do is look like it has a target when it doesn't.
export pure func commentText(author: string, text: string, anchorText: string, anchored: bool) -> string =
  if anchored && length(anchorText) > 0
  then "[comment by ${author} on \"${anchorText}\"] ${text}"
  else "[comment by ${author}, unanchored] ${text}"

export pure func isHeading(block: Block) -> bool =
  match block {
    HeadingBlock(_) => true,
    _ => false
  }

export pure func isTable(block: Block) -> bool =
  match block {
    TableBlock(_) => true,
    _ => false
  }

export pure func isImage(block: Block) -> bool =
  match block {
    ImageBlock(_) => true,
    _ => false
  }

export pure func isSection(block: Block) -> bool =
  match block {
    SectionBlock(_) => true,
    _ => false
  }

export pure func filterSections(blocks: [Block]) -> [Block]
  ensures { listLength(result) <= listLength(blocks) }
{
  filter(isSection, blocks)
}

export pure func countBlocks(blocks: [Block]) -> int
  ensures { result >= 0 }
{
  listLength(blocks)
}

export pure func filterHeadings(blocks: [Block]) -> [Block]
  ensures { listLength(result) <= listLength(blocks) }
{
  filter(isHeading, blocks)
}

export pure func filterTables(blocks: [Block]) -> [Block]
  ensures { listLength(result) <= listLength(blocks) }
{
  filter(isTable, blocks)
}

export pure func filterImages(blocks: [Block]) -> [Block]
  ensures { listLength(result) <= listLength(blocks) }
{
  filter(isImage, blocks)
}

export pure func isComment(block: Block) -> bool =
  match block {
    CommentBlock(_) => true,
    _ => false
  }

export pure func filterComments(blocks: [Block]) -> [Block]
  ensures { listLength(result) <= listLength(blocks) }
{
  filter(isComment, blocks)
}

-- Construct an anchored comment (the annotated span was resolved from
-- document.xml with certainty).
export pure func mkAnchoredComment(id: string, author: string, date: string, text: string,
                                    anchorText: string, anchorKind: string, anchorBlockIndex: int,
                                    parentId: string, resolved: bool) -> Block =
  CommentBlock({
    id: id, author: author, date: date, text: text,
    anchorText: anchorText, anchorKind: anchorKind, anchored: true,
    anchorBlockIndex: anchorBlockIndex, parentId: parentId, resolved: resolved
  })

-- Construct an unanchored comment. Used whenever the anchor cannot be
-- resolved — a w:id present in one part but not the other, a malformed or
-- missing id, an unterminated range. Never falls back to nearby text.
export pure func mkUnanchoredComment(id: string, author: string, date: string, text: string,
                                      parentId: string, resolved: bool) -> Block =
  CommentBlock({
    id: id, author: author, date: date, text: text,
    anchorText: "", anchorKind: "none", anchored: false,
    anchorBlockIndex: 0 - 1, parentId: parentId, resolved: resolved
  })

export pure func isChange(block: Block) -> bool =
  match block {
    ChangeBlock(_) => true,
    _ => false
  }

export pure func filterChanges(blocks: [Block]) -> [Block]
  ensures { listLength(result) <= listLength(blocks) }
{
  filter(isChange, blocks)
}

-- Create a simple (non-merged) table cell
export pure func simpleCell(text: string) -> TableCell
  ensures { result.colSpan == 1 && result.rowSpan == 1 && result.merged == false }
{
  {text: text, colSpan: 1, rowSpan: 1, merged: false, scope: "", align: ""}
}

-- Create a header cell with HTML5 scope (row | col | rowgroup | colgroup)
-- Used by html_parser when extracting <th scope=…>. Other parsers can
-- continue using simpleCell.
export pure func scopedCell(text: string, scope: string) -> TableCell
  ensures { result.colSpan == 1 && result.rowSpan == 1 && result.merged == false }
{
  {text: text, colSpan: 1, rowSpan: 1, merged: false, scope: scope, align: ""}
}

-- Create a merged continuation cell (empty, spanned from another cell)
export pure func mergedCell() -> TableCell
  ensures { result.merged && length(result.text) == 0 }
{
  {text: "", colSpan: 1, rowSpan: 1, merged: true, scope: "", align: ""}
}

-- Create a cell with column span
export pure func spanCell(text: string, cs: int) -> TableCell
  ensures { result.colSpan == cs && result.merged == false }
{
  {text: text, colSpan: cs, rowSpan: 1, merged: false, scope: "", align: ""}
}

-- Construct a TableBlock with no caption (most non-HTML parsers).
-- HTML parser uses mkTableFull when <caption> is present.
export pure func mkTable(rows: [[TableCell]], headers: [TableCell]) -> Block =
  TableBlock({rows: rows, headers: headers, caption: ""})

-- Construct a TableBlock with a caption (HTML <caption> element).
export pure func mkTableFull(rows: [[TableCell]], headers: [TableCell], caption: string) -> Block =
  TableBlock({rows: rows, headers: headers, caption: caption})

-- Get text from a table cell
export pure func cellText(cell: TableCell) -> string = cell.text

-- Construct a TextBlock.
--
-- Prefer this over constructing TextBlock({...}) directly. TableBlock and
-- ImageBlock have had mk* helpers since they gained optional fields, precisely
-- so that adding a field doesn't have to touch every construction site;
-- TextBlock never got one, which is why it has 75 direct constructors across 15
-- modules. Routing them through here keeps the next field addition to this
-- function.
export pure func mkText(text: string, style: string, level: int) -> Block =
  TextBlock({text: text, style: style, level: level, runs: []})

-- Construct a TextBlock carrying character formatting. Only for parsers that
-- can actually resolve run properties (DOCX w:rPr, PPTX a:rPr, HTML inline
-- tags); everything else should use mkText and leave runs empty.
-- Runs are coalesced here rather than in each parser: every parser routes
-- through this constructor, and all four split runs more finely than the
-- formatting requires.
export pure func mkTextRuns(text: string, style: string, level: int, runs: [InlineRun]) -> Block =
  TextBlock({text: text, style: style, level: level, runs: coalesceRuns(runs)})

-- A run with no formatting applied — the base to vary from, so call sites don't
-- have to spell out every flag to set one.
export pure func plainRun(text: string) -> InlineRun =
  {text: text, bold: false, italic: false, underline: false,
   strike: false, code: false, href: "", vertAlign: ""}

-- Merge adjacent runs that carry identical formatting.
--
-- Parsers split runs wherever the source does, which is finer than the
-- formatting requires: Word starts a new w:r at every property change AND at
-- many that change nothing, ODF splits at every <text:s/>, and re-parsing our
-- own generated ODT turns one bold phrase into "phrase" + " ". None of that is
-- wrong, but it makes runs verbose and makes a byte-comparison of two
-- semantically identical documents fail.
--
-- Text is concatenated; formatting is untouched. A run's flags are the identity
-- here, so this cannot change how anything renders.
export pure func coalesceRuns(runs: [InlineRun]) -> [InlineRun] =
  match runs {
    [] => [],
    r :: rest => reverse(docCoalesceStep(rest, r, []))
  }

pure func docCoalesceStep(runs: [InlineRun], cur: InlineRun, acc: [InlineRun]) -> [InlineRun] =
  match runs {
    [] => cur :: acc,
    r :: rest =>
      if docRunFmtEq(cur, r)
      then docCoalesceStep(rest, {text: "${cur.text}${r.text}", bold: cur.bold,
                                  italic: cur.italic, underline: cur.underline,
                                  strike: cur.strike, code: cur.code, href: "",
                                  vertAlign: cur.vertAlign}, acc)
      else docCoalesceStep(rest, r, cur :: acc)
  }

-- href is part of the identity: two runs with identical emphasis but different
-- targets are different links, and merging them would silently drop one. This
-- is the trap every new InlineRun field walks into — omit it here and the field
-- survives parsing but vanishes before any generator sees it.
pure func docRunFmtEq(a: InlineRun, b: InlineRun) -> bool =
  a.bold == b.bold && a.italic == b.italic && a.underline == b.underline &&
  a.strike == b.strike && a.code == b.code && a.vertAlign == b.vertAlign &&
  a.href == b.href

-- Construct a HeadingBlock. Same rationale as mkText: route constructions
-- through one function so field additions don't touch 25 call sites.
export pure func mkHeading(text: string, level: int) -> Block =
  HeadingBlock({text: text, level: level, runs: []})

export pure func mkHeadingRuns(text: string, level: int, runs: [InlineRun]) -> Block =
  HeadingBlock({text: text, level: level, runs: coalesceRuns(runs)})

-- Construct a ListBlock.
export pure func mkList(items: [string], ordered: bool) -> Block =
  ListBlock({items: items, ordered: ordered, itemRuns: [], itemLevels: []})

-- ListBlock with per-item formatting.
--
-- itemRuns is a PARALLEL array to items: itemRuns[i] holds the runs for
-- items[i]. It is either empty (nothing in the list is formatted) or exactly
-- the same length as items. A record-per-item would enforce that in the type,
-- but `items: [string]` is consumed by the SDKs, unstructured_compat, a2ui and
-- every generator, so changing its shape would be a breaking change where a
-- parallel field is additive. Consumers must tolerate an empty itemRuns and
-- should not assume alignment without checking length.
export pure func mkListRuns(items: [string], ordered: bool, itemRuns: [[InlineRun]]) -> Block =
  ListBlock({items: items, ordered: ordered, itemRuns: map(coalesceRuns, itemRuns), itemLevels: []})

-- A nested list. `itemLevels` is parallel to `items`, 0 for a top-level item.
-- Empty when the list is flat, so an ordinary list serialises exactly as it
-- did before nesting existed.
export pure func mkListNested(items: [string], ordered: bool,
                              itemRuns: [[InlineRun]], itemLevels: [int]) -> Block =
  ListBlock({items: items, ordered: ordered,
             itemRuns: map(coalesceRuns, itemRuns), itemLevels: itemLevels})

-- Construct a plain body paragraph — the overwhelmingly common case
-- (style "normal", level 0).
export pure func mkPara(text: string) -> Block =
  mkText(text, "normal", 0)

-- Construct an ImageBlock with default values for the extended HTML
-- attributes (width, height, srcset, title, loading). Most parsers
-- (DOCX/PPTX/ODT/EPUB/Markdown/TeX/AI) don't have these attributes to
-- extract, so this helper avoids forcing every constructor site to
-- pass empty strings / zeros.
-- Construct a SectionBlock. `kind` says what sort of container it is; `name`
-- is the container's own identity — a sheet name, a slide title, a chapter.
--
-- The name used to be packed into the kind ("sheet:Q1 Revenue"), which meant
-- every consumer matched on kind by exact equality and therefore matched
-- nothing: ODS sheets and ODP slides rendered with no label at all, while a
-- colon in the name would have split it in the middle. Callers with no name
-- use mkSection and `name` stays empty, keeping the JSON byte-identical.
export pure func mkSection(kind: string, blocks: [Block]) -> Block =
  SectionBlock({kind: kind, name: "", blocks: blocks})

export pure func mkNamedSection(kind: string, name: string, blocks: [Block]) -> Block =
  SectionBlock({kind: kind, name: name, blocks: blocks})

export pure func mkImage(data: string, description: string, mime: string) -> Block =
  ImageBlock({
    data: data,
    description: description,
    mime: mime,
    width: 0,
    height: 0,
    srcset: "",
    title: "",
    loading: ""
  })

-- Construct an ImageBlock with all HTML5 image attributes populated.
-- Used by html_parser when extracting <img> tags and <picture>/<source>
-- elements. Pass 0 / empty string for any attribute that wasn't present.
export pure func mkImageFull(data: string, description: string, mime: string,
                              width: int, height: int, srcset: string,
                              title: string, loading: string) -> Block =
  ImageBlock({
    data: data,
    description: description,
    mime: mime,
    width: width,
    height: height,
    srcset: srcset,
    title: title,
    loading: loading
  })

-- What an ImageBlock.data string actually refers to.
--
-- The field is overloaded by history: Office/EPUB/ODF parsers embed raw base64
-- bytes, while the HTML parser stores the <img src> verbatim — which may be a
-- data: URI, a relative path, or a remote URL. A consumer that assumes base64
-- unconditionally renders `src="data:image/unknown;base64,photo.png"`, which is
-- not a reference to anything.
export type ImageSource
  = InlineBase64(string)   -- bytes in hand (embedded base64, or a decoded data: URI)
  | LocalFile(string)      -- path to read from disk, relative to the doc's dir
  | RemoteUrl(string)      -- http(s) — never fetched by the CLI
  | NotAnImage             -- empty / unusable reference

-- Classify what an ImageBlock.data string refers to. Base64 uses the alphabet
-- A-Za-z0-9+/= and so never contains "."; a real file reference carries an
-- extension dot. That "." is the discriminator between a long embedded blob and
-- a path. Single definition shared by the AI describer (which needs to know
-- whether to read from disk) and by every generator (which needs to know what
-- to put in a src/href).
export pure func classifyImageSource(data: string) -> ImageSource {
  if length(data) == 0 then NotAnImage
  else if startsWith(data, "data:") then {
    let idx = find(data, ",");
    if idx >= 0 then InlineBase64(substring(data, idx + 1, length(data)))
    else NotAnImage
  }
  else if startsWith(data, "http://") || startsWith(data, "https://") then RemoteUrl(data)
  else if length(data) > 100 && contains(data, ".") == false then InlineBase64(data)
  else LocalFile(data)
}

-- The reference a generator should point at for an image: a full data: URI when
-- we hold the bytes, otherwise the path/URL as written. Shared by the HTML and
-- Quarto generators, which need the identical answer for src="…" and ![](…).
--
-- Returns "" when there is nothing to point at, so callers can branch on empty
-- rather than emitting a dangling reference. Bytes with no mime count as
-- nothing to point at: a data: URI needs a type to render, and the callers'
-- "[Image: description]" placeholder is more use to a reader than an <img> that
-- resolves to application/octet-stream and shows a broken icon.
export pure func imageSrcRef(data: string, mime: string) -> string
  ensures { length(data) > 0 || length(result) == 0 }
{
  match classifyImageSource(data) {
    NotAnImage => "",
    RemoteUrl(url) => url,
    LocalFile(path) => path,
    InlineBase64(b64) =>
      if length(mime) > 0 then "data:${mime};base64,${b64}" else ""
  }
}

-- Create an empty metadata record
export pure func emptyMetadata() -> DocMetadata
  ensures { length(result.title) == 0 && result.pageCount == 0 }
{
  {title: "", author: "", created: "", modified: "", pageCount: 0}
}
