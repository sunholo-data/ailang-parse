module test_eml_bug

import std/string (split, join)
import std/bytes (fromString as stringToBytes, toString as bytesToString)
import docparse/services/eml_parser (parseEml)
import docparse/types/document (Block)

-- Read the test file
export pure func main() -> string
{
  -- This is the exact test case from the bug report
  let testEml = """From: Alice Example <alice@example.com>
To: Mark <mark@example.com>
Subject: nested multipart with RFC 2387 type parameter
Date: Thu, 21 Jun 2012 08:19:27 +0100
Message-ID: <repro-nested-001@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="_B1_"; type="multipart/alternative"

--_B1_
Content-Type: multipart/alternative; boundary="_B0_"

--_B0_
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: base64

SGVsbG8gTWFyawoKVGhlIGxlZ2FsIGV4cGVuc2VzIGNvdmVyIGlzIDI1MCwwMDAgREtLIHBlciBj
aXZpbCBjYXNlLgoKUmVnYXJkcwpBbGljZQo=

--_B0_--

--_B1_--""";

  let blocks = parseEml(testEml);
  formatBlockTree(blocks)
}

pure func formatBlockTree(blocks: [Block]) -> string =
  join("\n\n", map(formatBlock, blocks))

pure func formatBlock(b: Block) -> string =
  match b {
    _ => "[Block]"
  }
